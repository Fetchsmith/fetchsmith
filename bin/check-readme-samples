#!/usr/bin/env python3
"""check-readme-samples (added cycle 448, extended cycles 451 and 2008)

Standing check, three passes over the same READMEs:

1. Every key shown in a README "Sample output" JSON block must be a field the
   Actor actually declares in .actor/dataset_schema.json.
2. The mirror case (cycle 451, h70 follow-up): every field name a README
   *prose* bullet calls out in its bold lead-in -- e.g.
   "- **`titleClean`** -- Google News always appends..." -- must still be a
   real field, input or output. A bullet like this is how READMEs explain a
   field's quirks well after the sample block above it stops being the
   freshest source of truth; if the field gets renamed or dropped in code and
   only the sample block is caught (or nothing is), this sentence keeps
   describing a field that no longer exists.
3. (cycle 2008) Every sample-block VALUE must have the JSON type its field
   declares in dataset_schema.json -- pass 1 only asks whether the key is a
   real field, so a README showing a scalar where the Actor now emits an array,
   or a quoted "42" for a number field, passed it silently. Example values are
   deliberately NOT diffed; see type_mismatches() for why that comparison is
   unsound against a gen-output-schema-generated schema.

Nothing else in the check suite looks at README prose: check-code-fields diffs
code -> dataset_schema, check-registry-fields diffs registry -> schema,
check-meta-fields diffs field-count claims in meta.json/actor.json.

Exit 1 = a sample key or a prose-bullet field name is not declared anywhere.
--verbose lists every block/bullet checked.

Nested keys inside object/array values are NOT checked (dataset_schema only
declares top-level fields) -- pass 2 truncates a bullet's `documents[].isAvailable`
style reference down to its top-level `documents` for the same reason. Keys
starting with "_" (watch-mode change bookkeeping like _watchChangeType) are
checked too -- they are real pushed fields and belong in the schema. Pass 2
checks against input fields too (input_schema.json), since a bolded bullet
just as often documents an input option (e.g. `watchLabel`) as an output field.
"""
import json
import re
import sys
from pathlib import Path

ACTORS = Path("/root/agent/actors")
VERBOSE = "--verbose" in sys.argv

# Bare JSON literals, never field names -- a bold lead-in legitimately mixes
# a real field's backtick with an unrelated backtick literal, e.g.
# "`courtJurisdiction` ... and is `null` for the rest" (court-records-scraper
# README:144, found cycle 541). Skip these outright rather than flagging them.
JSON_LITERALS = {"null", "true", "false"}

# Per-slug allowlist (same pattern as check-code-fields' FIELD_SUPPRESS) for
# prose bullets that name a field *because it no longer exists* -- e.g.
# "`posture` was removed from the schema" -- rather than because the README
# is stale. Keyed by slug -> the removed field names its README legitimately
# still mentions.
PROSE_SUPPRESS = {
    # court-records-scraper README:141 explains `posture` was dropped
    # (0% fill, no keyless source) -- the mention is the documentation of
    # the removal, not a stale leftover. Found/confirmed cycle 541 (h160).
    "court-records-scraper": {"posture"},
}

# Headings whose json blocks are output rows. A block under a heading matching
# SKIP_RE is something else (input example, webhook payload) and is not checked.
OUTPUT_RE = re.compile(r"output|sample row|result row", re.I)
SKIP_RE = re.compile(r"webhook|input|payload|request|schedule", re.I)

FENCE_RE = re.compile(r"^```(\w*)\s*$")
HEADING_RE = re.compile(r"^#{1,6}\s+(.*)$")


def top_level_keys(text):
    """Top-level keys of a JSON object/array-of-objects block, or None."""
    try:
        doc = json.loads(text)
    except Exception:
        return None
    if isinstance(doc, list):
        keys = []
        for item in doc:
            if isinstance(item, dict):
                keys.extend(item.keys())
        return keys or None
    if isinstance(doc, dict):
        return list(doc.keys())
    return None


def sample_items(text):
    """The sample block's row dicts: [the object], or every object in an array block."""
    try:
        doc = json.loads(text)
    except Exception:
        return []
    if isinstance(doc, dict):
        return [doc]
    if isinstance(doc, list):
        return [d for d in doc if isinstance(d, dict)]
    return []


def json_types(value):
    """The JSON Schema type name(s) a Python value from json.loads satisfies.

    bool is tested before int because Python's bool IS an int, and an integral
    float satisfies "integer" too -- JSON has one number type, so a schema field
    declared "integer" legitimately round-trips a sample written as 1.0.
    """
    if value is None:
        return {"null"}
    if isinstance(value, bool):
        return {"boolean"}
    if isinstance(value, int):
        return {"integer", "number"}
    if isinstance(value, float):
        return {"number"} | ({"integer"} if value.is_integer() else set())
    if isinstance(value, str):
        return {"string"}
    if isinstance(value, list):
        return {"array"}
    if isinstance(value, dict):
        return {"object"}
    return set()


def type_mismatches(text, props):
    """Yield (key, readme_types, declared) where a sample value contradicts the schema.

    Pass 1 above answers "is this key a real field"; this answers "is the value
    shown the SHAPE the field really has". The two artifacts are written by
    different hands -- the sample block by us, dataset_schema.json generated off a
    real run by bin/gen-output-schema -- so a README that still shows a scalar where
    the Actor now emits an array (or a quoted "42" where the field is a number) is
    drift a buyer wiring up a parser pays for, and nothing else in the suite looks
    at sample VALUES.

    Deliberately NOT compared: the example values themselves. gen-output-schema
    records the first non-empty value it sees *per field*, so a schema's examples
    are a composite of different rows (and strings are cut at 120 chars) -- they are
    not one record, and diffing them against the README's one real row flags
    truncation and row-to-row variation as if they were defects (scoped cycle 2008).
    Types survive that, because every row of a field shares one type.
    """
    for row in sample_items(text):
        for k, v in row.items():
            declared = props.get(k, {}).get("type")
            if declared is None:
                continue
            declared = {declared} if isinstance(declared, str) else set(declared)
            if not declared or json_types(v) & declared:
                continue
            yield k, json_types(v), sorted(declared)


def blocks(readme):
    """Yield (heading, lineno, body) for each ```json fence in the README."""
    heading = ""
    lines = readme.read_text().splitlines()
    i = 0
    while i < len(lines):
        h = HEADING_RE.match(lines[i])
        if h:
            heading = h.group(1).strip()
            i += 1
            continue
        f = FENCE_RE.match(lines[i])
        if f:
            lang = f.group(1)
            start = i + 1
            j = start
            while j < len(lines) and not lines[j].startswith("```"):
                j += 1
            if lang == "json":
                yield heading, start + 1, "\n".join(lines[start:j])
            i = j + 1
            continue
        i += 1


# A bullet's bold lead-in, e.g. "- **`titleClean`** -- ..." or
# "- **`postedFrom`/`postedTo` for a fixed calendar window** -- ...".
BULLET_RE = re.compile(r"^\s*-\s+\*\*(.+?)\*\*")
BACKTICK_RE = re.compile(r"`([^`]+)`")
# A backtick span's leading identifier: "documents[].isAvailable" -> "documents",
# 'recordType: "both"' -> "recordType", "titleClean" -> "titleClean".
IDENT_RE = re.compile(r"^[A-Za-z_$][A-Za-z0-9_$]*")
# An Apify Actor handle, "owner/slug". Rival handles live in bold bullet
# lead-ins all over the Pricing sections every competitor_audit rewrites, and
# IDENT_RE truncates `martc03/gov-contracts-mcp` down to `martc03`, which is
# not a field and never will be (cycle 1276: 4 such false flags, all added by
# the 1266-1275 audits). Collect every owner handle the file itself names in
# `owner/slug` form and treat a bare mention of one as a handle, not a field.
HANDLE_RE = re.compile(r"\b([A-Za-z0-9_.-]+)/[A-Za-z0-9_.-]+\b")


def owner_handles(text):
    """Owner handles this README names in full `owner/slug` form, anywhere in the file.

    Harvested from the raw text, not from backtick spans: pairing backticks across a
    whole README does not work, because ``` fences contribute an odd backtick count
    and shift every subsequent span boundary, which is why the span-scoped version of
    this function could not see `sourabhbgp/apple-app-store-scraper` even though it is
    plainly backticked in the file.

    Raw-text harvesting is loose -- prose slash-pairs and URL paths match too
    ("keyword/NAICS" -> "keyword", ".../blog/x" -> "blog") -- so: dotted owners
    (domains) and owners preceded by a slash (inside a longer path) are dropped here,
    and the caller never lets this set suppress a DECLARED field (`keyword` is a real
    field on sam-gov-opportunities-scraper). What remains at risk is only a *stale*
    field mention whose name also happens to appear as "name/..." somewhere in the
    same file -- a much rarer shape than the rival handles this is built for.
    """
    out = set()
    for m in HANDLE_RE.finditer(text):
        owner = m.group(1)
        if "." in owner:
            continue
        if m.start() > 0 and text[m.start() - 1] == "/":
            continue
        out.add(owner)
    return out


def prose_field_mentions(readme, known=frozenset()):
    """Yield (lineno, field_name) for each backtick identifier in a bullet's bold lead-in.

    `known` (the declared input+output fields) is passed in only so a declared field
    is never dropped by the handle rule below -- a real field mention always wins.
    """
    text = readme.read_text()
    handles = owner_handles(text)
    for lineno, line in enumerate(text.splitlines(), start=1):
        b = BULLET_RE.match(line)
        if not b:
            continue
        for bt in BACKTICK_RE.finditer(b.group(1)):
            span = bt.group(1)
            # "owner/slug" in one span: a handle, never a top-level field name.
            if "/" in span and HANDLE_RE.match(span):
                continue
            # A bare owner handle. Checked against the whole span before IDENT_RE
            # truncation, because IDENT_RE stops at a hyphen and would otherwise
            # turn `automation-lab` into the non-handle, non-field token "automation".
            if span.strip() not in known and span.strip() in handles:
                continue
            m = IDENT_RE.match(span)
            if not m or m.group(0) in JSON_LITERALS:
                continue
            if m.group(0) not in known and m.group(0) in handles:
                continue
            yield lineno, m.group(0)


def main():
    problems = 0
    checked_bullets = 0
    checked_blocks = 0
    checked_types = 0
    for actor_dir in sorted(ACTORS.iterdir()):
        if not actor_dir.is_dir() or actor_dir.name.startswith("_"):
            continue
        readme = actor_dir / "README.md"
        schema = actor_dir / ".actor" / "dataset_schema.json"
        input_schema = actor_dir / ".actor" / "input_schema.json"
        if not readme.exists() or not schema.exists():
            print(f"SKIP {actor_dir.name}: missing README or dataset_schema.json")
            continue
        props = json.loads(schema.read_text()).get("fields", {}).get("properties", {})
        declared = set(props)
        known = set(declared)
        if input_schema.exists():
            known |= set(
                json.loads(input_schema.read_text()).get("properties", {})
            )
        suppressed_names = PROSE_SUPPRESS.get(actor_dir.name, set())
        for lineno, name in prose_field_mentions(readme, known):
            checked_bullets += 1
            ok = name in known or name in suppressed_names
            if VERBOSE:
                print(f"  {'ok' if ok else '? '} {actor_dir.name}:{lineno} prose bullet names '{name}'")
            if not ok:
                problems += 1
                print(
                    f"DRIFT {actor_dir.name}:{lineno} prose bullet names '{name}' -- "
                    f"not a declared input or output field"
                )
        for heading, lineno, body in blocks(readme):
            if not OUTPUT_RE.search(heading) or SKIP_RE.search(heading):
                continue
            keys = top_level_keys(body)
            if keys is None:
                # Truncated/elided sample (e.g. "..."), not parseable -- report
                # so it can be eyeballed, but do not fail the check on it.
                if VERBOSE:
                    print(f"  ?  {actor_dir.name}:{lineno} [{heading}] unparseable JSON")
                continue
            checked_blocks += 1
            undeclared = [k for k in keys if k not in declared]
            if VERBOSE:
                print(
                    f"  ok {actor_dir.name}:{lineno} [{heading}] "
                    f"{len(keys)} keys, {len(undeclared)} undeclared"
                )
            for k in undeclared:
                problems += 1
                print(
                    f"DRIFT {actor_dir.name}:{lineno} sample under '{heading}' "
                    f"shows '{k}' -- not a declared field in dataset_schema.json"
                )
            for k, got, want in type_mismatches(body, props):
                problems += 1
                print(
                    f"DRIFT {actor_dir.name}:{lineno} sample under '{heading}' "
                    f"shows '{k}' as {'/'.join(sorted(got))} -- "
                    f"dataset_schema.json declares {want}"
                )
            checked_types += sum(len(r) for r in sample_items(body))
    print(
        f"check-readme-samples: {checked_blocks} sample blocks, "
        f"{checked_bullets} prose bullets, {checked_types} sample values "
        f"type-checked, {problems} drift"
    )
    return 1 if problems else 0


if __name__ == "__main__":
    sys.exit(main())
