#!/usr/bin/env python3
"""check-readme-samples (added cycle 448)

Standing check: every key shown in a README "Sample output" JSON block must be a
field the Actor actually declares in .actor/dataset_schema.json.

Nothing else in the check suite looks at README sample blocks: check-code-fields
diffs code -> dataset_schema, check-registry-fields diffs registry -> schema,
check-meta-fields diffs field-count claims in meta.json/actor.json. A README
sample that shows a field the Actor stopped emitting (or never emitted, e.g. a
key copied from a sibling Actor) is a buyer-facing promise nothing validates.

Exit 1 = a sample key is not a declared field. --verbose lists every block.

Nested keys inside object/array values are NOT checked (dataset_schema only
declares top-level fields). Keys starting with "_" (watch-mode change
bookkeeping like _watchChangeType) are checked too -- they are real pushed
fields and belong in the schema.
"""
import json
import re
import sys
from pathlib import Path

ACTORS = Path("/root/agent/actors")
VERBOSE = "--verbose" in sys.argv

# Headings whose json blocks are output rows. A block under a heading matching
# SKIP_RE is something else (input example, webhook payload) and is not checked.
OUTPUT_RE = re.compile(r"output|sample row|result row", re.I)
SKIP_RE = re.compile(r"webhook|input|payload|request|schedule", re.I)

FENCE_RE = re.compile(r"^```(\w*)\s*$")
HEADING_RE = re.compile(r"^#{1,6}\s+(.*)$")


def top_level_keys(text):
    """Top-level keys of a JSON object/array-of-objects block, or None."""
    try:
        doc = json.loads(text)
    except Exception:
        return None
    if isinstance(doc, list):
        keys = []
        for item in doc:
            if isinstance(item, dict):
                keys.extend(item.keys())
        return keys or None
    if isinstance(doc, dict):
        return list(doc.keys())
    return None


def blocks(readme):
    """Yield (heading, lineno, body) for each ```json fence in the README."""
    heading = ""
    lines = readme.read_text().splitlines()
    i = 0
    while i < len(lines):
        h = HEADING_RE.match(lines[i])
        if h:
            heading = h.group(1).strip()
            i += 1
            continue
        f = FENCE_RE.match(lines[i])
        if f:
            lang = f.group(1)
            start = i + 1
            j = start
            while j < len(lines) and not lines[j].startswith("```"):
                j += 1
            if lang == "json":
                yield heading, start + 1, "\n".join(lines[start:j])
            i = j + 1
            continue
        i += 1


def main():
    problems = 0
    checked = 0
    for actor_dir in sorted(ACTORS.iterdir()):
        if not actor_dir.is_dir() or actor_dir.name.startswith("_"):
            continue
        readme = actor_dir / "README.md"
        schema = actor_dir / ".actor" / "dataset_schema.json"
        if not readme.exists() or not schema.exists():
            print(f"SKIP {actor_dir.name}: missing README or dataset_schema.json")
            continue
        declared = set(
            json.loads(schema.read_text()).get("fields", {}).get("properties", {})
        )
        for heading, lineno, body in blocks(readme):
            if not OUTPUT_RE.search(heading) or SKIP_RE.search(heading):
                continue
            keys = top_level_keys(body)
            if keys is None:
                # Truncated/elided sample (e.g. "..."), not parseable -- report
                # so it can be eyeballed, but do not fail the check on it.
                if VERBOSE:
                    print(f"  ?  {actor_dir.name}:{lineno} [{heading}] unparseable JSON")
                continue
            checked += 1
            undeclared = [k for k in keys if k not in declared]
            if VERBOSE:
                print(
                    f"  ok {actor_dir.name}:{lineno} [{heading}] "
                    f"{len(keys)} keys, {len(undeclared)} undeclared"
                )
            for k in undeclared:
                problems += 1
                print(
                    f"DRIFT {actor_dir.name}:{lineno} sample under '{heading}' "
                    f"shows '{k}' -- not a declared field in dataset_schema.json"
                )
    print(f"check-readme-samples: {checked} sample blocks checked, {problems} drift")
    return 1 if problems else 0


if __name__ == "__main__":
    sys.exit(main())
