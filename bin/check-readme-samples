#!/usr/bin/env python3
"""check-readme-samples (added cycle 448, extended cycle 451)

Standing check, two passes over the same READMEs:

1. Every key shown in a README "Sample output" JSON block must be a field the
   Actor actually declares in .actor/dataset_schema.json.
2. The mirror case (cycle 451, h70 follow-up): every field name a README
   *prose* bullet calls out in its bold lead-in -- e.g.
   "- **`titleClean`** -- Google News always appends..." -- must still be a
   real field, input or output. A bullet like this is how READMEs explain a
   field's quirks well after the sample block above it stops being the
   freshest source of truth; if the field gets renamed or dropped in code and
   only the sample block is caught (or nothing is), this sentence keeps
   describing a field that no longer exists.

Nothing else in the check suite looks at README prose: check-code-fields diffs
code -> dataset_schema, check-registry-fields diffs registry -> schema,
check-meta-fields diffs field-count claims in meta.json/actor.json.

Exit 1 = a sample key or a prose-bullet field name is not declared anywhere.
--verbose lists every block/bullet checked.

Nested keys inside object/array values are NOT checked (dataset_schema only
declares top-level fields) -- pass 2 truncates a bullet's `documents[].isAvailable`
style reference down to its top-level `documents` for the same reason. Keys
starting with "_" (watch-mode change bookkeeping like _watchChangeType) are
checked too -- they are real pushed fields and belong in the schema. Pass 2
checks against input fields too (input_schema.json), since a bolded bullet
just as often documents an input option (e.g. `watchLabel`) as an output field.
"""
import json
import re
import sys
from pathlib import Path

ACTORS = Path("/root/agent/actors")
VERBOSE = "--verbose" in sys.argv

# Bare JSON literals, never field names -- a bold lead-in legitimately mixes
# a real field's backtick with an unrelated backtick literal, e.g.
# "`courtJurisdiction` ... and is `null` for the rest" (court-records-scraper
# README:144, found cycle 541). Skip these outright rather than flagging them.
JSON_LITERALS = {"null", "true", "false"}

# Per-slug allowlist (same pattern as check-code-fields' FIELD_SUPPRESS) for
# prose bullets that name a field *because it no longer exists* -- e.g.
# "`posture` was removed from the schema" -- rather than because the README
# is stale. Keyed by slug -> the removed field names its README legitimately
# still mentions.
PROSE_SUPPRESS = {
    # court-records-scraper README:141 explains `posture` was dropped
    # (0% fill, no keyless source) -- the mention is the documentation of
    # the removal, not a stale leftover. Found/confirmed cycle 541 (h160).
    "court-records-scraper": {"posture"},
}

# Headings whose json blocks are output rows. A block under a heading matching
# SKIP_RE is something else (input example, webhook payload) and is not checked.
OUTPUT_RE = re.compile(r"output|sample row|result row", re.I)
SKIP_RE = re.compile(r"webhook|input|payload|request|schedule", re.I)

FENCE_RE = re.compile(r"^```(\w*)\s*$")
HEADING_RE = re.compile(r"^#{1,6}\s+(.*)$")


def top_level_keys(text):
    """Top-level keys of a JSON object/array-of-objects block, or None."""
    try:
        doc = json.loads(text)
    except Exception:
        return None
    if isinstance(doc, list):
        keys = []
        for item in doc:
            if isinstance(item, dict):
                keys.extend(item.keys())
        return keys or None
    if isinstance(doc, dict):
        return list(doc.keys())
    return None


def blocks(readme):
    """Yield (heading, lineno, body) for each ```json fence in the README."""
    heading = ""
    lines = readme.read_text().splitlines()
    i = 0
    while i < len(lines):
        h = HEADING_RE.match(lines[i])
        if h:
            heading = h.group(1).strip()
            i += 1
            continue
        f = FENCE_RE.match(lines[i])
        if f:
            lang = f.group(1)
            start = i + 1
            j = start
            while j < len(lines) and not lines[j].startswith("```"):
                j += 1
            if lang == "json":
                yield heading, start + 1, "\n".join(lines[start:j])
            i = j + 1
            continue
        i += 1


# A bullet's bold lead-in, e.g. "- **`titleClean`** -- ..." or
# "- **`postedFrom`/`postedTo` for a fixed calendar window** -- ...".
BULLET_RE = re.compile(r"^\s*-\s+\*\*(.+?)\*\*")
BACKTICK_RE = re.compile(r"`([^`]+)`")
# A backtick span's leading identifier: "documents[].isAvailable" -> "documents",
# 'recordType: "both"' -> "recordType", "titleClean" -> "titleClean".
IDENT_RE = re.compile(r"^[A-Za-z_$][A-Za-z0-9_$]*")


def prose_field_mentions(readme):
    """Yield (lineno, field_name) for each backtick identifier in a bullet's bold lead-in."""
    for lineno, line in enumerate(readme.read_text().splitlines(), start=1):
        b = BULLET_RE.match(line)
        if not b:
            continue
        for bt in BACKTICK_RE.finditer(b.group(1)):
            m = IDENT_RE.match(bt.group(1))
            if m and m.group(0) not in JSON_LITERALS:
                yield lineno, m.group(0)


def main():
    problems = 0
    checked_bullets = 0
    checked_blocks = 0
    for actor_dir in sorted(ACTORS.iterdir()):
        if not actor_dir.is_dir() or actor_dir.name.startswith("_"):
            continue
        readme = actor_dir / "README.md"
        schema = actor_dir / ".actor" / "dataset_schema.json"
        input_schema = actor_dir / ".actor" / "input_schema.json"
        if not readme.exists() or not schema.exists():
            print(f"SKIP {actor_dir.name}: missing README or dataset_schema.json")
            continue
        declared = set(
            json.loads(schema.read_text()).get("fields", {}).get("properties", {})
        )
        known = set(declared)
        if input_schema.exists():
            known |= set(
                json.loads(input_schema.read_text()).get("properties", {})
            )
        suppressed_names = PROSE_SUPPRESS.get(actor_dir.name, set())
        for lineno, name in prose_field_mentions(readme):
            checked_bullets += 1
            ok = name in known or name in suppressed_names
            if VERBOSE:
                print(f"  {'ok' if ok else '? '} {actor_dir.name}:{lineno} prose bullet names '{name}'")
            if not ok:
                problems += 1
                print(
                    f"DRIFT {actor_dir.name}:{lineno} prose bullet names '{name}' -- "
                    f"not a declared input or output field"
                )
        for heading, lineno, body in blocks(readme):
            if not OUTPUT_RE.search(heading) or SKIP_RE.search(heading):
                continue
            keys = top_level_keys(body)
            if keys is None:
                # Truncated/elided sample (e.g. "..."), not parseable -- report
                # so it can be eyeballed, but do not fail the check on it.
                if VERBOSE:
                    print(f"  ?  {actor_dir.name}:{lineno} [{heading}] unparseable JSON")
                continue
            checked_blocks += 1
            undeclared = [k for k in keys if k not in declared]
            if VERBOSE:
                print(
                    f"  ok {actor_dir.name}:{lineno} [{heading}] "
                    f"{len(keys)} keys, {len(undeclared)} undeclared"
                )
            for k in undeclared:
                problems += 1
                print(
                    f"DRIFT {actor_dir.name}:{lineno} sample under '{heading}' "
                    f"shows '{k}' -- not a declared field in dataset_schema.json"
                )
    print(
        f"check-readme-samples: {checked_blocks} sample blocks, "
        f"{checked_bullets} prose bullets checked, {problems} drift"
    )
    return 1 if problems else 0


if __name__ == "__main__":
    sys.exit(main())
