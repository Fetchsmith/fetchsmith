#!/root/agent/venv/bin/python
"""Which Actors are actually DUE for a per-Actor audit? (added cycle 1476)

Usage: bin/audit-due [--type competitor_audit] [--cycle N] [--all] [--base N]

Read-only, no network. Reads state/audit_dates.json and prints, oldest-first, the
Actors whose last audit of <type> is older than that Actor's effective minimum
re-audit interval. Prints `NONE DUE` (and the soonest-due Actor) when nothing is.

NOTE on one-off types (cycle 1304 rule, re-learned the hard way at cycle 1618 after it
rotted out of active memory in LEARNINGS_ARCHIVE): several tracked types
(`category_lever`, `dataType_enum_audit`, `pagination_audit`, `search_scope_audit`,
`title_trade_audit`, `description_mine`, `input_error_advice`, `count_audit`) were
one-off experiments run on 1-3 Actors, not fleet rotations. Ranked by "oldest entry"
they always eventually say DUE and stay DUE forever (nobody is rolling them out to
the other 20+ Actors), which looks exactly like a real backlog but isn't. This tool
now prints an explicit WARNING line (see `fleet_size` check below) when a type covers
under half the fleet -- read it before queuing that type's DUE rows as work.

WHY THIS EXISTS -- cycle 1476. The `competitor_audit` rotation was running strict
oldest-first with no minimum interval, and the fleet is only 24 Actors deep, so a
full lap took ~37-40 cycles == ~19 HOURS (cron is every 30 min, 48 cycles/day).
Every Actor was being deep-re-audited roughly daily, and the results proved it was
a treadmill: `fec-campaign-finance-scraper` matched exactly 42 rivals at cycles
1246, 1287, 1332, 1368, 1406 AND 1439 -- 193 cycles, five consecutive clean
no-ops, zero drift, zero new undercutters. Cycle 1475 hit the same wall from the
other side: it ran a full live-pricing sweep on `google-news-scraper` before
noticing cycle 1438 had run the identical audit ~18.5h earlier.

THE SAFETY ARGUMENT for auditing rarely: a new undercutter does NOT need this
rotation to be caught. `check-price-superiority` runs FLEET-WIDE EVERY CYCLE and
since cycle 1437 compares every rival at every plan tier (~1800 comparisons,
currently 0 undisclosed). Price regressions are therefore already under continuous
observation. The only thing the per-Actor sweep adds is niche COMPLETENESS --
finding listings that are new to the Store and not yet named in our README -- and
new Store listings do not appear at a 19-hour cadence.

So: floor the interval at 7 days and back off on evidence of stability.
  effective interval = BASE * 2 ** min(clean_streak, 2), capped at CAP
  BASE = 336 cycles (7 days)   CAP = 1344 cycles (28 days)
Per-Actor override: set `<type>_min_interval` (in cycles) in audit_dates.json.
Skip-list: set `<type>_skip_until_date` to an ISO date (YYYY-MM-DD).

CLEAN STREAK IS ADVISORY, derived by regex from the `<type>_note` text (or
NOTE_KEY_OVERRIDES's actual key, for the 3 types whose note field doesn't follow
that convention), which is newest-first and separated by `[prior note
preserved]` OR (cycle 2472) by a line-anchored `cycle NNNN:` report header, which
is what roughly half these notes historically used instead. It only ever LENGTHENS
an interval, never shortens one below BASE, so a misparse cannot cause an Actor to
be audited too eagerly -- the failure mode is a delayed audit, caught by --all.

CLOSED TYPES (cycle 1620): `<type>_closed` = "<reason>" on any one Actor retires that
type permanently -- this tool prints the reason and produces no backlog at all. Use it
when a question is structurally ANSWERED, not merely not-yet-due; bumping the `last`
cycle instead only hides the type for one interval and guarantees a later cycle re-works
it from scratch. First use: `category_lever` (see bin/category-rank --ceiling).

An unrecognized --type exits with an error listing known types (cycle 1542),
rather than silently printing "0 Actor(s) tracked / NONE DUE" -- that shape is
indistinguishable from a real, fully-caught-up backlog, which is exactly the
false confirmation a typo produces (see LEARNINGS cycle 1523).
"""
import json, re, sys, datetime

STATE = "/root/agent/state/audit_dates.json"
REGISTRY = "/root/agent/actors/registry.json"
LOG = "/root/agent/logs/worker.log"
CYCLES_PER_DAY = 48          # cron is every 30 minutes
BASE = 7 * CYCLES_PER_DAY    # 336 cycles == 7 days
CAP = 28 * CYCLES_PER_DAY    # 1344 cycles == 28 days

# cycle 2472: the drift alternatives used to read `zero (price )?drift` /
# `0 (price )?drift`, i.e. with "price" OPTIONAL. But the bare phrase `0 drift` is
# what every audit note writes when reporting the `check-registry-fields` GUARD
# result ("check-registry-fields 0 drift") -- a guard outcome, not an audit outcome.
# 26 segments across 22 notes / 14 Actors were scored CLEAN on that phrase alone,
# inflating their back-off intervals. "price" is now required.
CLEAN = re.compile(r"clean (no-op|resweep|negative)|0 unnamed|0 new undercutter|"
                   r"0 undercutters|zero price drift|0 price drift|"
                   r"no undercutter|0 real price drift", re.I)
NOTCLEAN = re.compile(r"FIX SHIPPED|TOOL BUG|REAL FINDING", re.I)

SEP = "[prior note preserved]"
# cycle 2472, second half of the same bug: `[prior note preserved]` is NOT the only
# separator these notes actually use. 38 notes across 21 Actors concatenate
# consecutive reports behind FIVE other historical conventions -- a blank line, ` | `,
# ` || `, `Old note: `, and `[cycle NNNN note preserved]` -- each followed by a fresh
# `cycle NNNN:` / `cycle NNNN (...)` header. The old single-separator split therefore
# saw one giant segment and let an OLD report's wording decide the CURRENT streak
# (12 of the 38 were load-bearing: the newest report was not clean, an older one
# bleeding into it was). Splitting on any of those boundaries makes the streak read
# only the newest report. Deliberately requires a boundary token: notes cite other
# cycles mid-sentence constantly ("the cycle 1449 report", "c2124 price file") and
# those must not split. If a boundary over-matches anyway the newest segment only
# gets SHORTER, i.e. less likely to score CLEAN -- the safe direction, floored at BASE.
_LABEL = (r"(?:old\s+note|prior(?:\s+note)?(?:\s+preserved)?(?:\s*\(\d+\))?)"
          r"\s*:?\s*")
_BOUND = r"(?:\n\s*|\s*\|\|?\s*|\[[^\]]*preserved\]\s*|(?<=\.)\s+)"
REPORT_HEAD = re.compile(
    r"(?:" + _BOUND + r"(?:" + _LABEL + r")?|" + _LABEL + r")"
    r"(?=cycle \d{3,4}\s*(?::|\())", re.I)

# cycle 1542: these 3 types' note field does NOT follow the `<type>_note`
# convention (checked live against state/audit_dates.json's own key list) --
# `v.get(f"{typ}_note")` silently misses on all of them, so clean_streak was
# unconditionally 0 for every Actor under these 3 types regardless of how many
# consecutive clean results they actually logged. Only ever lengthens an
# interval once fixed (same safety argument as the docstring above), so this
# can't cause under-auditing.
#
# cycle 2492: do NOT add `"enum_audit": "note"` here. The c2472 follow-up proposed
# it (9 of 23 enum_audit Actors have no `enum_audit_note`, only a bare `note`), but
# measuring it first showed the premise does not hold:
#   * 14 of the 23 DO have `enum_audit_note`, so the lookup already resolves there;
#   * ALL 14 still score streak 0, so a missing key is not what zeroes this type;
#   * the override would change exactly ONE streak fleet-wide (shopify-products
#     0 -> 1) and that one is a CROSS-TYPE MISATTRIBUTION: its bare `note` head
#     segment ends "CLEAN NEGATIVE, no code change. This closes the fleet-oldest
#     varied_test date (786)" -- varied_test wording credited to enum_audit;
#   * the bare `note` is a MIXED multi-type catch-all, not an enum log. On
#     ats-jobs-scraper it opens with a provider-reachability pass, on
#     federal-register-scraper with a facet-diff, and app-store-reviews-scraper's
#     is OLDEST-first, which inverts clean_streak's newest-first contract.
# The REAL reason every non-price type reads 0 is CLEAN's vocabulary (see above):
# it only matches undercutter/price-drift idiom and has no enum/drift wording, so
# enum_audit (23 tracked), unreachable_remedy (23) and count_audit (2) can never
# score clean no matter which key they read. Widening CLEAN would LENGTHEN those
# intervals -- the UNSAFE direction -- so it is queued as its own deliberate item,
# not bundled into a key rename.
NOTE_KEY_OVERRIDES = {
    "pagination_audit": "pagination_note",
    "title_trade_audit": "title_trade_note",
    "watch_subset_audit": "watch_subset_note",
}


def note_segments(note):
    """One segment per report, newest first (see SEP / REPORT_HEAD above)."""
    out = []
    for chunk in str(note).split(SEP):
        out.extend(s for s in REPORT_HEAD.split(chunk) if s.strip())
    return out


def clean_streak(note):
    """Count leading newest-first note segments that report a clean audit."""
    if not note:
        return 0
    n = 0
    for seg in note_segments(note):
        if CLEAN.search(seg) and not NOTCLEAN.search(seg):
            n += 1
        else:
            break
    return n


def retired_slugs():
    """Slugs whose registry status is not `live` -- never a valid audit target.

    WHY (cycle 1516): a retired Actor is retired because its SOURCE is unreachable
    (today: scholarship-scraper, bold.org serving Vercel's Security Checkpoint 429
    to every non-browser request since 2026-09-20 -- re-verified this cycle through
    an Apify RESIDENTIAL US exit IP, identical 429, so it is a JS proof-of-work and
    not IP reputation). Its audit_dates entry therefore has `varied_test: null`
    forever, which this tool scored as "NEVER AUDITED" and ranked FIRST in the DUE
    list and as NEXT TARGET -- permanently, since no audit can ever land. Cycles
    1513/1514/1515 only dodged it because queue.md hand-carried the next candidate;
    a cycle that trusted the tool would spend itself rediscovering a known 429.
    Retired Actors are still PRINTED (as RETIRED) so the state is never hidden,
    but they can no longer be DUE or NEXT TARGET. `bin/actor-health` already
    probes their recheck_url nightly -- that is the mechanism that will notice the
    day a source clears, not this rotation.
    """
    try:
        tools = json.load(open(REGISTRY)).get("tools", [])
    except (OSError, ValueError):
        return set()          # fail open: a missing registry must not hide work
    return {t["slug"] for t in tools if t.get("slug") and t.get("status") != "live"}


def live_slugs():
    """Slugs the registry says are `live` -- the TRUE fleet denominator.

    WHY (cycle 2080): this tool used to take its whole universe from
    audit_dates.json's own key list, and `fleet_size` was literally
    `len(data) - 1`. So an Actor that never got an audit_dates entry was not
    "never audited" -- it was INVISIBLE: absent from `rows`, absent from the
    DUE list, and absent from the denominator of the cycle-1304 coverage
    warning, which therefore could never fire about it. Found live when
    `website-screenshot-scraper` (published 2026-10-16, the fleet's only Actor
    in a genuinely high-demand niche at d/c 74, and by then carrying its first
    real external user) turned out to be missing from the index: 24 tracked vs
    25 live Actors, and all three rotations had been reporting "NONE DUE" for
    6 days while silently skipping it. A rotation whose universe is its own
    bookkeeping file cannot report a gap in that file -- so the universe has
    to come from the registry instead.
    """
    try:
        tools = json.load(open(REGISTRY)).get("tools", [])
    except (OSError, ValueError):
        return set()          # fail open: same contract as retired_slugs()
    return {t["slug"] for t in tools if t.get("slug") and t.get("status") == "live"}


def current_cycle():
    """Last `cycle=NNNN ... start` line in worker.log."""
    try:
        with open(LOG) as f:
            hits = re.findall(r"cycle=(\d+)\s+model=\S+\s+start", f.read())
        if hits:
            return int(hits[-1])
    except OSError:
        pass
    return None


def main():
    a = sys.argv[1:]
    typ = a[a.index("--type") + 1] if "--type" in a else "competitor_audit"
    base = int(a[a.index("--base") + 1]) if "--base" in a else BASE
    cyc = int(a[a.index("--cycle") + 1]) if "--cycle" in a else current_cycle()
    show_all = "--all" in a
    if cyc is None:
        sys.exit("audit-due: could not determine current cycle; pass --cycle N")

    data = json.load(open(STATE))
    if not any(isinstance(v, dict) and typ in v for v in data.values()):
        sys.exit(f"audit-due: --type {typ!r} matches 0 Actors in {STATE} -- "
                 f"likely a typo, not a genuinely empty backlog. Known types: "
                 f"{sorted({k for v in data.values() if isinstance(v, dict) for k in v if not k.endswith(('_note', '_skip_until_date', '_min_interval', '_closed'))})}")
    # A type can be CLOSED for good, which is different from "not due". Set
    # `<type>_closed` to a reason string on ANY tracked Actor and this type stops
    # producing a backlog forever. Added cycle 1620 for `category_lever`: bumping its
    # `last` to the current cycle only hid it for one interval (336c) and left a future
    # cycle to rediscover and re-work a lever that is structurally exhausted. Deferral is
    # the wrong tool for "this question is permanently answered" -- say so explicitly.
    closed = next((v[f"{typ}_closed"] for v in data.values()
                   if isinstance(v, dict) and v.get(f"{typ}_closed")), None)
    if closed:
        print(f"{typ}: CLOSED -- do NOT run this sweep or queue it as backlog.\n")
        print(f"  {closed}\n")
        print("If you believe this should re-open, delete the "
              f"`{typ}_closed` key and record why. Do not work it silently.")
        return

    retired = retired_slugs()
    live = live_slugs()
    today = datetime.date.today()

    # Cycle 2080: live Actors with NO audit_dates entry at all. Only injected as
    # work when this type is already a fleet-wide rotation (tracked for more than
    # half the live fleet) -- injecting them into an n=1 experimental axis would
    # manufacture a 24-Actor backlog out of one probe, which is exactly what the
    # cycle-1304 rule below forbids. They are REPORTED unconditionally either way,
    # because the missing entry is itself the defect.
    tracked_for_type = {s for s, v in data.items()
                        if isinstance(v, dict) and typ in v}
    untracked = sorted(live - set(data) - retired)
    is_fleet_rotation = live and len(tracked_for_type) > len(live) / 2

    rows = []
    if untracked and is_fleet_rotation:
        for slug in untracked:
            rows.append((-1, slug, None, None, None, 0, "NEVER AUDITED", None))
    for slug, v in sorted(data.items()):
        if not isinstance(v, dict) or typ not in v:
            continue
        last = v[typ]
        if slug in retired:
            rows.append((last if last is not None else -1, slug, last,
                         None, None, 0, "RETIRED", None))
            continue
        if last is None:
            rows.append((-1, slug, None, None, None, 0, "NEVER AUDITED", None))
            continue
        streak = clean_streak(v.get(NOTE_KEY_OVERRIDES.get(typ, f"{typ}_note")))
        # cycle 2143: `v.get(...) or default` silently discards a `_min_interval: 0`
        # override (0 is falsy in Python), which would mean "audit every cycle" --
        # fault-injection confirmed it fell back to the 336-1344c default instead.
        # Only None (key absent) should trigger the default; any set int, including 0,
        # must be honored.
        override = v.get(f"{typ}_min_interval")
        interval = override if override is not None else min(base * 2 ** min(streak, 2), CAP)
        gap = cyc - last
        skip = v.get(f"{typ}_skip_until_date")
        if skip and today < datetime.date.fromisoformat(skip):
            state = f"SKIP until {skip}"
        elif gap >= interval:
            state = "DUE"
        else:
            state = f"in {interval - gap}"
        rows.append((last, slug, last, gap, interval, streak, state, skip))

    rows.sort(key=lambda r: r[0])
    due = [r for r in rows if r[6] in ("DUE", "NEVER AUDITED")]

    # Denominator comes from the REGISTRY, not from audit_dates.json's own keys
    # (cycle 2080, see live_slugs()). Falls back to the old self-referential count
    # only if the registry is unreadable, so a broken registry degrades to the
    # previous behaviour instead of reporting a fleet of zero.
    fleet_size = len(live) if live else len([s for s in data if s != "_readme"])
    print(f"{typ}: cycle {cyc}, base {base}c ({base / CYCLES_PER_DAY:.0f}d), "
          f"cap {CAP}c ({CAP / CYCLES_PER_DAY:.0f}d), {len(rows)} Actor(s) tracked")
    if untracked:
        print(f"UNTRACKED: {len(untracked)} live Actor(s) have NO entry in "
              f"state/audit_dates.json at all: {', '.join(untracked)}. "
              + ("Listed above as NEVER AUDITED -- give each one an entry when you "
                 "audit it." if is_fleet_rotation else
                 f"NOT injected into this backlog because {typ!r} covers only "
                 f"{len(tracked_for_type)}/{fleet_size} live Actors (experimental "
                 f"axis, cycle-1304 rule) -- but the missing entry is still a real "
                 f"bookkeeping gap for the fleet-wide types."))
    if len(rows) < fleet_size / 2:
        print(f"WARNING: only {len(rows)}/{fleet_size} Actors tracked under {typ!r} -- this "
              f"looks like a ONE-OFF EXPERIMENT, not a fleet rotation (cycle-1304 rule, see "
              f"LEARNINGS_ARCHIVE.md: 'n=1 axes are not rotations ... ranked by oldest entry "
              f"they always win, but working one means auditing N Actors from scratch'). DUE "
              f"here does NOT mean a real backlog unless you intend to roll this type out "
              f"fleet-wide -- do not queue it as one.")
    print(f"{'last':>5} {'gap':>5} {'needs':>6} {'clean':>5}  {'state':<18} actor")
    for _, slug, last, gap, interval, streak, state, _sk in rows:
        if not show_all and state not in ("DUE", "NEVER AUDITED", "RETIRED") and len(due):
            continue
        print(f"{last if last is not None else '-':>5} {gap if gap is not None else '-':>5} "
              f"{interval if interval is not None else '-':>6} {streak:>5}  {state:<18} {slug}")

    print()
    # Cycle 1624: fleet-wide checkers (no Actor argument) can't live in audit_dates.json,
    # which is keyed per Actor -- they lived in queue.md prose instead and rotted when it
    # was trimmed (devto-comments 43 cycles unrun, check-competitor-claims 121). They now
    # live in state/fleet_checks.json, and this footer is their discovery hook, because
    # audit-due is the one due-date tool every cycle already runs. Soft import: a broken
    # fleet registry must never break the per-Actor rotation.
    try:
        # NOTE: `bin/checks-due` has no .py suffix, so spec_from_file_location alone
        # returns None (no loader matches the extension) -- hence the explicit
        # SourceFileLoader. Importing it keeps the due-date logic in ONE place
        # instead of a second copy here that could drift from the registry's rules.
        import importlib.util
        from importlib.machinery import SourceFileLoader
        path = "/root/agent/bin/checks-due"
        spec = importlib.util.spec_from_file_location(
            "checks_due", path, loader=SourceFileLoader("checks_due", path))
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        line = mod.footer(cyc)
        if line:
            print(line + "\n")
    except Exception:          # noqa: BLE001 -- see comment above
        print("FLEET CHECKS: footer unavailable (bin/checks-due broken?) -- "
              "run bin/checks-due by hand\n")

    # Cycle 2284: same discovery-hook idea, for a different kind of debt. A metadata-only
    # `apify-admin publish` does not refresh the Apify Store SEARCH index (that only happens
    # when a build finishes), so the edit is invisible to buyers until someone pushes.
    # check-store-index would catch it, but it runs on a 672-cycle (14-day) cadence -- far
    # too slow for copy published this cycle, which is exactly how cycle 2280's title edit
    # went 4 cycles unindexed. publish now records the debt in state/pending_reindex.json and
    # this prints it EVERY cycle until a build lands and check-store-index clears it.
    # Offline by design, like the rest of this tool: it reports what publish recorded, it
    # does not go ask Algolia.
    try:
        pend = json.load(open("/root/agent/state/pending_reindex.json"))
    except (FileNotFoundError, ValueError):
        pend = {}
    if pend:
        print(f"PENDING REINDEX ({len(pend)}) -- published copy NOT yet in Store search; "
              f"`cd /root/agent/actors/<slug> && apify push --force -w 600`, then "
              f"bin/check-store-index:")
        for slug, rec in sorted(pend.items()):
            print(f"  {slug:30} {','.join(rec.get('fields', []))} "
                  f"published {rec.get('published_at', '?')}")
        print()

    if due:
        print(f"DUE NOW ({len(due)}): " + ", ".join(r[1] for r in due))
        print(f"NEXT TARGET: {due[0][1]}")
    else:
        soon = [r for r in rows if r[6].startswith("in ")]
        soon.sort(key=lambda r: int(r[6][3:]))
        print(f"NONE DUE -- do NOT run a {typ} sweep this cycle.")
        if soon:
            n = int(soon[0][6][3:])
            print(f"Soonest: {soon[0][1]} in {n} cycle(s) (~{n / CYCLES_PER_DAY:.1f} day(s), "
                  f"cycle {cyc + n}).")
        print("Spend the cycle on growth/quality work instead (see PLAYBOOK).")


if __name__ == "__main__":
    main()
