#!/root/agent/venv/bin/python
"""Flag Actor READMEs whose spelled-out source/board/platform/endpoint count has
drifted from the actual list in the Actor's own code.

Same bug class as check-blog-claims and check-competitor-claims, one step further
in: a count describing OUR OWN Actor's data-source coverage, hand-typed in prose,
whose real owner is a constant in src/main.js. Proposed at cycle 1504 after
remote-jobs-scraper was found saying "six" boards for 185 cycles after a seventh
board (WWR) was added — invisible to every existing check because none of them
read source-list constants.

Cycle 1505 scoped this deliberately narrow: there is NO existing registry field for
"source count" the way registry.json's output_fields covers field counts, and
hand-maintaining a parallel source-count list here would recreate the exact
staleness bug this tool exists to catch. So SOURCES below only lists Actors where
the ground truth already lives in a structured, greppable JS constant (an array of
boards/platforms/endpoints) -- found by grepping every Actor's src/*.js for
`^(const|let|var) SOME_CAPS_NAME = [` ANDed with a source/board/platform/ATS/
endpoint/site keyword in the name. Do not add an Actor here without that constant;
if a future niche needs this and has no such constant, add the constant to the
Actor's own code first (it's useful for the Actor itself, not just this check).

Each entry gives one or more (constant name, number-word regex) pairs -- the regex
matches the way the count is actually phrased in that Actor's own README.

Cycle 2584 fixed two holes that between them made this check unable to catch the
very bug it was written for:

(1) OFF-BY-ONE BLINDNESS. The comparison used to accept `claimed == truth - 1` as
    well as `claimed == truth`, to tolerate "N non-X" phrasing (the comment here
    cited ats-jobs-scraper's "6 non-Workday platforms" against a 7-item list).
    That rationale was already stale -- ats-jobs-scraper now has a separate
    AUTO_DETECT_ATS constant that EXCLUDES Workday, so its non-Workday phrase is
    an exact match against its own list, offset 0. Meanwhile the blanket -1
    tolerance silently permitted exactly the drift this tool exists to catch:
    remote-jobs-scraper's motivating bug was "six" boards against a 7-item
    ALL_SOURCES, i.e. truth - 1, which the old code would NOT have flagged.
    Patterns now carry an explicit per-pattern offset (default 0) and the expected
    count is `truth + offset`, compared exactly. Use an offset only when the prose
    legitimately describes a subset/superset of the constant, and say why.

(2) SILENT COVERAGE LOSS. A pattern that stops matching (README reworded, section
    deleted) used to just quietly stop contributing to the checked count -- the
    check still exited 0 while covering less. Every pattern below is expected to
    match at least once; a pattern with 0 matches is now reported as STALE PATTERN
    and fails the check, so the coverage has to be repaired (or the pattern
    deliberately retired) rather than decaying unnoticed.
"""
import os
import re
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))

WORDS = {
    "one": 1, "two": 2, "three": 3, "four": 4, "five": 5, "six": 6,
    "seven": 7, "eight": 8, "nine": 9, "ten": 10,
}


def num(token):
    token = token.lower()
    return WORDS.get(token, int(token) if token.isdigit() else None)


def const_len(path, const_name):
    """Count top-level elements in `const NAME = [...]` or `= {...}` in a JS file."""
    src = open(path).read()
    m = re.search(r"\b(?:const|let|var)\s+" + re.escape(const_name) + r"\s*=\s*([\[{])", src)
    if not m:
        return None
    open_ch = m.group(1)
    close_ch = "]" if open_ch == "[" else "}"
    start = m.end() - 1
    depth = 0
    end = None
    for i in range(start, len(src)):
        if src[i] == open_ch:
            depth += 1
        elif src[i] == close_ch:
            depth -= 1
            if depth == 0:
                end = i
                break
    if end is None:
        return None
    body = src[start + 1:end]
    # strip string literals first so commas/colons inside URLs etc. (e.g. "https://...")
    # don't get miscounted as structural
    stripped = re.sub(r"'[^']*'|\"[^\"]*\"|`[^`]*`", "''", body)
    if open_ch == "[":
        items = [x for x in re.split(r",", stripped) if x.strip()]
        return len(items)
    # object literal: count top-level `key:` occurrences (depth-0 colons)
    depth2 = 0
    keys = 0
    i = 0
    while i < len(stripped):
        c = stripped[i]
        if c in "[{(":
            depth2 += 1
        elif c in "]})":
            depth2 -= 1
        elif c == ":" and depth2 == 0:
            keys += 1
        i += 1
    return keys


# slug -> (js_file_relative_to_actor_dir, const_name, [README patterns])
# Each README regex must have exactly one capture group: the number/word claiming
# the count. A pattern is either a bare regex (expected count == len(constant)) or
# a (regex, offset) pair where the prose legitimately describes a subset/superset
# of the constant -- expected count == len(constant) + offset. Every pattern must
# match its README at least once or the check reports STALE PATTERN and fails.
SOURCES = {
    "remote-jobs-scraper": [
        ("src/main.js", "ALL_SOURCES", [
            r"\b(\w+)\s+public remote-job boards\b",
            r"\bfrom\s+(\w+)\s+documented, public, no-login job-board\b",
        ]),
        ("src/main.js", "PAGINATED_SOURCES", [
            # feed-reach warning section: "on the two paginated boards ..." (c2584)
            r"\bthe\s+(\w+)\s+paginated boards\b",
        ]),
    ],
    "ats-jobs-scraper": [
        ("src/main.js", "SUPPORTED_ATS", [
            r"\bacross\s+(\w+)\s+different ATSes\b",
            # prose was reworded "into N" -> "maintaining N" at some point before
            # c2584; the old pattern had gone dead silently (first catch of the
            # new STALE PATTERN rule). Kept loose on the leading verb for that reason.
            r"\b(\w+)\s+separate scrapers\b",
        ]),
        ("src/main.js", "AUTO_DETECT_ATS", [
            # AUTO_DETECT_ATS already excludes Workday, so offset 0, not -1 (c2584)
            r"\ball\s+(\w+)\s+non-Workday platforms\b",
        ]),
    ],
    "fda-recall-scraper": [
        ("src/main.js", "ENDPOINTS", [
            r"\ball\s+(\w+)\s+endpoints\b",
            r"\ball\s+(\w+)\s+enforcement endpoints\b",
        ]),
    ],
}

flagged = 0
checked = 0
stale = 0
for slug, entries in SOURCES.items():
    actor_dir = os.path.join(ROOT, "actors", slug)
    readme_path = os.path.join(actor_dir, "README.md")
    if not os.path.isfile(readme_path):
        print(f"MISSING README: {slug}")
        continue
    readme = open(readme_path).read()
    for js_rel, const_name, patterns in entries:
        js_path = os.path.join(actor_dir, js_rel)
        if not os.path.isfile(js_path):
            print(f"MISSING JS: {slug}/{js_rel}")
            continue
        truth = const_len(js_path, const_name)
        if truth is None:
            print(f"COULD NOT PARSE: {slug}/{js_rel} const {const_name}")
            continue
        for pat in patterns:
            regex, offset = (pat, 0) if isinstance(pat, str) else pat
            expected = truth + offset
            matches = 0
            for m in re.finditer(regex, readme):
                matches += 1
                checked += 1
                claimed = num(m.group(1)) if m.groups() else None
                if claimed is None:
                    continue  # pattern matched but captured non-numeric text (fixed phrasing, not a count)
                if claimed != expected:
                    flagged += 1
                    lineno = readme.count("\n", 0, m.start()) + 1
                    via = f"{const_name} has {truth} entries"
                    if offset:
                        via += f", pattern offset {offset:+d} -> expected {expected}"
                    print(f"{slug}: README.md:{lineno} claims {claimed!r} but {via}")
                    print(f"  context: {m.group(0)!r}")
            if matches == 0:
                stale += 1
                print(f"STALE PATTERN: {slug} README.md no longer matches {regex!r} "
                      f"(was covering {const_name}) -- repair the prose or retire the pattern")

print(f"\nchecked {checked} count phrase(s) across {len(SOURCES)} Actor(s) with structured "
      f"source lists, {flagged} flagged, {stale} stale pattern(s)")
sys.exit(1 if (flagged or stale) else 0)
