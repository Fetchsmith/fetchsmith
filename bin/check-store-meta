#!/usr/bin/env python3
"""check-store-meta — detect drift between local .actor/actor.json and the live
Apify Store metadata (title, description).

WHY (cycle 200): `apify push` does NOT update an existing Actor's Store title or
description. Those fields are set once at creation and thereafter only via the
console or `PUT /v2/acts/<id>`. So editing `.actor/actor.json` and pushing looks
like it worked and silently changes nothing. Found this with 18/18 Actors drifting
on `description` and 7 on `title` — including two Actors (hacker-news, apple-podcasts)
whose *better* local titles had been sitting unshipped for many cycles.

Same failure class as `bin/check-registry-fields` (2b/2d): a file nothing enforced.

Store limits (measured, enforced server-side, 400 on violation):
  title <= 63 chars.  description has no observed hard cap (219 accepted).

Usage:
  bin/check-store-meta          # report drift, exit 1 if any
  bin/check-store-meta --pull   # overwrite local actor.json from live (live wins)
Deliberate local->live changes must be PUT explicitly; this tool never pushes.
"""
import json
import os
import sys
import urllib.request

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
TITLE_MAX = 63


def token():
    for line in open(os.path.join(ROOT, "secrets/env")):
        if line.startswith("APIFY_TOKEN="):
            return line.split("=", 1)[1].strip().strip('"')
    sys.exit("APIFY_TOKEN not found in secrets/env")


def live(slug, tok):
    req = urllib.request.Request(
        f"https://api.apify.com/v2/acts/fetchsmith~{slug}",
        headers={"Authorization": f"Bearer {tok}"},
    )
    return json.load(urllib.request.urlopen(req, timeout=30))["data"]


def main():
    pull = "--pull" in sys.argv[1:]
    tok = token()
    tools = json.load(open(os.path.join(ROOT, "actors/registry.json")))["tools"]
    drift = 0
    for t in tools:
        slug = t["slug"]
        path = os.path.join(ROOT, "actors", slug, ".actor/actor.json")
        if not os.path.exists(path):
            print(f"{slug}: no .actor/actor.json")
            continue
        loc = json.load(open(path))
        rem = live(slug, tok)
        fix = {}
        for k in ("title", "description"):
            if (loc.get(k) or "") != (rem.get(k) or ""):
                drift += 1
                fix[k] = rem.get(k)
                print(f"{slug}: {k} DRIFT\n  local: {loc.get(k)}\n  live : {rem.get(k)}")
        if len(rem.get("title") or "") > TITLE_MAX:
            drift += 1
            print(f"{slug}: live title exceeds {TITLE_MAX} chars ({len(rem['title'])})")
        if fix and pull:
            loc.update(fix)
            with open(path, "w") as fh:
                fh.write(json.dumps(loc, indent=2, ensure_ascii=False) + "\n")
            print(f"  -> pulled live into {path}")
    print(f"check-store-meta: {len(tools)} Actors, {drift} drift(s)")
    return 1 if (drift and not pull) else 0


if __name__ == "__main__":
    sys.exit(main())
