#!/usr/bin/env python3
"""check-store-meta — detect drift between local .actor/actor.json and the live
Apify Store metadata (title, description), AND between actors/registry.json's
`title` (what fetchsmith.com renders) and that same live Store title.

WHY (cycle 200): `apify push` does NOT update an existing Actor's Store title or
description. Those fields are set once at creation and thereafter only via the
console or `PUT /v2/acts/<id>`. So editing `.actor/actor.json` and pushing looks
like it worked and silently changes nothing. Found this with 18/18 Actors drifting
on `description` and 7 on `title` — including two Actors (hacker-news, apple-podcasts)
whose *better* local titles had been sitting unshipped for many cycles.

WHY the registry check was added (cycle 233, after cycle 232 found it by hand):
this script only ever compared `.actor/actor.json` (the local Apify-repo copy)
against live — it never looked at `registry.json`, the file that actually drives
fetchsmith.com's `<title>`, `<h1>`, JSON-LD name, `og:title` and tool cards. Cycle
232 found all 8 of the oldest Actors carrying a bare head-term title in
`registry.json` while the live Store listing (and `.actor/actor.json`) had long
since been sharpened to `Base Name - Differentiator Keywords`. `description` is
deliberately NOT compared here: registry.json's `description` is long-form HTML
body copy for the site, `.actor/actor.json`'s is a short Store one-liner — they
are meant to read differently, so diffing them would just be permanent false-
positive noise, not real drift. `title` is the only field both files intend to
hold identically.

WHY the meta.json check was added (cycle 235, after cycle 234 found by hand that
`ats-jobs-scraper`'s meta.json had carried a sharper title since cycle ~197 that
was simply never published): `apify-admin publish <slug> meta.json` is the ONLY
thing that ships meta.json's title/description/seoTitle/seoDescription live, and
nothing previously checked whether meta.json and live had drifted apart. Unlike
the actor.json/registry.json checks above, this direction is ambiguous — meta.json
being ahead means "publish it"; live being ahead means someone edited the listing
directly and meta.json is the one that's stale — so this check only reports, it
never auto-pulls either way. A human (or the next cycle) decides which side wins.

Same failure class as `bin/check-registry-fields` (2b/2d): a file nothing enforced.

Store limits (measured, enforced server-side, 400 on violation):
  title <= 63 chars.  description has no observed hard cap (219 accepted).

Usage:
  bin/check-store-meta          # report drift, exit 1 if any
  bin/check-store-meta --pull   # overwrite local actor.json AND registry.json title from live (live wins)
Deliberate local->live changes must be PUT explicitly; this tool never pushes.
"""
import json
import os
import sys
import urllib.request

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
TITLE_MAX = 63


def token():
    for line in open(os.path.join(ROOT, "secrets/env")):
        if line.startswith("APIFY_TOKEN="):
            return line.split("=", 1)[1].strip().strip('"')
    sys.exit("APIFY_TOKEN not found in secrets/env")


def live(slug, tok):
    req = urllib.request.Request(
        f"https://api.apify.com/v2/acts/fetchsmith~{slug}",
        headers={"Authorization": f"Bearer {tok}"},
    )
    return json.load(urllib.request.urlopen(req, timeout=30))["data"]


def main():
    pull = "--pull" in sys.argv[1:]
    tok = token()
    registry_path = os.path.join(ROOT, "actors/registry.json")
    registry = json.load(open(registry_path))
    tools = registry["tools"]
    drift = 0
    registry_changed = False
    for t in tools:
        slug = t["slug"]
        path = os.path.join(ROOT, "actors", slug, ".actor/actor.json")
        if not os.path.exists(path):
            print(f"{slug}: no .actor/actor.json")
            continue
        loc = json.load(open(path))
        rem = live(slug, tok)
        fix = {}
        for k in ("title", "description"):
            if (loc.get(k) or "") != (rem.get(k) or ""):
                drift += 1
                fix[k] = rem.get(k)
                print(f"{slug}: {k} DRIFT\n  local: {loc.get(k)}\n  live : {rem.get(k)}")
        if len(rem.get("title") or "") > TITLE_MAX:
            drift += 1
            print(f"{slug}: live title exceeds {TITLE_MAX} chars ({len(rem['title'])})")
        if fix and pull:
            loc.update(fix)
            with open(path, "w") as fh:
                fh.write(json.dumps(loc, indent=2, ensure_ascii=False) + "\n")
            print(f"  -> pulled live into {path}")
        # registry.json's `title` drives fetchsmith.com; compare it against the
        # same live Store title (not against .actor/actor.json's, since those two
        # can themselves differ deliberately, e.g. a shorter Store-only variant).
        if (t.get("title") or "") != (rem.get("title") or ""):
            drift += 1
            print(f"{slug}: registry title DRIFT\n  registry: {t.get('title')}\n  live    : {rem.get('title')}")
            if pull:
                t["title"] = rem.get("title")
                registry_changed = True
                print(f"  -> pulled live into registry.json")
        # meta.json is the file `apify-admin publish` reads FROM; a drift here
        # means either an unpublished local improvement (publish it) or a live
        # edit meta.json doesn't know about (update meta.json to match) — this
        # tool can't tell which, so it only reports, never auto-pulls.
        meta_path = os.path.join(ROOT, "actors", slug, "meta.json")
        if os.path.exists(meta_path):
            meta = json.load(open(meta_path))
            for k in ("title", "description", "seoTitle", "seoDescription"):
                if (meta.get(k) or "") != (rem.get(k) or ""):
                    drift += 1
                    print(f"{slug}: meta.json {k} DRIFT (unpublished local change or stale meta.json)\n  meta.json: {meta.get(k)}\n  live     : {rem.get(k)}")
    if registry_changed:
        with open(registry_path, "w") as fh:
            fh.write(json.dumps(registry, indent=2, ensure_ascii=False) + "\n")
    print(f"check-store-meta: {len(tools)} Actors, {drift} drift(s)")
    return 1 if (drift and not pull) else 0


if __name__ == "__main__":
    sys.exit(main())
