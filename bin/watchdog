#!/usr/bin/env bash
# Every 5 min: keep services alive, retry Resend verification, alert on disk/auth problems.
set -u; A=/root/agent; L=$A/logs; S=$A/state
set -a; . $A/secrets/env; set +a
log(){ printf '%s %s\n' "$(date -Is)" "$*" >>"$L/watchdog.log"; }
for svc in caddy fetchsmith-web fetchsmith-mail; do
  systemctl is-active --quiet $svc || { systemctl restart $svc; log "restarted $svc"; }
done
code=$(curl -s -o /dev/null -w '%{http_code}' -m 15 https://fetchsmith.com/health)
[[ $code == 200 ]] || { systemctl restart fetchsmith-web; log "health=$code restarted web"; }
if [[ ! -f $S/resend_verified ]]; then
  id=$(jq -r .id $S/resend_domain.json)
  st=$(curl -s -H "Authorization: Bearer $RESEND_API_KEY" https://api.resend.com/domains/$id | jq -r .status)
  if [[ $st == verified ]]; then touch $S/resend_verified; log "resend domain verified"; else curl -s -X POST -H "Authorization: Bearer $RESEND_API_KEY" https://api.resend.com/domains/$id/verify >/dev/null; fi
fi
use=$(df --output=pcent / | tail -1 | tr -dc 0-9); (( use > 90 )) && log "DISK ${use}%" && journalctl --vacuum-size=100M >/dev/null 2>&1
# stale worker? (no cycle log line in 3h while not paused)
last=$(grep -E 'cycle=[0-9]+ (start|rc=)' $L/worker.log 2>/dev/null | tail -1 | cut -d' ' -f1)
if [[ -n ${last:-} ]] && [[ ! -f $S/pause_until || $(cat $S/pause_until) -lt $(date +%s) ]]; then
  (( $(date +%s) - $(date -d "$last" +%s) > 10800 )) && log "worker stale since $last" && pkill -f 'claude -p' && rm -f $S/worker.lock
fi
exit 0
