#!/usr/bin/env python3
"""bin/vocab-screen [actor-slug ...] -- live-proof the CLOSED real-world vocabularies that
`bin/enum-screen` is structurally blind to (added cycle 2512).

WHY THIS EXISTS.  `enum-screen` diffs DECLARED input-schema enums and prints
IDENTICAL/CHANGED.  Its own docstring names two limits, and both have already bitten
this backlog:

  1. A free-text `stringList` field whose real-world vocabulary is closed (CourtListener
     court ids, Federal Register agency slugs, NIH institute abbreviations, HN Algolia
     tags) declares no `enum` at all, so enum-screen cannot see it.  The last two real
     defects in the enum_audit backlog came from exactly here (`offices` c1530,
     `orgStates` c1531).
  2. IDENTICAL means the SURFACE is unchanged -- never that the values still WORK.
     Upstream can retire a value silently, after which a buyer who filters on it gets an
     empty dataset and no explanation.

This tool closes limb 2 for the fields where the upstream authority publishes a free,
unauthenticated endpoint we can ask.  Every probe below is free: no Apify Actor run, no
PPE event, no proxy.  It is a VALUE-LIVENESS test, not a schema diff -- run it alongside
enum-screen, not instead of it.

Exit status is 0 when every probe is clean, 1 when any vocabulary value no longer
resolves upstream (i.e. a buyer-facing filter value has gone stale).
"""
import datetime as dt, json, re, subprocess, sys, urllib.request, urllib.error, urllib.parse

R = "/root/agent"
UA = "FetchSmith-vocab-screen/1.0 (+https://fetchsmith.com)"
TIMEOUT = 30


def http(url, data=None):
    """One GET/POST returning parsed JSON.  Retries once on a transient 5xx or a
    transport error -- same lesson as cycle 2510's check-source-endpoints fix: a retry
    scoped to 'transient' must cover BOTH exception-based and HTTP-response-based
    transients, or a 502 silently counts as a real failure."""
    body = json.dumps(data).encode() if data is not None else None
    hdrs = {"User-Agent": UA, "Accept": "application/json"}
    if body:
        hdrs["Content-Type"] = "application/json"
    for attempt in (1, 2):
        try:
            req = urllib.request.Request(url, data=body, headers=hdrs)
            with urllib.request.urlopen(req, timeout=TIMEOUT) as r:
                return json.loads(r.read().decode())
        except urllib.error.HTTPError as e:
            if e.code >= 500 and attempt == 1:
                continue
            raise
        except Exception:
            if attempt == 1:
                continue
            raise


def http_raw(url, data=None):
    """Like http(), but returns (status_code, body_text) instead of parsed JSON and never
    raises on a 4xx -- needed for the eu-ted-tenders-scraper probe, which must read a
    deliberate 400's error body rather than treat it as a transport failure."""
    body = json.dumps(data).encode() if data is not None else None
    hdrs = {"User-Agent": UA, "Accept": "application/json"}
    if body:
        hdrs["Content-Type"] = "application/json"
    for attempt in (1, 2):
        try:
            req = urllib.request.Request(url, data=body, headers=hdrs)
            with urllib.request.urlopen(req, timeout=TIMEOUT) as r:
                return r.status, r.read().decode()
        except urllib.error.HTTPError as e:
            if e.code >= 500 and attempt == 1:
                continue
            return e.code, e.read().decode()
        except Exception:
            if attempt == 1:
                continue
            raise


def schema(slug):
    return json.load(open(f"{R}/actors/{slug}/.actor/input_schema.json"))


def field(slug, name):
    return schema(slug)["properties"][name]


# ---------------------------------------------------------------- probes
# Each probe returns (ok: bool, list[str] of report lines).  A probe asserts the values
# our buyer-facing copy NAMES are still accepted upstream -- it deliberately does not try
# to enumerate every legal value, which for most of these is thousands long.

def p_federal_register_agencies():
    """Authority publishes the full list, so this is an exhaustive set check."""
    out = []
    live = http("https://www.federalregister.gov/api/v1/agencies")
    slugs = {a.get("slug") for a in live if a.get("slug")}
    out.append(f"  authority: /api/v1/agencies -> {len(live)} agencies, {len(slugs)} slugs")

    desc = field("federal-register-scraper", "agencies").get("description", "")
    # Regex, not .split(): the copy reads "473-agency list" (hyphenated, no space), so
    # whitespace tokenising finds no number at all and the drift check silently never
    # fires -- a false CLEAN, the same shape as the c2510 check-source-endpoints bug.
    m = re.search(r"(\d[\d,]*)[\s-]*agenc", desc, re.I)
    claimed = int(m.group(1).replace(",", "")) if m else None
    if claimed is None:
        out.append("  schema states no agency count -- nothing to falsify")
    elif claimed == len(live):
        out.append(f"  schema's stated {claimed}-agency list MATCHES live count")
    else:
        out.append(f"  DRIFT: schema states {claimed} agencies, live is {len(live)}")
        return False, out

    # every slug our own copy names to a buyer must still resolve
    named = list(field("federal-register-scraper", "agencies").get("prefill") or [])
    named += ["homeland-security-department", "environmental-protection-agency"]
    bad = [s for s in dict.fromkeys(named) if s not in slugs]
    out.append(f"  named slugs checked: {len(set(named))}, unresolved: {bad or 'none'}")
    return not bad, out


def p_hacker_news_tags():
    """No list endpoint; Algolia accepts any tag string and silently returns 0 hits for
    one it does not know, which is precisely the failure mode worth testing."""
    out = []
    desc = field("hacker-news-scraper", "tags").get("description", "")
    tags = [t.strip() for t in desc.split(".")[0].split(",") if t.strip()]
    out.append(f"  schema documents {len(tags)} tags: {tags}")
    dead = []
    for t in tags:
        d = http(f"https://hn.algolia.com/api/v1/search?tags={t}&hitsPerPage=1")
        n = d.get("nbHits", 0)
        if not n:
            dead.append(t)
        out.append(f"    {t:12s} nbHits={n}")
    if dead:
        out.append(f"  DEAD TAGS (documented but return nothing): {dead}")
    return not dead, out


def p_nih_agency_ic_codes():
    """Probes the codes most likely to have gone stale rather than all ~50: the two our
    own copy flags as historical (NCRR defunct 2011, ADAMHA pre-1992) plus a spread of
    live institutes and CDC sub-centers.  A 0-result code is NOT automatically a defect
    for the historical ones -- the schema already tells the buyer they are historical --
    so those are reported separately and do not fail the run."""
    out = []
    live_expected = ["NCI", "NIAID", "NHLBI", "NIGMS", "NIMH", "NLM", "NCATS", "FDA", "CDC"]
    historical = ["NCRR", "ADAMHA"]
    dead = []
    totals = {}
    # `criteria.agencies` is the key the Actor itself sends (main.js:627).  Using any other
    # spelling (e.g. agency_ic_admin) is silently IGNORED by RePORTER and every code then
    # returns the same unfiltered corpus total -- a probe whose values cannot diverge proves
    # nothing (the c2500 matchMode trap).  The divergence assert below makes that unfakeable.
    for code in live_expected + historical:
        d = http(
            "https://api.reporter.nih.gov/v2/projects/search",
            {"criteria": {"agencies": [code]}, "limit": 1,
             "offset": 0, "include_fields": ["ProjectNum"]},
        )
        n = (d.get("meta") or {}).get("total", 0)
        totals[code] = n
        tag = "historical" if code in historical else "expected-live"
        out.append(f"    {code:8s} total={n:<10} ({tag})")
        if not n and code in live_expected:
            dead.append(code)
    if len(set(totals.values())) == 1:
        out.append("  PROBE INVALID: every code returned the same total, so the filter was "
                   "ignored rather than applied -- this proves nothing about the vocabulary.")
        return False, out
    if dead:
        out.append(f"  DEAD CODES (documented as live but return nothing): {dead}")
    return not dead, out


def p_usaspending_recipient_types():
    """USAspending publishes no standalone reference list for business-type categories
    (checked: only toptier_agencies/def_codes have a dedicated /references/ endpoint), so
    this probes the real search endpoint directly with each documented value -- same shape
    as the NIH probe above. The values are pulled from the schema's own description text
    (the `e.g. ...` clause), so a future README edit is screened automatically rather than
    against a hardcoded copy that can drift from the live schema."""
    out = []
    desc = field("us-federal-awards-scraper", "recipientTypes").get("description", "")
    m = re.search(r"e\.g\.\s*([a-z_, ]+?)\s*\(", desc)
    values = [v.strip() for v in m.group(1).split(",")] if m else []
    out.append(f"  schema documents: {values}")
    if not values:
        out.append("  PROBE INVALID: could not parse any documented value out of the description")
        return False, out
    # `recipient_type_names` is the key the Actor itself sends (src/main.js:744), against
    # `spending_by_award_count` (src/main.js:29) -- the lightest endpoint that still applies
    # the real filter, so this costs USAspending one small count query per value.
    totals = {}
    for v in values:
        d = http(
            "https://api.usaspending.gov/api/v2/search/spending_by_award_count/",
            {"filters": {"award_type_codes": ["A", "B", "C", "D"],
                         "time_period": [{"start_date": "2024-01-01", "end_date": "2026-10-31"}],
                         "recipient_type_names": [v]}},
        )
        n = sum((d.get("results") or {}).values())
        totals[v] = n
        out.append(f"    {v:28s} total={n}")
    dead = [v for v, n in totals.items() if not n]
    if len(set(totals.values())) == 1:
        out.append("  PROBE INVALID: every value returned the same total, so the filter was "
                   "ignored rather than applied -- this proves nothing about the vocabulary.")
        return False, out
    if dead:
        out.append(f"  DEAD VALUES (documented as live but return nothing): {dead}")
    # Sanity check the README's own claim that a bad value fails open to zero, not an error
    # or the unfiltered total -- confirms "double-check spelling" is honest advice.
    bogus = http(
        "https://api.usaspending.gov/api/v2/search/spending_by_award_count/",
        {"filters": {"award_type_codes": ["A", "B", "C", "D"],
                     "time_period": [{"start_date": "2024-01-01", "end_date": "2026-10-31"}],
                     "recipient_type_names": ["bogus_nonexistent_type_xyz"]}},
    )
    bogus_total = sum((bogus.get("results") or {}).values())
    out.append(f"  misspelled-value sanity check: bogus_nonexistent_type_xyz total={bogus_total} "
               f"({'matches README claim' if bogus_total == 0 else 'CONTRADICTS README claim'})")
    if bogus_total != 0:
        return False, out
    return not dead, out


def p_usaspending_naics_psc_codes():
    """naicsCodes/pscCodes are the other two USAspending `stringList` filters this Actor sends
    server-side (src/main.js:753/758) that, like recipientTypes above, have no dedicated
    reference endpoint on USAspending (only toptier_agencies/def_codes get one) -- so this
    probes the real `spending_by_award_count` endpoint directly, same shape as the
    recipientTypes probe. Two fields in one function (not two PROBES entries) because the
    dict is keyed by slug; `us-federal-awards-scraper` already owns one entry for
    recipientTypes.  Unlike recipientTypes' flat equality list, both fields are PREFIX
    vocabularies (main.js:751/754: a 2/4/6-digit NAICS prefix or a 1-4 char PSC prefix matches
    every leaf code under it), so the real thing worth proving live is that narrowing a prefix
    narrows the count monotonically, not just that each value is independently non-zero."""
    out = []
    award_type_codes = ["A", "B", "C", "D"]  # contracts group (main.js:47) -- only contracts/
    # IDVs carry NAICS/PSC, confirmed by main.js's own comments at 752/757.
    time_period = [{"start_date": "2024-01-01", "end_date": "2026-10-31"}]

    def count(filters):
        d = http(
            "https://api.usaspending.gov/api/v2/search/spending_by_award_count/",
            {"filters": {"award_type_codes": award_type_codes, "time_period": time_period, **filters}},
        )
        return sum((d.get("results") or {}).values())

    ok = True

    # naicsCodes: README's own example is 541511; walk its 2/4/6-digit prefix chain, which
    # main.js documents as all server-accepted and ORed via {require: [...]}.
    naics_desc = field("us-federal-awards-scraper", "naicsCodes").get("description", "")
    m = re.search(r"e\.g\.\s*(\d+)", naics_desc)
    leaf = m.group(1) if m else "541511"
    chain = [leaf[:2], leaf[:4], leaf]
    totals = {c: count({"naics_codes": {"require": [c]}}) for c in dict.fromkeys(chain)}
    out.append(f"  naicsCodes prefix chain (schema example {leaf}): {totals}")
    if len(set(totals.values())) < len(totals):
        out.append("  PROBE INVALID: prefix narrowing did not change the count -- filter may be ignored")
        ok = False
    vals = list(totals.values())
    if not (vals[0] >= vals[1] >= vals[2] > 0):
        out.append(f"  NAICS prefix chain not monotonically narrowing or hit zero: {vals}")
        ok = False
    naics_bad = count({"naics_codes": {"require": ["999999"]}})
    out.append(f"  misspelled NAICS sanity check: 999999 total={naics_bad} "
               f"({'fails closed as expected' if naics_bad == 0 else 'CONTRADICTS expected fail-closed behavior'})")
    if naics_bad != 0:
        ok = False

    # pscCodes: README's own example is R425; walk R425 -> R4 -> R, plus the independently
    # named "10" weapons-category example, confirming main.js's own cycle-measured
    # R425+R499=88,874 pairing shape still holds (narrowing, not a coincidence of that pair).
    psc_desc = field("us-federal-awards-scraper", "pscCodes").get("description", "")
    m = re.search(r"`([A-Z0-9]{1,4})`", psc_desc)
    psc_leaf = m.group(1) if m else "R425"
    psc_chain = [psc_leaf, psc_leaf[:2], psc_leaf[:1]]
    psc_totals = {c: count({"psc_codes": [c]}) for c in dict.fromkeys(psc_chain)}
    out.append(f"  pscCodes prefix chain (schema example {psc_leaf}): {psc_totals}")
    pv = list(psc_totals.values())
    if not (pv[0] <= pv[1] <= pv[2] and pv[0] > 0):
        out.append(f"  PSC prefix chain not monotonically widening or hit zero: {pv}")
        ok = False
    ten_total = count({"psc_codes": ["10"]})
    out.append(f"  PSC '10' (weapons category, named separately in the schema) total={ten_total}")
    if not ten_total:
        out.append("  DEAD VALUE: documented PSC example '10' returns nothing")
        ok = False
    psc_bad = count({"psc_codes": ["ZZZZ"]})
    out.append(f"  misspelled PSC sanity check: ZZZZ total={psc_bad} "
               f"({'fails closed as expected' if psc_bad == 0 else 'CONTRADICTS expected fail-closed behavior'})")
    if psc_bad != 0:
        ok = False

    return ok, out


def p_substack_discover_categories():
    """No dedicated per-category filter to send -- discoverCategories resolves against this
    same live list at RUN TIME (resolveCategoryIds(), src/main.js:586), so the Actor already
    re-checks every slug it is given on every run and warns on an unresolved one
    (unknownCategorySlugs, main.js:614) rather than silently matching nothing. This probe is
    therefore a liveness check on the named EXAMPLES in our own copy, same shape as the
    Federal Register probe above, not a defect hunt on the Actor's own validation (which
    cannot go stale the way a hardcoded list could)."""
    out = []
    live = http("https://substack.com/api/v1/categories")
    flat = []
    for c in live:
        flat.append(c)
        flat.extend(c.get("subcategories") or [])
    slugs = {c.get("slug") for c in flat if c.get("slug")}
    out.append(f"  authority: /api/v1/categories -> {len(live)} top-level, {len(flat)} incl. subcategories, {len(slugs)} slugs")

    named = []
    for key in ("discoverCategories",):
        desc = field("substack-scraper", key).get("description", "")
        named += re.findall(r"`?([a-z][a-z-]+)`?", desc.split(":", 1)[-1])
    named = [n for n in dict.fromkeys(named) if n not in ("e", "g", "no")]
    # keep only the slugs the description actually names as examples (technology, business,
    # finance, culture, us-politics, food per the schema's own `e.g.` clause)
    candidates = [n for n in named if n in slugs or n in
                  {"technology", "business", "finance", "culture", "us-politics", "food"}]
    bad = [c for c in candidates if c not in slugs]
    out.append(f"  named example slugs checked: {candidates}, unresolved: {bad or 'none'}")
    return not bad, out


def p_eu_ted_cpv_codes():
    """classification-cpv is server-validated by TED itself (api.ted.europa.eu/v3/notices/search
    answers 400 QUERY_UNSUPPORTED_FIELD_VALUE naming the bad value, live-confirmed cycle 1017 and
    wired into main.js's own error handling at ~line 477) -- so unlike the free-text stringList
    fields above, a stale value here can never silently match nothing; TED tells the buyer
    immediately. This probe re-confirms that mechanism still holds today, live, rather than
    trusting a 2026-era finding to still be true 1,500+ cycles later: one documented-example
    code must 200 with a non-zero count, and one unused-but-well-formed code must 400 with the
    exact error shape main.js's INPUT_ERROR_STATUS/upstreamAdvice branch expects."""
    out = []
    good = http_raw(
        "https://api.ted.europa.eu/v3/notices/search",
        {"query": "classification-cpv=72000000 AND publication-date>=today(-30)",
         "page": 1, "limit": 1, "fields": ["publication-number"]},
    )
    good_body = json.loads(good[1])
    good_count = good_body.get("totalNoticeCount", 0)
    out.append(f"  classification-cpv=72000000 (IT services, our README's own example) -> "
               f"HTTP {good[0]}, totalNoticeCount={good_count}")

    bad = http_raw(
        "https://api.ted.europa.eu/v3/notices/search",
        {"query": "classification-cpv=99999999 AND publication-date>=today(-30)",
         "page": 1, "limit": 1, "fields": ["publication-number"]},
    )
    bad_body = json.loads(bad[1])
    bad_type = (bad_body.get("error") or {}).get("type")
    out.append(f"  classification-cpv=99999999 (well-formed, unused) -> HTTP {bad[0]}, "
               f"error.type={bad_type}")

    ok = good[0] == 200 and good_count > 0 and bad[0] == 400 and bad_type == "QUERY_UNSUPPORTED_FIELD_VALUE"
    if not ok:
        out.append("  DRIFT: TED's server-side validation no longer matches what main.js's "
                   "upstreamAdvice()/INPUT_ERROR_STATUS branch assumes -- re-check main.js:477-519.")
    return ok, out


def p_uk_find_a_tender_cpv_codes():
    """A FOURTH shape, and the dangerous one: uk-find-a-tender-scraper's cpvCodes is matched
    ENTIRELY CLIENT-SIDE (main.js:533-534, `cpvPrefixes.some(p => row.cpvCodes.some(h =>
    h.startsWith(p)))`) against whatever `allCpv()` (main.js:379) could dig out of the OCDS
    release.  There is no upstream to ask "is this code valid" and no server-side CPV param on
    either portal, so a stale/absent vocabulary cannot 400 and cannot warn -- it silently
    returns an empty dataset.  Two distinct things can therefore rot invisibly, and this probe
    tests both against live releases from BOTH portals:

      (a) the `scheme === 'CPV'` literal `allCpv()` gates on.  If either portal renamed it
          (OCDS permits e.g. 'CPV2008'), every row would come back with cpvCodes: [] and every
          cpvCodes filter in the fleet would match nothing, fleet-wide, with no error.
      (b) per-stage COVERAGE.  Measured live 2026-10-31, Find a Tender publishes no CPV
          classification AT ALL on award/contract-stage releases filed under the Procurement
          Act 2023 (legalBasis UKPGA 2023/54) -- 225 of 225 across four sampled windows, vs
          52 of 52 legacy EU-directive awards (32014L0023/24/25) that do carry one.  Tender,
          tenderUpdate, planning and planningUpdate stages are at 100%.  So a cpvCodes filter
          over FTS awards drops every post-Act award silently, which is now ~81% of them.  The
          README documents this (see its CPV coverage FAQ); the probe exists so the README is
          falsified the moment either direction changes -- FTS starting to publish CPV on Act
          notices makes our caveat wrong, FTS dropping it on tender stage makes the whole
          filter useless."""
    out = []
    now = dt.datetime.now(dt.timezone.utc)

    def window(days_ago, span=1):
        frm = (now - dt.timedelta(days=days_ago)).strftime("%Y-%m-%dT%H:%M:%S")
        to = (now - dt.timedelta(days=max(0, days_ago - span))).strftime("%Y-%m-%dT%H:%M:%S")
        return frm, to

    def all_cpv(tender):
        """Mirrors actors/uk-find-a-tender-scraper/src/main.js allCpv() exactly, including the
        scheme gate -- per the c2512 rule, a probe must send/read what the ACTOR does, not a
        plausible shape from upstream docs."""
        got, schemes = [], []
        c = (tender or {}).get("classification") or {}
        if c.get("scheme"):
            schemes.append(c["scheme"])
        if c.get("scheme") == "CPV" and c.get("id"):
            got.append(str(c["id"]))
        for item in (tender or {}).get("items") or []:
            ic = item.get("classification") or {}
            if ic.get("scheme"):
                schemes.append(ic["scheme"])
            if ic.get("scheme") == "CPV" and ic.get("id"):
                got.append(str(ic["id"]))
            for a in item.get("additionalClassifications") or []:
                if a.get("scheme"):
                    schemes.append(a["scheme"])
                if a.get("scheme") == "CPV" and a.get("id"):
                    got.append(str(a["id"]))
        return list(dict.fromkeys(got)), schemes

    # --- Find a Tender: sample several disjoint day-windows so one quiet day can't decide it
    fts_stage = {}          # stage tag -> [releases, releases with >=1 CPV]
    fts_award_basis = {}    # (legalBasis id, hasCPV) -> count
    schemes_seen = set()
    codes_fts = []
    for days_ago in (3, 10, 20, 40):
        frm, to = window(days_ago)
        pkg = http("https://www.find-tender.service.gov.uk/api/1.0/ocdsReleasePackages"
                   f"?limit=100&updatedFrom={frm}&updatedTo={to}")
        for rel in pkg.get("releases") or []:
            tender = rel.get("tender") or {}
            cpv, schemes = all_cpv(tender)
            schemes_seen.update(schemes)
            codes_fts.extend(cpv)
            tags = set(rel.get("tag") or [])
            stage = ("award/contract"
                     if tags & {"award", "contract", "awardUpdate", "contractUpdate"}
                     else ",".join(sorted(tags)) or "untagged")
            slot = fts_stage.setdefault(stage, [0, 0])
            slot[0] += 1
            slot[1] += 1 if cpv else 0
            if stage == "award/contract":
                basis = (tender.get("legalBasis") or {}).get("id") or "none"
                key = (basis, bool(cpv))
                fts_award_basis[key] = fts_award_basis.get(key, 0) + 1

    out.append("  Find a Tender (4 x 1-day windows, 100/page):")
    for stage, (n, w) in sorted(fts_stage.items(), key=lambda kv: -kv[1][0]):
        out.append(f"    {stage:20s} {n:4d} releases, {w:4d} with >=1 CPV ({100 * w // max(1, n)}%)")

    # --- Contracts Finder: the portal that DOES classify everything, sampled the same four
    # windows so the README's side-by-side table stays reproducible from one command.  All
    # stages requested explicitly: the default is tender-only, which would hide the award rows
    # that are the whole point of the comparison.
    cf_stage = {}
    codes_cf = []
    for days_ago in (3, 10, 20, 40):
        frm, to = window(days_ago)
        cf = http("https://www.contractsfinder.service.gov.uk/Published/Notices/OCDS/Search"
                  f"?limit=100&publishedFrom={frm}&publishedTo={to}"
                  "&stages=planning,tender,award,contract,implementation")
        for rel in cf.get("releases") or []:
            cpv, schemes = all_cpv(rel.get("tender") or {})
            schemes_seen.update(schemes)
            codes_cf.extend(cpv)
            tags = set(rel.get("tag") or [])
            stage = ("award/contract"
                     if tags & {"award", "contract", "awardUpdate", "contractUpdate"}
                     else ",".join(sorted(tags)) or "untagged")
            slot = cf_stage.setdefault(stage, [0, 0])
            slot[0] += 1
            slot[1] += 1 if cpv else 0
    cf_n = sum(n for n, _ in cf_stage.values())
    cf_with = sum(w for _, w in cf_stage.values())
    out.append(f"  Contracts Finder (4 x 1-day windows, all stages): {cf_with}/{cf_n} with >=1 CPV "
               f"({100 * cf_with // max(1, cf_n)}%)")
    for stage, (n, w) in sorted(cf_stage.items(), key=lambda kv: -kv[1][0]):
        out.append(f"    {stage:20s} {n:4d} releases, {w:4d} with >=1 CPV ({100 * w // max(1, n)}%)")
    out.append(f"  classification schemes seen across both portals: {sorted(schemes_seen)}")

    ok = True

    # (a) the scheme literal allCpv() gates on
    if "CPV" not in schemes_seen:
        out.append("  DRIFT (CRITICAL): no classification carried scheme=='CPV'. allCpv() "
                   "(main.js:379) gates on that exact literal, so EVERY row would ship "
                   "cpvCodes: [] and EVERY cpvCodes filter would silently match nothing.")
        ok = False

    # (b) the stages our copy tells buyers to filter must stay fully classified
    for stage in ("tender", "planning"):
        n, w = fts_stage.get(stage, [0, 0])
        if n == 0:
            out.append(f"  (no {stage}-stage releases in the sampled windows -- coverage not asserted)")
            continue
        pct = 100 * w / n
        out.append(f"  {stage}-stage coverage {w}/{n} ({pct:.0f}%) -- README tells buyers to "
                   f"filter cpvCodes on exactly this stage")
        if pct < 90:
            out.append(f"  DRIFT: {stage}-stage CPV coverage has collapsed; the README's "
                       "'filter on cpvCodes to find IT opportunities' advice no longer holds.")
            ok = False

    # (b, cont.) the Procurement-Act award gap the README now documents, in BOTH directions
    act_no = fts_award_basis.get(("2023/54", False), 0)
    act_yes = fts_award_basis.get(("2023/54", True), 0)
    legacy_yes = sum(v for (b, h), v in fts_award_basis.items() if b.startswith("32014L") and h)
    legacy_no = sum(v for (b, h), v in fts_award_basis.items() if b.startswith("32014L") and not h)
    out.append(f"  FTS award/contract by legal basis: Procurement Act 2023 (UKPGA 2023/54) "
               f"{act_no} without CPV / {act_yes} with; legacy EU directives "
               f"{legacy_no} without / {legacy_yes} with")
    if act_no + act_yes == 0:
        out.append("  (no Procurement Act award notices sampled -- gap not asserted this run)")
    elif act_yes:
        out.append(f"  DRIFT: {act_yes} Procurement Act award notice(s) now DO carry a CPV "
                   "classification. Good news upstream, but the README's CPV-coverage FAQ "
                   "states the gap is total -- re-measure and soften the copy.")
        ok = False

    # (b, cont.) the README sends award-side CPV work to Contracts Finder BECAUSE it classifies
    # everything, so that recommendation has to be falsifiable too.
    if cf_n and 100 * cf_with / cf_n < 99:
        out.append(f"  DRIFT: Contracts Finder CPV coverage is {cf_with}/{cf_n}, no longer the "
                   "100% the README leans on when it tells award-side buyers to use "
                   'sources: ["cf"] -- re-measure and fix that recommendation.')
        ok = False

    # divergence, per the c2512 rule: a prefix filter that distinguishes values must be shown
    # to actually partition, or an inert filter reads as a confident CLEAN
    codes = codes_fts + codes_cf
    it_hits = [c for c in codes if c.startswith("72")]
    health_hits = [c for c in codes if c.startswith("85")]
    out.append(f"  prefix partition over {len(codes)} live codes: '72' (README's own IT example) "
               f"-> {len(it_hits)} codes, '85' -> {len(health_hits)} codes, overlap "
               f"{len(set(it_hits) & set(health_hits))}")
    if not it_hits or not health_hits or (set(it_hits) & set(health_hits)):
        out.append("  DRIFT: the client-side subtree prefix match no longer partitions live "
                   "codes as README's CPV FAQ describes -- re-check cpvPrefixes (main.js:197).")
        ok = False

    return ok, out


def p_samgov_set_aside_types():
    """SAM.gov's `set_aside` is the opp-index-shape (c2516's class 2: entirely CLIENT-matched by
    the Actor's own canonSetAsides(), no server-side reference endpoint -- SAM.gov publishes no
    facet/aggregations endpoint for this vocabulary at any spelling, re-confirmed main.js:120-122).
    Unlike the free-text fields above, there IS a real upstream authority to ask: the same keyless
    search backend the Actor itself calls (api `set_aside=<code>`, fails CLOSED -- 0 rows, HTTP 200
    -- on an unrecognised value per main.js:107). So every documented code must be sent to that
    exact endpoint and assert a non-zero, DIVERGENT total (the c2512 PROBE INVALID rule), and a
    deliberately-wrong spelling must still read 0, matching the README's "fails closed, not open"
    claim. Last live-verified main.js-side at cycle 1524 (SET_ASIDE_CODES comment) -- never run as
    a repeatable vocab-screen probe before this cycle, so "verified" was one-off and undated in
    `audit_dates.json` terms."""
    out = []
    codes = field("sam-gov-opportunities-scraper", "setAsideTypes")
    desc = codes.get("description", "")
    # Pull the three groups named in the schema's own prose: the 18 ordinary codes, the
    # unrestricted marker NONE, and the 2 retired-but-real historical codes (SDB/ESB) -- same
    # "parse from the live schema text, not a hardcoded copy" shape as the USAspending probe.
    m = re.search(r"Valid codes:\s*([A-Za-z0-9, ]+?)\.", desc)
    ordinary = [c.strip() for c in m.group(1).split(",")] if m else []
    historical = re.findall(r"\b(SDB|ESB)\b", desc)
    codes_to_probe = list(dict.fromkeys(ordinary + ["NONE"] + historical))
    out.append(f"  schema documents {len(codes_to_probe)} codes: {codes_to_probe}")
    if not codes_to_probe:
        out.append("  PROBE INVALID: could not parse any documented code out of the description")
        return False, out

    # The sgs/v1/search backend 406s on `Accept: application/json` -- it only serves
    # `application/hal+json`, so send `*/*` like the Actor's got-scraping client effectively does
    # (curl's default) rather than the explicit application/json this tool's http() always sends.
    def sgs_total(params_tail):
        req = urllib.request.Request(
            f"https://sam.gov/api/prod/sgs/v1/search/?index=opp&responseType=json&page=0&size=1&{params_tail}",
            headers={"User-Agent": UA, "Accept": "*/*"},
        )
        with urllib.request.urlopen(req, timeout=TIMEOUT) as r:
            return json.loads(r.read().decode()).get("page", {}).get("totalElements")

    totals = {}
    for c in codes_to_probe:
        totals[c] = sgs_total(f"set_aside={urllib.parse.quote(c)}")
        out.append(f"    {c:10s} total={totals[c]}")
    dead = [c for c, n in totals.items() if not n]
    if len(set(totals.values())) == 1:
        out.append("  PROBE INVALID: every code returned the same total, so the filter was "
                   "ignored rather than applied -- this proves nothing about the vocabulary.")
        return False, out
    if dead:
        out.append(f"  DEAD CODES (documented as live but return nothing): {dead}")

    # README's "fails closed, not open" claim: a buyer-natural lowercase typo must still read 0,
    # not silently widen to the unfiltered index (main.js:107's whole reason for canonSetAsides()).
    bogus_total = sgs_total("set_aside=sba")
    out.append(f"  lowercase-typo sanity check: set_aside=sba total={bogus_total} "
               f"({'matches README fails-closed claim' if bogus_total == 0 else 'CONTRADICTS README claim'})")
    if bogus_total != 0:
        return False, out

    return not dead, out


def p_google_news_topics():
    """google-news-scraper.topics is the same shape as sam-gov's setAsideTypes: a hardcoded
    client-side vocabulary (main.js:32-36 VALID_TOPICS, 20 codes) with no upstream reference
    endpoint -- Google publishes no API listing its RSS topic sections. Last live-verified at
    cycle 832 (main.js's own comment) and never run as a repeatable probe since, so "verified"
    was one-off and undated in audit_dates.json terms, same gap c2518 found for sam-gov.

    The real endpoint IS probeable though, and the fail-closed signature is distinctive: a
    valid code 302-redirects to a real `/rss/topics/<hash>` feed with dozens of real <item>
    entries; an invalid code 301/302-redirects all the way to the generic `news.google.com/home`
    page (0 <item>s, no /rss/topics/ in the final URL) -- main.js:27's "a made-up code returns
    an empty feed rather than falling back to Top Stories" holds in spirit (it falls back to
    the homepage, not Top Stories specifically, but the net effect buyers care about -- empty,
    not real content -- matches). Codes parsed from the schema's own description text (not a
    hardcoded copy), same self-screening shape as the USAspending/SAM.gov probes above."""
    out = []
    desc = field("google-news-scraper", "topics").get("description", "")
    # Two explicit comma-separated lists ("Main sections: ...." and "...nav: ...."), not a bare
    # all-caps-word scan -- the surrounding prose itself contains all-caps words ("RSS", "URL")
    # that are not topic codes and would otherwise false-positive as DEAD.
    codes = []
    for m in re.finditer(r"(?:sections|nav):\s*([A-Z_, ]+?)\.", desc):
        codes += [c.strip() for c in m.group(1).split(",") if c.strip()]
    out.append(f"  schema documents {len(codes)} codes: {codes}")
    if not codes:
        out.append("  PROBE INVALID: could not parse any documented code out of the description")
        return False, out

    def topic_items(code):
        url = (f"https://news.google.com/rss/headlines/section/topic/{code}"
               "?hl=en-US&gl=US&ceid=US:en")
        req = urllib.request.Request(url, headers={"User-Agent": UA})
        with urllib.request.urlopen(req, timeout=TIMEOUT) as r:
            final_url = r.geturl()
            body = r.read().decode("utf-8", "replace")
        return body.count("<item>"), "/rss/topics/" in final_url

    dead = []
    for c in codes:
        n, is_topic_hash = topic_items(c)
        out.append(f"    {c:14s} items={n:3d} redirected-to-topic-hash={is_topic_hash}")
        if not n or not is_topic_hash:
            dead.append(c)
    if dead:
        out.append(f"  DEAD CODES (documented as live but return no real topic feed): {dead}")

    # Fail-closed sanity check: a code main.js explicitly documents (comment lines 29-31) as
    # probed-and-NOT-a-section must still fail the same way, confirming Google hasn't quietly
    # added it (which would mean VALID_TOPICS is now incomplete, not wrong).
    invalid_sample = ["TV", "NFL", "SPACE"]
    false_positives = []
    for c in invalid_sample:
        n, is_topic_hash = topic_items(c)
        out.append(f"    (known-invalid) {c:10s} items={n:3d} redirected-to-topic-hash={is_topic_hash}")
        if n and is_topic_hash:
            false_positives.append(c)
    if false_positives:
        out.append(f"  NEW SECTIONS: {false_positives} now resolve to real topic feeds -- "
                   "main.js's VALID_TOPICS list is stale-by-omission, add them.")
        return False, out

    return not dead, out


def p_steam_reviews_language():
    """steam-reviews-scraper.language (c2521/c2522 candidate) is a THIRD backlog shape, not a
    dead-value question: every documented Steam language code still resolves (confirmed live
    2026-10-31 across all 29), but Steam's `filterLanguage` param FAILS OPEN on an unrecognized
    one -- it silently serves the SAME top review as a plain `english` request, HTTP 200, no
    error. c2522 added a `VALID_LANGUAGES` warning to main.js for exactly this trap (the natural
    wrong guess "chinese"/"korean" instead of Steam's own "schinese"/"tchinese"/"koreana"). This
    probe re-proves BOTH halves live so neither can rot silently: (a) every code the warning
    treats as valid still gets its OWN top review, not the English fallback -- if Steam ever
    retires one, the warning would wrongly go silent on a now-broken value; (b) a sample of
    realistic wrong guesses still falls into the trap -- if Steam ever starts rejecting bad
    codes outright (or stops defaulting to English), the warning's own prose would be wrong and
    need rewriting, not just re-confirming.

    Reads `VALID_LANGUAGES` out of the ACTOR'S OWN SOURCE (regex on main.js), not a duplicated
    copy here -- the lesson from every other probe in this file: mirror what the Actor does, not
    what you remember it doing, or a later source edit silently desyncs from the test.

    Parsing HTML needs the Actor's own `parseReviewsPage` (cheerio-based), not a hand-rolled
    regex -- reusing the real code path matters more here than in any other probe, since the
    discriminator IS the parser's output. Shells out to `node` rather than reimplementing cheerio
    in Python.
    """
    out = []
    main_js = open(f"{R}/actors/steam-reviews-scraper/src/main.js").read()
    m = re.search(r"VALID_LANGUAGES = new Set\(\[([^\]]+)\]\)", main_js)
    if not m:
        out.append("  PROBE INVALID: could not find VALID_LANGUAGES in main.js -- source shape changed")
        return False, out
    valid = [c.strip().strip("'\"") for c in m.group(1).split(",") if c.strip()]
    out.append(f"  main.js declares {len(valid)} valid codes: {valid}")

    app_id = 1145360  # Hades -- the Actor's own example game, high review volume in many languages
    sample_valid = ["schinese", "tchinese", "koreana", "brazilian", "latam", "russian",
                     "german", "french", "spanish", "japanese"]
    sample_valid = [c for c in sample_valid if c in valid]
    sample_bad = ["chinese", "korean", "xyzzy123bogus"]

    def top_review(lang):
        url = (f"https://steamcommunity.com/app/{app_id}/reviews/"
               f"?browsefilter=mostrecent&filterLanguage={urllib.parse.quote(lang)}&l=english")
        status, html = http_raw(url)
        if status != 200:
            return status, None
        tmp = f"/tmp/_vocab_screen_steam_{lang}.html"
        open(tmp, "w").write(html)
        js = (f"import('{R}/actors/steam-reviews-scraper/src/reviews_html.js').then("
              f"async ({{parseReviewsPage}}) => {{"
              f"const fs = await import('fs');"
              f"const html = fs.readFileSync('{tmp}','utf8');"
              f"const p = parseReviewsPage(html, {app_id});"
              f"console.log(JSON.stringify((p.reviews[0]?.review || '').slice(0,80)));"
              f"}});")
        result = subprocess.run(["node", "-e", js], capture_output=True, text=True, timeout=TIMEOUT)
        if result.returncode != 0:
            raise RuntimeError(f"node parse failed for {lang}: {result.stderr[:300]}")
        return status, json.loads(result.stdout.strip())

    _, baseline = top_review("english")
    out.append(f"  baseline (english) top review: {baseline!r}")
    if not baseline:
        out.append("  PROBE INVALID: english baseline itself returned no review to compare against")
        return False, out

    fellback_valid = []
    for c in sample_valid:
        _, first = top_review(c)
        matches_english = first == baseline
        out.append(f"    valid   {c:10s} top review: {first!r}  {'<- FELL BACK TO ENGLISH' if matches_english else ''}")
        if matches_english:
            fellback_valid.append(c)

    stayed_closed = []
    for c in sample_bad:
        _, first = top_review(c)
        matches_english = first == baseline
        out.append(f"    bad     {c:14s} top review: {first!r}  {'(fail-open confirmed)' if matches_english else '(!) NO LONGER falls back'}")
        if not matches_english:
            stayed_closed.append(c)

    if fellback_valid:
        out.append(f"  REGRESSION: documented-valid code(s) now fall back to English like a typo "
                   f"would: {fellback_valid} -- main.js's VALID_LANGUAGES is stale, drop them or the "
                   "warning will wrongly stay silent on a now-broken value.")
        return False, out
    if stayed_closed:
        out.append(f"  UPSTREAM CHANGED: {stayed_closed} no longer fail open the way the warning's "
                   "prose claims -- re-check main.js's warning text, it may now be wrong.")
        return False, out

    return True, out


def p_grants_gov_agencies():
    """grants-gov-scraper.agencies, added cycle 2524 to give this field the live-probe
    treatment eu-ted's cpvCodes got at c2515 -- c2514 only CODE-READ it and deliberately
    left the audit date unbumped.

    Shape: self-validating like substack/eu-ted (the Actor rebuilds its whole index from
    the live /search2 agency facet on EVERY run, loadAgencyIndex() src/main.js:262, and
    drops an unrecognised code with a warning -- refusing to run if ALL are unrecognised,
    main.js:310), so the vocabulary itself cannot go stale.  What CAN go stale is the
    three live measurements main.js's own comments hardcode as load-bearing, each of which
    silently un-filters a run if upstream changes:

      1. the facet must be probed with all four oppStatuses (default is forecasted|posted,
         which hid 549 of 712 codes incl. ED/HHS-CDC/USAID before c1532);
      2. the two-pass index build exists because some parents are listed as a sub-agency OF
         THEMSELVES -- in one pass {"agencies":["DOD"]} collapsed to a bare "DOD";
      3. a BARE parent code matches almost nothing here, which is the only reason the
         sub-agency expansion is worth its complexity.

    So this probe asserts the facet shape AND that expansion still changes the answer --
    per the backlog's own rule, a probe that cannot tell a working filter from an ignored
    one reads CLEAN either way."""
    out = []
    ALL_STATUSES = "forecasted|posted|closed|archived"  # mirrors main.js ALL_OPP_STATUSES
    API = "https://api.grants.gov/v1/api/search2"

    def search(agencies=None):
        body = {"rows": 1, "oppStatuses": ALL_STATUSES}
        if agencies:
            body["agencies"] = agencies
        return http(API, body)

    probe = search()
    lst = (probe.get("data") or {}).get("agencies")
    total_all = (probe.get("data") or {}).get("hitCount")
    if not isinstance(lst, list) or not lst:
        out.append("  FACET GONE: /search2 no longer returns data.agencies -- loadAgencyIndex() "
                   "would return an empty Map, so EVERY supplied code becomes 'unrecognised' and "
                   "main.js:310 fails every agency-filtered run. Fix the Actor before shipping.")
        return False, out

    # Rebuild the index exactly the way the Actor does: sub-agencies first, parents last.
    index = {}
    for parent in lst:
        for sub in parent.get("subAgencyOptions") or []:
            if sub.get("value"):
                index[str(sub["value"]).upper()] = [sub["value"]]
    for parent in lst:
        subs = [s["value"] for s in (parent.get("subAgencyOptions") or []) if s.get("value")]
        index[str(parent["value"]).upper()] = list(dict.fromkeys([parent["value"], *subs]))
    self_subs = [p["value"] for p in lst
                 if any(s.get("value") == p["value"] for s in (p.get("subAgencyOptions") or []))]
    out.append(f"  facet (all 4 statuses): {len(lst)} parents -> {len(index)} resolvable codes, "
               f"{total_all} opportunities; {len(self_subs)} parent(s) listed as a sub-agency of "
               f"themselves (two-pass build still required)")
    # main.js's comments pin these as measured live 2026-10-10; drift here means its prose lies.
    PINNED = {"codes": 712, "self_subs": 15, "USDA": 84, "DOS": 219, "DOD": 75}
    drift = []
    if len(index) != PINNED["codes"]:
        drift.append(f"code count {len(index)} != main.js's {PINNED['codes']}")
    if len(self_subs) != PINNED["self_subs"]:
        drift.append(f"self-sub parents {len(self_subs)} != main.js's {PINNED['self_subs']}")

    # Documented examples from our own schema copy must each resolve AND actually filter.
    named = ["NSF", "ED", "HHS-CDC", "USDA-NIFA"]  # schema description's own e.g. list
    desc = field("grants-gov-scraper", "agencies").get("description", "")
    missing_from_copy = [n for n in named if n not in desc]
    unresolved = [n for n in named if n not in index]
    counts = {}
    for code in named:
        if code in index:
            counts[code] = search("|".join(index[code])).get("data", {}).get("hitCount", 0)
    out.append(f"  schema-named examples {named}: unresolved {unresolved or 'none'}, "
               f"hitCounts {counts}")
    zero = [c for c, n in counts.items() if not n]
    # Divergence: four different agencies must not all return the same number, or the
    # filter is being ignored and every value would read CLEAN.
    diverge = len(set(counts.values())) == len(counts) and counts

    # Parent expansion must still be load-bearing: bare parent << expanded parent.
    expansion = []
    for parent in ("USDA", "DOD"):
        bare = search(parent).get("data", {}).get("hitCount", 0)
        full = search("|".join(index[parent])).get("data", {}).get("hitCount", 0)
        out.append(f"  parent {parent}: bare -> {bare}, expanded to {len(index[parent])} "
                   f"codes -> {full}")
        if len(index[parent]) != PINNED[parent]:
            drift.append(f"{parent} expands to {len(index[parent])} != main.js's {PINNED[parent]}")
        if not (full > bare * 5):
            expansion.append(parent)

    # Fail-closed: an unknown code must contribute 0, not be ignored upstream. The Actor
    # drops unknowns before sending, so this guards the case where it ever stopped doing so.
    bogus = search("FAKEAGENCY").get("data", {}).get("hitCount", -1)
    mixed = search("NSF|FAKEAGENCY").get("data", {}).get("hitCount", -1)
    nsf_only = counts.get("NSF")
    out.append(f"  fail-closed: agencies=FAKEAGENCY -> {bogus} (not {total_all}); "
               f"NSF|FAKEAGENCY -> {mixed} vs NSF alone {nsf_only}")
    fail_open = bogus != 0 or mixed != nsf_only

    if drift:
        out.append(f"  PROSE DRIFT (not buyer-facing breakage, but main.js's comments and the "
                   f"schema's '712 codes' claim are now wrong): {'; '.join(drift)} -- update the "
                   "comments at src/main.js:244-262 and the schema description.")
    if missing_from_copy:
        out.append(f"  PROBE STALE: {missing_from_copy} no longer appear in the schema description "
                   "-- re-sync this probe's `named` list with our copy.")
    if unresolved or zero:
        out.append(f"  STALE VALUE: schema-named example(s) {unresolved + zero} no longer resolve "
                   "or match nothing -- a buyer copying our own example gets an empty dataset.")
    if not diverge:
        out.append(f"  PROBE INVALID: the four named agencies no longer return distinct counts "
                   f"({counts}) -- the agencies filter may be being ignored, in which case every "
                   "value would read CLEAN regardless.")
    if expansion:
        out.append(f"  EXPANSION NO LONGER LOAD-BEARING for {expansion}: a bare parent code now "
                   "matches about as much as the full sub-agency tree. Harmless to buyers, but "
                   "main.js:244-249's justification for loadAgencyIndex()'s complexity is stale.")
    if fail_open:
        out.append(f"  FAIL-OPEN: /search2 now ignores an unknown agency code instead of matching "
                   "0 -- if main.js ever stops dropping unknowns client-side, a typo would silently "
                   "return EVERY agency's rows. Keep main.js:292-316 exactly as it is.")

    ok = not (drift or missing_from_copy or unresolved or zero or expansion or fail_open) and bool(diverge)
    return ok, out


PROBES = {
    "federal-register-scraper": ("agencies", p_federal_register_agencies),
    "hacker-news-scraper": ("tags", p_hacker_news_tags),
    "nih-reporter-scraper": ("agencyIcCodes", p_nih_agency_ic_codes),
    "us-federal-awards-scraper": ("recipientTypes", p_usaspending_recipient_types),
    # colon suffix (not a real slug) because the dict is keyed by slug and this Actor already
    # owns the plain "us-federal-awards-scraper" key for its recipientTypes probe above.
    "us-federal-awards-scraper:naics-psc": ("naicsCodes+pscCodes", p_usaspending_naics_psc_codes),
    "substack-scraper": ("discoverCategories", p_substack_discover_categories),
    "eu-ted-tenders-scraper": ("cpvCodes", p_eu_ted_cpv_codes),
    "uk-find-a-tender-scraper": ("cpvCodes", p_uk_find_a_tender_cpv_codes),
    "sam-gov-opportunities-scraper": ("setAsideTypes", p_samgov_set_aside_types),
    "google-news-scraper": ("topics", p_google_news_topics),
    "steam-reviews-scraper": ("language", p_steam_reviews_language),
    "grants-gov-scraper": ("agencies", p_grants_gov_agencies),
}

targets = sys.argv[1:] or sorted(PROBES)
unknown = [t for t in targets if t not in PROBES]
if unknown:
    print(f"no vocab probe for: {', '.join(unknown)}")
    print(f"available: {', '.join(sorted(PROBES))}")
    sys.exit(2)

print(f"vocab-screen -- live liveness proof of closed stringList vocabularies "
      f"({len(targets)} Actor(s))\n")
failed = []
for slug in targets:
    fname, fn = PROBES[slug]
    print(f"{slug}.{fname}")
    try:
        ok, lines = fn()
    except Exception as e:
        ok, lines = False, [f"  PROBE ERROR: {type(e).__name__}: {e}"]
    for ln in lines:
        print(ln)
    print(f"  => {'CLEAN' if ok else 'STALE'}\n")
    if not ok:
        failed.append(slug)

if failed:
    print(f"STALE VOCABULARY in {len(failed)} Actor(s): {', '.join(failed)}")
    print("A documented filter value that resolves to nothing upstream hands the buyer an")
    print("empty dataset with no explanation -- fix the copy or drop the value.")
    sys.exit(1)
print("ALL CLEAN -- every documented vocabulary value still resolves upstream.")
