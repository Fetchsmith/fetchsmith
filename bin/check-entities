#!/root/agent/venv/bin/python
"""Probe one Actor's live output for undecoded HTML entities / raw tags.

Usage: bin/check-entities <slug> '{json input}'

Runs run-sync-get-dataset-items (registry memory, limit=10) like bin/varied-test,
then walks EVERY string value in every row (nested dicts/lists included) and counts
`&name;` / `&#NNN;` / `&#xHH;` entities plus raw `<tag>` markup, reporting per field.

Why this exists: cycle 556 found grants-gov-scraper shipping 131 undecoded entities
in fields the README documents as plain prose — the source API returns entities in
fields with ZERO tags, so a tag-stripper alone never catches them. Any Actor pulling
free text out of a government/CMS API is a candidate. Always pass a small explicit
maxResults: unknown input keys are silently ignored by Apify (LEARNINGS, apple-podcasts).

Exit 0 = clean, 1 = entities and/or raw tags found, 2 = run failed.
"""
import json, re, sys, collections, httpx

ENT = re.compile(r"&(?:[a-zA-Z][a-zA-Z0-9]{1,31}|#\d{1,7}|#[xX][0-9a-fA-F]{1,6});")
TAG = re.compile(r"</?[a-zA-Z][a-zA-Z0-9]*(?:\s[^<>]*)?/?>")

if len(sys.argv) < 3:
    print(__doc__); sys.exit(2)

env = dict(l.rstrip("\n").split("=", 1) for l in open("/root/agent/secrets/env")
           if "=" in l and not l.startswith("#"))
T = env["APIFY_TOKEN"]; API = "https://api.apify.com/v2"
user = httpx.get(f"{API}/users/me", headers={"Authorization": f"Bearer {T}"}).json()["data"]["username"]
reg = {t["slug"]: t for t in json.load(open("/root/agent/actors/registry.json"))["tools"]}

slug = sys.argv[1]; inp = json.loads(sys.argv[2])
mem = reg[slug].get("memory_mb", 1024)
print(f"--- {slug} mem={mem} input={json.dumps(inp)}")
r = httpx.post(f"{API}/acts/{user}~{slug}/run-sync-get-dataset-items",
               params={"token": T, "timeout": 240, "memory": mem, "clean": "true", "limit": 10},
               json=inp, timeout=300)
print("HTTP", r.status_code)
items = r.json() if r.status_code < 300 else r.text[:400]
if not isinstance(items, list):
    print(items); sys.exit(2)
print("rows:", len(items))

ents = collections.Counter(); tags = collections.Counter()
samples = {}; kinds = collections.Counter()

def walk(v, path):
    if isinstance(v, str):
        e = ENT.findall(v); t = TAG.findall(v)
        if e:
            ents[path] += len(e); kinds.update(e)
            samples.setdefault(path, v[:160])
        if t:
            tags[path] += len(t)
            samples.setdefault(path, v[:160])
    elif isinstance(v, dict):
        for k, sub in v.items():
            walk(sub, f"{path}.{k}" if path else k)
    elif isinstance(v, list):
        for sub in v:
            walk(sub, f"{path}[]")

for it in items:
    walk(it, "")

if not ents and not tags:
    print("CLEAN: 0 entities, 0 raw tags across all string fields")
    sys.exit(0)

print(f"\nENTITIES: {sum(ents.values())} total in {len(ents)} field(s)")
for f, n in ents.most_common():
    print(f"  {n:4d}  {f}")
print(f"RAW TAGS: {sum(tags.values())} total in {len(tags)} field(s)")
for f, n in tags.most_common():
    print(f"  {n:4d}  {f}")
if kinds:
    print("entity kinds:", dict(kinds.most_common(12)))
print("\nsamples:")
for f, s in list(samples.items())[:8]:
    print(f"  {f}: {s!r}")
sys.exit(1)
