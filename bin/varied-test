#!/root/agent/venv/bin/python
"""Capped varied-input platform verification for one Actor (QUALITY cycles).

Usage: bin/varied-test <slug> '{json input}' [comma,separated,output,keys] [--force]
Runs run-sync-get-dataset-items with the registry memory and limit=10, prints the
chosen output keys per row so a filter can be checked against real data.
Always pass an explicit small maxResults: unknown input keys are silently ignored
by Apify, so a typo means an uncapped (billable) run (LEARNINGS, apple-podcasts).

Two guards, both added cycle 2160 after they bit inside one cycle:
  * INPUT keys are checked against the Actor's own .actor/input_schema.json BEFORE
    the billable POST, because Apify silently ignores an unknown one -- the exact
    way a typo turns into an uncapped run. Exits 1 on an unknown key (--force to
    run anyway, e.g. a key the schema genuinely does not declare).
  * OUTPUT keys you asked to print are diffed against the keys the rows actually
    have. `it.get(k)` returns None for a key that DOES NOT EXIST just as it does
    for a field that is genuinely null, so a mistyped output key reads exactly
    like "this Actor returns nothing here" -- c2160 nearly filed two false bugs
    that way (asked for oppNum/oppTitle, real fields are
    opportunityNumber/title). Absent-everywhere keys are now called out as NOT A
    FIELD, separately from fields that exist but were null in every row.
"""
import json, os, sys, httpx
env = dict(l.rstrip("\n").split("=", 1) for l in open("/root/agent/secrets/env") if "=" in l and not l.startswith("#"))
T = env["APIFY_TOKEN"]; API = "https://api.apify.com/v2"
user = httpx.get(f"{API}/users/me", headers={"Authorization": f"Bearer {T}"}).json()["data"]["username"]
reg = {t["slug"]: t for t in json.load(open("/root/agent/actors/registry.json"))["tools"]}

argv = [a for a in sys.argv[1:] if a != "--force"]; force = "--force" in sys.argv
slug = argv[0]; inp = json.loads(argv[1]); keys = argv[2].split(",") if len(argv) > 2 else []
mem = reg[slug].get("memory_mb", 1024)

# Pre-flight: an unknown INPUT key is dropped silently by Apify, so the run still
# succeeds -- just unfiltered, and therefore billable at full size. Catch it here,
# before spending anything, rather than reading it off a surprising row count.
sch = f"/root/agent/actors/{slug}/.actor/input_schema.json"
if os.path.exists(sch):
    declared = set(json.load(open(sch)).get("properties", {}))
    unknown = [k for k in inp if k not in declared]
    if unknown:
        print(f"UNKNOWN INPUT KEY(S) for {slug}: {', '.join(unknown)}")
        print(f"  declared: {', '.join(sorted(declared))}")
        if not force:
            sys.exit("refusing to spend a billable run on silently-ignored input (--force to override)")
        print("  --force given, running anyway")
else:
    print(f"(no input_schema.json at {sch} -- input keys unchecked)")

print(f"--- {slug} mem={mem} input={json.dumps(inp)}")
r = httpx.post(f"{API}/acts/{user}~{slug}/run-sync-get-dataset-items",
               params={"token": T, "timeout": 240, "memory": mem, "clean": "true", "limit": 10},
               json=inp, timeout=300)
print("HTTP", r.status_code)
items = r.json() if r.status_code < 300 else r.text[:400]
if not isinstance(items, list):
    print(items); sys.exit(1)
print("rows:", len(items))
for i, it in enumerate(items):
    print(i, {k: it.get(k) for k in keys})

# Separate "you asked for a key this Actor does not emit" from "the field exists and
# was null" -- it.get() renders both as None, which is the whole trap.
if keys and items:
    present = set().union(*(it.keys() for it in items))
    absent = [k for k in keys if k not in present]
    allnull = [k for k in keys if k in present and all(it.get(k) is None for it in items)]
    if absent:
        print(f"\nNOT A FIELD (absent from all {len(items)} rows, the None above is NOT a null "
              f"value): {', '.join(absent)}")
        near = [p for p in sorted(present) if any(a.lower()[:3] in p.lower() for a in absent)]
        if near:
            print(f"  did you mean: {', '.join(near[:8])}")
        print(f"  rows actually have: {', '.join(sorted(present))}")
    if allnull:
        print(f"\nREAL NULLS (field exists, null in every row -- worth investigating): "
              f"{', '.join(allnull)}")
