#!/root/agent/venv/bin/python
"""check-row-floor -- flag live Actors whose nightly health run returns far FEWER
rows than its own test input asked for, or fewer than its own recent history.

WHY THIS EXISTS (cycle 1716)
----------------------------
`bin/actor-health` scores every Actor with `ok = (status < 300 and n >= 1)`. That is
an EXISTENCE test, not a QUANTITY test, so an Actor can degrade from 10 rows to 1 and
stay green forever. Cycle 1716 found two live instances by hand:

  sam-gov-opportunities-scraper -- 1 row of a 10-row cap, and it had silently gone
      2 -> 1 at some point in the 80-run health history with no alert. Platform runs
      proved the ACTOR was fine (prefill-only default 5/5, keyword-only 5/5); the
      fault was our own test input (`keyword:"solar"` AND `naicsCodes:["221122"]` is a
      near-empty intersection), so nightly health had been proving ~nothing for it.
  fec-campaign-finance-scraper -- 2 rows of a 5-row cap ("Warren"+MA+Senate).

Both test inputs were rewritten that cycle to inputs verified to return 10/10.

This is the same bug class as cycle 1713's missing-CTA gap: a check that verifies
something EXISTS is structurally blind to whether there is ENOUGH of it. Note the
corollary -- a FLAG HERE IS NOT AN OUTAGE. It most often means a weak test input.
Diagnose with `bin/varied-test` (broaden one filter at a time) BEFORE touching Actor
code, exactly as 1716 did.

TWO INDEPENDENT SIGNALS
-----------------------
1. ratio   -- items / min(test_input.maxResults, 10). The <0.6 floor is what separated
              the two real cases (0.10, 0.40) from the other 21 (all 1.00) at 1716.
2. decline -- items vs. the max seen for that Actor across health.json's git history
              (a drop of >=2 from its own observed best). Catches an Actor whose test
              input is fine but whose upstream source quietly started returning less;
              `--no-history` skips it when git is unavailable or slow.

Honest limits: an Actor whose upstream genuinely holds few rows for a legitimately
narrow query will flag every run -- put it in ALLOW below with a reason, do not relax
the floor. And a cap-matching 10/10 says nothing about field-level nulls; that is
`bin/check-field-fill`'s job, not this one.

THE SNAPSHOT IS NOT THE PRESENT (cycle 2388)
--------------------------------------------
Every signal above is read out of `state/health.json`, which only `bin/actor-health`
writes -- a NIGHTLY snapshot (03:30 UTC). A flag therefore describes the fleet as it
was up to ~24h ago, and by the time a cycle reads it the cause may already be gone.
Cycle 2388 hit exactly that, on BOTH of its flags at once:

  court-records-scraper -- 0/10 rows, CourtListener answering HTTP 401 "Authentication
      credentials were not provided". Already fixed before the flag was ever read: the
      03:30 run used build 0.1.69, and build 0.1.71 (pushed ~06:13 the same morning)
      returned 10/10 on identical input.
  shopify-products-scraper -- 0/10 rows, three Apify-Proxy timeouts on allbirds.com's
      products.json burning the whole 180s health budget. The very next run, 03:37 the
      same morning, returned 10/10. A slow upstream minute, not a defect; the Actor
      reported it honestly rather than failing open.

So: read the snapshot AGE in the header line before diagnosing anything, and prefer
`--recheck`, which re-runs `bin/actor-health --only <slug>` for each flagged Actor and
tells you whether the flag survives contact with the present. That costs one real
(tiny, capped at 10 rows) Apify run per flagged Actor -- cheap next to a cycle spent
debugging an outage that healed itself overnight.

Usage: bin/check-row-floor [--no-history] [--json] [--recheck]
Exit 0 = clean, 1 = at least one Actor flagged. Under --recheck only CONFIRMED
findings (ones a fresh run reproduced) set exit 1; CLEARED ones do not.
"""
import ast
import collections
import json
import os
import subprocess
import sys
import time

ROOT = "/root/agent"
RATIO_FLOOR = 0.6
DECLINE_MIN = 2
HISTORY_DEPTH = 60

# slug -> reason. Only for Actors whose niche genuinely returns few rows for the
# narrowest input we still want tested nightly. Never add a slug here to silence a
# real decline; fix or broaden the test input instead.
ALLOW = {}

# Input keys that are a LIST OF TARGETS, where the Actor emits one row per entry and
# there is no maxResults cap to read (cycle 1812: `website-screenshot-scraper` takes
# `urls` and has no maxResults anywhere in its .actor/input_schema.json -- one row per
# URL, success or error). For those the row count the test input ASKED FOR is the length
# of that list, not actor-health's fallback default of 5, which flagged a correct 1/1 run
# as 1/5 = 0.20. Only consulted when the input declares NO maxResults at all, so this can
# never move the cap for the 23 search-shaped Actors that do declare one. Add a key here
# when a new "user supplies the target" Actor ships; do not make this a general
# longest-list guess -- filter lists (`phases`, `classifications`, `countries`) are lists
# too and say nothing about row count.
TARGET_LIST_KEYS = ("urls",)


def latest_health():
    with open(f"{ROOT}/state/health.json") as fh:
        return json.load(fh)


def live_slugs():
    with open(f"{ROOT}/actors/registry.json") as fh:
        reg = json.load(fh).get("tools", [])
    return {t["slug"]: t for t in reg if t.get("status") in ("live", "beta")}


def requested_cap(slug, tool):
    """Mirror bin/actor-health's own input resolution, including its min(...,10) cap."""
    path = f"{ROOT}/actors/{slug}/test_input.json"
    if os.path.exists(path):
        with open(path) as fh:
            inp = json.load(fh)
    else:
        inp = tool.get("example_input", {"maxResults": 5})
    if inp.get("maxResults") is None:
        for key in TARGET_LIST_KEYS:
            targets = inp.get(key)
            if isinstance(targets, list) and targets:
                return max(min(len(targets), 10), 1)
    try:
        want = int(inp.get("maxResults", 5) or 5)
    except (TypeError, ValueError):
        want = 5
    return max(min(want, 10), 1)


def history_max():
    """Per-slug max row count across recent distinct health.json revisions."""
    try:
        log = subprocess.run(
            ["git", "-C", ROOT, "log", "--format=%H", "--", "state/health.json"],
            capture_output=True, text=True, timeout=60,
        ).stdout.split()
    except Exception:
        return {}
    best = collections.defaultdict(int)
    seen_ts = set()
    for sha in log[:HISTORY_DEPTH]:
        try:
            blob = subprocess.run(
                ["git", "-C", ROOT, "show", f"{sha}:state/health.json"],
                capture_output=True, text=True, timeout=30,
            ).stdout
            data = json.loads(blob)
        except Exception:
            continue
        ts = data.get("ts")
        if ts in seen_ts:
            continue
        seen_ts.add(ts)
        for slug, res in data.get("results", {}).items():
            n = res.get("items") or 0
            if n > best[slug]:
                best[slug] = n
    return dict(best)


def recheck(slug):
    """Re-run just this Actor's health input NOW and return its fresh result dict.

    `bin/actor-health --only <slug>` is deliberately side-effect-free (it does NOT write
    state/health.json), so this cannot corrupt the nightly record with a hand-triggered
    run. It prints one line, `<slug> {'ok': True, 'items': 10, ...}` -- a Python dict
    repr, so literal_eval, not json.loads. Returns None if the run or the parse failed,
    which is reported as UNKNOWN rather than silently treated as a pass.
    """
    try:
        out = subprocess.run(
            [f"{ROOT}/bin/actor-health", "--only", slug],
            capture_output=True, text=True, timeout=420,
        ).stdout
    except Exception as exc:
        print(f"  recheck {slug}: run failed ({exc})")
        return None
    for line in out.splitlines():
        if line.startswith(f"{slug} ") and "{" in line:
            try:
                return ast.literal_eval(line[line.index("{"):])
            except (ValueError, SyntaxError):
                break
    print(f"  recheck {slug}: could not parse actor-health output")
    return None


def age_str(ts):
    if not ts:
        return "age unknown"
    hours = (time.time() - ts) / 3600.0
    if hours < 1:
        return f"{hours * 60:.0f}m old"
    return f"{hours:.1f}h old"


def main():
    use_history = "--no-history" not in sys.argv
    as_json = "--json" in sys.argv
    do_recheck = "--recheck" in sys.argv

    health = latest_health()
    results = health.get("results", {})
    tools = live_slugs()
    best = history_max() if use_history else {}

    findings = []
    for slug, tool in sorted(tools.items()):
        res = results.get(slug)
        if res is None:
            continue  # not in the last health run; actor-health's own report covers that
        got = res.get("items") or 0
        cap = requested_cap(slug, tool)
        ratio = got / cap
        reasons = []
        if ratio < RATIO_FLOOR:
            reasons.append(f"ratio {ratio:.2f} ({got}/{cap} rows) below {RATIO_FLOOR}")
        peak = best.get(slug, 0)
        # Only meaningful when the Actor FAILED to fill its current cap. If got == cap it
        # delivered everything asked for, so a lower absolute count than some historical
        # peak is a deliberate cap change by an earlier cycle, not a degradation.
        if got < cap and peak - got >= DECLINE_MIN:
            reasons.append(f"declined from own best {peak} rows to {got}")
        # Cycle 1813 (queue item (q)): actor-health now records fail_rows, an additive
        # count of rows that are themselves pushData({success: false, ...}) error rows
        # (e.g. website-screenshot-scraper's per-URL failure path). Those rows satisfy
        # both signals above (ratio can read 1.00, decline can read 0) while the capture
        # itself failed -- the "a QUANTITY test is blind to row-level SUCCESS" blind spot
        # cycle 1812 found. health.json runs before this field existed have no key, so
        # .get(...,0) is 0 and this adds no flags until the next nightly run repopulates it.
        fail_rows = res.get("fail_rows") or 0
        if fail_rows:
            reasons.append(f"{fail_rows} of {got} rows are failed captures (success: false)")
        if not reasons:
            continue
        if slug in ALLOW:
            print(f"  allow {slug}: {'; '.join(reasons)} -- {ALLOW[slug]}")
            continue
        findings.append({"slug": slug, "items": got, "cap": cap,
                         "ratio": round(ratio, 2), "history_max": peak,
                         "reasons": reasons})

    ts = health.get("ts")
    if do_recheck and findings:
        if not as_json:
            print(f"rechecking {len(findings)} flagged Actor(s) live "
                  f"(snapshot is {age_str(ts)}) -- one capped Apify run each\n")
        for f in findings:
            fresh = recheck(f["slug"])
            if fresh is None:
                f["recheck"] = "UNKNOWN"
                continue
            got = fresh.get("items") or 0
            bad = fresh.get("fail_rows") or 0
            f["recheck_items"] = got
            f["recheck_fail_rows"] = bad
            # Same two row-level conditions as the snapshot pass, re-applied to the fresh
            # run. The DECLINE signal is deliberately NOT re-applied: it compares against a
            # historical peak, and one hand-triggered run is not a new history entry.
            f["recheck"] = "CLEARED" if (got / f["cap"] >= RATIO_FLOOR and not bad) else "CONFIRMED"

    if as_json:
        print(json.dumps({"ts": ts, "findings": findings}, indent=1))
    else:
        print(f"check-row-floor: {len(tools)} live Actors, health ts={ts} ({age_str(ts)}), "
              f"history={'on' if use_history else 'off'}")
        for f in findings:
            tail = ""
            if "recheck" in f:
                tail = f"  [recheck: {f['recheck']}"
                if f["recheck"] != "UNKNOWN":
                    tail += f", {f['recheck_items']}/{f['cap']} rows now"
                tail += "]"
            print(f"FLAG {f['slug']}: {'; '.join(f['reasons'])}{tail}")
        if not findings:
            print("CLEAN -- every live Actor returned >=60% of its requested cap "
                  "and none declined from its own observed best.")
        else:
            print("\nA flag is most likely a WEAK TEST INPUT, not an outage. Broaden one "
                  "filter at a time with bin/varied-test before editing Actor code.")
            if not do_recheck:
                print(f"The snapshot above is {age_str(ts)} -- re-run with --recheck to see "
                      "whether these flags survive a fresh run before diagnosing anything.")

    live = [f for f in findings if f.get("recheck") != "CLEARED"]
    return 1 if live else 0


if __name__ == "__main__":
    sys.exit(main())
