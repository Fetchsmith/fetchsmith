#!/root/agent/venv/bin/python
"""check-field-fill (added cycle 486)

Follow-up to h105 (cycle 485): check-real-fields only catches undeclared keys,
never "declared field is present but null/empty on almost every row" -- the
exact shape that hid eu-ted-tenders-scraper's deadlineDate bug (95% null,
invisible to every existing check since none of them read fill rate). This
script reuses check-real-fields' recent-SUCCEEDED-runs data (no new runs, no
cost) and reports, per Actor, the fraction of rows where each declared field
is null/missing/empty-string.

This is a SIGNAL tool, not a pass/fail gate: many low-fill fields are
legitimately conditional (mode-gated, or genuinely sparse upstream data, like
award-notice tenders having no deadline). Read the flagged list and judge each
one -- do not treat every low-fill field as a bug.

Usage: bin/check-field-fill [--threshold 0.3] [--min-items 5]
"""
import json
import sys

import httpx

env = dict(
    l.rstrip("\n").split("=", 1)
    for l in open("/root/agent/secrets/env")
    if "=" in l and not l.startswith("#")
)
T = env["APIFY_TOKEN"]
API = "https://api.apify.com/v2"
H = {"Authorization": f"Bearer {T}"}
N_RUNS = 3


def arg(flag, default, cast):
    if flag in sys.argv:
        return cast(sys.argv[sys.argv.index(flag) + 1])
    return default


THRESHOLD = arg("--threshold", 0.3, float)  # flag fields filled on <30% of rows
MIN_ITEMS = arg("--min-items", 5, int)  # need at least this many rows to judge

user = httpx.get(f"{API}/users/me", headers=H, timeout=30).json()["data"]["username"]
reg = json.load(open("/root/agent/actors/registry.json")).get("tools", [])


def declared_fields(slug):
    p = f"/root/agent/actors/{slug}/.actor/dataset_schema.json"
    try:
        return set(json.load(open(p)).get("fields", {}).get("properties", {}))
    except FileNotFoundError:
        return None


def recent_succeeded_runs(slug, n):
    r = httpx.get(
        f"{API}/acts/{user}~{slug}/runs",
        headers=H,
        params={"desc": "true", "limit": 20, "status": "SUCCEEDED"},
        timeout=30,
    )
    if r.status_code != 200:
        return []
    return [d["id"] for d in r.json()["data"]["items"][:n]]


def dataset_items(run_id):
    d = httpx.get(f"{API}/actor-runs/{run_id}", headers=H, timeout=30).json()["data"]
    ds_id = d.get("defaultDatasetId")
    if not ds_id:
        return []
    return httpx.get(
        f"{API}/datasets/{ds_id}/items", headers=H, params={"limit": 20}, timeout=30
    ).json()


def is_empty(v):
    return v is None or v == "" or v == [] or v == {}


def main():
    flagged = 0
    checked = 0
    for t in reg:
        slug = t["slug"]
        if t.get("status") not in ("live", "beta"):
            continue
        declared = declared_fields(slug)
        if not declared:
            continue
        run_ids = recent_succeeded_runs(slug, N_RUNS)
        items = []
        for rid in run_ids:
            items.extend(x for x in dataset_items(rid) if isinstance(x, dict))
        if len(items) < MIN_ITEMS:
            print(f"SKIP {slug}: only {len(items)} real row(s), too few to judge")
            continue
        checked += 1
        n = len(items)
        for field in sorted(declared):
            filled = sum(1 for it in items if not is_empty(it.get(field)))
            rate = filled / n
            if rate < THRESHOLD:
                flagged += 1
                print(
                    f"LOW-FILL {slug}: '{field}' filled {filled}/{n} rows "
                    f"({rate:.0%}) across {len(run_ids)} run(s)"
                )
    print(f"check-field-fill: {checked} actors checked, {flagged} low-fill fields flagged (threshold {THRESHOLD:.0%})")
    return 0


if __name__ == "__main__":
    sys.exit(main())
