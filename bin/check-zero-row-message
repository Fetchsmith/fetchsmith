#!/usr/bin/env python3
"""Static tripwire for the zero-row-reaches-no-statusMessage bug class closed fleet-wide
across cycles 1752-1757 (trademark-search, court-records, uk-find-a-tender, eu-ted-tenders,
sec-insider-trades, sam-gov-opportunities): a run can finish SUCCEEDED with `pushed === 0`
along some reachable branch, but that branch only logs the cause (`log.warning`) instead of
also calling `Actor.setStatusMessage`, so the Console shows a green run beside an empty
dataset with no explanation and no bill to ask about.

Built cycle 1758 as the follow-up noted at 1756/1757: with the fleet-wide hand audit done,
nothing stops a FUTURE Actor (or a future edit to an audited one) from reintroducing the same
gap. This is the static check, registered in state/fleet_checks.json like the other no-
argument fleet sweeps (check-cascade-causes, check-filter-reach).

Method, per live Actor's src/main.js (skipped if it never calls `Actor.pushData`, i.e. not a
dataset Actor):

  1. Find every `pushed === 0` / `pushed < 1` / `!pushed` test used as an `if`/`else if`
     condition (balanced-paren walk, same style as check-cascade-causes).
  2. Take that branch's balanced-brace body.
  3. PASS the branch if its body either calls `Actor.setStatusMessage` directly, or assigns a
     "message-like" variable (identifier ending in `Msg` or `Message`) that is ALSO passed to
     `Actor.setStatusMessage` somewhere else in the file (the `statusMsg`/`zeroRowMessage`-
     variable-plus-later-call shape every 1752-1757 fix used). A bare `throw`/`return` with no
     message-like assignment does not count -- it is reporting, at most, to the log/caller, not
     to the buyer's Console.
  4. Otherwise the branch is a MISS: a reachable zero-row cause with nothing wired to
     `setStatusMessage`.

Known blind spots, do not read a clean run as proof the class is fully closed: (1) this does
not trace real control flow, so a message-like variable declared ANYWHERE in the file counts
as reaching ANY branch that assigns it, even across unrelated functions -- a false PASS is
possible if the same variable name is reused for an unrelated purpose; (2) a zero-row branch
expressed as a flag test rather than literally `pushed`-something (e.g. `rows.length === 0`)
is invisible to this pass, same class of gap check-cascade-causes documents for its own
`.length` requirement; (3) only catches the "no message at all" shape, not a wrong-cause
message (that needs the live-reproduce-before-editing method, not a grep).

Exit 1 if any MISS found. Usage: check-zero-row-message [slug ...]
"""
import json
import os
import re
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
ACTORS = os.path.join(ROOT, "actors")

ZERO_TEST = re.compile(r"\bpushed\s*===\s*0\b|\bpushed\s*<\s*1\b|!pushed\b(?!\.\w)")
MESSAGE_VAR = re.compile(r"\b([A-Za-z_$][\w$]*(?:Msg|Message))\b")


def balanced(src, i, open_ch="{", close_ch="}"):
    depth = 0
    for j in range(i, len(src)):
        if src[j] == open_ch:
            depth += 1
        elif src[j] == close_ch:
            depth -= 1
            if depth == 0:
                return src[i + 1:j], j
    return None, None


def zero_branches(src):
    """(cond, body, cond_start) for every if/else-if whose condition tests pushed==0."""
    out = []
    for m in re.finditer(r"\bif\s*\(", src):
        open_paren = m.end() - 1
        cond, close = balanced(src, open_paren, "(", ")")
        if cond is None or not ZERO_TEST.search(cond):
            continue
        rest = src[close + 1:]
        stripped = rest.lstrip()
        if not stripped.startswith("{"):
            continue  # bare single-statement arm, no block to inspect -- skip rather than guess
        lead = len(rest) - len(stripped)
        body, _ = balanced(src, close + 1 + lead, "{", "}")
        if body is not None:
            out.append((cond, body, m.start()))
    return out


def status_message_args(src):
    """Argument text of every `Actor.setStatusMessage(...)` call in the file."""
    args = []
    for m in re.finditer(r"setStatusMessage\s*\(", src):
        arg, _ = balanced(src, m.end() - 1, "(", ")")
        if arg is not None:
            args.append(arg)
    return args


def branch_passes(body, call_args):
    if "setStatusMessage" in body or "Actor.fail(" in body:
        # Actor.fail() ends the run FAILED with its own message, not the SUCCEEDED-silently
        # bug class this check targets -- a branch that fails out has already told the buyer.
        return True
    assigned = set(re.findall(r"\b([A-Za-z_$][\w$]*(?:Msg|Message))\s*=(?!=)", body))
    for name in assigned:
        word = re.compile(r"\b" + re.escape(name) + r"\b")
        if any(word.search(arg) for arg in call_args):
            return True
    return False


def main():
    registry = json.load(open(os.path.join(ACTORS, "registry.json")))
    live = sorted(t["slug"] for t in registry["tools"] if t["status"] == "live")
    args = sys.argv[1:]
    if args:
        live = [s for s in live if s in args]

    misses = []
    actors_checked = branches_checked = 0

    for slug in live:
        main_js = os.path.join(ACTORS, slug, "src/main.js")
        if not os.path.exists(main_js):
            continue
        src = open(main_js).read()
        if "Actor.pushData" not in src:
            continue
        actors_checked += 1
        call_args = status_message_args(src)
        branches = zero_branches(src)
        branches_checked += len(branches)
        if not branches:
            continue
        # Per-ACTOR, not per-branch: the fleet bug class is "NOTHING in this file reaches a
        # message on a zero-row path" -- a narrower diagnostic sub-branch (e.g. one more specific
        # condition nested inside a broader `!pushed` block that already sets a message a few
        # lines later) is not itself required to repeat the message, so flagging every branch
        # independently over-reports (confirmed cycle 1758 on sec-insider-trades-scraper's
        # already-fixed `!pushed && dropped && !derivativeCodesBlocked` detail log).
        if not any(branch_passes(body, call_args) for _, body, _ in branches):
            cond, _, pos = branches[0]
            line = src.count("\n", 0, pos) + 1
            misses.append((slug, line, cond.strip()))

    for slug, line, cond in misses:
        print(f"MISS? {slug}:{line} branch on `{cond}` has no reachable Actor.setStatusMessage "
              f"-- confirm live (every filter valid, this branch's cause forced, run finishes "
              f"SUCCEEDED) before fixing, same method as cycles 1752-1757")

    print(f"check-zero-row-message: {actors_checked} dataset Actor(s) checked "
          f"({branches_checked} pushed===0 branch(es) scanned), {len(misses)} MISS?")
    return 1 if misses else 0


if __name__ == "__main__":
    sys.exit(main())
