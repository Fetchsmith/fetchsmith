def search(query, hits=1000):
    url = f"https://{APP}-dsn.algolia.net/1/indexes/{IDX}/query"
    params = f"query={urllib.parse.quote(query)}&hitsPerPage={hits}"
    req = urllib.request.Request(
        url,
        data=json.dumps({"params": params}).encode(),
        headers={
            "X-Algolia-API-Key": KEY,
            "X-Algolia-Application-Id": APP,
            "Content-Type": "application/json",
        },
    )
    return json.load(urllib.request.urlopen(req, timeout=30))


def rank_of(slug, term):
    r = search(term)
    for i, h in enumerate(r["hits"], 1):
        if h.get("username") == "fetchsmith" and h.get("name") == slug:
            return i, r["nbHits"], h.get("storePosition")
    return None, r["nbHits"], None


def leaderboard(query):
    r = search(query, hits=60)
    print(f"{'#':>3}  {'actor':44} {'storePos':>9} {'users':>6} {'runs':>7}")
    for i, h in enumerate(r["hits"], 1):
        if i <= 15 or h.get("username") == "fetchsmith":
            s = h.get("stats") or {}
            name = f"{h.get('username','')}/{h.get('name','')}"[:44]
            print(
                f"{i:>3}  {name:44} {str(h.get('storePosition')):>9} "
                f"{s.get('totalUsers',0):>6} {s.get('totalRuns',0):>7}"
            )
    print(f"\nnbHits={r['nbHits']} for {query!r}")


def meta(slug):
    """Print what the Algolia index actually has for a slug's title/description
    (cycle 201: found a title PUT still unindexed 24+ min later, while an earlier
    seoTitle/seoDescription change on the same record HAD been picked up — title
    and seo* fields reindex independently and lag is not on a fixed short clock).
    Compare this against `curl .../v2/acts/fetchsmith~<slug>` before trusting any
    rank number as evidence a metadata change moved anything.
    """
    terms = TERMS.get(slug)
    if not terms:
        print(f"unknown slug: {slug}", file=sys.stderr)
        return 2
    r = search(terms[0])
    for h in r["hits"]:
        if h.get("username") == "fetchsmith" and h.get("name") == slug:
            print(f"indexed title      : {h.get('title')}")
            print(f"indexed description: {h.get('description')}")
            print(f"indexed seoTitle   : {h.get('seoTitle')}")
            print(f"indexed modifiedAt : {h.get('modifiedAt')}  (Algolia's own last-index unix ts)")
            return 0
    print(f"{slug}: not found via {terms[0]!r}", file=sys.stderr)
    return 1


def attr(query, slug):
    """Size the payoff of putting `query`'s head-word into <slug>'s title.

    Algolia applies its `attribute` criterion before `storePosition`, so every record
    matching the query in its TITLE outranks every record matching only in the
    description, regardless of storePosition (cycle 520 — see module docstring).
    This prints the title-match block, where we currently sit, and what rank we would
    land at if the title were edited to match: one past every title-matcher whose
    storePosition already beats ours.

    CAVEAT (cycle 522) + CORRECTED cycle 523: cycle 522 checked Algolia's own
    `_highlightResult.matchLevel` on OUR hit to catch cases where this function's
    naive word-prefix check disagrees with real Algolia matching, and concluded
    "clinicaltrials.gov" was a false positive because our hit showed matchLevel
    "none". Cycle 523 tried the same check on "recruitee" and "tmview" — both
    CONFIRMED real wins from cycles 520/522 — and got `matchLevel: "none"` on those
    too, which would wrongly invalidate confirmed-good edits. Investigating the
    contradiction found the real mechanism: **Algolia only computes real
    `_highlightResult` data for the first 5 hits of a query's response, full stop**
    — verified by re-requesting the same query at hitsPerPage 3/20/100 and seeing
    positions 1-6 apparently real (full/partial/none per genuine content) and position
    7+ always hard-coded "none", even for a hit whose title is byte-identical to a
    position-3 hit that DOES show "full". **CORRECTED cycle 535**: a closer check
    (hitsPerPage 5/6/7 on "who's hiring") found position 6 is ALSO hard-coded "none",
    even for a title textually identical in pattern to position 2's genuine "full"
    match — the real reliable window is positions **1-5**, not 1-6. So **checking OUR
    OWN hit's matchLevel is useless whenever we rank below position 5** (always true
    pre-edit — that's exactly the case this function exists to evaluate). A "none" there proves
    nothing either way; cycle 522's specific verdict on "clinicaltrials.gov" was
    reached this same unreliable way and should be treated as UNRESOLVED, not
    confirmed-fake (re-checking cycle 523: other developers' clinicaltrials-scraper
    records DO score real matchLevel "full" at position 1 for that query — a genuine
    title-match block exists — but our own record, whose title also literally
    contains "ClinicalTrials.gov", inexplicably sits at p61 rather than inside that
    top cluster. **RESOLVED cycle 552 — there was never an anomaly.** Dumping the whole
    364-hit leaderboard showed ranks 1..60 are ALL genuine title-matchers and their
    `storePosition` rises monotonically 7335 -> 54023 against our 54494: p61 is exactly
    where the storePosition tiebreaker puts us INSIDE the block, not outside it. The
    block is just 81 records deep because the niche is saturated. The lesson that
    generalizes: when `--attr` reports "already in the title block, span 0" and the rank
    still looks bad, that is not a bug to investigate — it is storePosition, and the only
    fix is real cumulative usage. Verify by printing the block's storePosition sequence.)

    CAVEAT 2 (cycle 524) — **PROXIMITY, and it dominates everything below it.**
    Joining the title-match block is necessary but NOT sufficient: Algolia's
    `proximity` criterion (how many words apart the query's tokens sit in the title,
    in query order) is applied BEFORE `storePosition`, so the prediction printed
    below only holds if the edited title puts the query's tokens ADJACENT and IN
    QUERY ORDER. Measured directly on `google-news-scraper` (one Actor, one index,
    same storePosition 53755, only the word order changed between two real publishes):
        title "Google News Scraper - RSS & API, ..."   -> 'google news rss' p4,   'google news api' p255
        title "Google News API Scraper - RSS, ..."     -> 'google news api' p6,   'google news rss' p128
    A token three words downstream instead of one costs ~250 ranks — far more than
    the whole storePosition spread this function models. Both queries were in-title
    in both titles, so `query in our title: True` alone means nothing.
    Practical rules: (a) one title can realistically win ONE multi-word query — pick
    it; (b) write the query as a literal contiguous phrase in the title ("Steam API
    Scraper", "Hacker News (HN) API Scraper" — both measured p2) rather than
    scattering its words; (c) every confirmed win this method has produced
    (`recruitee`, `tmview`, `super pac`, `nice classification`, `hn api`, `steam api`)
    was an exact contiguous phrase, which is why the naive model looked accurate
    until a non-contiguous edit was tried.

    **Correct verification: check the matchLevel of the TOP-RANKED member of the
    title-match block instead of our own hit** — the top block member sits at or
    near position 1, safely inside the reliable window. If real Algolia agrees that
    record is a genuine title match, the block concept holds for this query and the
    naive word-prefix heuristic can be trusted enough to size the opportunity; if
    Algolia says "none" even for the block's nominal #1, don't trust the block at
    all. This function checks that automatically below and prints the verdict.
    """
    r = search(query)
    hits = r["hits"]
    # Algolia matches per WORD (with a prefix match on the last one), not as a literal
    # substring, so "docket scraper" title-matches a title reading "... Dockets +
    # Opinions ... Scraper". Treat a record as a title-matcher when every query token
    # prefixes some word of its title.
    #
    # Query tokens must be normalized the SAME way title words are (strip punctuation,
    # not just whitespace) or a query containing punctuation can never match a title
    # that legitimately contains it -- title words already go through this via
    # token_span/title_match's `"".join(c if isalnum else " ")`, but a plain
    # `.split()` on the query left literal punctuation in place. Cycle 535 hit this
    # for apostrophes ("who's hiring" vs. title word "who") and worked around it by
    # picking an apostrophe-free phrase rather than fixing the root cause. Cycle 541
    # hit the identical bug for periods: `sam.gov scraper` against
    # sam-gov-opportunities-scraper showed a false "0 title-matchers" block, but the
    # real Algolia data (raw `_highlightResult`) confirmed a genuine, verified block
    # (scrapesage/sam-gov-scraper's "SAM.gov Scraper ..." scores real matchLevel
    # "full"). Fixed at the source this time: normalize the query the same way.
    tokens = "".join(c if c.isalnum() else " " for c in query.lower()).split()

    def token_span(title, toks):
        """Extra words between the query's tokens in `title`, matched in query order.

        0 == contiguous phrase (what Algolia's proximity criterion rewards). None ==
        the tokens do not appear in query order at all (worst case for proximity).
        """
        words = "".join(c if c.isalnum() else " " for c in title.lower()).split()
        best = None
        # A token can occur more than once ("Steam Reviews Scraper - Steam API..."),
        # and Algolia scores the tightest occurrence, so try every start position for
        # the first token and keep the minimum span, not the first match found.
        for first in (i for i, w in enumerate(words) if w.startswith(toks[0])):
            idxs = [first]
            for t in toks[1:]:
                hit = next((i for i in range(idxs[-1] + 1, len(words)) if words[i].startswith(t)), None)
                if hit is None:
                    idxs = None
                    break
                idxs.append(hit)
            if idxs:
                span = (idxs[-1] - idxs[0]) - (len(toks) - 1)
                best = span if best is None else min(best, span)
        return best

    def title_match(h):
        words = "".join(c if c.isalnum() else " " for c in (h.get("title") or "").lower()).split()
        return all(any(w.startswith(t) for w in words) for t in tokens)

    ours = next(
        (
            (i, h)
            for i, h in enumerate(hits, 1)
            if h.get("username") == "fetchsmith" and h.get("name") == slug
        ),
        None,
    )
    if not ours:
        print(f"{slug}: not in the first {len(hits)} hits for {query!r} (nbHits={r['nbHits']})")
        print("  -> not a title-match question; we do not match this query at all.")
        return 1
    pos, rec = ours
    sp = rec.get("storePosition")
    titled = [h for h in hits if title_match(h)]
    ranks = [i for i, h in enumerate(hits, 1) if title_match(h)]
    ahead = [h for h in titled if (h.get("storePosition") or 10**9) < (sp or 10**9)]
    in_title = title_match(rec)
    print(f"query {query!r}  nbHits={r['nbHits']}")
    print(f"  {slug}: rank p{pos}, storePosition {sp}, query in our title: {in_title}")
    print(f"  title-match block: {len(titled)} records at ranks {ranks[:3]}..{ranks[-3:] if ranks else []}")
    if titled:
        top_rank = ranks[0]
        top_hit = titled[0]
        top_hl = top_hit.get("_highlightResult", {}).get("title", {})
        top_ml = top_hl.get("matchLevel")
        if top_rank > 5:
            print(
                f"  cannot verify block: top member is at p{top_rank}, past Algolia's real-highlight "
                "cutoff (positions 1-5 only, see docstring — corrected cycle 535) — matchLevel there is "
                "meaningless. Do not trust this block without independently confirming a real match some "
                "other way."
            )
        elif top_ml in ("full", "partial"):
            print(f"  verified: block's #1 (p{top_rank}) has real Algolia matchLevel {top_ml!r} — block is genuine.")
        else:
            print(
                f"  -> WARNING: block's own #1 (p{top_rank}) has real Algolia matchLevel {top_ml!r}, not "
                "full/partial — this naive word-prefix block does NOT correspond to a genuine Algolia title "
                "match for this query. DO NOT publish a title edit off this prediction."
            )
    if in_title:
        span = token_span(rec.get("title") or "", tokens)
        print(f"  -> already in the title block; our title's token span for this query: {span}")
        if span is not None and span > 0 and pos > 20:
            print(
                "  -> LIKELY PROXIMITY DEMOTION (cycle 524): the tokens are in the title but not "
                f"contiguous ({span} extra word(s) between them). Rewriting the title so the query "
                "reads as a literal adjacent phrase is worth ~hundreds of ranks — but it will cost "
                "you whichever other query currently sits closer together. See docstring CAVEAT 2."
            )
            if len(titled) == 1:
                print(
                    "  -> *** HIGHEST-VALUE SHAPE (cycle 548): we are the ONLY title-matcher on this "
                    "query, so nothing outranks us on the `attribute` criterion — the whole gap is "
                    "proximity. Measured instance: 'podcast publisher(s)' (nbHits 714/611), sole "
                    "title-matcher, span 4 -> p31; span 0 -> **p1**. Prefer this shape over a bigger "
                    "predicted jump into a CROWDED block, where storePosition still caps you."
                )
        else:
            print("  -> only storePosition (real usage) can move us further on this query.")
    else:
        print(f"  -> {len(ahead)} title-matchers have a better storePosition than us")
        print(f"  -> predicted rank if we join the title block: ~p{len(ahead) + 1} (from p{pos})")
        print(
            "  -> VALID ONLY IF the new title spells this query as a contiguous, in-order phrase "
            "(cycle 524 proximity finding — see docstring CAVEAT 2). A scattered match ranks far worse."
        )
    return 0


def prev_snapshot():
    """Rows of the most recent full-fleet snapshot, keyed (slug, query)."""
    if not os.path.exists(HIST):
        return {}
    try:
        hist = json.load(open(HIST))
    except (ValueError, OSError):
        return {}
    if not hist:
        return {}
    return {(r["slug"], r["query"]): r for r in hist[-1]["rows"]}


def save_snapshot(rows):
    hist = []
    if os.path.exists(HIST):
        try:
            hist = json.load(open(HIST))
        except (ValueError, OSError):
            hist = []
    hist.append({"ts": int(time.time()), "date": time.strftime("%Y-%m-%d"), "rows": rows})
    json.dump(hist[-HIST_KEEP:], open(HIST, "w"), indent=1)


def drift(old, pos, sp):
    """One compact cell: rank change then storePosition change vs the last full run.

    Both are 'lower is better', so an improvement is printed with a minus sign and
    the word better/worse is spelled out — cycle 453's noise-floor check means a
    1-2 place rank wiggle is not signal, but a storePosition move is Apify's own
    batch rescoring and is the number actually worth watching.
    """
    if not old:
        return "new"
    out = []
    if old.get("rank") != pos:
        a, b = old.get("rank"), pos
        out.append(f"rank {'p'+str(a) if a else '>1000'}->{'p'+str(b) if b else '>1000'}")
    if sp is not None and old.get("storePosition") is not None and old["storePosition"] != sp:
        d = sp - old["storePosition"]
        out.append(f"storePos {d:+d} ({'better' if d < 0 else 'worse'})")
    return ", ".join(out) if out else "="


def main():
    args = sys.argv[1:]
    if args and args[0] == "--attr":
        if len(args) < 3:
            print('usage: store-rank --attr "<query>" <slug>', file=sys.stderr)
            return 2
        return attr(args[1], args[2])
    if args and args[0] == "--query":
        leaderboard(" ".join(args[1:]))
        return 0
    if args and args[0] == "--meta":
        return meta(args[1]) if len(args) > 1 else (print("usage: store-rank --meta <slug>", file=sys.stderr) or 2)

    targets = {k: v for k, v in TERMS.items() if not args or k in args}
    if not targets:
        print(f"unknown slug: {args[0]}", file=sys.stderr)
        return 2
    only = bool(args)

    prev = prev_snapshot() if not only else {}
    top20 = 0
    total = 0
    rows = []
    print(f"{'actor':32} {'query':24} {'nbHits':>7} {'rank':>14} {'storePos':>9}  drift")
    for slug, terms in sorted(targets.items()):
        for term in (terms if only else terms[:1]):
            pos, nb, sp = rank_of(slug, term)
            total += 1
            if pos and pos <= 20:
                top20 += 1
            shown = f"p{pos}" if pos else ">1000"
            rows.append({"slug": slug, "query": term, "rank": pos, "nbHits": nb, "storePosition": sp})
            # A slug-filtered run probes every term, not just the primary one, so its
            # shape does not line up with the stored full-fleet snapshot — print "-"
            # rather than a misleading "new" on rows we simply did not compare.
            cell = "-" if only else drift(prev.get((slug, term)), pos, sp)
            print(f"{slug:32} {term!r:24} {nb:>7} {shown:>14} {str(sp):>9}  {cell}")
    if not only:
        save_snapshot(rows)
    print(
        f"\nIndexed and retrievable in the real store search: yes (that is the point).\n"
        f"Top-20 on {top20}/{total} probed queries. Within a match group rank is driven\n"
        f"by `storePosition` (Apify-computed, ascending, not settable) — but a TITLE\n"
        f"match outranks a description-only match first (cycle 520). For a query we\n"
        f"place badly on, run `store-rank --attr \"<query>\" <slug>` before concluding\n"
        f"nothing can be done: it says whether we are outside the title block and what\n"
        f"rank joining it would actually buy."
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
