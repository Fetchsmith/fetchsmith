#!/usr/bin/env python3
"""store-rank — measure where our Actors ACTUALLY rank in apify.com/store search.

Why this exists (cycle 168): `bin/store-visibility` probes the /v2/store REST API,
which is NOT the surface a real visitor uses. The apify.com/store search box is
powered by a public Algolia index. Querying that index anonymously (same call the
browser makes; credentials are embedded in Apify's own client JS bundle and are
search-only) shows all 21 of our Actors ARE indexed and retrievable (re-verified
fleet-wide cycle 520: 21/21 present).

So we were never excluded. The problem is RANK, not visibility.

Ranking mechanics:
  - `storePosition` (ascending, lower=better) is the final tiebreaker. It is
    Apify-computed and tracks cumulative users/runs/reviews/age. We cannot set it.
    A brand-new Actor carries the sentinel 999999 on both `storePosition` and
    `experimentalStorePosition` until Apify's batch job first scores it (cycle 520:
    `trademark-search-scraper`, published the same day, was 999999 while every other
    Actor including one published 2 days earlier had a real value). Do not read
    999999 as a penalty; re-measure after ~48h before concluding anything.
  - CORRECTION (cycle 520) to the cycle-168 claim that "text relevance is maxed;
    rewriting titles/descriptions cannot move us": that held only WITHIN one match
    group. Algolia's `attribute` criterion ranks a title match strictly above a
    description-only match, and it is applied BEFORE storePosition. Measured on
    `courtlistener`: our record (storePosition 52702, "CourtListener" in the
    description only) sits at p67, while ranks 1..47 are exactly the 47 records with
    "courtlistener" in their TITLE, sorted among themselves by storePosition. Same
    record, same storePosition, query `docket scraper` (the word IS in our title):
    p6, ahead of competitors with far better storePosition. So title wording IS a
    real lever — bounded, but real. Use `--attr` below to size the gain before editing
    a title: joining a title-match block lands you after every title-matcher with a
    better storePosition, not at the top of it.
Conclusion: rank improves from (a) real cumulative usage, (b) targeting low-nbHits
long-tail queries where we already land in the top 20, and (c) getting the query's
exact head-word into the TITLE for queries worth winning.

Usage:
  bin/store-rank              # all registry Actors on their primary query
  bin/store-rank <slug>       # one Actor, all its terms
  bin/store-rank --query "fda recall"   # leaderboard for an arbitrary query
  bin/store-rank --attr "courtlistener" <slug>   # title-match block analysis +
                                                 # predicted rank if <slug> joined it
Exit 0 always (informational); prints a summary line.
"""
import json
import sys
import urllib.parse
import urllib.request

APP = "OW0O5I3QO7"
KEY = "0ecccd09f50396a4dbbe5dbfb17f4525"
IDX = "prod_PUBLIC_STORE"

# Primary store-search phrasings per Actor. First term is the primary one.
TERMS = {
    "scholarship-scraper": ["scholarship", "scholarships"],
    "fda-recall-scraper": ["fda recall", "food recall", "drug recall"],
    "eu-ted-tenders-scraper": ["ted tenders", "eu tenders", "public procurement"],
    "nih-reporter-scraper": ["nih reporter", "nih grants"],
    "federal-register-scraper": ["federal register"],
    "grants-gov-scraper": ["grants.gov", "government grants"],
    "clinicaltrials-scraper": ["clinical trials", "clinicaltrials.gov"],
    "us-federal-awards-scraper": ["usaspending", "federal contracts"],
    "uk-find-a-tender-scraper": ["find a tender", "uk tenders"],
    "substack-scraper": ["substack"],
    "apple-podcasts-scraper": ["apple podcasts"],
    "steam-reviews-scraper": ["steam reviews"],
    "hacker-news-scraper": ["hacker news"],
    "google-news-scraper": ["google news"],
    "app-store-reviews-scraper": ["app store reviews"],
    "google-play-reviews-scraper": ["google play reviews"],
    "shopify-products-scraper": ["shopify products"],
    # cycle 200: chosen by measured winnability, not by guessing. "recruitee"
    # and "smartrecruiters" are thin fields where we already place; "greenhouse"
    # and "lever" are broad/crowded and we sit past rank 350 there regardless.
    "ats-jobs-scraper": ["recruitee", "smartrecruiters", "ats jobs scraper", "workable jobs"],
    # cycle 520: these 3 were published after cycle 200 and were never added here, so
    # their buyer-facing rank had never once been measured. Terms picked the cycle-200
    # way — by measuring ~11 candidates each and keeping the ones where we actually
    # place, not by guessing. Measured ranks at time of adding, for drift comparison:
    "fec-campaign-finance-scraper": ["super pac", "fec api", "fec filings", "campaign finance"],  # p5 p6 p12 p19
    "court-records-scraper": ["docket scraper", "federal dockets", "case law", "court records"],  # p6 p16 p18 p20
    "trademark-search-scraper": ["tmview", "euipo", "nice classification", "wipo"],  # p5 p12 p18 p20
}


def search(query, hits=1000):
    url = f"https://{APP}-dsn.algolia.net/1/indexes/{IDX}/query"
    params = f"query={urllib.parse.quote(query)}&hitsPerPage={hits}"
    req = urllib.request.Request(
        url,
        data=json.dumps({"params": params}).encode(),
        headers={
            "X-Algolia-API-Key": KEY,
            "X-Algolia-Application-Id": APP,
            "Content-Type": "application/json",
        },
    )
    return json.load(urllib.request.urlopen(req, timeout=30))


def rank_of(slug, term):
    r = search(term)
    for i, h in enumerate(r["hits"], 1):
        if h.get("username") == "fetchsmith" and h.get("name") == slug:
            return i, r["nbHits"], h.get("storePosition")
    return None, r["nbHits"], None


def leaderboard(query):
    r = search(query, hits=60)
    print(f"{'#':>3}  {'actor':44} {'storePos':>9} {'users':>6} {'runs':>7}")
    for i, h in enumerate(r["hits"], 1):
        if i <= 15 or h.get("username") == "fetchsmith":
            s = h.get("stats") or {}
            name = f"{h.get('username','')}/{h.get('name','')}"[:44]
            print(
                f"{i:>3}  {name:44} {str(h.get('storePosition')):>9} "
                f"{s.get('totalUsers',0):>6} {s.get('totalRuns',0):>7}"
            )
    print(f"\nnbHits={r['nbHits']} for {query!r}")


def meta(slug):
    """Print what the Algolia index actually has for a slug's title/description
    (cycle 201: found a title PUT still unindexed 24+ min later, while an earlier
    seoTitle/seoDescription change on the same record HAD been picked up — title
    and seo* fields reindex independently and lag is not on a fixed short clock).
    Compare this against `curl .../v2/acts/fetchsmith~<slug>` before trusting any
    rank number as evidence a metadata change moved anything.
    """
    terms = TERMS.get(slug)
    if not terms:
        print(f"unknown slug: {slug}", file=sys.stderr)
        return 2
    r = search(terms[0])
    for h in r["hits"]:
        if h.get("username") == "fetchsmith" and h.get("name") == slug:
            print(f"indexed title      : {h.get('title')}")
            print(f"indexed description: {h.get('description')}")
            print(f"indexed seoTitle   : {h.get('seoTitle')}")
            print(f"indexed modifiedAt : {h.get('modifiedAt')}  (Algolia's own last-index unix ts)")
            return 0
    print(f"{slug}: not found via {terms[0]!r}", file=sys.stderr)
    return 1


def attr(query, slug):
    """Size the payoff of putting `query`'s head-word into <slug>'s title.

    Algolia applies its `attribute` criterion before `storePosition`, so every record
    matching the query in its TITLE outranks every record matching only in the
    description, regardless of storePosition (cycle 520 — see module docstring).
    This prints the title-match block, where we currently sit, and what rank we would
    land at if the title were edited to match: one past every title-matcher whose
    storePosition already beats ours.
    """
    r = search(query)
    hits = r["hits"]
    # Algolia matches per WORD (with a prefix match on the last one), not as a literal
    # substring, so "docket scraper" title-matches a title reading "... Dockets +
    # Opinions ... Scraper". Treat a record as a title-matcher when every query token
    # prefixes some word of its title.
    tokens = query.lower().split()

    def title_match(h):
        words = "".join(c if c.isalnum() else " " for c in (h.get("title") or "").lower()).split()
        return all(any(w.startswith(t) for w in words) for t in tokens)

    ours = next(
        (
            (i, h)
            for i, h in enumerate(hits, 1)
            if h.get("username") == "fetchsmith" and h.get("name") == slug
        ),
        None,
    )
    if not ours:
        print(f"{slug}: not in the first {len(hits)} hits for {query!r} (nbHits={r['nbHits']})")
        print("  -> not a title-match question; we do not match this query at all.")
        return 1
    pos, rec = ours
    sp = rec.get("storePosition")
    titled = [h for h in hits if title_match(h)]
    ranks = [i for i, h in enumerate(hits, 1) if title_match(h)]
    ahead = [h for h in titled if (h.get("storePosition") or 10**9) < (sp or 10**9)]
    in_title = title_match(rec)
    print(f"query {query!r}  nbHits={r['nbHits']}")
    print(f"  {slug}: rank p{pos}, storePosition {sp}, query in our title: {in_title}")
    print(f"  title-match block: {len(titled)} records at ranks {ranks[:3]}..{ranks[-3:] if ranks else []}")
    if in_title:
        print("  -> already in the title block; only storePosition (real usage) can move us.")
    else:
        print(f"  -> {len(ahead)} title-matchers have a better storePosition than us")
        print(f"  -> predicted rank if we join the title block: ~p{len(ahead) + 1} (from p{pos})")
    return 0


def main():
    args = sys.argv[1:]
    if args and args[0] == "--attr":
        if len(args) < 3:
            print('usage: store-rank --attr "<query>" <slug>', file=sys.stderr)
            return 2
        return attr(args[1], args[2])
    if args and args[0] == "--query":
        leaderboard(" ".join(args[1:]))
        return 0
    if args and args[0] == "--meta":
        return meta(args[1]) if len(args) > 1 else (print("usage: store-rank --meta <slug>", file=sys.stderr) or 2)

    targets = {k: v for k, v in TERMS.items() if not args or k in args}
    if not targets:
        print(f"unknown slug: {args[0]}", file=sys.stderr)
        return 2
    only = bool(args)

    top20 = 0
    total = 0
    print(f"{'actor':32} {'query':24} {'nbHits':>7} {'rank':>14} {'storePos':>9}")
    for slug, terms in sorted(targets.items()):
        for term in (terms if only else terms[:1]):
            pos, nb, sp = rank_of(slug, term)
            total += 1
            if pos and pos <= 20:
                top20 += 1
            shown = f"p{pos}" if pos else ">1000"
            print(f"{slug:32} {term!r:24} {nb:>7} {shown:>14} {str(sp):>9}")
    print(
        f"\nIndexed and retrievable in the real store search: yes (that is the point).\n"
        f"Top-20 on {top20}/{total} probed queries. Within a match group rank is driven\n"
        f"by `storePosition` (Apify-computed, ascending, not settable) — but a TITLE\n"
        f"match outranks a description-only match first (cycle 520). For a query we\n"
        f"place badly on, run `store-rank --attr \"<query>\" <slug>` before concluding\n"
        f"nothing can be done: it says whether we are outside the title block and what\n"
        f"rank joining it would actually buy."
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
