#!/root/agent/venv/bin/python
"""Sweep the Apify Store for rivals Apify just converted from rental pricing
(FLAT_PRICE_PER_MONTH) to pay-per-event, per the platform's 2026-10-01 rental-
pricing deprecation.

Queued at cycle 1116/1117 after `hacker-news-scraper`'s competitor_audit found
`epctex/hackernews-scraper` -- a dormant, 2021-era, 176-user listing (build still
v0.0, 0 new users in 30 days) that rented FLAT_PRICE_PER_MONTH until 2026-10-01,
when Apify auto-converted it to PAY_PER_EVENT ($0.0003/result + $0.00005 start).
It had never shown up in ANY price comparison we own, by construction: a rental
Actor has no per-event price, so `check-price-superiority` (and every manual
"price vs rivals" paragraph written before today) silently skipped it, even
though it was -- by lifetime users -- the niche's biggest listing the whole
time. Apify is converting these on the same schedule fleet-wide, so other
niches likely have dormant rental listings about to become comparable for the
first time, and every competitor_audit that ran before 2026-10-01 had no way to
have seen them.

This is a DISCOVERY sweep, not a verdict: a flagged listing still needs a human
read (as cycle 1116 did for epctex) to decide whether it is a real "niche
leader" claim to fix, a genuine undisclosed undercutter, or neither -- it does
not replace running competitor_audit on the flagged Actor's niche.

Detection: the live `/v2/acts/<owner>~<slug>` record's currently-effective
pricingInfos entry carries a `reasonForChange` field that literally says
"Apify is deprecating rental pricing" on every auto-converted Actor (confirmed
on epctex, cycle 1116) -- far more robust than diffing the pricingModel
sequence, which would also have to handle Actors with unrelated pricing history.

Search terms are a hand-curated niche -> query map, one entry per live Actor,
mirroring the terms past competitor_audit cycles used manually for the same
niche. A new Actor needs a new entry here -- main() warns (does not fail) if
registry.json gains a slug with none, same spirit as other checks in this
fleet that treat missing metadata as a loud warning rather than a silent skip.

Read-only: GETs only (`/v2/store` search + `/v2/acts/<owner>~<slug>`), no Actor
runs, no file writes.

Ported to an 8-way `ThreadPoolExecutor` prefetch at cycle 2155, closing the one real
candidate left from c2152's grep-based "port the other 3 serial sweeps" follow-up (corrected
at c2154: 2 of the 4 named scripts already had the pattern, 1 makes no HTTP calls at all).
Measured serial at c2154: 145s wall / 14.4s CPU for 23 niches -- almost entirely idle network
wait, same profile `check-price-superiority` (cycle 1384) and `check-unit-matched-price`
(cycle 1494) already proved out at 6-8x.

The one hazard those two ports didn't have: the original serial loop's `seen` dict decides
which NICHE a listing shared by two search terms gets attributed to, by first-match
iteration order over `live_slugs` (alphabetical) then over each niche's own `/v2/store`
relevance order. Naive concurrency on the per-niche searches, or on the per-listing
`/v2/acts` fetches, can reorder completion and silently reattribute a shared rival to the
wrong niche. Fixed by splitting what was one loop into four passes, with exactly one still
serial:
  1. Fetch all 23 `/v2/store` searches concurrently (independent of each other, no shared
     state -- safe to parallelize outright).
  2. Replay the ORIGINAL `seen`-dict dedup loop over those prefetched results, single-
     threaded, in the exact original `live_slugs` x per-niche-item order. This is the only
     pass that may not be parallelized; it fixes which niche "wins" each ident before any
     further fetching happens.
  3. Prefetch the resulting ordered, deduplicated `/v2/acts` GETs concurrently -- safe now,
     since attribution was already decided in pass 2 and this pass only resolves prices.
  4. Replay the `rental_converted` analysis over the ordered list, reading the prefetched
     cache -- byte-identical verdicts and `flagged` order to the pre-port code.
Verified cycle 2155 by running the pre-port code and this code over the SAME live Store data
back-to-back and diffing stdout: byte-identical (23 niches searched, same unique-listing
count, same flagged set in the same order). Wall time: ~145s -> ~25s.
"""
import datetime
import glob
import json
import os
import re
import sys
from concurrent.futures import ThreadPoolExecutor

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from _apify_get import get_data  # noqa: E402  (shared retrying GET, cycle 1404)

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
API = "https://api.apify.com/v2"
FULL_HANDLE = re.compile(r"`([a-z][a-z0-9_.-]{2,}/[A-Za-z0-9_.-]+)`")
CUTOFF = datetime.datetime(2026, 10, 1, tzinfo=datetime.timezone.utc)

NICHE_TERMS = {
    "ats-jobs-scraper": "ats jobs",
    "google-news-scraper": "google news",
    "app-store-reviews-scraper": "app store reviews",
    "shopify-products-scraper": "shopify products",
    "hacker-news-scraper": "hacker news",
    "google-play-reviews-scraper": "google play reviews",
    "substack-scraper": "substack",
    "apple-podcasts-scraper": "apple podcasts",
    "steam-reviews-scraper": "steam reviews",
    "eu-ted-tenders-scraper": "eu ted tenders",
    "uk-find-a-tender-scraper": "uk find a tender",
    "us-federal-awards-scraper": "usaspending federal awards",
    "fda-recall-scraper": "fda recall",
    "federal-register-scraper": "federal register",
    "clinicaltrials-scraper": "clinicaltrials",
    "grants-gov-scraper": "grants.gov",
    "nih-reporter-scraper": "nih reporter",
    "fec-campaign-finance-scraper": "fec campaign finance",
    "court-records-scraper": "court records",
    "trademark-search-scraper": "trademark",
    "sam-gov-opportunities-scraper": "sam.gov",
    "remote-jobs-scraper": "remote jobs",
    "sec-insider-trades-scraper": "sec insider trading",
    "website-screenshot-scraper": "screenshot",
}


def token():
    for line in open(os.path.join(ROOT, "secrets/env")):
        if line.startswith("APIFY_TOKEN"):
            return line.split("=", 1)[1].strip().strip('"')
    sys.exit("check-rental-converts: no APIFY_TOKEN in secrets/env")


def already_named():
    idents = set()
    for path in glob.glob(os.path.join(ROOT, "actors", "*", "README.md")):
        idents |= set(FULL_HANDLE.findall(open(path).read()))
    return idents


def rental_converted(act, now):
    live = [p for p in (act.get("pricingInfos") or [])
            if p.get("startedAt")
            and datetime.datetime.fromisoformat(p["startedAt"].replace("Z", "+00:00")) <= now]
    if not live:
        return False
    cur = live[-1]
    reason = (cur.get("reasonForChange") or "").lower()
    started = datetime.datetime.fromisoformat(cur["startedAt"].replace("Z", "+00:00"))
    if started < CUTOFF:
        return False
    # Cycle 1796: the original test was `"deprecating rental" in reason` alone -- Apify's
    # own auto-migration blurb. That misses every conversion the OWNER announces in their
    # own words, and the owner-written case is not an edge case: it hid
    # `lhotanova/google-news-scraper`, the LARGEST listing in the google-news niche (3,201
    # users, 3.67M lifetime runs), which left a $20/month rental for PAY_PER_EVENT on
    # 2026-10-14 with reasonForChange "This Actor will move from rental to pay-per-event.
    # You will pay per result, plus two optional add-ons...". Thirteen prior sweeps of that
    # niche never named it, because a rental has no per-event price for any price check to
    # compare and this tool -- the one check built for exactly that blind spot -- was
    # keying off Apify's wording instead of the transition itself.
    # So detect it STRUCTURALLY: rental anywhere in the price history + PAY_PER_EVENT in
    # effect now == a rental convert, whoever wrote the note. Reason string kept as an OR
    # so a record whose rental history has been truncated still flags.
    if "deprecating rental" in reason:
        return True
    was_rental = any(p.get("pricingModel") == "FLAT_PRICE_PER_MONTH"
                     for p in (act.get("pricingInfos") or []))
    return was_rental and cur.get("pricingModel") == "PAY_PER_EVENT"


def store_search(term):
    """One `/v2/store` search. Public endpoint, no auth header needed."""
    data = get_data(f"{API}/store", params={"search": term, "limit": 20, "sortBy": "relevance"},
                     timeout=30)
    return (data or {}).get("items", [])


def prefetch_store(slug_terms, workers=8):
    """Fetch every niche's `/v2/store` search concurrently -- these are independent of each
    other (no shared state), so no ordering hazard here. Returns {slug: [items]}.
    """
    slugs = list(slug_terms)
    results = {}
    with ThreadPoolExecutor(max_workers=workers) as pool:
        for slug, items in zip(slugs, pool.map(lambda s: store_search(slug_terms[s]), slugs)):
            results[slug] = items
    return results


CACHE = {}


def live_actor(ident, headers, cache=CACHE):
    """Live record for a rival handle, or None if the handle is genuinely gone.

    Was `rr.json().get("data") if rr.status_code == 200 else None` -- one GET at a time, no
    retry. Ported cycle 2155 from check-price-superiority's identical fix (cycle 1404): a
    transient 429 on one rival would silently read as "no live record" and drop it from the
    sweep, which matters more now that these GETs run in an 8-thread pool. `get_data` retries
    429/5xx/network/non-JSON and still returns None for a real 404 (delisted rival stays
    None, not retried).
    """
    if ident not in cache:
        u, n = ident.split("/")
        cache[ident] = get_data(f"{API}/acts/{u}~{n}", headers=headers, timeout=30)
    return cache[ident]


def prefetch(idents, headers, workers=8):
    """Warm CACHE for every handle concurrently; the analysis pass below then reads it."""
    todo = [i for i in idents if i not in CACHE]
    done = 0
    with ThreadPoolExecutor(max_workers=workers) as pool:
        for _ in pool.map(lambda i: live_actor(i, headers), todo):
            done += 1
            if done % 100 == 0 or done == len(todo):
                print(f"  ...prefetched {done}/{len(todo)} live Actor records",
                      file=sys.stderr, flush=True)


def main():
    headers = {"Authorization": f"Bearer {token()}"}
    now = datetime.datetime.now(datetime.timezone.utc)
    registry = json.load(open(os.path.join(ROOT, "actors/registry.json")))
    live_slugs = sorted(t["slug"] for t in registry["tools"] if t["status"] == "live")
    missing = [s for s in live_slugs if s not in NICHE_TERMS]
    if missing:
        print(f"WARN: no NICHE_TERMS search term for: {', '.join(missing)} -- not swept")

    named = already_named()
    slug_terms = {s: NICHE_TERMS[s] for s in live_slugs if s in NICHE_TERMS}

    # Pass 1: all 23 store searches concurrently -- independent, no shared state.
    store_results = prefetch_store(slug_terms)

    # Pass 2: replay the ORIGINAL serial `seen`-dict dedup loop, single-threaded, over the
    # prefetched search results, in the exact original live_slugs x per-niche-item order.
    # This is the one pass that must stay serial: it is what decides which niche "wins" a
    # listing two search terms both surface, and that decision has to be made before any
    # concurrent fetching starts, not as a side effect of whichever fetch finishes first.
    seen = set()
    ordered = []
    searched = 0
    for slug in live_slugs:
        term = slug_terms.get(slug)
        if not term:
            continue
        searched += 1
        for item in store_results[slug]:
            ident = f"{item['username']}/{item['name']}"
            if ident == f"fetchsmith/{slug}" or ident in seen:
                continue
            seen.add(ident)
            ordered.append((ident, slug))

    # Pass 3: now that attribution order is fixed, prefetch the per-listing /v2/acts GETs
    # concurrently -- safe, since this pass only resolves prices, not niche ownership.
    prefetch([ident for ident, _slug in ordered], headers)

    # Pass 4: replay the analysis loop in the original order, reading the prefetched cache.
    flagged = []
    for ident, slug in ordered:
        act = live_actor(ident, headers)
        if act and rental_converted(act, now):
            stats = act.get("stats", {})
            flagged.append({
                "niche": slug, "ident": ident,
                "users": stats.get("totalUsers", 0),
                "u30d": stats.get("totalUsers30Days", 0),
                "named": ident in named,
            })

    print(f"check-rental-converts: {searched} niches searched, {len(ordered)} unique listings "
          f"checked, {len(flagged)} newly rental-converted")
    for f in flagged:
        tag = "already named" if f["named"] else "NOT YET NAMED"
        print(f"  {f['niche']:32} {f['ident']:45} users={f['users']:5} u30d={f['u30d']:4} ({tag})")
    return 0


if __name__ == "__main__":
    sys.exit(main())
