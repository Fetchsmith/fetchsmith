#!/root/agent/venv/bin/python
"""Nightly: run every live Actor on Apify with its test_input.json; record pass/fail in state/health.json.

--only <slug>  (cycle 1813, closing queue item (q)) -- run just that one Actor and print its
result; does NOT touch state/health.json or the FIX FAILED ACTORS task. actor-health is the
nightly critical path with no prior single-slug mode, so a change to it could only be verified
by running all 24 Actors; this flag lets a future edit be tested on one Actor instead."""
import json, os, re, time, httpx, sys
env = dict(l.rstrip("\n").split("=", 1) for l in open("/root/agent/secrets/env") if "=" in l and not l.startswith("#"))
T = env["APIFY_TOKEN"]; API = "https://api.apify.com/v2"; user = httpx.get(f"{API}/users/me", headers={"Authorization": f"Bearer {T}"}).json()["data"]["username"]

# Added c2743, closing the c2742 shopify-products-scraper remedy (b): Shopify's edge 403/429s
# on the REPUTATION of Apify's shared IP, time-varying and store-independent (c2742 measured
# allbirds/brooklinen/rothys/nativecos 403 and bombas 429 within one 4-minute window, with
# deathwishcoffee flipping ok->403 three minutes after succeeding). That is an upstream
# condition we cannot fix, so a nightly run that comes back 0 items for that reason alone is
# not evidence the Actor is broken -- it just mislabels "FIX FAILED ACTORS" against working
# code. Several Actors in the fleet (shopify-products-scraper's shape at least) write a
# machine-readable `RUN_SUMMARY.sources[].reason` to their default KV store naming the real
# HTTP cause; read it back for the run that just happened (run-sync-get-dataset-items returns
# no run-id header, so look up the most recent run for this Actor instead -- safe because
# run.sh's lock keeps this to one worker/one run at a time) and, ONLY if every source's reason
# names a known-transient storefront or proxy code and none succeeded, mark the result
# INCONCLUSIVE rather than FAILED. Any other code (401/402/404/503-from-the-storefront/missing
# RUN_SUMMARY/anything we can't read) leaves `ok` exactly as it was -- this can only soften a
# false alarm, never hide a real one.
#
# Extended c3362 (FIX FAILED ACTORS, nightly 2026-11-18): the SAME reputation-block phenomenon
# can also surface BELOW the storefront-status layer, as Apify Proxy's own synthetic `590`
# wrapper failing to reach the origin at all (`"Proxy responded with 590 UPSTREAM504: 0 bytes"`)
# -- no parenthesized code for STOREFRONT_CODE to catch, so this shape fell through to FAILED
# even though it is literally the same stores (allbirds/gymshark/bombas, all three named in the
# c2742 measurement above) going through the same time-varying block, just observed as a proxy
# timeout instead of an explicit 403/429. Live re-check same cycle: deathwishcoffee/brooklinen/
# rothys/nativecos all returned products through this Actor at the same moment allbirds/
# gymshark/bombas all threw this exact message -- store-specific, not code-wide. Matched against
# `PROXY_UPSTREAM_CODE` and gated to {502, 504} only -- the two codes actually measured live (502
# here at c992/trademark-search-scraper's h913/h825/h826, 504 here at c3362) -- deliberately NOT
# 503, since `UPSTREAM503` would just be the storefront's own 503 relayed through the proxy
# wrapper, the one code the storefront-side rule above was written to keep OUT of the softened
# set.
# --- selftest region start (execed verbatim by bin/_actor_health_selftest.py; it needs only
# `re`, so keep everything down to the matching end sentinel free of network, token and
# filesystem access -- that is what lets the classifier be regression-tested for free) ---
STOREFRONT_CODE = re.compile(r"\((\d{3})\)")
PROXY_UPSTREAM_CODE = re.compile(r"UPSTREAM(\d{3})")
KNOWN_TRANSIENT_STOREFRONT = {"403", "429"}
KNOWN_TRANSIENT_PROXY = {"502", "504"}
# Added c3369 (nightly 2026-11-18, grants-gov-scraper FAILED/0-items): the multi-source
# `sources[].reason` shape above does not cover the fleet's OTHER shared RUN_SUMMARY
# convention -- a single-source Actor's own `incompleteReason`/`incompleteDetail` pair
# (confirmed shared verbatim, not grants-gov-only: clinicaltrials-scraper calls
# `markIncomplete(failureReason('search-request-failed'), lastApiError)` with the exact
# same reason string). Live-verified same cycle: grants.gov's OWN `/search2` endpoint
# (not an Apify-proxy wrapper, so PROXY_UPSTREAM_CODE's "UPSTREAM503" shape never
# appears here) answered 200/200/502 on three successive direct probes seconds apart --
# genuinely time-varying upstream flakiness, not a code regression. Gated narrowly to
# the ONE reason string that names an upstream HTTP-request failure (never
# `charge-limit`/`max-results`/`time-budget`/`seed-cap`, which are caps the Actor hit on
# purpose, not upstream faults) and to codes classically transient for a bare JSON API
# (503 included here, unlike KNOWN_TRANSIENT_PROXY above, because there is no
# storefront-side 503 being double-counted through a proxy wrapper on this shape).
UPSTREAM_HTTP_CODE = re.compile(r"\bHTTP (\d{3})\b")
KNOWN_TRANSIENT_UPSTREAM_API = {"502", "503", "504"}
TRANSIENT_INCOMPLETE_REASONS = {"search-request-failed"}
# Added c3372 (nightly 2026-11-18, uk-find-a-tender-scraper FAILED/0-items). A THIRD shared
# RUN_SUMMARY shape, missed by both branches above: `sources` as a per-source MAP
# ({fts: {label, pages, delivered, failed, lastError}, cf: {...}}, built by that Actor's
# `sources: Object.fromEntries(cursors.map(...))`), not a list of `{complete, reason}`. The list
# branch is typed on `isinstance(list)` so it skipped the map entirely, and the fallthrough
# needs `incompleteReason == 'search-request-failed'` whereas the multi-source convention here
# is `source-failed` -- so a pure upstream outage was reported as a code failure.
# Live-diagnosed that cycle from the failing run's own record: Find a Tender answered
# `HTTP 502: <html>...502 Bad Gateway...` on page 0 (its OWN origin, no Apify-proxy wrapper, so
# PROXY_UPSTREAM_CODE never matches here) and its retry ladder then burned the run-timeout
# budget, leaving Contracts Finder starved at `run-timeout budget exceeded` before its first
# request. 30 minutes later the identical input returned 10 rows with BOTH portals
# `failed: false` -- time-varying portal flakiness, not a regression.
# Gating, deliberately narrow (same doctrine as c3369):
#   - EVERY source in the map must have failed. One source with `failed: false` means the
#     capture path works and a 0-row run is a real signal (empty window or a filter/parse
#     regression) -- exactly what the list branch's `complete` test preserves.
#   - At least ONE failure must name a classically-transient upstream code, so a run that only
#     ran out of clock (a genuine slowdown worth investigating) is never softened.
#   - The remaining failures may only be `run-timeout budget exceeded`, which `fetchPage` sets
#     purely off the wall clock (main.js:822/839) and which is never evidence of a parse fault:
#     it is the stalled sibling's collateral damage, not an independent cause. NOT extended to
#     that function's other wall-clock stop ('stopped early to leave run time for the other
#     portal'), where the sibling did get its slice.
STARVED_BY_SIBLING_STALL = "run-timeout budget exceeded"
# Added c3376 (nightly 2026-11-18, uk-find-a-tender-scraper FAILED/0-items AGAIN -- run
# VYGUmIoWSzqZS0BDe, third shape in the c3362/c3369/c3372 series). Same per-source MAP as
# c3372, but with NO upstream error anywhere: `fts` was stopped at 0 pages with
# `sliceExceeded: true` so `cf` could have a turn (main.js:824/841), then `cf` hit
# `run-timeout budget exceeded` before its first request, and the run ends
# `incompleteReason: "source-time-share"` (main.js:1041) with 0 rows. c3372's branch needs at
# least one classically-transient HTTP code, so a pure two-portal clock race fell through to
# FAILED. Live-verified at c3375 that this is NOT a regression: direct probes of both origins
# returned 200/200 and two manual `--only` re-runs each delivered 10 rows from `fts` -- the
# race is against the health check's deliberately tight 180s `health_timeout_secs`, a budget
# ~20x smaller than the Actor's real 3600s production timeout.
# Gating, deliberately narrower than the queue item asked for -- a clock-only stop is exactly
# the case c3372 refused to soften ("a genuine slowdown worth investigating"), so this branch
# must not re-open that door by text alone:
#   - `incompleteReason` must be EXACTLY `source-time-share`. The Actor's first-cause-wins
#     `markIncomplete` reserves that string for the sibling-yield path; a run that truly ran
#     out of clock reports `time-budget` and stays FAILED.
#   - EVERY source must have `failed: true` (same reason as the c3372 branch: one working
#     source means the capture path works and 0 rows is a real signal).
#   - EVERY source must have fetched NOTHING (`pages`/`scanned` both 0). This is what keeps a
#     real slowdown visible: if any portal did fetch and parse a page and still delivered 0
#     rows, the capture path ran, so a filter/parse regression is on the table and the run
#     must stay FAILED no matter what stopped the siblings. Both sources read 0/0 in the real
#     payload, so softening the run that motivated this costs nothing.
#   - At least ONE source must carry the yield stop, and trusted via the STRUCTURED
#     `sliceExceeded` flag, not just the message (c3372's hard-won lesson: `lastError` is
#     never cleared, so error text alone is not evidence of this run's outcome).
#   - Every remaining failure may only be `run-timeout budget exceeded` -- the yielded-to
#     sibling that never got to make a request. Any other cause is unrecognized, hence FAILED.
SLICE_YIELD_PREFIX = "stopped early to leave run time for"
TIME_SHARE_REASON = "source-time-share"
def time_share_race(rs, sources):
    """True only for a 0-page, 0-row run in which the portals did nothing but hand the clock
    to each other -- see the gating notes above. Pure; selftested in bin/_actor_health_selftest.py."""
    if rs.get("incompleteReason") != TIME_SHARE_REASON: return False
    saw_yield = False
    for s in sources.values():
        if not isinstance(s, dict): return False
        if not s.get("failed"): return False
        if (s.get("pages") or 0) or (s.get("scanned") or 0): return False
        err = s.get("lastError") or ""
        if err.startswith(SLICE_YIELD_PREFIX):
            if not s.get("sliceExceeded"): return False  # trust the flag, not the text
            saw_yield = True
            continue
        if err == STARVED_BY_SIBLING_STALL: continue  # never got to make a request
        return False  # a cause we didn't recognize -- don't soften it
    return saw_yield
def classify_inconclusive(rs):
    """Pure predicate over a RUN_SUMMARY record: may this 0-row run be softened to INCONCLUSIVE?

    Separated from the fetch in c3372 so the three shapes can be regression-tested offline
    against real recorded payloads -- see bin/_actor_health_selftest.py."""
    if not isinstance(rs, dict): return False
    sources = rs.get("sources")
    if isinstance(sources, list) and sources:
        for s in sources:
            if not isinstance(s, dict): return False
            if s.get("complete"): return False  # at least one source actually worked -- a real failure
            reason = s.get("reason") or ""
            m1 = STOREFRONT_CODE.search(reason)
            m2 = PROXY_UPSTREAM_CODE.search(reason)
            if m1 and m1.group(1) in KNOWN_TRANSIENT_STOREFRONT: continue
            if m2 and m2.group(1) in KNOWN_TRANSIENT_PROXY: continue
            return False  # a cause we didn't recognize -- don't soften it
        return True
    if isinstance(sources, dict) and sources:
        if time_share_race(rs, sources): return True  # c3376, gated above
        saw_transient_upstream = False
        for s in sources.values():
            if not isinstance(s, dict): return False
            if not s.get("failed"): return False  # a source actually worked -- a real failure
            err = s.get("lastError") or ""
            m = UPSTREAM_HTTP_CODE.search(err)
            if m and m.group(1) in KNOWN_TRANSIENT_UPSTREAM_API:
                saw_transient_upstream = True
                continue
            if err == STARVED_BY_SIBLING_STALL: continue  # never got to make a request
            return False  # a cause we didn't recognize -- don't soften it
        return saw_transient_upstream
    if rs.get("incompleteReason") in TRANSIENT_INCOMPLETE_REASONS:
        m = UPSTREAM_HTTP_CODE.search(rs.get("incompleteDetail") or "")
        if m and m.group(1) in KNOWN_TRANSIENT_UPSTREAM_API: return True
    return False
# --- selftest region end ---
def inconclusive_blocked(slug):
    try:
        runs = httpx.get(f"{API}/acts/{user}~{slug}/runs", params={"token": T, "desc": "true", "limit": 1}, timeout=30).json()["data"]["items"]
        if not runs: return False
        kv_id = runs[0]["defaultKeyValueStoreId"]
        r = httpx.get(f"{API}/key-value-stores/{kv_id}/records/RUN_SUMMARY", params={"token": T}, timeout=30)
        if r.status_code != 200: return False
        return classify_inconclusive(r.json())
    except Exception:
        return False
reg = json.load(open("/root/agent/actors/registry.json")).get("tools", [])
only = None
if "--only" in sys.argv:
    only = sys.argv[sys.argv.index("--only") + 1]
    reg = [t for t in reg if t["slug"] == only]
    if not reg:
        sys.exit(f"--only {only}: no such slug in registry.json")
report = {"ts": int(time.time()), "results": {}}
for t in reg:
    if t.get("status") not in ("live", "beta"): continue
    # A standby-mode Actor (registry `mcp: true`, added cycle 2759) must NEVER be probed with
    # run-sync-get-dataset-items: its entrypoint is `app.listen()`, so it never exits and never
    # pushes a dataset row. The call is therefore a GUARANTEED `timeout` + `items: 0` -- a false
    # FIX FAILED ACTORS task against a healthy product, a `check-row-floor` ratio-0.00 flag, and
    # ~180s of billable compute, every night. Probed over MCP below instead (cycle 2764: caught
    # before the first nightly run that would have included it -- health.json ts 06:38 predates
    # the registry entry, so this had never actually fired yet).
    if t.get("mcp"): continue
    slug = t["slug"]; p = f"/root/agent/actors/{slug}/test_input.json"
    inp = json.load(open(p)) if os.path.exists(p) else t.get("example_input", {"maxResults": 5})
    inp = {**inp, "maxResults": min(int(inp.get("maxResults", 5)), 10)}
    # Per-Actor run-timeout override (registry.json `health_timeout_secs`), added cycle 1061. 180s is
    # right for the fleet, but an Actor whose own retry path is a chain of proxy rotations needs more
    # wall-clock than its happy path suggests: `trademark-search-scraper` has now TIMED-OUT twice on
    # nothing but transient `590 UPSTREAM502` blips (h913/h825/h826, run bAeFGpiApFJl7u085), each time
    # opening a FIX FAILED ACTORS task against code that was working. The read timeout tracks it.
    run_timeout = int(t.get("health_timeout_secs", 180))
    try:
        r = httpx.post(f"{API}/acts/{user}~{slug}/run-sync-get-dataset-items", params={"token": T, "timeout": run_timeout, "memory": t.get("memory_mb", 256), "clean": "true", "limit": 10}, json=inp, timeout=run_timeout + 60)
        items = r.json() if r.status_code < 300 else []
        n = len(items) if isinstance(items, list) else 0
        ok = r.status_code < 300 and n >= 1
        # Additive signal (cycle 1813, queue item (q)): a row that is itself an error --
        # `pushData({success: false, ...})`, e.g. website-screenshot-scraper's per-URL
        # failure path -- still counts toward `items`/`n` above, so row-count alone can't
        # tell a clean capture from a failed one. check-row-floor reads only `items`, so
        # this key is safe to add without changing any existing check's behavior.
        fail_rows = sum(1 for it in items if isinstance(it, dict) and it.get("success") is False) if n else 0
        inconclusive = (not ok) and inconclusive_blocked(slug)
        report["results"][slug] = {"ok": ok, "inconclusive": inconclusive, "status": r.status_code, "items": n, "fail_rows": fail_rows, "sample_keys": list(items[0].keys())[:8] if n else [], "err": None if ok else r.text[:200]}
    except Exception as e:
        report["results"][slug] = {"ok": False, "items": 0, "fail_rows": 0, "err": str(e)[:200]}
    print(slug, report["results"][slug])

# Standby-mode (MCP) Actors, cycle 2764. The batch loop skips them for the reason documented
# there, which would otherwise leave our only non-batch product with NO monitoring at all: a
# dead standby URL is invisible to every other fleet check (they read the registry and the
# platform record, not the running server). Two JSON-RPC calls over the real public standby URL
# -- the same surface a buyer's MCP client hits, not a localhost stand-in:
#   tools/list  -- server up, transport speaking MCP, the priced tool still registered (FREE:
#                  it does not enter the tool handler, so no `Actor.charge` fires)
#   tools/call  -- the end-to-end analogue of the batch check's `items >= 1`: upstream API
#                  reachable AND our parser still returning rows with the documented fields
# Recorded under "standby", NOT in report["results"] -- the same containment the `retired`
# probe below uses, so it cannot shift the pass/fail count, open a FIX task, or move
# `check-row-floor`'s denominator (24 batch rows before this change, 24 after; verified).
# FOLLOW-UP left in queue.md: wire a standby failure into the FIX-task path deliberately.
# Responses are SSE-framed (`event: message\ndata: {...}`), so the JSON needs unwrapping.
def _mcp_rpc(url, token, method, params=None):
    body = {"jsonrpc": "2.0", "id": 1, "method": method}
    if params is not None:
        body["params"] = params
    r = httpx.post(f"{url}/mcp", params={"token": token}, json=body, timeout=120,
                   headers={"Accept": "application/json, text/event-stream"})
    payload = None
    for ln in r.text.splitlines():
        if ln.startswith("data:"):
            try:
                payload = json.loads(ln[5:].strip())
            except Exception:
                payload = None
            break
    if payload is None:
        try:
            payload = r.json()
        except Exception:
            payload = None
    return r.status_code, payload

report["standby"] = {}
for t in reg:
    if not t.get("mcp") or t.get("status") not in ("live", "beta"): continue
    slug = t["slug"]; url = t.get("standby_url")
    if not url:
        report["standby"][slug] = {"ok": False, "err": "no standby_url in registry.json"}
        print("standby:", slug, report["standby"][slug]); continue
    rec = {"ok": False, "url": url, "list_status": None, "tool_listed": False,
           "call_status": None, "rows": 0, "sample_keys": [], "err": None}
    try:
        rec["list_status"], payload = _mcp_rpc(url, T, "tools/list")
        names = [x.get("name") for x in ((payload or {}).get("result", {}) or {}).get("tools", [])]
        rec["tool_listed"] = t.get("mcp_tool") in names
        inp = t.get("example_input") or {}
        rec["call_status"], payload = _mcp_rpc(url, T, "tools/call",
                                               {"name": t.get("mcp_tool"), "arguments": inp})
        result = ((payload or {}).get("result") or {})
        rows = []
        for c in result.get("content", []):
            if c.get("type") == "text":
                try:
                    parsed = json.loads(c.get("text") or "")
                except Exception:
                    continue
                rows = parsed if isinstance(parsed, list) else [parsed]
        rec["rows"] = len(rows)
        rec["sample_keys"] = list(rows[0].keys())[:8] if rows and isinstance(rows[0], dict) else []
        rec["ok"] = (rec["list_status"] < 300 and rec["tool_listed"]
                     and rec["call_status"] < 300 and not result.get("isError") and rec["rows"] >= 1)
        if not rec["ok"]:
            rec["err"] = json.dumps(payload)[:200]
    except Exception as e:
        rec["err"] = str(e)[:200]
    report["standby"][slug] = rec
    print("standby:", slug, "ok=", rec["ok"], "list=", rec["list_status"],
          "tool_listed=", rec["tool_listed"], "call=", rec["call_status"], "rows=", rec["rows"])

if only:
    sys.exit(0)

# A `retired` Actor is skipped above on purpose -- running a scraper whose source has blocked us
# just burns platform compute to re-learn the same failure. But retirement should not be a one-way
# door: probe the source with one plain GET so a future cycle can see the day it clears instead of
# guessing. Recorded under "retired" and NOT in report["results"], so it can never affect the
# pass/fail count or open a FIX task. Added cycle 652 (scholarship-scraper / bold.org 429).
report["retired"] = {}
for t in reg:
    if t.get("status") != "retired" or not t.get("recheck_url"): continue
    slug = t["slug"]
    try:
        r = httpx.get(t["recheck_url"], timeout=30, follow_redirects=True,
                      headers={"User-Agent": "Mozilla/5.0 (compatible; FetchSmithHealth/1.0; +https://fetchsmith.com)"})
        # Not `status == 200`: a bot challenge can serve its interstitial with a 200 as easily as
        # bold.org's 429, and "cleared" would then flip on a page that is still the challenge. The
        # body has to look like the real thing too.
        challenged = any(s in r.text[:4000] for s in ("Security Checkpoint", "Just a moment",
                                                      "Checking your browser", "cf-challenge", "__cf_chl"))
        report["retired"][slug] = {"url": t["recheck_url"], "status": r.status_code,
                                   "cleared": r.status_code == 200 and not challenged,
                                   "challenged": challenged, "body_head": r.text[:120]}
    except Exception as e:
        report["retired"][slug] = {"url": t["recheck_url"], "status": None, "cleared": False, "err": str(e)[:200]}
    print("retired:", slug, report["retired"][slug]["status"], "cleared=", report["retired"][slug]["cleared"])
json.dump(report, open("/root/agent/state/health.json", "w"), indent=1)
failed = [k for k, v in report["results"].items() if not v["ok"] and not v.get("inconclusive")]
# Standby outages were invisible to this FIX path until cycle 2765 (c2764 left it as a named
# gap): report["standby"] is deliberately NOT in report["results"] (keeps check-row-floor's
# denominator and the batch pass/fail count untouched), but that also meant a dead MCP server
# opened no task. Appended as a SEPARATE line with its own wording so it reads as "standby
# server down", not "scraper broken" -- a human (or future cycle) skimming the FIX line
# must not reach for the batch-Actor remedy (test_input.json, proxy, selectors) against a
# standby server problem (process crash, standby URL change, token).
standby_failed = [k for k, v in report["standby"].items() if not v.get("ok")]
if failed:
    q = "/root/agent/tasks/queue.md"; txt = open(q).read()
    line = f"- [ ] FIX FAILED ACTORS (nightly health {time.strftime('%Y-%m-%d')}): {', '.join(failed)} — see state/health.json [hard]\n"
    if line not in txt:
        txt = txt.replace("# Task queue", "# Task queue", 1).replace("\n\n", "\n\n" + line, 1)
        open(q, "w").write(txt)
if standby_failed:
    q = "/root/agent/tasks/queue.md"; txt = open(q).read()
    line = f"- [ ] FIX STANDBY ACTORS (nightly health {time.strftime('%Y-%m-%d')}): {', '.join(standby_failed)} — MCP standby server unreachable or failing, see state/health.json['standby'] [hard]\n"
    if line not in txt:
        open(q, "w").write(txt.replace("# Task queue", "# Task queue", 1).replace("\n\n", "\n\n" + line, 1))
