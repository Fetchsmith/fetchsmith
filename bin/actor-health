#!/root/agent/venv/bin/python
"""Nightly: run every live Actor on Apify with its test_input.json; record pass/fail in state/health.json.

--only <slug>  (cycle 1813, closing queue item (q)) -- run just that one Actor and print its
result; does NOT touch state/health.json or the FIX FAILED ACTORS task. actor-health is the
nightly critical path with no prior single-slug mode, so a change to it could only be verified
by running all 24 Actors; this flag lets a future edit be tested on one Actor instead."""
import json, os, re, time, httpx, sys
env = dict(l.rstrip("\n").split("=", 1) for l in open("/root/agent/secrets/env") if "=" in l and not l.startswith("#"))
T = env["APIFY_TOKEN"]; API = "https://api.apify.com/v2"; user = httpx.get(f"{API}/users/me", headers={"Authorization": f"Bearer {T}"}).json()["data"]["username"]

# Added c2743, closing the c2742 shopify-products-scraper remedy (b): Shopify's edge 403/429s
# on the REPUTATION of Apify's shared IP, time-varying and store-independent (c2742 measured
# allbirds/brooklinen/rothys/nativecos 403 and bombas 429 within one 4-minute window, with
# deathwishcoffee flipping ok->403 three minutes after succeeding). That is an upstream
# condition we cannot fix, so a nightly run that comes back 0 items for that reason alone is
# not evidence the Actor is broken -- it just mislabels "FIX FAILED ACTORS" against working
# code. Several Actors in the fleet (shopify-products-scraper's shape at least) write a
# machine-readable `RUN_SUMMARY.sources[].reason` to their default KV store naming the real
# HTTP cause; read it back for the run that just happened (run-sync-get-dataset-items returns
# no run-id header, so look up the most recent run for this Actor instead -- safe because
# run.sh's lock keeps this to one worker/one run at a time) and, ONLY if every source's reason
# names 403 or 429 and none succeeded, mark the result INCONCLUSIVE rather than FAILED. Any
# other code (401/402/404/503/missing RUN_SUMMARY/anything we can't read) leaves `ok` exactly
# as it was -- this can only soften a false alarm, never hide a real one.
STOREFRONT_CODE = re.compile(r"\((\d{3})\)")
def inconclusive_blocked(slug):
    try:
        runs = httpx.get(f"{API}/acts/{user}~{slug}/runs", params={"token": T, "desc": "true", "limit": 1}, timeout=30).json()["data"]["items"]
        if not runs: return False
        kv_id = runs[0]["defaultKeyValueStoreId"]
        r = httpx.get(f"{API}/key-value-stores/{kv_id}/records/RUN_SUMMARY", params={"token": T}, timeout=30)
        if r.status_code != 200: return False
        sources = r.json().get("sources")
        if not isinstance(sources, list) or not sources: return False
        codes = set()
        for s in sources:
            if not isinstance(s, dict): return False
            if s.get("complete"): return False  # at least one source actually worked -- a real failure
            m = STOREFRONT_CODE.search(s.get("reason") or "")
            if not m: return False  # a cause we didn't recognize -- don't soften it
            codes.add(m.group(1))
        return codes and codes <= {"403", "429"}
    except Exception:
        return False
reg = json.load(open("/root/agent/actors/registry.json")).get("tools", [])
only = None
if "--only" in sys.argv:
    only = sys.argv[sys.argv.index("--only") + 1]
    reg = [t for t in reg if t["slug"] == only]
    if not reg:
        sys.exit(f"--only {only}: no such slug in registry.json")
report = {"ts": int(time.time()), "results": {}}
for t in reg:
    if t.get("status") not in ("live", "beta"): continue
    # A standby-mode Actor (registry `mcp: true`, added cycle 2759) must NEVER be probed with
    # run-sync-get-dataset-items: its entrypoint is `app.listen()`, so it never exits and never
    # pushes a dataset row. The call is therefore a GUARANTEED `timeout` + `items: 0` -- a false
    # FIX FAILED ACTORS task against a healthy product, a `check-row-floor` ratio-0.00 flag, and
    # ~180s of billable compute, every night. Probed over MCP below instead (cycle 2764: caught
    # before the first nightly run that would have included it -- health.json ts 06:38 predates
    # the registry entry, so this had never actually fired yet).
    if t.get("mcp"): continue
    slug = t["slug"]; p = f"/root/agent/actors/{slug}/test_input.json"
    inp = json.load(open(p)) if os.path.exists(p) else t.get("example_input", {"maxResults": 5})
    inp = {**inp, "maxResults": min(int(inp.get("maxResults", 5)), 10)}
    # Per-Actor run-timeout override (registry.json `health_timeout_secs`), added cycle 1061. 180s is
    # right for the fleet, but an Actor whose own retry path is a chain of proxy rotations needs more
    # wall-clock than its happy path suggests: `trademark-search-scraper` has now TIMED-OUT twice on
    # nothing but transient `590 UPSTREAM502` blips (h913/h825/h826, run bAeFGpiApFJl7u085), each time
    # opening a FIX FAILED ACTORS task against code that was working. The read timeout tracks it.
    run_timeout = int(t.get("health_timeout_secs", 180))
    try:
        r = httpx.post(f"{API}/acts/{user}~{slug}/run-sync-get-dataset-items", params={"token": T, "timeout": run_timeout, "memory": t.get("memory_mb", 256), "clean": "true", "limit": 10}, json=inp, timeout=run_timeout + 60)
        items = r.json() if r.status_code < 300 else []
        n = len(items) if isinstance(items, list) else 0
        ok = r.status_code < 300 and n >= 1
        # Additive signal (cycle 1813, queue item (q)): a row that is itself an error --
        # `pushData({success: false, ...})`, e.g. website-screenshot-scraper's per-URL
        # failure path -- still counts toward `items`/`n` above, so row-count alone can't
        # tell a clean capture from a failed one. check-row-floor reads only `items`, so
        # this key is safe to add without changing any existing check's behavior.
        fail_rows = sum(1 for it in items if isinstance(it, dict) and it.get("success") is False) if n else 0
        inconclusive = (not ok) and inconclusive_blocked(slug)
        report["results"][slug] = {"ok": ok, "inconclusive": inconclusive, "status": r.status_code, "items": n, "fail_rows": fail_rows, "sample_keys": list(items[0].keys())[:8] if n else [], "err": None if ok else r.text[:200]}
    except Exception as e:
        report["results"][slug] = {"ok": False, "items": 0, "fail_rows": 0, "err": str(e)[:200]}
    print(slug, report["results"][slug])

# Standby-mode (MCP) Actors, cycle 2764. The batch loop skips them for the reason documented
# there, which would otherwise leave our only non-batch product with NO monitoring at all: a
# dead standby URL is invisible to every other fleet check (they read the registry and the
# platform record, not the running server). Two JSON-RPC calls over the real public standby URL
# -- the same surface a buyer's MCP client hits, not a localhost stand-in:
#   tools/list  -- server up, transport speaking MCP, the priced tool still registered (FREE:
#                  it does not enter the tool handler, so no `Actor.charge` fires)
#   tools/call  -- the end-to-end analogue of the batch check's `items >= 1`: upstream API
#                  reachable AND our parser still returning rows with the documented fields
# Recorded under "standby", NOT in report["results"] -- the same containment the `retired`
# probe below uses, so it cannot shift the pass/fail count, open a FIX task, or move
# `check-row-floor`'s denominator (24 batch rows before this change, 24 after; verified).
# FOLLOW-UP left in queue.md: wire a standby failure into the FIX-task path deliberately.
# Responses are SSE-framed (`event: message\ndata: {...}`), so the JSON needs unwrapping.
def _mcp_rpc(url, token, method, params=None):
    body = {"jsonrpc": "2.0", "id": 1, "method": method}
    if params is not None:
        body["params"] = params
    r = httpx.post(f"{url}/mcp", params={"token": token}, json=body, timeout=120,
                   headers={"Accept": "application/json, text/event-stream"})
    payload = None
    for ln in r.text.splitlines():
        if ln.startswith("data:"):
            try:
                payload = json.loads(ln[5:].strip())
            except Exception:
                payload = None
            break
    if payload is None:
        try:
            payload = r.json()
        except Exception:
            payload = None
    return r.status_code, payload

report["standby"] = {}
for t in reg:
    if not t.get("mcp") or t.get("status") not in ("live", "beta"): continue
    slug = t["slug"]; url = t.get("standby_url")
    if not url:
        report["standby"][slug] = {"ok": False, "err": "no standby_url in registry.json"}
        print("standby:", slug, report["standby"][slug]); continue
    rec = {"ok": False, "url": url, "list_status": None, "tool_listed": False,
           "call_status": None, "rows": 0, "sample_keys": [], "err": None}
    try:
        rec["list_status"], payload = _mcp_rpc(url, T, "tools/list")
        names = [x.get("name") for x in ((payload or {}).get("result", {}) or {}).get("tools", [])]
        rec["tool_listed"] = t.get("mcp_tool") in names
        inp = t.get("example_input") or {}
        rec["call_status"], payload = _mcp_rpc(url, T, "tools/call",
                                               {"name": t.get("mcp_tool"), "arguments": inp})
        result = ((payload or {}).get("result") or {})
        rows = []
        for c in result.get("content", []):
            if c.get("type") == "text":
                try:
                    parsed = json.loads(c.get("text") or "")
                except Exception:
                    continue
                rows = parsed if isinstance(parsed, list) else [parsed]
        rec["rows"] = len(rows)
        rec["sample_keys"] = list(rows[0].keys())[:8] if rows and isinstance(rows[0], dict) else []
        rec["ok"] = (rec["list_status"] < 300 and rec["tool_listed"]
                     and rec["call_status"] < 300 and not result.get("isError") and rec["rows"] >= 1)
        if not rec["ok"]:
            rec["err"] = json.dumps(payload)[:200]
    except Exception as e:
        rec["err"] = str(e)[:200]
    report["standby"][slug] = rec
    print("standby:", slug, "ok=", rec["ok"], "list=", rec["list_status"],
          "tool_listed=", rec["tool_listed"], "call=", rec["call_status"], "rows=", rec["rows"])

if only:
    sys.exit(0)

# A `retired` Actor is skipped above on purpose -- running a scraper whose source has blocked us
# just burns platform compute to re-learn the same failure. But retirement should not be a one-way
# door: probe the source with one plain GET so a future cycle can see the day it clears instead of
# guessing. Recorded under "retired" and NOT in report["results"], so it can never affect the
# pass/fail count or open a FIX task. Added cycle 652 (scholarship-scraper / bold.org 429).
report["retired"] = {}
for t in reg:
    if t.get("status") != "retired" or not t.get("recheck_url"): continue
    slug = t["slug"]
    try:
        r = httpx.get(t["recheck_url"], timeout=30, follow_redirects=True,
                      headers={"User-Agent": "Mozilla/5.0 (compatible; FetchSmithHealth/1.0; +https://fetchsmith.com)"})
        # Not `status == 200`: a bot challenge can serve its interstitial with a 200 as easily as
        # bold.org's 429, and "cleared" would then flip on a page that is still the challenge. The
        # body has to look like the real thing too.
        challenged = any(s in r.text[:4000] for s in ("Security Checkpoint", "Just a moment",
                                                      "Checking your browser", "cf-challenge", "__cf_chl"))
        report["retired"][slug] = {"url": t["recheck_url"], "status": r.status_code,
                                   "cleared": r.status_code == 200 and not challenged,
                                   "challenged": challenged, "body_head": r.text[:120]}
    except Exception as e:
        report["retired"][slug] = {"url": t["recheck_url"], "status": None, "cleared": False, "err": str(e)[:200]}
    print("retired:", slug, report["retired"][slug]["status"], "cleared=", report["retired"][slug]["cleared"])
json.dump(report, open("/root/agent/state/health.json", "w"), indent=1)
failed = [k for k, v in report["results"].items() if not v["ok"] and not v.get("inconclusive")]
if failed:
    q = "/root/agent/tasks/queue.md"; txt = open(q).read()
    line = f"- [ ] FIX FAILED ACTORS (nightly health {time.strftime('%Y-%m-%d')}): {', '.join(failed)} — see state/health.json [hard]\n"
    if line not in txt:
        open(q, "w").write(txt.replace("# Task queue", "# Task queue", 1).replace("\n\n", "\n\n" + line, 1))
