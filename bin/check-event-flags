#!/usr/bin/env python3
"""Catch a multi-event Actor whose own meta.json never says which event is PRIMARY.

Cycle 3157 (`uk-find-a-tender-scraper`): `bin/_batch_price_uktft3.py` refused to read
OUR OWN live price with "AMBIGUOUS: 2 recurring, no primary flag". The live record had
genuinely lost the flag. Tracing `pricingInfos` showed why: in the single-event era the
PLATFORM auto-adds `isPrimaryEvent: true` to the only event (see the SERVER_ADDED note
in bin/apify-admin, cycle 588), so a meta.json that never declares the flag still ends
up correct live. The moment a SECOND charge event is added, that auto-add stops firing,
and the new `pricingInfos` entry carries NO primary flag on either event.

Why that matters, concretely: every price-reading tool we own -- `check-price-superiority`,
`store-price`, the `_batch_price_*` family -- reduces an Actor to "the isPrimaryEvent
price, else the cheapest non-one-time event". With no flag and two recurring events the
reduction is ambiguous, so our own pricing claims become unverifiable, and the Store page
headline rate is whatever Apify picks. This is a self-inflicted version of the rival-side
trap `check-primary-event` sweeps for; that script only ever looks at OTHER people's
Actors, so nothing covered our own side until this check.

The real failure mode is LATENT and is what this guards: meta.json is the publish
payload. An Actor can look fine live (platform auto-added the flag back when it had one
event) while its meta.json still declares nothing -- then the next `apify-admin publish`
or `apify push` writes the flagless payload over the good live record. Cycle 3160 found
exactly that on three Actors (grants-gov, shopify-products, substack: live flag present,
meta.json silent) and made all three explicit.

  PASS 1 (static, default, free)  every actors/<slug>/meta.json with >= 2 events must
         declare exactly one `isPrimaryEvent: true`. Zero is the cycle-3157 bug. Two or
         more is incoherent -- the platform picks one and our tools pick another.
  PASS 2 (--live, ~1 GET per multi-event Actor)  the newest `pricingInfos` entry's event
         flags must MATCH what meta.json declares, both ways. Catches drift in either
         direction: a flag we declare but never shipped, and a flag the platform added
         that we never wrote down (the latent case above).

Single-event Actors are deliberately NOT flagged. The platform auto-add is reliable in
that case, and demanding the flag on all 24 of them would be noise that buries the real
signal. They are re-checked by PASS 2 only if they ever gain a second event.

`isOneTimeEvent` is reported but never required: whether a secondary event is one-time
(a per-run digest) or recurring (a per-item add-on) is a product fact this script cannot
derive. PASS 2 still diffs it against live so a silent change is visible.

Read-only: GET /v2/acts/<id> only, no Actor runs, no writes.
"""
import glob
import json
import os
import re
import sys
import urllib.request

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
API = "https://api.apify.com/v2"


def token():
    env = open(os.path.join(ROOT, "secrets/env")).read()
    return re.search(r"APIFY_TOKEN=(\S+)", env).group(1)


def live_events(slug, tok):
    """Newest pricingInfos entry's actorChargeEvents, or None if not PPE/not found."""
    url = f"{API}/acts/{slug}?token={tok}"
    req = urllib.request.Request(url, headers={"Accept": "application/json"})
    with urllib.request.urlopen(req, timeout=60) as r:
        data = json.load(r)["data"]
    pis = data.get("pricingInfos") or []
    if not pis:
        return None
    ppe = pis[-1].get("pricingPerEvent")
    if not ppe:
        return None
    return ppe.get("actorChargeEvents") or {}


def flags(ev):
    return {
        k: (bool(v.get("isPrimaryEvent")), bool(v.get("isOneTimeEvent")))
        for k, v in ev.items()
    }


def main():
    want_live = "--live" in sys.argv
    tok = token() if want_live else None

    # Resolve local slug -> the owner~name the API wants, via registry if present.
    owner = None
    try:
        env = open(os.path.join(ROOT, "secrets/env")).read()
        m = re.search(r"APIFY_USERNAME=(\S+)", env)
        owner = m.group(1) if m else None
    except OSError:
        pass

    multi, flagged = [], 0
    for path in sorted(glob.glob(os.path.join(ROOT, "actors/*/meta.json"))):
        slug = os.path.basename(os.path.dirname(path))
        if slug.startswith("_"):
            continue
        try:
            meta = json.load(open(path))
        except (OSError, ValueError) as e:
            print(f"  UNREADABLE {slug}: {e}")
            flagged += 1
            continue
        ev = meta.get("events") or {}
        if len(ev) < 2:
            continue
        multi.append((slug, ev))

    print(f"check-event-flags: {len(multi)} multi-event Actor(s) of "
          f"{len(glob.glob(os.path.join(ROOT, 'actors/*/meta.json')))} checked"
          f"{' (PASS 1 + PASS 2 live)' if want_live else ' (PASS 1 static only)'}")

    for slug, ev in multi:
        prim = [k for k, v in ev.items() if v.get("isPrimaryEvent")]
        if len(prim) != 1:
            print(f"  FLAG {slug}: {len(ev)} events, {len(prim)} declared "
                  f"isPrimaryEvent (want exactly 1) -- {sorted(ev)}")
            flagged += 1
            continue
        line = f"  ok   {slug}: {len(ev)} events, primary={prim[0]}"

        if want_live:
            handle = f"{owner}~{slug}" if owner else slug
            try:
                lev = live_events(handle, tok)
            except Exception as e:  # network/auth -- loud, not silent-pass
                print(f"  FLAG {slug}: live read failed: {e}")
                flagged += 1
                continue
            if lev is None:
                print(f"  FLAG {slug}: no live PAY_PER_EVENT pricingInfos entry")
                flagged += 1
                continue
            lf, mf = flags(lev), flags(ev)
            if lf != mf:
                print(f"  FLAG {slug}: live/meta flag drift")
                for k in sorted(set(lf) | set(mf)):
                    if lf.get(k) != mf.get(k):
                        print(f"         {k}: meta(primary,onetime)={mf.get(k)} "
                              f"live={lf.get(k)}")
                flagged += 1
                continue
            line += "  [live matches]"
        print(line)

    if flagged:
        print(f"\n{flagged} FLAG(S) -- a multi-event Actor's primary rate is ambiguous "
              f"to every price-reading tool we own. Fix meta.json, then publish.")
        return 1
    print("\nCLEAN -- every multi-event Actor declares exactly one primary event"
          + (" and matches live." if want_live else "."))
    return 0


if __name__ == "__main__":
    sys.exit(main())
