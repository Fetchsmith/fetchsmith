#!/root/agent/venv/bin/python
"""Flag a named rival whose LIVE price beats ours but whose README paragraph never says so.

Queued at cycle 1112/1113 (NEXT-CYCLE item 2) after `google-play-reviews-scraper`'s README
spent ~3 months publishing "No Actor in this niche advertises a lower per-review price than
ours" while `apihq/google-play-reviews-scraper` had charged 20% less, unnoticed, since
2026-07-10. `check-pricing` verifies OUR charge events against the platform; `check-
competitor-claims` verifies rivals' USER COUNTS and paragraph freshness; `check-comparison-
breadth` counts rival HANDLES. None of the three reads a rival's own live price and compares
it to ours -- this script is that missing comparison.

Scope, deliberately narrow:
  - Only looks at rivals we have ALREADY named by full `owner/slug` (same regex as
    check-comparison-breadth). It cannot catch an UNNAMED cheaper rival -- that needs a full
    Store sweep during a competitor_audit, same caveat check-comparison-breadth documents.
  - "Our price" and "rival price" are each reduced to ONE number: the event flagged
    `isPrimaryEvent` if the live record has one, else the cheapest non-one-time (not a
    start/setup fee) event, else the cheapest event of any kind. A MIXED shape
    (`$0.10/run + $0.00001/row`) still reduces to its per-row number, so it compares
    unfavourably here at low volume and favourably at high volume -- for that shape this
    script picks one number and does not model a crossover. Treat a flag as "go look", not as
    a confirmed false claim (same spirit as check-comparison-breadth's NARROW).
  - A PURE run-fee-only rival (every charge event run-scoped, no per-row event at all) is the
    one case where the single number is not just imprecise but backwards, so since cycle 1392
    it is held out of the comparison above and routed to `runfee_price` + an exact crossover
    instead. See that function's docstring (closes 0-TODO-h1356-run-fee-only-rivals).
  - A rival on Apify's FREE pricing model prices at $0 (cycle 1104 LEARNINGS: FREE/absent
    `pricingInfos` is the cheapest possible rival, not missing data -- a checker that skips it
    sees the opposite of the truth).
  - A rival whose live pricingModel is neither PAY_PER_EVENT nor FREE (e.g. a flat monthly
    price) is skipped, not flagged -- not safely comparable to our per-event price with a
    single number.
  - Only flags when NO paragraph naming the rival anywhere in the file contains a disclosure
    keyword (cheap/undercut/lower/beats/crossover/"do not claim"/etc). First tried scoping
    the disclosure check to the one paragraph where the price comparison lives, and it false-
    flagged `sam-gov-opportunities-scraper`'s `jungle_synthesizer`: the Pricing paragraph
    fully discloses it as cheaper ("cheaper than our flat $0.0015 at every tier", "We are not
    the cheapest... jungle_synthesizer... undercut us"), but an unrelated FAQ paragraph later
    names the same handle again for its attachment-download feature, with no price word in
    sight -- same "mention without the magic word" trap `check-competitor-claims`'s RIVALS
    regex already has to dodge. Whole-file disclosure is the lesser false-positive risk; it
    could in principle miss a rival disclosed in one README but silently re-named undisclosed
    in another, but no such case exists in the fleet today.

Runtime, measured (cycle 1384, closes 0-TODO-h1368-cps-progress-line): **~75s** for 23 live
Actors / 1595 unique live Actor records / 1603 price comparisons, with the GETs in an 8-thread
prefetch pool. The figure this docstring and PLAYBOOK.md carried until now -- "~70s for 24
Actors / ~180 calls" -- was measured at cycle 1115, when the niches really were that small;
the call count has since grown ~9x, so the same ~70s wall clock is now a coincidence of the
parallelism added here, not continuity. Sequential, those 1595 calls took long enough that
cycle 1366 read a 280s timeout as a hang and filed a bug against the Apify API. Progress now
goes to STDERR with flush=True (prefetch counter every 100 records, then one line per Actor),
so a long run is visibly alive even under `timeout ... > file`, where Python fully buffers
stdout; STDOUT still carries only the UNDISCLOSED/SKIP findings and the summary line, so
nothing that parses this script's stdout needs to change.

Read-only: GETs only, no Actor runs, no file writes.
"""
import datetime
import glob
import json
import os
import re
import sys
import time
from concurrent.futures import ThreadPoolExecutor

import httpx

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
API = "https://api.apify.com/v2"
FULL_HANDLE = re.compile(r"`([a-z][a-z0-9_.-]{2,}/[A-Za-z0-9_.-]+)`")
DISCLOSED = re.compile(
    r"cheap|undercut|lower|beats?\b|crossover|do not claim|genuine|free pricing model|\$0\b",
    re.I,
)
EPSILON = 1e-9
# A run-fee-only rival (see runfee_price) is cheaper than us on every run bigger than
# `its flat fee / our per-row price` rows. Our Actors are bulk row exporters whose useful
# runs are tens-to-thousands of rows, so a crossover under this many rows means a typical
# customer run really does cost less there and the README has to say so. Above it, the
# rival only wins on runs too small to be the use case we sell, which is not a claim defect.
RUNFEE_CROSSOVER_ROWS = 1000


def token():
    for line in open(os.path.join(ROOT, "secrets/env")):
        if line.startswith("APIFY_TOKEN"):
            return line.split("=", 1)[1].strip().strip('"')
    sys.exit("check-price-superiority: no APIFY_TOKEN in secrets/env")


def effective(pricing_infos, now):
    live = [p for p in (pricing_infos or [])
            if p.get("startedAt")
            and datetime.datetime.fromisoformat(p["startedAt"].replace("Z", "+00:00")) <= now]
    return live[-1] if live else None


def price_of(event):
    if "eventPriceUsd" in event:
        return event["eventPriceUsd"]
    tiers = event.get("eventTieredPricingUsd") or {}
    return (tiers.get("FREE") or {}).get("tieredEventPriceUsd")


def headline_price(act_data, now):
    """(price, label) for the one number this script treats as "the" price, or (None, reason)."""
    pricing_infos = act_data.get("pricingInfos")
    cur = effective(pricing_infos, now)
    if cur is None:
        if not pricing_infos:
            # No pricingInfos at all (never monetized) is the cheapest possible rival,
            # not missing data (cycle 1104 LEARNINGS) -- score it $0, don't skip it.
            return 0.0, "no pricing record -- free to run"
        return None, "no pricing in effect"
    model = cur.get("pricingModel")
    if model == "FREE":
        return 0.0, "FREE pricing model"
    if model != "PAY_PER_EVENT":
        return None, f"pricingModel={model}, not comparable"
    events = cur.get("pricingPerEvent", {}).get("actorChargeEvents", {}) or {}
    if not events:
        return None, "no charge events"
    # `apify-actor-start` is Apify's own reserved key for the run-start charge -- a
    # one-time start fee in substance even when the owner never set isOneTimeEvent, AND
    # even when the owner (mistakenly or not) marks it isPrimaryEvent (cycle 1385 LEARNINGS:
    # delectable_incubator/google-news-scraper-low-cost and fanciful_geode/google-news-es both
    # flag apify-actor-start as primary, which used to make this function report the $0.00005
    # start fee as "the price" instead of the real $0.00239/$0.001 per-row rate -- cycle 1360's
    # fix only excluded it from the non-primary fallback pool, not this branch).
    primary = [n for n, e in events.items() if e.get("isPrimaryEvent") and n != "apify-actor-start"]
    if primary:
        name = primary[0]
    else:
        non_onetime = [n for n, e in events.items()
                       if not e.get("isOneTimeEvent") and n != "apify-actor-start"]
        pool = non_onetime or list(events.keys())
        name = min(pool, key=lambda n: (price_of(events[n]) if price_of(events[n]) is not None else float("inf")))
    p = price_of(events[name])
    return (p, name) if p is not None else (None, f"{name} has no resolvable price")


def runfee_price(act_data, now):
    """(flat_usd_per_run, label) when EVERY live charge event is run-scoped, else (None, reason).

    Closes 0-TODO-h1356-run-fee-only-rivals, open since cycle 1356 and re-cited at 1384 and
    1391. `headline_price` above reduces a rival to ONE number and then compares it to our
    per-ROW price. That is right for the per-row rivals which are nearly all of the fleet's
    niches, but it reads a flat per-RUN fee as though it were a per-row rate, and the error
    points the wrong way: `second_coming/brand-mention-monitor` (cycle 1384, re-verified live
    at cycle 1392) charges a single `scan` event of $0.02 with isOneTimeEvent=True and no
    per-row event at all. headline_price takes it as primary, compares $0.02 > our $0.0008
    and stays silent -- but $0.02 buys a WHOLE RUN there, so it undercuts us on any run past
    ~25 rows. A false negative, i.e. exactly the undisclosed-cheaper-rival case this script
    exists to catch, and invisible to it until now. (The other handle 1391 cited for this
    TODO, `firmhound/congressional-intelligence-api`, turned out NOT to be an instance: it
    has a real $0.006/dataset-item event alongside its $0.01 start fee, so headline_price
    already picks the per-row rate correctly. Noted so a later cycle does not re-hunt it.)

    Run-scoped means `apify-actor-start` (Apify's reserved start-fee key) or any event the
    owner marked isOneTimeEvent -- a one-time event bills at most once per run, so when NO
    other event exists the run costs the SUM of them no matter how many rows it returns.
    That sum is both floor and ceiling, which is what makes a single-number crossover against
    our per-row price exact here rather than the "go look" heuristic headline_price gives.

    Returns None for anything with a per-row event left over (headline_price's existing
    comparison owns that case, including the start-fee-plus-per-row shape) and for any event
    whose price will not resolve, so a tiered or malformed record is never silently scored $0.

    Closes 0-TODO-h1396-runfee-ladder-falsepos (filed cycle 1396). The `isOneTimeEvent`-only
    test above used to trust the owner's flag at face value, but cycle 1396 found 3
    `hipersoft/*` listings that flag a real per-ROW event (6-tier volume ladder) as
    isOneTimeEvent=True -- a ladder discounts volume, which is meaningless on a charge that
    bills at most once per run, so the ladder disproves the flag. Taking it at face value
    made every event here look run-scoped and summed the per-row ladder's FREE-tier price as
    though it were the whole run's flat fee, understating the rival without bound -- the
    opposite error from the one this function was built to catch. Delegates to
    bin/_unit_price.py's `is_start_fee`, which already carries this discriminator (and the
    apify-actor-start override) verified live against all 8 hipersoft listings at 1396;
    imported lazily so loading this file never recurses into itself (_unit_price.py loads
    this module by path to get `price_of`/`token`, so a module-level import up here would
    load _unit_price, which would load a fresh copy of this file, which would load
    _unit_price again, forever).
    """
    sys.path.insert(0, os.path.join(ROOT, "bin"))
    import _unit_price as up
    cur = effective(act_data.get("pricingInfos"), now)
    if cur is None or cur.get("pricingModel") != "PAY_PER_EVENT":
        return None, "not a live PAY_PER_EVENT record"
    events = cur.get("pricingPerEvent", {}).get("actorChargeEvents", {}) or {}
    if not events:
        return None, "no charge events"
    per_row = [n for n, e in events.items() if not up.is_start_fee(n, e)]
    if per_row:
        return None, "has per-row event(s): " + ",".join(sorted(per_row))
    total = 0.0
    for name, event in sorted(events.items()):
        p = price_of(event)
        if p is None:
            return None, f"{name} has no resolvable price"
        total += p
    return total, "+".join(sorted(events))


CACHE = {}


def live_actor(ident, headers, cache=CACHE):
    if ident not in cache:
        u, n = ident.split("/")
        r = httpx.get(f"{API}/acts/{u}~{n}", headers=headers, timeout=30)
        cache[ident] = r.json().get("data") if r.status_code == 200 else None
    return cache[ident]


def prefetch(idents, headers, workers=8):
    """Warm CACHE for every handle concurrently; the scoring pass below then reads it.

    Cycle 1384 (closes 0-TODO-h1368-cps-progress-line (c)): the scoring loop is unchanged
    and still sequential -- this only moves the ~1600 blocking GETs it used to make one at a
    time into a small thread pool, so the verdicts are byte-identical but the wall clock is
    not. `idents` is deduped by the caller, so no handle is fetched twice and each CACHE key
    is written by exactly one worker.
    """
    todo = [i for i in idents if i not in CACHE]
    done = 0
    with ThreadPoolExecutor(max_workers=workers) as pool:
        for _ in pool.map(lambda i: live_actor(i, headers), todo):
            done += 1
            if done % 100 == 0 or done == len(todo):
                print(f"  ...prefetched {done}/{len(todo)} live Actor records",
                      file=sys.stderr, flush=True)


def main():
    headers = {"Authorization": f"Bearer {token()}"}
    now = datetime.datetime.now(datetime.timezone.utc)
    registry = json.load(open(os.path.join(ROOT, "actors/registry.json")))
    live = sorted(t["slug"] for t in registry["tools"] if t["status"] == "live")

    # Pass 0: collect every handle this run will need, then fetch them all concurrently.
    # Re-parsing the READMEs below is free compared to one HTTP call, so the scoring loop is
    # left exactly as it was rather than restructured around a prefetched index.
    wanted = set()
    for slug in live:
        path = os.path.join(ROOT, "actors", slug, "README.md")
        if not os.path.exists(path):
            continue
        wanted.add(f"fetchsmith/{slug}")
        wanted.update(FULL_HANDLE.findall(open(path).read()))
    started = time.time()
    print(f"check-price-superiority: {len(live)} live Actor(s), "
          f"{len(wanted)} unique live Actor record(s) to fetch", file=sys.stderr, flush=True)
    prefetch(sorted(wanted), headers)

    compared = cheaper_found = flagged = 0
    runfee_seen = runfee_flagged = 0
    for n, slug in enumerate(live, 1):
        path = os.path.join(ROOT, "actors", slug, "README.md")
        if not os.path.exists(path):
            continue
        print(f"  [{n}/{len(live)}] {slug} ({time.time() - started:.0f}s elapsed)",
              file=sys.stderr, flush=True)
        our = live_actor(f"fetchsmith/{slug}", headers)
        if our is None:
            print(f"SKIP {slug}: our own Actor not readable live")
            continue
        our_price, our_label = headline_price(our, now)
        if our_price is None:
            print(f"SKIP {slug}: our own headline price not resolvable ({our_label})")
            continue

        text = open(path).read()
        paragraphs = text.split("\n\n")
        first_line = {}
        disclosed_anywhere = {}
        offset = 1
        for para in paragraphs:
            lineno = offset
            offset += para.count("\n") + 2
            for ident in sorted(set(FULL_HANDLE.findall(para))):
                first_line.setdefault(ident, lineno)
                disclosed_anywhere[ident] = disclosed_anywhere.get(ident, False) or bool(DISCLOSED.search(para))

        for ident, lineno in sorted(first_line.items()):
            if ident == f"fetchsmith/{slug}":
                continue
            rival = live_actor(ident, headers)
            if rival is None:
                continue  # gone from Store -- check-competitor-claims already flags this
            # Run-fee-only rivals first: headline_price would mis-read their flat per-run fee
            # as a per-row rate and conclude they are dearer. Our own price is per-row for all
            # 24 live Actors, but guard the division anyway -- if we ever price at $0 nobody
            # can undercut us and there is nothing to disclose.
            flat, flat_label = runfee_price(rival, now)
            if flat is not None and our_price > 0:
                runfee_seen += 1
                rows = flat / our_price
                verdict = ("UNDISCLOSED" if rows < RUNFEE_CROSSOVER_ROWS
                           and not disclosed_anywhere[ident] else None)
                if verdict:
                    runfee_flagged += 1
                    flagged += 1
                    print(f"RUNFEE-UNDISCLOSED {slug}/README.md:{lineno}  {ident} charges a flat "
                          f"${flat:g}/run ({flat_label}, no per-row event) vs our "
                          f"${our_price:g}/{our_label} -- cheaper than us on any run over "
                          f"~{rows:.0f} row(s), but no paragraph in this file discloses it")
                else:
                    print(f"RUNFEE {slug}/README.md:{lineno}  {ident} charges a flat ${flat:g}/run "
                          f"({flat_label}) vs our ${our_price:g}/{our_label} -- crossover "
                          f"~{rows:.0f} row(s)"
                          f"{'; disclosed' if disclosed_anywhere[ident] else '; above the '+str(RUNFEE_CROSSOVER_ROWS)+'-row floor'}")
                continue

            rival_price, rival_label = headline_price(rival, now)
            if rival_price is None:
                continue  # not comparable with a single number, see docstring
            compared += 1
            if rival_price + EPSILON < our_price:
                cheaper_found += 1
                if not disclosed_anywhere[ident]:
                    flagged += 1
                    print(f"UNDISCLOSED {slug}/README.md:{lineno}  {ident} charges "
                          f"${rival_price:g}/{rival_label} (live) vs our ${our_price:g}/{our_label} "
                          f"-- cheaper and named, but no paragraph in this file discloses it")

    print(f"check-price-superiority: {compared} named-rival price(s) compared, "
          f"{cheaper_found} cheaper than us, {flagged} undisclosed anywhere in the README "
          f"({runfee_seen} run-fee-only rival(s) held out of the per-row comparison, "
          f"{runfee_flagged} of them undisclosed under the {RUNFEE_CROSSOVER_ROWS}-row "
          f"crossover floor) ({time.time() - started:.0f}s)")
    return 1 if flagged else 0


if __name__ == "__main__":
    sys.exit(main())
