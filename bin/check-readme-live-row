#!/root/agent/venv/bin/python
"""check-readme-live-row (added cycle 1989)

Checks sample-row TRUTH, not just presence. check-readme-samples (cycle 448)
already verifies every key in a README's "Sample output" JSON block is a field
the Actor actually declares -- but it never asks whether the pasted VALUES are
still correct. Cycle 1988 found sam-gov-opportunities-scraper's `12.002` sample
row had been wrong for an unknown number of cycles (`obligations` showed a
flag-only placeholder; the live record has real dollar figures) and no existing
check would have caught it, because buyers read the sample row to decide
whether to pay -- a wrong one is a worse bug than a missing field.

DESIGN, DELIBERATELY NARROW: this does NOT reimplement each Actor's field-
mapping logic (main.js files are monoliths with no exported mapping function,
and duplicating that logic here would just be a second place for it to drift).
Instead each entry below names a small set of SPOT-CHECK fields whose live
JSON path is either identical to the README's key name or a trivial one-level
rename (e.g. raw `financial.obligations` -> README's top-level `obligations`)
-- verified by hand against a live response before being added, not guessed.
Fields that genuinely need the Actor's own transform (nested arrays reshaped,
renamed sub-keys, computed booleans) are deliberately left UNCHECKED here
rather than approximated; see each entry's `skip_note`.

One live GET per entry, no Apify spend, no auth. ADDING AN ACTOR: find its
sample block's natural key, confirm live via curl that the raw API's field
names at the chosen paths literally match (or trivially rename to) the
README's, then add an entry -- do not add a field whose raw shape differs
structurally from the README without a `transform` lambda that is itself
verified live.

Exit 1 = any spot-check field's live value differs from the README's.
--verbose prints every field checked, matched or not.
"""
import datetime
import json
import re
import sys
import urllib.parse
import urllib.request

ACTORS = "/root/agent/actors"
VERBOSE = "--verbose" in sys.argv
HEADING_RE = re.compile(r"^#{1,6}\s+(.*)$")
FENCE_RE = re.compile(r"^```(\w*)\s*$")


def fetch_json(url):
    req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
    with urllib.request.urlopen(req, timeout=20) as r:
        return json.load(r)


def fetch_json_post(url, body):
    data = json.dumps(body).encode()
    req = urllib.request.Request(
        url, data=data, method="POST",
        headers={"User-Agent": "Mozilla/5.0", "Content-Type": "application/json"},
    )
    with urllib.request.urlopen(req, timeout=20) as r:
        return json.load(r)


def get_path(d, path):
    """Dotted path into nested dicts/lists, e.g. 'financial.obligations'."""
    cur = d
    for part in path.split("."):
        if isinstance(cur, list):
            cur = cur[0] if cur else None
        if not isinstance(cur, dict) or part not in cur:
            return None
        cur = cur[part]
    return cur


def sample_block(readme_path, heading_substr):
    """First ```json fence under a heading containing heading_substr, parsed."""
    heading = ""
    lines = readme_path.read_text() if hasattr(readme_path, "read_text") else open(readme_path).read()
    lines = lines.splitlines()
    i = 0
    while i < len(lines):
        h = HEADING_RE.match(lines[i])
        if h:
            heading = h.group(1).strip()
            i += 1
            continue
        f = FENCE_RE.match(lines[i])
        if f and f.group(1) == "json" and heading_substr.lower() in heading.lower():
            start = i + 1
            j = start
            while j < len(lines) and not lines[j].startswith("```"):
                j += 1
            try:
                return json.loads("\n".join(lines[start:j]))
            except Exception:
                return None
        if f:
            start = i + 1
            j = start
            while j < len(lines) and not lines[j].startswith("```"):
                j += 1
            i = j + 1
            continue
        i += 1
    return None


# Each entry: fetch the live record by natural key, then spot-check a few
# fields whose README name is either identical to, or a verified trivial
# rename of, the raw API path.
ENTRIES = [
    {
        "slug": "sam-gov-opportunities-scraper",
        "heading": "Sample assistance-listings output row",
        "key_field": "programNumber",
        # Verified live cycle 1989: index=cfda, q=<exact program number> ->
        # first hit is the matching program (same q-semantics cycle 1985
        # documented for wage-determinations: an exact full-token match wins
        # even though a partial query can OR-flip across tokens).
        "fetch": lambda key: fetch_json(
            "https://sam.gov/api/prod/sgs/v1/search/"
            f"?index=cfda&responseType=json&page=0&size=1&q={urllib.parse.quote(key)}"
        )["_embedded"]["results"][0],
        "fields": {
            "programNumber": "programNumber",
            "title": "title",
            "isActive": "isActive",
            "isFunded": "isFunded",
            "isLatest": "isLatest",
            # Raw nests this under `financial`; README flattens it to
            # top-level `obligations` with the identical sub-shape (verified
            # cycle 1989 by diffing a live fetch against the corrected
            # cycle-1988 README row byte-for-byte).
            "obligations": "financial.obligations",
        },
        "skip_note": (
            "assistanceTypes, organizationHierarchy, contacts, eligibility, "
            "historicalIndexCount are all reshaped by the Actor's own mapping "
            "(nested hierarchy -> flat pairs, org list -> department/agency "
            "strings, etc.) and are intentionally NOT spot-checked here -- "
            "doing so would require reimplementing that transform."
        ),
    },
    {
        "slug": "sam-gov-opportunities-scraper",
        "heading": "wage-determination output",
        "key_field": "referenceNumber",
        # Verified live cycle 1991: index=dbra, q=<exact reference number> -> the single
        # matching determination (same exact-match q semantics cycle 1989/1985 documented
        # for cfda/wage-determinations -- a complete token wins outright). This run FOUND
        # a real drift: the sample's revisionNumber/publishDate/modifiedDate had moved
        # (revision 2 -> 4, 2026-09-17 -> 2026-10-15) since the README sample was captured
        # -- fixed the README row to match live before adding this entry.
        "fetch": lambda key: fetch_json(
            "https://sam.gov/api/prod/sgs/v1/search/"
            f"?index=dbra&responseType=json&page=0&size=1&q={urllib.parse.quote(key)}"
        )["_embedded"]["results"][0],
        "fields": {
            "wageDeterminationId": "_id",
            "referenceNumber": "fullReferenceNumber",
            "shortReferenceNumber": "shortReferenceNumber",
            "title": "title",
            "actCode": "type.code",
            "actName": "type.value",
            "recordType": "_type",
            "isActive": "isActive",
            "isStandard": "isStandard",
            "revisionNumber": "revisionNumber",
            "year": "year",
            # Raw `modifiedDate` is already ISO on a wdDBRA row (confirmed live cycle 1991,
            # unlike `publishDate` which is epoch-ms on DBRA/SCA -- see skip_note), so a
            # direct path match is valid for this specific DBRA sample without reimplementing
            # the Actor's toIso() transform.
            "modifiedDate": "modifiedDate",
            "constructionTypes": "constructionTypes",
        },
        "skip_note": (
            "publishDate (epoch-ms on the raw wdDBRA row, ISO in the README -- needs the "
            "Actor's own toIso() transform), coverage/stateCodes/countyCount (reshaped from "
            "raw `location.state` into a flat array + derived count) and services/wageRates "
            "(null on this DBRA sample, not exercised by it) are intentionally NOT "
            "spot-checked here."
        ),
    },
    {
        "slug": "us-federal-awards-scraper",
        "heading": "Sample row",
        "key_field": "awardId",
        # Verified live cycle 1990: the sample row's award is a contract (awardType
        # "BPA CALL"), so award_type_codes must be the contracts group ['A','B','C','D']
        # (main.js CATEGORIES.contracts) -- award_ids is otherwise exclusive per
        # main.js buildFilters() and widens time_period to the full EARLIEST..today
        # range, so no other filter can hide the match. award_type_codes is still a
        # required field even for an exact award_ids lookup (confirmed: omitting it
        # 400s with "Missing value: 'filters|award_type_codes' is a required field").
        "fetch": lambda key: fetch_json_post(
            "https://api.usaspending.gov/api/v2/search/spending_by_award/",
            {
                "filters": {
                    "award_type_codes": ["A", "B", "C", "D"],
                    "time_period": [{
                        "start_date": "2007-10-01",
                        "end_date": datetime.date.today().isoformat(),
                    }],
                    "award_ids": [key],
                },
                "fields": [
                    "Award ID", "Recipient Name", "Recipient UEI", "Awarding Agency",
                    "Description", "Place of Performance State Code", "pop_city_name",
                    "recipient_location_city_name", "recipient_location_state_code",
                    "def_codes", "Award Amount", "Total Outlays", "Start Date", "End Date",
                    "Contract Award Type", "NAICS", "PSC",
                ],
                "sort": "Award ID", "order": "desc", "limit": 1, "page": 1, "subawards": False,
            },
        )["results"][0],
        "fields": {
            "awardId": "Award ID",
            "awardType": "Contract Award Type",
            "recipientName": "Recipient Name",
            "recipientUei": "Recipient UEI",
            "recipientCity": "recipient_location_city_name",
            "recipientState": "recipient_location_state_code",
            "awardingAgency": "Awarding Agency",
            "description": "Description",
            "awardAmount": "Award Amount",
            "totalOutlays": "Total Outlays",
            "startDate": "Start Date",
            "endDate": "End Date",
            "placeOfPerformanceCity": "pop_city_name",
            "placeOfPerformanceState": "Place of Performance State Code",
            "naicsCode": "NAICS.code",
            "pscCode": "PSC.code",
            "disasterEmergencyFundCodes": "def_codes",
        },
        "skip_note": (
            "awardUrl/generatedInternalId (built from `generated_internal_id` via a URL "
            "template, not a verbatim field), awardCategory (not an API field at all -- "
            "it's which CATEGORIES group main.js chose to query, 'contracts' here by "
            "construction) and awardingSubAgency (sample happens to equal awardingAgency "
            "for this DOE award, not a verified rename) are intentionally NOT spot-checked."
        ),
    },
]

def main():
    failures = []
    checked_entries = 0
    for entry in ENTRIES:
        readme = f"{ACTORS}/{entry['slug']}/README.md"
        sample = sample_block(readme, entry["heading"])
        if sample is None:
            failures.append(f"{entry['slug']}: could not find/parse sample block under heading {entry['heading']!r}")
            continue
        key_value = sample.get(entry["key_field"])
        if not key_value:
            failures.append(f"{entry['slug']}: sample block has no {entry['key_field']!r}")
            continue
        try:
            live = entry["fetch"](key_value)
        except Exception as e:
            failures.append(f"{entry['slug']}: live fetch for {entry['key_field']}={key_value!r} failed: {e}")
            continue
        checked_entries += 1
        for readme_field, live_path in entry["fields"].items():
            readme_val = sample.get(readme_field)
            live_val = get_path(live, live_path)
            if readme_val != live_val:
                failures.append(
                    f"{entry['slug']}: field {readme_field!r} (key {entry['key_field']}={key_value!r}) "
                    f"README={readme_val!r} LIVE={live_val!r}"
                )
            elif VERBOSE:
                print(f"OK {entry['slug']}.{readme_field} = {readme_val!r}")

    print(f"check-readme-live-row: {checked_entries} entr{'y' if checked_entries == 1 else 'ies'} checked, {len(failures)} mismatch(es)")
    for f in failures:
        print(f"MISMATCH: {f}")
    sys.exit(1 if failures else 0)


if __name__ == "__main__":
    main()
