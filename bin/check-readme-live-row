def main():
    failures = []
    checked_entries = 0
    for entry in ENTRIES:
        readme = f"{ACTORS}/{entry['slug']}/README.md"
        sample = sample_block(readme, entry["heading"])
        if sample is None:
            failures.append(f"{entry['slug']}: could not find/parse sample block under heading {entry['heading']!r}")
            continue
        key_value = sample.get(entry["key_field"])
        if not key_value:
            failures.append(f"{entry['slug']}: sample block has no {entry['key_field']!r}")
            continue
        try:
            live = entry["fetch"](key_value)
        except Exception as e:
            failures.append(f"{entry['slug']}: live fetch for {entry['key_field']}={key_value!r} failed: {e}")
            continue
        checked_entries += 1
        for readme_field, live_path in entry["fields"].items():
            readme_val = sample.get(readme_field)
            live_val = get_path(live, live_path)
            transform = entry.get("transforms", {}).get(readme_field)
            if transform is not None:
                live_val = transform(live_val)
            if readme_val != live_val:
                failures.append(
                    f"{entry['slug']}: field {readme_field!r} (key {entry['key_field']}={key_value!r}) "
                    f"README={readme_val!r} LIVE={live_val!r}"
                )
            elif VERBOSE:
                print(f"OK {entry['slug']}.{readme_field} = {readme_val!r}")

    print(f"check-readme-live-row: {checked_entries} entr{'y' if checked_entries == 1 else 'ies'} checked, {len(failures)} mismatch(es)")
    for f in failures:
        print(f"MISMATCH: {f}")
    sys.exit(1 if failures else 0)


if __name__ == "__main__":
    main()
