#!/root/agent/venv/bin/python
"""check-readme-live-row (added cycle 1989)

Checks sample-row TRUTH, not just presence. check-readme-samples (cycle 448)
already verifies every key in a README's "Sample output" JSON block is a field
the Actor actually declares -- but it never asks whether the pasted VALUES are
still correct. Cycle 1988 found sam-gov-opportunities-scraper's `12.002` sample
row had been wrong for an unknown number of cycles (`obligations` showed a
flag-only placeholder; the live record has real dollar figures) and no existing
check would have caught it, because buyers read the sample row to decide
whether to pay -- a wrong one is a worse bug than a missing field.

DESIGN, DELIBERATELY NARROW: this does NOT reimplement each Actor's field-
mapping logic (main.js files are monoliths with no exported mapping function,
and duplicating that logic here would just be a second place for it to drift).
Instead each entry below names a small set of SPOT-CHECK fields whose live
JSON path is either identical to the README's key name or a trivial one-level
rename (e.g. raw `financial.obligations` -> README's top-level `obligations`)
-- verified by hand against a live response before being added, not guessed.
Fields that genuinely need the Actor's own transform (nested arrays reshaped,
renamed sub-keys, computed booleans) are deliberately left UNCHECKED here
rather than approximated; see each entry's `skip_note`.

One live GET per entry, no Apify spend, no auth. ADDING AN ACTOR: find its
sample block's natural key, confirm live via curl that the raw API's field
names at the chosen paths literally match (or trivially rename to) the
README's, then add an entry -- do not add a field whose raw shape differs
structurally from the README without a `transform` lambda that is itself
verified live.

Exit 1 = any spot-check field's live value differs from the README's.
--verbose prints every field checked, matched or not.
"""
import datetime
import json
import os
import re
import sys
import urllib.parse
import urllib.request
import xml.etree.ElementTree as ET

ACTORS = "/root/agent/actors"
VERBOSE = "--verbose" in sys.argv
HEADING_RE = re.compile(r"^#{1,6}\s+(.*)$")
FENCE_RE = re.compile(r"^```(\w*)\s*$")


def fetch_json(url):
    req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
    with urllib.request.urlopen(req, timeout=20) as r:
        return json.load(r)


def fetch_json_post(url, body):
    data = json.dumps(body).encode()
    req = urllib.request.Request(
        url, data=data, method="POST",
        headers={"User-Agent": "Mozilla/5.0", "Content-Type": "application/json"},
    )
    with urllib.request.urlopen(req, timeout=20) as r:
        return json.load(r)


def fetch_text(url):
    # SEC's www.sec.gov/Archives (unlike efts.sec.gov) enforces its fair-access policy and
    # 403s a generic UA -- verified live cycle 1995, same declarative-contact format the
    # Actor's own secGet() sends.
    ua = "FetchSmith-check-readme-live-row admin@fetchsmith.com" if "sec.gov" in url else "Mozilla/5.0"
    req = urllib.request.Request(url, headers={"User-Agent": ua})
    with urllib.request.urlopen(req, timeout=20) as r:
        return r.read().decode()


# sec-insider-trades-scraper's sample row has no single-GET live endpoint (unlike every
# other entry below): the row's `id` encodes an accession number + transaction selector +
# in-document index, and the raw source is a Form 4 ownership XML filed under the issuer's
# EDGAR CIK, not a JSON API. Verified live cycle 1995 end to end against the README's own
# sample (accession 0001140361-26-037020, row n0): EDGAR's full-text-search index
# (efts.sec.gov) resolves an accession number straight to its CIK + filename without first
# needing to know the issuer (main.js itself gets there via a ticker->CIK map + a
# submissions-index page scan, a path this check deliberately skips since it already has
# the accession number), then the raw XML is fetched from the Archives path using EITHER
# CIK efts returns (confirmed live: the same filing resolves under both the reporting
# owner's CIK 1780525 and the issuer's CIK 320193 -- EDGAR cross-indexes a submission under
# every filer CIK on it, not just the issuer).
SEC_FORM4_ID_RE = re.compile(r"^(?P<acc>\d{10}-\d{2}-\d{6})-(?P<der>[nd])(?P<hold>h?)(?P<idx>\d+)$")
# Mirrors main.js's CODE_MEANING table verbatim (the only transaction codes a buyer sees
# decoded) -- a static lookup table, not a derived value, so this is a copy rather than a
# `transforms` lambda, verified against main.js's own literal at the time this was added.
SEC_CODE_MEANING = {
    "P": "Open-market purchase", "S": "Open-market sale", "A": "Grant/award", "D": "Disposition to issuer",
    "F": "Shares withheld for taxes", "M": "Option exercise/conversion", "C": "Conversion of derivative",
    "G": "Gift", "X": "Option exercise (in the money)", "J": "Other (see footnotes)", "K": "Equity swap",
    "I": "Discretionary transaction", "H": "Expiration (long derivative)", "E": "Expiration (short derivative)",
    "U": "Tender of shares", "L": "Small acquisition", "W": "Will or laws of descent", "Z": "Voting trust",
    "O": "Option exercise (out of the money)", "V": "Voluntarily reported early",
}


def sec_num(s):
    if s is None or s == "":
        return None
    try:
        return float(s) if "." in s else int(s)
    except ValueError:
        return None


def fetch_sec_form4_row(key):
    """Fetch and re-derive one sec-insider-trades-scraper row by its `id`, mirroring
    main.js's rowsFromXml() field-by-field (verified live cycle 1995 against the README's
    own sample row, byte-for-byte on every field including the two derived ones)."""
    m = SEC_FORM4_ID_RE.match(key)
    if not m:
        raise ValueError(f"id {key!r} doesn't match accession-number-n/d[h]idx shape")
    acc, derivative, holding, idx = m.group("acc"), m.group("der") == "d", m.group("hold") == "h", int(m.group("idx"))
    hit = fetch_json(
        f"https://efts.sec.gov/LATEST/search-index?q=%22{urllib.parse.quote(acc)}%22&forms=4"
    )["hits"]["hits"][0]
    cik = int(hit["_source"]["ciks"][0])
    filename = hit["_id"].split(":")[1]
    acc_nodash = acc.replace("-", "")
    root = ET.fromstring(fetch_text(
        f"https://www.sec.gov/Archives/edgar/data/{cik}/{acc_nodash}/{filename}"
    ))

    def t(el, path):
        n = el.find(path)
        return n.text.strip() if n is not None and n.text else None

    footnotes = {f.get("id"): (f.text or "").strip() for f in root.findall(".//footnotes/footnote")}

    def footnote_text(el):
        seen = []
        for fid in (n.get("id") for n in el.iter("footnoteId")):
            if fid in footnotes and footnotes[fid] not in seen:
                seen.append(footnotes[fid])
        return " ".join(seen) if seen else None

    owner = root.find(".//reportingOwner")
    table = root.find("derivativeTable" if derivative else "nonDerivativeTable")
    tx_tag = ("derivativeHolding" if holding else "derivativeTransaction") if derivative \
        else ("nonDerivativeHolding" if holding else "nonDerivativeTransaction")
    tx = table.findall(tx_tag)[idx]

    code = None if holding else t(tx, "transactionCoding/transactionCode")
    shares = None if holding else sec_num(t(tx, "transactionAmounts/transactionShares/value"))
    price = None if holding else sec_num(t(tx, "transactionAmounts/transactionPricePerShare/value"))
    acq = None if holding else t(tx, "transactionAmounts/transactionAcquiredDisposedCode/value")

    return {
        "id": key,
        "accessionNumber": acc,
        "formType": t(root, "documentType"),
        "filingDate": hit["_source"]["file_date"],
        "periodOfReport": t(root, "periodOfReport"),
        "issuerName": t(root, "issuer/issuerName"),
        "ticker": t(root, "issuer/issuerTradingSymbol"),
        "insiderName": t(owner, "reportingOwnerId/rptOwnerName"),
        "isOfficer": t(owner, "reportingOwnerRelationship/isOfficer") == "true",
        "officerTitle": t(owner, "reportingOwnerRelationship/officerTitle"),
        "derivative": derivative,
        "securityTitle": t(tx, "securityTitle/value"),
        "transactionDate": t(tx, "transactionDate/value"),
        "transactionCode": code,
        "transactionCodeMeaning": SEC_CODE_MEANING.get(code) if code else None,
        "acquiredOrDisposed": acq,
        "shares": shares,
        "pricePerShare": price,
        "transactionValueUsd": round((-1 if acq == "D" else 1) * shares * price, 2)
            if shares is not None and price is not None else None,
        "sharesOwnedAfter": sec_num(t(tx, "postTransactionAmounts/sharesOwnedFollowingTransaction/value")),
        "rule10b5_1Plan": t(root, "aff10b5One") == "true",
        "footnotes": footnote_text(tx),
    }


def grants_parse_money(v):
    """Mirrors grants-gov-scraper main.js parseMoney() verbatim (one-liner, see src/main.js):
    non-string -> None; otherwise JS Number(v), None when not finite. Grants.gov sends award
    amounts as STRINGS and uses the literal "none" for "agency set no floor/ceiling"
    (confirmed live cycle 1996: awardCeiling "500000", awardFloor "none" on opp 357002)."""
    if not isinstance(v, str):
        return None
    s = v.strip()
    if s == "":
        return 0  # JS Number('') === 0; mirrored deliberately rather than "fixed" here
    try:
        n = float(s)
    except ValueError:
        return None  # covers "none" and any other non-numeric string
    return int(n) if n.is_integer() else n


def grants_selected_attachments(folders):
    """Build main.js's `attachments` array (flatMap synopsisAttachmentFolders ->
    synopsisAttachments, building downloadUrl from the attachment id, main.js:861-870,
    verified line-for-line) for opportunity 332894's live record, then narrow it to the exact
    two attachments the README's hand-picked sample illustrates (ids 306813 and 350603,
    identified by the downloadUrl those ids build), in the same order the live record's own
    folder iteration produces (verified live: 306813 is folder 0's attachment, 350603 is
    folder 2's -- the README's sample order matches that natural order, not a re-sort). The
    live record has 5 real attachments total (confirmed live, matches the README's own prose
    "five attachments in total"); the README's JSON block deliberately shows only 2 as an
    illustration, so whole-array equality would never match -- this is the
    select-the-shown-subset shape queue.md scoped for this entry, not a bug.

    fileDescription passes through cleanText() in main.js (decodeEntities + tag-strip +
    whitespace-collapse), which this check deliberately never mirrors anywhere (see every
    title/synopsisText skip_note above -- decodeEntities is a custom entity table with an
    iterative fixpoint loop, not a one-line mirror). But for these specific two descriptions
    cleanText is a PROVEN no-op: by inspection of cleanText's own definition, a string with no
    HTML entity sequence, no tag, and no run of whitespace to collapse comes out identical.
    Checked live, not assumed -- and asserted here, so a future re-sample that picks a
    description actually needing cleanText() raises instead of silently comparing wrong.
    """
    shown_ids = {306813, 350603}
    out = []
    for f in (folders or []):
        for a in (f.get("synopsisAttachments") or []):
            if a.get("id") not in shown_ids:
                continue
            desc = a.get("fileDescription")
            if desc and (
                re.search(r"&(#x?[0-9a-fA-F]+|[a-zA-Z]+);", desc)
                or re.search(r"<[^>]+>", desc)
                or re.search(r"\s{2,}", desc)
            ):
                raise RuntimeError(
                    f"fileDescription {desc!r} (attachment id {a.get('id')}) may need "
                    "cleanText(); grants_selected_attachments()'s plain-text assumption broke"
                )
            out.append({
                "fileName": a.get("fileName"),
                "description": desc,
                "mimeType": a.get("mimeType"),
                "sizeBytes": a.get("fileLobSize") if isinstance(a.get("fileLobSize"), (int, float)) else None,
                "folderName": f.get("folderName"),
                "folderType": f.get("folderType"),
                "postedDate": a.get("createdDate"),
                "downloadUrl": f"https://www.grants.gov/grantsws/rest/opportunity/att/download/{a['id']}",
            })
    return out


def fetch_grants_gov_row(key):
    """Fetch one grants-gov-scraper row's two live halves by opportunity id.

    Unlike every other entry, this Actor's row is a MERGE of two API responses (verified
    live cycle 1996 by reading main.js first): the thin half comes from `/search2`'s
    `oppHits[]` (normalizeThin) and the enriched half from `/fetchOpportunity`
    (normalizeEnriched). Rather than approximate the merge, this returns both halves under
    explicit `thin.`/`detail.` path prefixes so each entry field names the half it came from.

    `/search2` has no id lookup -- only `oppNum` (main.js's own walkOppNums path) -- so the
    opportunity number is read off the detail record first, then the thin row is fetched by
    that number across all four statuses and asserted to be the same id.
    """
    detail = fetch_json_post(
        "https://api.grants.gov/v1/api/fetchOpportunity", {"opportunityId": str(key)}
    )["data"]
    opp_num = detail.get("opportunityNumber")
    if not opp_num:
        raise RuntimeError(f"detail record for id={key!r} has no opportunityNumber")
    hits = fetch_json_post(
        "https://api.grants.gov/v1/api/search2",
        {
            "resultType": "json", "oppNum": opp_num,
            "oppStatuses": "forecasted|posted|closed|archived",
            "rows": 10, "startRecordNum": 0,
        },
    )["data"].get("oppHits") or []
    thin = next((h for h in hits if str(h.get("id")) == str(key)), None)
    if thin is None:
        raise RuntimeError(
            f"no /search2 oppHit with id={key!r} for oppNum={opp_num!r} "
            f"({len(hits)} hit(s) returned)"
        )
    return {"thin": thin, "detail": detail}


def fetch_uk_fts_row(notice_id):
    """Fetch one uk-find-a-tender-scraper row's live OCDS release by Find a Tender notice id.

    The notice id IS the primary key -- `ocdsReleasePackages/<id>` 404s on an unknown id
    (verified live cycle 1998), same no-wrong-hit shape as the clinicaltrials/federal-register
    entries below, so there is no search-semantics risk to get wrong.

    main.js's normalize() (read first, not guessed) pulls several README fields out of
    structures `get_path` can't express (first party with a given role; CPV codes scattered
    across `tender.classification` + every item's `classification`/`additionalClassifications`;
    region/location dedup across every item) -- so those are precomputed here under `_`-prefixed
    keys, each a verified line-for-line mirror of the corresponding main.js helper
    (`party()`/`allCpv()`/`deliveryRegions()`/`deliveryLocations()`), not an approximation.
    """
    pkg = fetch_json(f"https://www.find-tender.service.gov.uk/api/1.0/ocdsReleasePackages/{urllib.parse.quote(notice_id)}")
    releases = pkg.get("releases") or []
    release = next((r for r in releases if str(r.get("id")) == str(notice_id)), None)
    if release is None:
        raise RuntimeError(f"no release with id={notice_id!r} ({len(releases)} returned)")
    tender = release.get("tender") or {}

    # main.js allCpv(): tender-level classification + every item's classification/additionalClassifications.
    cpv = []
    cls = tender.get("classification") or {}
    if cls.get("scheme") == "CPV" and cls.get("id"):
        cpv.append(str(cls["id"]))
    for item in tender.get("items") or []:
        icls = item.get("classification") or {}
        if icls.get("scheme") == "CPV" and icls.get("id"):
            cpv.append(str(icls["id"]))
        for c in item.get("additionalClassifications") or []:
            if c.get("scheme") == "CPV" and c.get("id"):
                cpv.append(str(c["id"]))
    seen = set()
    cpv_uniq = [c for c in cpv if not (c in seen or seen.add(c))]

    # main.js party(release, 'buyer'): first party whose roles[] includes 'buyer'.
    buyer = next((p for p in (release.get("parties") or []) if "buyer" in (p.get("roles") or [])), None) or {}

    # main.js deliveryRegions()/deliveryLocations(): dedup across every item.
    regions, locations = [], []
    for item in tender.get("items") or []:
        for addr in item.get("deliveryAddresses") or []:
            if addr.get("region"):
                regions.append(addr["region"])
        if (item.get("deliveryLocation") or {}).get("description"):
            locations.append(item["deliveryLocation"]["description"])
    seen_r, seen_l = set(), set()
    regions_uniq = [r for r in regions if not (r in seen_r or seen_r.add(r))]
    locations_uniq = [l for l in locations if not (l in seen_l or seen_l.add(l))]

    return {
        **release,
        "_cpvCodes": cpv_uniq,
        "_buyer": buyer,
        "_deliveryRegions": regions_uniq,
        "_deliveryLocations": locations_uniq,
    }


def fetch_clinicaltrials_site_row(nct_id):
    """Fetch one clinicaltrials-scraper `rowsPerStudy: "site"` row.

    main.js's normalizeStudy() (read first, src/main.js:938-944) builds each `facilities[]`
    entry as a flat {facility, status, city, state, country, lat, lon} object, with lat/lon
    lifted straight out of each location's own `geoPoint.lat`/`geoPoint.lon` -- a pure
    structural flatten, no renames beyond that, verified line-for-line against the live
    response below. `rowsPerStudy: "site"` then explodes one row per facility, pairing that
    flat object with the SAME top-level study fields the "study" mode entry above already
    checks (src/main.js:1132-1136), so this entry reuses that shape for everything except
    `locations`/`locationCount` (dropped in site mode) and adds `site`.

    The README's sample is ONE site out of this study's 113 (confirmed live), so -- same
    select-the-shown-subset rule as grants_selected_attachments() -- this does not compare the
    whole `facilities[]` array. It selects by the exact facility+city the README itself shows
    (`Arizona Oncology Associates` / `Tucson`), verified live this cycle to be the only
    location on NCT06246916 matching either field, so the pair is an unambiguous key, not a
    guess.
    """
    study = fetch_json(
        f"https://clinicaltrials.gov/api/v2/studies/{urllib.parse.quote(nct_id)}?format=json"
    )
    p = study.get("protocolSection") or {}
    id_mod = p.get("identificationModule") or {}
    status_mod = p.get("statusModule") or {}
    design_mod = p.get("designModule") or {}
    sponsor_mod = p.get("sponsorCollaboratorsModule") or {}
    locs = (p.get("contactsLocationsModule") or {}).get("locations") or []
    matches = [
        l for l in locs
        if l.get("facility") == "Arizona Oncology Associates" and l.get("city") == "Tucson"
    ]
    if len(matches) != 1:
        raise RuntimeError(
            f"expected exactly 1 Arizona Oncology Associates/Tucson location on {nct_id!r}, "
            f"found {len(matches)} (of {len(locs)} total)"
        )
    l = matches[0]
    return {
        "nctId": id_mod.get("nctId"),
        "overallStatus": status_mod.get("overallStatus"),
        "phases": design_mod.get("phases"),
        "leadSponsorClass": (sponsor_mod.get("leadSponsor") or {}).get("class"),
        "site": {
            "facility": l.get("facility"),
            "status": l.get("status"),
            "city": l.get("city"),
            "state": l.get("state"),
            "country": l.get("country"),
            "lat": (l.get("geoPoint") or {}).get("lat"),
            "lon": (l.get("geoPoint") or {}).get("lon"),
        },
    }


def list_dedup(v):
    """Mirrors fda-recall-scraper main.js's list(): Array.from(new Set(v.filter(Boolean))) --
    dedup preserving first-occurrence order, drop falsy entries. Verified live cycle 1999: the
    README sample's openfda arrays (product_ndc/package_ndc/upc/rxcui) are already unique with
    no falsy entries, so this is exercised as a straight pass-through on this sample, not
    approximated for the harder case."""
    seen = set()
    return [x for x in (v or []) if x and not (x in seen or seen.add(x))]


def fda_first(v):
    """Mirrors fda-recall-scraper main.js's first(): Array.isArray(v) ? v[0] ?? null : v ?? null."""
    return (v[0] if v else None) if isinstance(v, list) else v


def fda_iso(v):
    """Mirrors fda-recall-scraper main.js's isoOf(): strip non-digits, YYYYMMDD -> YYYY-MM-DD,
    else None. Verified live cycle 1999 against the sample's reportDate/recallInitiationDate/
    centerClassificationDate (all present) and terminationDate (absent on this Ongoing
    recall -- openFDA omits the key entirely rather than sending an empty string, so get_path's
    None already matches isoOf(undefined) -> None without needing this transform, but it is
    applied uniformly for the three present date fields too)."""
    d = re.sub(r"[^0-9]", "", str(v) if v is not None else "")
    return f"{d[0:4]}-{d[4:6]}-{d[6:8]}" if len(d) == 8 else None


def fetch_fda_recall_row(recall_number):
    """Fetch one fda-recall-scraper row live from openFDA's drug/enforcement.json by its
    recall_number -- the id IS the primary key (an exact `recall_number:"<id>"` search is
    verified live cycle 1999 to return `meta.results.total: 1` for the README's sample
    D-0785-2026), so there is no wrong-hit risk, same shape as the clinicaltrials/
    federal-register/uk-fts entries above."""
    data = fetch_json(
        "https://api.fda.gov/drug/enforcement.json"
        f"?search=recall_number:%22{urllib.parse.quote(recall_number)}%22&limit=1"
    )
    results = data.get("results") or []
    if not results:
        raise RuntimeError(f"no openFDA drug/enforcement result for recall_number={recall_number!r}")
    row = results[0]
    if row.get("recall_number") != recall_number:
        raise RuntimeError(f"openFDA returned recall_number={row.get('recall_number')!r}, expected {recall_number!r}")
    return row


def fetch_fec_candidate_row(candidate_id):
    """Fetch one fec-campaign-finance-scraper candidates-mode row live from OpenFEC, mirroring
    exactly the two calls main.js makes for a candidates-mode row with includeTotals on:
    `GET /v1/candidates/?candidate_id=<id>` for identity, then `fetchTotals()`'s
    `GET /v1/candidate/<id>/totals/?per_page=1&sort=-candidate_election_year` for the money
    columns. Both read line-for-line off main.js (cycle 2000), not guessed.

    Returns the raw identity record with the raw totals record nested under `totals`, so the
    entry's `fields` map stays plain snake_case->camelCase paths. A candidate with no totals
    row on file yields `{}` there, and get_path's None then matches main.js's `totals?.x ?? null`
    with no transform needed (the asymmetric-empty-`results` case the Actor's own blog post
    documents).

    Unlike every other entry this one needs a key: OpenFEC has no keyless path (DEMO_KEY is
    itself a shared key with a published ceiling). FEC_API_KEY is read from the environment --
    never hardcode it here. `worker/run.sh` line 7 already exports it for every cycle, so a
    normal cycle needs no extra step; a bare interactive run needs
    `set -a; . /root/agent/secrets/env; set +a` first, and without it this raises a named
    error rather than a 403 (fault-tested cycle 2000). This is an admin-side check, not
    product runtime, so an owner-provided key is in scope."""
    api_key = os.environ.get("FEC_API_KEY")
    if not api_key:
        raise RuntimeError(
            "FEC_API_KEY not in environment -- run `set -a; . /root/agent/secrets/env; set +a` first"
        )

    def fec_get(path, **params):
        params["api_key"] = api_key
        return fetch_json(f"https://api.open.fec.gov/v1{path}?{urllib.parse.urlencode(params)}")

    results = fec_get("/candidates/", candidate_id=candidate_id, per_page=1).get("results") or []
    if not results:
        raise RuntimeError(f"no OpenFEC candidate for candidate_id={candidate_id!r}")
    row = results[0]
    if row.get("candidate_id") != candidate_id:
        raise RuntimeError(f"OpenFEC returned candidate_id={row.get('candidate_id')!r}, expected {candidate_id!r}")
    totals = fec_get(
        f"/candidate/{urllib.parse.quote(candidate_id)}/totals/",
        per_page=1, sort="-candidate_election_year",
    ).get("results") or []
    return {**row, "totals": totals[0] if totals else {}}


TED_FIELDS = [
    'publication-number', 'notice-title', 'notice-type', 'notice-subtype', 'procedure-type',
    'publication-date', 'buyer-name', 'buyer-country', 'buyer-city',
    'organisation-email-buyer', 'organisation-tel-buyer', 'organisation-internet-address-buyer',
    'place-of-performance-country-lot', 'place-of-performance-city-lot',
    'contract-nature', 'classification-cpv', 'description-lot',
    'total-value', 'total-value-cur',
    'deadline-date-lot', 'deadline-receipt-tender-date-lot', 'deadline-receipt-expressions-date-lot',
    'deadline-receipt-request-date-lot', 'links',
    'procedure-identifier', 'change-reason-description',
]  # verbatim copy of eu-ted-tenders-scraper src/main.js:69-79's FIELDS, read first not guessed.

TED_OUTPUT_LANGUAGE = "eng"  # main.js default (input.outputLanguage ?? 'eng'); matches this
# README sample's own titleLanguage, so the default-leg of every language-preference helper
# below is what's actually exercised, not the outputLanguage-override leg.


def ted_first(v):
    """Mirrors main.js firstValue(): Array.isArray(v) ? v[0] ?? null : v ?? null."""
    if isinstance(v, list):
        return v[0] if v else None
    return v if v is not None else None


def ted_preferred_text(m, output_language=TED_OUTPUT_LANGUAGE):
    """Mirrors main.js preferredText(): prefer outputLanguage, else eng, else mul, else the
    first key present. Returns (value, language) like the original."""
    if not isinstance(m, dict) or not m:
        return (None, None)
    if output_language != "eng" and m.get(output_language) is not None:
        return (ted_first(m[output_language]), output_language)
    if m.get("eng") is not None:
        return (ted_first(m["eng"]), "eng")
    if m.get("mul") is not None:
        return (ted_first(m["mul"]), "mul")
    lang = next(iter(m), None)
    if lang is None:
        return (None, None)
    return (ted_first(m[lang]), lang)


def ted_dedupe(arr):
    """Mirrors main.js dedupe(): Array.from(new Set(arr.filter(v => v != null))) -- dedup
    preserving first-occurrence order, dropping only null/undefined (NOT every falsy value,
    unlike fda-recall-scraper's list_dedup -- the two Actors' own helpers differ, so this is
    a deliberately separate function rather than reusing list_dedup)."""
    if not isinstance(arr, list):
        return []
    seen = set()
    out = []
    for v in arr:
        if v is None or v in seen:
            continue
        seen.add(v)
        out.append(v)
    return out


def ted_earliest_date(arr):
    """Mirrors main.js earliestDate(): dedupe, strip a trailing '+offset' or bare 'Z', sort,
    take the earliest."""
    uniq = ted_dedupe(arr)
    if not uniq:
        return None
    cleaned = sorted(re.sub(r"Z$", "", str(d).split("+")[0]) for d in uniq)
    return cleaned[0]


TED_DEADLINE_SOURCES = [
    ("deadline-receipt-tender-date-lot", "tender"),
    ("deadline-date-lot", "generic"),
    ("deadline-receipt-expressions-date-lot", "expressions"),
]


def ted_pick_deadline(notice):
    """Mirrors main.js pickDeadline(): first non-empty field in DEADLINE_SOURCES order."""
    for field, kind in TED_DEADLINE_SOURCES:
        date = ted_earliest_date(notice.get(field))
        if date:
            return (date, kind)
    return (None, None)


def ted_pick_link(links, kind, output_language=TED_OUTPUT_LANGUAGE):
    """Mirrors main.js pickLink(): prefer outputLanguage (upper), else ENG, else MUL, else
    whatever key is first."""
    by_lang = (links or {}).get(kind)
    if not by_lang:
        return None
    preferred_upper = output_language.upper()
    if preferred_upper != "ENG" and by_lang.get(preferred_upper):
        return by_lang[preferred_upper]
    if by_lang.get("ENG"):
        return by_lang["ENG"]
    if by_lang.get("MUL"):
        return by_lang["MUL"]
    first_key = next(iter(by_lang), None)
    return by_lang.get(first_key) if first_key else None


def fetch_ted_notice_row(publication_number):
    """Fetch one eu-ted-tenders-scraper row live from TED's v3 notices/search, by-id (the
    README's own key, publicationNumber). Keyless POST, proven live against this exact
    sample at cycle 2000 before this entry was written: `{"query":
    "publication-number=<id>", "page":1, "limit":1, "fields": TED_FIELDS}` returns exactly
    one notice whose own 'publication-number' matches (TED has no separate numeric id --
    the publication number IS the primary key).

    main.js's normalize() (read first, not guessed) computes several README fields out of
    shapes get_path can't express -- multilingual dicts needing a language-preference pick
    (title/buyerName/buyerCity/description/changeReasonDescription), per-lot arrays needing
    dedup (placeOfPerformance*/contractNature/cpvCodes), three deadline fields needing a
    first-non-empty pick with a provenance label (deadlineDate/deadlineType), and a
    links-by-format-by-language object needing a language pick per format
    (pdfUrl/htmlUrl/xmlUrl/noticeUrl) -- so those are precomputed here under `_`-prefixed
    keys, each a verified line-for-line mirror of the corresponding main.js helper, not an
    approximation.
    """
    data = fetch_json_post(
        "https://api.ted.europa.eu/v3/notices/search",
        {"query": f"publication-number={publication_number}", "page": 1, "limit": 1, "fields": TED_FIELDS},
    )
    notices = data.get("notices") or []
    if not notices:
        raise RuntimeError(f"no TED notice for publication-number={publication_number!r}")
    n = notices[0]
    if n.get("publication-number") != publication_number:
        raise RuntimeError(f"TED returned publication-number={n.get('publication-number')!r}, expected {publication_number!r}")

    title, title_language = ted_preferred_text(n.get("notice-title"))
    buyer_name, _ = ted_preferred_text(n.get("buyer-name"))
    buyer_city, _ = ted_preferred_text(n.get("buyer-city"))
    description, _ = ted_preferred_text(n.get("description-lot"))
    change_reason, _ = ted_preferred_text(n.get("change-reason-description"))

    buyer_country_raw = n.get("buyer-country")
    buyer_country = buyer_country_raw[0] if isinstance(buyer_country_raw, list) else buyer_country_raw
    if isinstance(buyer_country_raw, list) and not buyer_country_raw:
        buyer_country = None

    deadline_date, deadline_type = ted_pick_deadline(n)

    links = n.get("links") or {}
    pdf_url = ted_pick_link(links, "pdf")
    html_url = ted_pick_link(links, "html")
    xml_url = ted_pick_link(links, "xml")
    notice_url = pdf_url if pdf_url is not None else xml_url

    total_value_cur_raw = n.get("total-value-cur")
    total_value_cur = total_value_cur_raw[0] if isinstance(total_value_cur_raw, list) else total_value_cur_raw
    if isinstance(total_value_cur_raw, list) and not total_value_cur_raw:
        total_value_cur = None

    pub_date_raw = n.get("publication-date")
    publication_date = str(pub_date_raw).split("+")[0] if pub_date_raw else None

    return {
        **n,
        "_title": title,
        "_titleLanguage": title_language,
        "_buyerName": buyer_name,
        "_buyerCountry": buyer_country,
        "_buyerCity": buyer_city,
        "_description": description,
        "_changeReasonDescription": change_reason,
        "_placeOfPerformanceCountry": ted_dedupe(n.get("place-of-performance-country-lot")),
        "_placeOfPerformanceCity": ted_dedupe(n.get("place-of-performance-city-lot")),
        "_contractNature": ted_dedupe(n.get("contract-nature")),
        "_cpvCodes": ted_dedupe(n.get("classification-cpv")),
        "_totalValueCurrency": total_value_cur,
        "_deadlineDate": deadline_date,
        "_deadlineType": deadline_type,
        "_deadlineReceiptRequestDate": ted_earliest_date(n.get("deadline-receipt-request-date-lot")),
        "_publicationDate": publication_date,
        "_pdfUrl": pdf_url,
        "_htmlUrl": html_url,
        "_xmlUrl": xml_url,
        "_noticeUrl": notice_url,
    }


def org_field_by_level(hierarchy, level):
    """Literal port of main.js's orgFieldByLevel() (src/main.js:752-755).

    `(hierarchy ?? []).find((h) => h.level === level)` then `.name`, else null.
    Shared by the exclusions entry's department/agency/office fields.
    """
    for row in hierarchy or []:
        if row.get("level") == level:
            return row.get("name")
    return None


def fetch_sam_exclusion_row(exclusion_id):
    """Reach one SAM.gov exclusion record and return it keyed EXACTLY by its `_id`.

    `index=ei` has no by-id lookup -- querying a record's own `_id` returns
    totalElements 0 (verified live cycle 2004), and `exactMatch=true` changes
    nothing on this index. The only way in is the same fuzzy title search a buyer
    runs, so this helper searches the README sample's title and then SELECTS the
    hit whose `_id` equals `exclusion_id`, raising if none does. It never trusts
    rank: the live result set holds a near-twin title one rank below the target.

    The Actor normalizes exclusions straight off the search row (no detail fetch),
    so this row is exactly what normalizeExclusionRow() consumes.
    """
    title = SAM_EXCLUSION_TITLES.get(exclusion_id)
    if not title:
        raise RuntimeError(
            f"no search title registered for exclusionId {exclusion_id} -- add one to "
            "SAM_EXCLUSION_TITLES rather than letting this fall back to a blind query"
        )
    data = fetch_json(
        "https://sam.gov/api/prod/sgs/v1/search/"
        f"?index=ei&responseType=json&page=0&size=50&q={urllib.parse.quote(title)}"
    )
    results = (data.get("_embedded") or {}).get("results") or []
    if not results:
        raise RuntimeError(f"index=ei returned no results for title {title!r}")
    for row in results:
        if row.get("_id") == exclusion_id:
            return row
    raise RuntimeError(
        f"exclusionId {exclusion_id} not in the first {len(results)} hits for "
        f"{title!r} (top hit was {results[0].get('_id')!r} / "
        f"{results[0].get('title')!r}) -- do NOT relax this to rank 0; re-derive the "
        "record's own id from sam.gov first"
    )


# exclusionId -> the title to search for it by, since index=ei cannot be queried by
# id. Kept beside the helper so adding a second exclusions sample is a one-line change
# and can never silently become a rank-0 guess.
SAM_EXCLUSION_TITLES = {
    "4550ad9c-4b01-4e3d-bc94-716ee807836e":
        "CHOSUN INTERNATIONAL CHEMICALS JOINT OPERATION COMPANY",
}


def get_path(d, path):
    """Dotted path into nested dicts/lists, e.g. 'financial.obligations'."""
    cur = d
    for part in path.split("."):
        if isinstance(cur, list):
            cur = cur[0] if cur else None
        if not isinstance(cur, dict) or part not in cur:
            return None
        cur = cur[part]
    return cur


def sample_block(readme_path, heading_substr):
    """First ```json fence under a heading containing heading_substr, parsed."""
    heading = ""
    lines = readme_path.read_text() if hasattr(readme_path, "read_text") else open(readme_path).read()
    lines = lines.splitlines()
    i = 0
    while i < len(lines):
        h = HEADING_RE.match(lines[i])
        if h:
            heading = h.group(1).strip()
            i += 1
            continue
        f = FENCE_RE.match(lines[i])
        if f and f.group(1) == "json" and heading_substr.lower() in heading.lower():
            start = i + 1
            j = start
            while j < len(lines) and not lines[j].startswith("```"):
                j += 1
            try:
                return json.loads("\n".join(lines[start:j]))
            except Exception:
                return None
        if f:
            start = i + 1
            j = start
            while j < len(lines) and not lines[j].startswith("```"):
                j += 1
            i = j + 1
            continue
        i += 1
    return None


