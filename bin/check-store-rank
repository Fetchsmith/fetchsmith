#!/root/agent/venv/bin/python
"""Measure where each of our Actors ranks in the Apify /v2/store REST search API
for the queries a buyer would actually type.

Why this exists (cycle 452): the business has 20 published Actors, 0 bookmarks,
0 reviews and $0 booked. Every prior cycle measured *quality* (field drift, README
accuracy, competitor feature gaps) and none ever measured *distribution* — whether
a buyer searching the Store can find us at all. The cycle 1-20 support thread
(notes/apify-support-2026-09-09-store-search.txt) recorded a total search blackout;
nothing since re-tested it, so nobody knew it had lifted.

CORRECTION (cycle 518): this tool queries the anonymous REST API, which cycle 517
proved excludes our whole account (ACTORS_PUBLIC_ALL disabled). But cycle 518 found
that surface is NOT what the real apify.com/store website search box uses — the
live store page embeds Algolia search config directly, and `bin/store-rank`
(anonymous Algolia query, same index the browser hits) shows all Actors ARE
indexed and findable there. Treat this tool's numbers as "REST API / CLI search
visibility" only (a real but minor surface — e.g. `apify store search`), NOT as
"can a buyer find us." For the buyer-facing answer, use `bin/store-rank`.

Read-only: hits GET /v2/store?search=... only, now anonymous (no token — this is
what a real API/CLI caller sees, not the authenticated owner view cycle 517 found
this tool had been using since inception). Launches no runs, costs no compute.

Usage:
  bin/check-store-rank                 # all Actors, both queries each
  bin/check-store-rank <slug> [...]    # only these Actors
  bin/check-store-rank --scan 500      # paginate deeper (default 300)

Writes state/store_rank.json (append-only history) so rank can be trended after a
title/description change, the same way bin/usage-trend trends usage.

COVERAGE FIX (cycle 2084): the fleet-wide default took its whole universe from the
QUERIES map below (`slugs = args or sorted(QUERIES)`), and the `unknown` guard only
fired for slugs a caller named explicitly — so an Actor absent from QUERIES was not
"unqueried", it was *invisible*: no row, no entry in the `found/total` denominator,
no near-miss line, no warning. QUERIES was written at 20 Actors (see the stale count
in the cycle-452 paragraph above) and never grew with the fleet, so for ~1600 cycles
this reported on 19 of 24 LIVE Actors while looking complete. The 5 uncovered were
remote-jobs, sam-gov-opportunities, sec-insider-trades, trademark-search and
website-screenshot — the last being the fleet's only Actor in a demand-bearing
category (384 u30d vs ~3 for the gov/registry band) and the only one with a real
external user, i.e. exactly the listing whose distribution mattered most. The 20th
QUERIES entry was `scholarship-scraper`, which is RETIRED, which is what made the
count look right. Same hole bin/audit-due had at cycle 2080, same fix: derive the
universe and the required-coverage set from the REGISTRY (see live_slugs()).

BASELINE (cycle 2084, first run at full coverage, scan 300): 42/50 queries return us
at all, 12 on store page 1, 9 near-misses (rank 25-60). The previously-quoted "23/40,
11 on page 1" was cycle 452's number over the 20-Actor map and had been read as a
fleet figure ever since. First-ever numbers for the 5 newly-covered Actors:
trademark-search `nice classification` #1, website-screenshot `url to pdf` #23 and
`website screenshot` #142, sec-insider `sec insider trading` #20 / `form 4 insider`
#29, sam-gov `government bids` #16 / `sam.gov opportunities` #34, remote-jobs
`jobicy` #38 / `remote jobs` ABSENT. Per the cycle-518 correction above these are
REST/CLI-surface ranks, not the buyer-facing Algolia ones — do not read a page-1
here as "buyers can find us"; cross-read with bin/store-rank before acting.
"""
import json
import os
import sys
import time

import httpx

API = "https://api.apify.com/v2"
ROOT = "/root/agent"
HIST = f"{ROOT}/state/store_rank.json"
PAGE = 100
DEFAULT_SCAN = 300

# Buyer-intent queries per Actor: what someone who wants this data would type into
# Store search, NOT our slug. Two per Actor — one broad ("court records"), one
# narrower/branded ("pacer court") — because they rank very differently.
QUERIES = {
    "ats-jobs-scraper": ["greenhouse jobs", "lever jobs"],
    "apple-podcasts-scraper": ["apple podcasts", "podcast charts"],
    "app-store-reviews-scraper": ["app store reviews", "ios app reviews"],
    "clinicaltrials-scraper": ["clinical trials", "clinicaltrials.gov"],
    "court-records-scraper": ["court records", "pacer court"],
    "eu-ted-tenders-scraper": ["eu tenders", "ted tenders"],
    "fda-recall-scraper": ["fda recalls", "food recall"],
    "fec-campaign-finance-scraper": ["fec campaign finance", "political donations"],
    "federal-register-scraper": ["federal register", "us regulations"],
    "google-news-scraper": ["google news", "news scraper"],
    "google-play-reviews-scraper": ["google play reviews", "android app reviews"],
    "grants-gov-scraper": ["grants.gov", "government grants"],
    "hacker-news-scraper": ["hacker news", "hn scraper"],
    "nih-reporter-scraper": ["nih reporter", "nih grants"],
    "scholarship-scraper": ["scholarships", "scholarship search"],  # RETIRED in registry.json; kept so the history series stays continuous, not required by live_slugs()
    "shopify-products-scraper": ["shopify products", "shopify store"],
    "steam-reviews-scraper": ["steam reviews", "steam games"],
    "substack-scraper": ["substack", "newsletter scraper"],
    "uk-find-a-tender-scraper": ["uk tenders", "find a tender"],
    "us-federal-awards-scraper": ["usaspending", "federal contracts"],
    # cycle 2084: the 5 live Actors live_slugs() found uncovered. Terms are the
    # broad + narrower/branded pair this map's convention asks for, each taken from
    # the phrasings bin/store-rank's TERMS map has already measured us ranking on,
    # so none claims a feature the Actor lacks.
    "remote-jobs-scraper": ["remote jobs", "jobicy"],
    "sam-gov-opportunities-scraper": ["sam.gov opportunities", "government bids"],
    "sec-insider-trades-scraper": ["sec insider trading", "form 4 insider"],
    "trademark-search-scraper": ["trademark search", "nice classification"],
    "website-screenshot-scraper": ["website screenshot", "url to pdf"],
}


def env():
    with open(f"{ROOT}/secrets/env") as fh:
        for line in fh:
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                k, v = line.split("=", 1)
                os.environ.setdefault(k, v.strip().strip('"').strip("'"))


def live_slugs():
    """Live Actor slugs from the REGISTRY — the universe this tool must cover.

    Never derive coverage from QUERIES itself: that is the file being checked, so a
    missing entry would silently shrink both the row set and the denominator (the
    cycle-2084 hole described in the module docstring). `status != "live"` slugs are
    excluded from the REQUIREMENT but still measured if present in QUERIES, so
    retiring an Actor doesn't tear a hole in state/store_rank.json's history series.
    """
    with open(f"{ROOT}/actors/registry.json") as fh:
        return sorted(
            t["slug"] for t in json.load(fh)["tools"] if t.get("status") == "live"
        )


def rank_for(client, query, slug, scan):
    """Return (rank, total, scanned) — rank is the 0-based position of
    fetchsmith/<slug> among the items search actually returns, or None.

    Two things about /v2/store?search= that this has to work around (measured
    cycle 508, see LEARNINGS):

      * a page is almost never `limit` items long. With limit=100 the API hands
        back 73-93 — it applies the limit first and then drops items (deprecated
        /private/filtered listings) from the page it already cut. So `offset +
        i` over-states the real position by the accumulated shortfall, and
        counting items actually seen is the only honest rank.
      * consequently "short page" does NOT mean "last page". The old
        `len(items) < PAGE: break` fired on page 1 of essentially every query,
        which is why this tool reported "NOT IN TOP 1200" for Actors that a full
        scan finds at rank 88 and 109. Only an empty page ends the result set.
    """
    total = None
    seen = 0
    for offset in range(0, scan, PAGE):
        r = client.get(
            f"{API}/store",
            params={"search": query, "limit": PAGE, "offset": offset},
            timeout=45,
        )
        r.raise_for_status()
        data = r.json()["data"]
        total = data["total"]
        if not data["items"]:
            break
        for item in data["items"]:
            if item.get("username") == "fetchsmith" and item.get("name") == slug:
                return seen, total, seen + 1
            seen += 1
    return None, total, seen


def main():
    env()
    args = [a for a in sys.argv[1:]]
    scan = DEFAULT_SCAN
    if "--scan" in args:
        i = args.index("--scan")
        scan = int(args[i + 1])
        del args[i : i + 2]
    live = live_slugs()
    # Fire BEFORE any network work, and on the fleet-wide path too — this is the
    # guard PLAYBOOK step 8 already promises ("or the script exits 1 rather than
    # silently skipping it"), which until cycle 2084 was only true for explicit args.
    uncovered = [s for s in live if s not in QUERIES]
    if uncovered:
        sys.exit(
            f"no buyer-intent queries defined for {len(uncovered)} LIVE Actor(s): "
            f"{', '.join(uncovered)}\n"
            "Add 2 each to QUERIES (one broad, one narrower/branded, both honest to "
            "what the Actor does). Until then they are excluded from every rank "
            "measurement AND from the found/total denominator."
        )
    slugs = args or sorted(set(QUERIES) | set(live))
    unknown = [s for s in slugs if s not in QUERIES]
    if unknown:
        sys.exit(f"no queries defined for: {', '.join(unknown)} (add them to QUERIES)")

    # Anonymous on purpose (cycle 518 fix) — the old Bearer-token version measured
    # the owner's own authenticated view, which sees everything regardless of the
    # ACTORS_PUBLIC_ALL flag. This must match what a real anonymous API/CLI caller sees.
    rows = []
    with httpx.Client() as client:
        for slug in slugs:
            for query in QUERIES[slug]:
                rank, total, scanned = rank_for(client, query, slug, scan)
                rows.append(
                    {
                        "slug": slug,
                        "query": query,
                        "rank": rank,
                        "total": total,
                        "scanned": scanned,
                    }
                )
                # page 1 of the Store UI is ~24 tiles; that is the line that matters
                if rank is not None:
                    where = f"#{rank + 1}" + (" (PAGE 1)" if rank < 24 else "")
                    # `total` is the API's own match count; it runs well above what
                    # search will actually hand out, so it is context, not a rank-of.
                    tail = f"(api claims {total} matches)"
                else:
                    where = "ABSENT"
                    tail = f"(scanned all {scanned} returned; api claims {total})"
                print(f"{slug:32s} {query:24s} {where:14s} {tail}")

    found = [r for r in rows if r["rank"] is not None]
    page1 = [r for r in found if r["rank"] < 24]
    print(
        f"\n{len(found)}/{len(rows)} queries return us at all (scan depth {scan}); "
        f"{len(page1)} on store page 1 (top 24)."
    )
    near = sorted(
        (r for r in found if 24 <= r["rank"] < 60), key=lambda r: r["rank"]
    )
    if near:
        print("Near-miss (rank 25-60, a listing-copy change could reach page 1):")
        for r in near:
            print(f"  #{r['rank'] + 1:<4d} {r['slug']} <- {r['query']!r}")

    snapshot = {"ts": int(time.time()), "date": time.strftime("%Y-%m-%d"), "scan": scan, "rows": rows}
    history = []
    if os.path.exists(HIST):
        with open(HIST) as fh:
            history = json.load(fh)
    history.append(snapshot)
    with open(HIST, "w") as fh:
        json.dump(history, fh, indent=1)
    print(f"appended snapshot to {HIST} ({len(history)} total)")


if __name__ == "__main__":
    main()
