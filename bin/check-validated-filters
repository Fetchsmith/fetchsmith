#!/usr/bin/env python3
"""check-validated-filters -- fleet sweep for the cycle-1532 blind spot.

Every filter field in an Actor's input schema falls into one of three buckets:

  (a) SCHEMA_ENUM    -- the schema itself pins the vocabulary (`enum` / `items.enum`).
                        Audited by enum_audit's facet-diff method.
  (b) FREE_TEXT      -- free text with no authority anywhere; whatever the buyer types
                        goes to the vendor as-is. Nothing to audit.
  (c) RUNTIME_VALID  -- free text that OUR code validates at runtime against a list
                        (fetched facet list, hardcoded table, regex, numeric range...).
                        *** This is the blind spot. *** Two independent audits of
                        grants-gov-scraper's `agencies` skipped it because it is neither
                        (a) nor (b), and the validator could only see 163 of 712 real
                        agency codes. The code that validates a filter is itself an
                        unaudited claim.
  (d) DATE_BOUND     -- a date-shaped string field (a camelCase name token is
                        date/since/until/before/after/from/to, or the description says
                        YYYY-MM-DD/ISO 8601). Added cycle 2314: this class used to fall
                        into (b)
                        FREE_TEXT ("nothing to audit"), which is wrong -- a date HAS an
                        authority (its format), and that bucket is exactly where cycle
                        2312/2313 found two live widen-and-bill/narrow-to-zero defects
                        (google-play-reviews-scraper, hacker-news-scraper: an unparsed
                        `new Date(junk)` is an Invalid Date, which is silently truthy/
                        NaN, so the filter bound was defeated instead of rejected).
                        PASS requires either a schema `pattern`, or runtime code that
                        DETECTS an unparseable/impossible value (isNaN/Invalid Date/NaN
                        check, a regex `.test()` guard, or a Date-roundtrip component
                        comparison -- `getUTCFullYear()/getUTCMonth()/getUTCDate() ===`,
                        added cycle 2315, the only one of the three that catches a
                        calendar-impossible-but-well-formed value like "20260230") --
                        found either inline or inside a named helper function the field's
                        value is piped through (e.g. `parseDateBound()`). A date field
                        with none of these is FAILED loudly here instead of silently,
                        which is the whole point.

For every (c) field this prints the evidence lines so a cycle can ask the two questions
that matter:
  1. WHAT CAN THE VALIDATOR SEE?  If its list comes from a vendor probe, is every other
     filter pinned to its widest value, or does the allowlist silently inherit the
     vendor's defaults? (cycle 1532: an unpinned oppStatuses cost 549 of 712 codes.)
  2. WHAT HAPPENS WHEN EVERYTHING IS DROPPED?  Dropping an unrecognised value is only
     safe if dropping NARROWS the search. If an absent param means "match everything",
     an all-invalid filter must fail loudly instead of billing the buyer for the fleet.

Usage:
  check-validated-filters                 # whole fleet, summary + (c) detail
  check-validated-filters <slug> [...]    # named Actors only
  check-validated-filters --all-buckets   # also print (a) and (b) listings
"""
import json
import os
import re
import sys

ACTORS = '/root/agent/actors'

# Fields that are not filters: paging/limits/output/auth knobs. Classifying these would
# bury the real filters in noise.
NON_FILTER = re.compile(
    r'^(maxResults|maxItems|maxRows|maxPages|max[A-Z]\w*|limit|offset|page|pageSize|'
    r'perPage|startPage|sortBy|sortOrder|sort|order|proxy\w*|debug|verbose|dryRun|'
    r'includeRaw|include[A-Z]\w*|outputFields|fields|csv\w*|datasetName|apiKey|token|'
    r'concurrency|requestDelay\w*|delay\w*|timeout\w*|retries|retr\w*|minDelay|rateLimit\w*)$'
)

# Only a VOCABULARY-membership test counts as (c). A date parse or a numeric-range check
# validates a *format*, not a vocabulary: there is no list of permitted values that could
# turn out to be incomplete, which is the entire failure mode we are hunting. Including
# them buried grants-gov's real `agencies` finding under 14 false positives.
# A call expression, so we can tell `AGENCY_INDEX.get(code)` (the buyer's value looked up
# in an authority) from `hay.includes(keyword)` (the buyer's value substring-matched
# against row content). Only the first is a vocabulary that can be silently incomplete;
# the second is just (b) free text doing its job, and reporting it drowns the signal.
CALL_RE = re.compile(r'([A-Za-z_$][\w$]*(?:\.[\w$]+)*|\[[^\]\n]*\])\.(has|get|includes|indexOf)\(([^;]*)')
# Receivers that are plausibly an authority list rather than row content.
AUTHORITY_RE = re.compile(
    r'(^\[)|(^[A-Z][A-Z0-9_]{2,}$)|(Set|Index|Lookup|Table|Vocab|Alias|Synonym|Codes|'
    r'Allow|Valid|Known|Canon|Supported|Vocabulary|Options|Choices)', re.I)
# Receivers that are definitely row content / the haystack side of a text search.
HAYSTACK_RE = re.compile(r'^(hay\w*|text|body|title|name|desc\w*|String|row|item|r|s|u|blob|joined)\b', re.I)
# Run bookkeeping -- dedup sets, watch-state maps, per-run tallies. These are keyed on ROW
# ids, never on a buyer-supplied filter value, so a hit here is always a false positive.
BOOKKEEPING_RE = re.compile(r'seen|deliver|dedup|visit|attempt|summar|snapshot|prev|'
                            r'watchMeta|watchNow|reached|emitted|charged|counts?$', re.I)
DROP_TOKENS = re.compile(r'\b(Ignoring|ignored|dropp?(ing|ed)?|skipp?(ing|ed)?)\b', re.I)
THROW_TOKENS = re.compile(r'\bthrow\b')
# Rejects a bad value without a JS `throw`: the Apify SDK's own fail-the-run call.
# `app-store-reviews-scraper` uses this form exclusively for its date-bound guard, and a
# plain `\bthrow\b` search missed it on the first run of the new (d) bucket below.
REJECT_TOKENS = re.compile(r'\bthrow\b|Actor\.fail\(')
FACET_TOKENS = re.compile(r'\bawait\b|fetch\(|httpGet|apiGet|probe', re.I)

# --- bucket (d): date-shaped string fields (cycle 2314) ---------------------------
ISO_DESC_RE = re.compile(r'YYYY-MM-DD|ISO[- ]?8601', re.I)
NAN_TOKENS = re.compile(r'isNaN|Number\.isNaN|Invalid Date|isFinite', re.I)
# A second, independent validity idiom (cycle 2315, fda-recall-scraper/federal-register-scraper):
# construct a Date from the parsed y/m/d components and compare the getters back against what was
# asked for. This is NOT weaker than isNaN/regex -- it is the only one of the three idioms in the
# fleet that actually catches a calendar-impossible-but-well-formed date like "20260230" (Date.UTC
# normalizes Feb 30 -> Mar 2 instead of throwing, so isNaN(new Date(...)) never fires on it, and a
# plain `/^\d{4}-\d{2}-\d{2}$/.test()` only checks digit shape, not calendar range). Missing this
# idiom made the first run after these two Actors were fixed report a false FAILED.
ROUNDTRIP_DATE_TOKENS = re.compile(r'get(?:UTC)?(?:FullYear|Month|Date)\(\)\s*===')
CAMEL_TOKEN_RE = re.compile(r'[A-Z]?[a-z0-9]+|[A-Z]+(?![a-z])')
DATE_TOKENS = {'date', 'dates', 'since', 'until', 'before', 'after', 'from', 'to'}
FUNC_DECL_RE = re.compile(r'function\s+([\w$]+)\s*\(')
ARROW_RE = re.compile(r'^\s*(?:async\s*)?\([^)]*\)\s*=>')
CALLNAME_RE = re.compile(r'([\w$]+)\s*\(')


def _brace_body(src, open_idx):
    depth, i = 0, open_idx
    while i < len(src):
        if src[i] == '{':
            depth += 1
        elif src[i] == '}':
            depth -= 1
            if depth == 0:
                return src[open_idx:i + 1]
        i += 1
    return src[open_idx:]


def function_bodies(src):
    """Name -> body text, for `function name(...) {}` and `const name = (...) => ...`.

    Lets a validator one hop away from the field's own statement still count: the real
    shape this bucket exists for is `const sinceDate = parseDateBound(input.sinceDate,
    'sinceDate');` with the actual `throw`/`isNaN` living inside `parseDateBound`'s body,
    not on the call-site line.

    The arrow half reuses `statements()` rather than its own brace-only regex: a brace-
    only extractor missed `const isDate = (v) => /^\\d{4}-\\d{2}-\\d{2}$/.test(v);`
    (google-news-scraper) -- a concise, EXPRESSION-bodied arrow with no `{}` at all --
    and `statements()` already handles both forms correctly via real bracket-depth
    tracking (that is the whole reason it exists, see its own docstring above).
    """
    bodies = {}
    for m in FUNC_DECL_RE.finditer(src):
        brace = src.find('{', m.end())
        if brace != -1:
            bodies[m.group(1)] = _brace_body(src, brace)
    for name, rhs, _off in statements(src):
        if name not in bodies and ARROW_RE.match(rhs):
            bodies[name] = rhs
    return bodies


def is_date_shaped(name, spec):
    """Whole-token match on camelCase pieces, not a raw substring.

    A raw `re.search('date', name, re.I)` flags `candidateId`/`candidateName` as date
    fields, because "candidate" contains the letters "date" -- a false positive found
    the first time this ran fleet-wide. Splitting into camelCase tokens first
    (`studyStartDateFrom` -> study/Start/Date/From) keeps the real signal (a `date`/
    `from`/`to`/etc. token) without matching letters that happen to appear mid-word.
    """
    if ISO_DESC_RE.search(spec.get('description') or ''):
        return True
    tokens = {t.lower() for t in CAMEL_TOKEN_RE.findall(name)}
    return bool(tokens & DATE_TOKENS)


def date_shaped_fields(slug):
    path = os.path.join(ACTORS, slug, '.actor', 'input_schema.json')
    if not os.path.exists(path):
        return []
    props = json.load(open(path)).get('properties', {})
    out = []
    for name, spec in props.items():
        if NON_FILTER.match(name) or spec.get('type') != 'string' or spec.get('enum'):
            continue
        if is_date_shaped(name, spec):
            out.append((name, spec))
    return out


def _has_validity_check(text):
    return bool(NAN_TOKENS.search(text) or '.test(' in text or ROUNDTRIP_DATE_TOKENS.search(text))


def _mode(text):
    return 'throws/fails' if REJECT_TOKENS.search(text) else 'warns+drops, does not reject'


def _resolves_validity(callname, bodies, depth=2, _seen=None):
    """Does `callname`'s body check validity, directly or via one more call it makes?

    One hop (e.g. `normDate()` calling `isDate()`) is a real shape in the fleet
    (google-news-scraper): the field's own helper delegates the actual `/^\\d{4}-...$/
    .test()` to a second, smaller function. Unbounded recursion would risk matching an
    unrelated validity check elsewhere in the file; two hops mirrors the same tradeoff
    `derived_vars()` above already made for the (c) bucket.
    """
    _seen = _seen or set()
    if callname in _seen or callname not in bodies:
        return False
    _seen.add(callname)
    body = bodies[callname]
    if _has_validity_check(body):
        return True
    if depth <= 0:
        return False
    return any(_resolves_validity(n, bodies, depth - 1, _seen)
               for n in CALLNAME_RE.findall(body) if n != callname)


def date_validated(name, spec, src, bodies):
    """True + evidence if a date-shaped field is checked for validity, else False.

    PASS requires only that an invalid value gets DETECTED (isNaN/Invalid Date/
    Number.isFinite/a regex `.test()`), not that it throws. The real blind spot this
    bucket exists for is a field with NO validity check anywhere (`new Date(junk)` used
    directly, Invalid-Date's truthiness silently defeating a naive comparison) --
    cycle 2312/2313's actual fixes. Whether a detected-invalid value then throws
    (`google-play`/`hacker-news`'s fix, `clinicaltrials`/`uk-find-a-tender`'s
    `parseBound`) or is dropped with a disclosed `log.warning` (`google-news-scraper`'s
    `normDate`, `steam-reviews-scraper`, `sec-insider-trades-scraper`) is a softer,
    separate design choice three independently-written Actors already make on purpose --
    flagging it as a hard FAIL here would bury the three genuine zero-validation gaps
    this run actually found (`fda-recall-scraper`/`federal-register-scraper`'s shared
    `normDate` checks only a digit COUNT, never calendar validity, and silently falls
    back to a default with no warning at all; `us-federal-awards-scraper` does not check
    validity anywhere) under false positives. `_mode()` records which kind it is as
    evidence, for a future cycle that wants to tighten warn-and-drop cases separately.

    Schema `pattern` is authoritative on its own (cycle 2312/2313 found NONE of the
    fleet's 19 live date fields pin one, so in practice this always falls through to the
    runtime check below).
    """
    if spec.get('pattern'):
        return True, 'schema pattern'
    seed = re.compile(r'\binput\.' + re.escape(name) + r'\b')
    for sname, rhs, _off in statements(src):
        if not seed.search(rhs):
            continue
        if _has_validity_check(rhs):
            return True, f'{sname} inline validity check ({_mode(rhs)})'
        for callname in CALLNAME_RE.findall(rhs):
            if _resolves_validity(callname, bodies):
                return True, f'{sname} via {callname}() ({_mode(bodies[callname])})'
    # Fallback: used inline without an intermediate declaration (no const/let/var
    # assignment to hang the match on -- the check sits directly around the read).
    for m in seed.finditer(src):
        window = src[max(0, m.start() - 300):m.end() + 300]
        if _has_validity_check(window):
            return True, f'inline proximity validity check ({_mode(window)})'
    # Fallback: a config-table field. The name never appears as a literal `input.<name>`
    # anywhere -- only as a quoted string naming a key in a shared table (e.g.
    # `{ from: 'studyStartDateFrom', to: 'studyStartDateTo', area: 'StartDate' }`), read
    # via `input[from]` inside a `for (... of TABLE)` loop. clinicaltrials-scraper's 6
    # paired date-range filters are this exact shape, sharing one `parseDateBound()`.
    # Literal-string proximity to a validating call is the only signal available short of
    # tracing the destructured loop variable through the loop body.
    literal = re.compile(r'[\'"]' + re.escape(name) + r'[\'"]')
    for m in literal.finditer(src):
        window = src[max(0, m.start() - 100):m.end() + 800]
        for callname in CALLNAME_RE.findall(window):
            if _resolves_validity(callname, bodies):
                return True, f'config-table field via {callname}() ({_mode(bodies[callname])})'
    return False, None


def schema_filters(slug):
    path = os.path.join(ACTORS, slug, '.actor', 'input_schema.json')
    if not os.path.exists(path):
        return None
    props = json.load(open(path)).get('properties', {})
    out = []
    for name, spec in props.items():
        if NON_FILTER.match(name):
            continue
        has_enum = bool(spec.get('enum')) or bool((spec.get('items') or {}).get('enum'))
        out.append((name, spec.get('type'), has_enum, spec.get('editor')))
    return out


DECL_RE = re.compile(r'\b(?:const|let|var)\s+([\w$]+)\s*=')


def statements(src):
    """(name, rhs_text, start_offset) per declaration, RHS taken to its real end.

    A regex stopping at the first `;` truncates `const offices = (input.offices ?? [])
    .map((o) => { const upper = ...; if (!OFFICE_SET.has(upper)) ... })` right before the
    validator -- which is exactly where trademark-search's real office check lives. Track
    bracket depth so a multi-line callback body stays part of its own statement.
    """
    out = []
    for m in DECL_RE.finditer(src):
        i, depth = m.end(), 0
        while i < len(src):
            ch = src[i]
            if ch in '([{':
                depth += 1
            elif ch in ')]}':
                if depth == 0:
                    break
                depth -= 1
            elif ch == ';' and depth == 0:
                break
            i += 1
        out.append((m.group(1), src[m.end():i], m.end()))
    return out
FOR_OF_RE = re.compile(r'for\s*\(\s*(?:const|let|var)\s+([\w$]+)\s+of\s+([^)]*)\)')
ARROW_PARAM_RE = re.compile(r'\(?\b([a-z_$][\w$]*)\b\)?\s*=>')


def derived_vars(src, field):
    """Names the buyer's value flows into, so we can follow it to its validator.

    Proximity matching was wrong twice over: it missed grants-gov's real `agencies`
    finding (the lookup happens on a loop variable two hops from `input.agencies`) and it
    invented six for steam-reviews (unrelated consts that merely sit on adjacent lines).
    Taint propagation over whole statements is the honest model -- follow the value.
    """
    names = {field}
    assigns = [(n, e) for n, e, _ in statements(src)]
    loops = FOR_OF_RE.findall(src)
    seed = re.compile(r'\binput\.' + re.escape(field) + r'\b')
    for name, expr in assigns:
        if seed.search(expr):
            names.add(name)
    # Exactly two hops. Unbounded propagation taints nearly every local in a 900-line
    # file (`seenIds`, `ids`, `summaries`...) and the report fills with dedup bookkeeping;
    # two hops is what the real shape needs -- `input.agencies` -> `wantedAgencies` ->
    # `for (const raw of wantedAgencies)` -> `agencyIndex.get(raw)`.
    for _ in range(2):
        var_re = re.compile(r'\b(' + '|'.join(re.escape(v) for v in sorted(names)) + r')\b')
        hop = set()
        for loopvar, iterable in loops:  # `for (const raw of wantedAgencies)`
            if var_re.search(iterable):
                hop.add(loopvar)
        for name, expr in assigns:
            if var_re.search(expr):
                hop.add(name)
        if hop <= names:
            break
        names |= hop
    return names


def classify(slug, filters, src):
    lines = src.split('\n')
    stmts = statements(src)
    results = []
    for name, typ, has_enum, editor in filters:
        if has_enum:
            results.append((name, typ, 'a:SCHEMA_ENUM', []))
            continue
        # A boolean or a number has no vocabulary to be incomplete about.
        if typ in ('boolean', 'integer', 'number'):
            results.append((name, typ, 'b:FREE_TEXT (no vocabulary)', []))
            continue
        vars_ = derived_vars(src, name)
        var_re = re.compile(r'\b(' + '|'.join(re.escape(v) for v in sorted(vars_)) + r')\b')
        evidence, seen = [], set()
        # Pass 1, statement-scoped: a validator that runs inside the statement that reads
        # the field, on a callback param of that statement. The param is deliberately NOT
        # added to the global taint set -- names like `o`/`c`/`s` are reused by every other
        # field's callbacks, and taking them globally made one Actor's `wantedStatuses`
        # check show up as evidence against six unrelated date and keyword fields.
        for sname, rhs, off in stmts:
            if not (re.search(r'\binput\.' + re.escape(name) + r'\b', rhs) or sname in vars_):
                continue
            local = set(ARROW_PARAM_RE.findall(rhs)) | {n for n, _, _ in statements(rhs)}
            if not local:
                continue
            local_re = re.compile(r'\b(' + '|'.join(re.escape(v) for v in sorted(local)) + r')\b')
            for recv, meth, args in CALL_RE.findall(rhs):
                if not (local_re.search(args) or var_re.search(args)):
                    continue
                tail = recv.split('.')[-1]
                if HAYSTACK_RE.match(recv) or HAYSTACK_RE.match(tail) or BOOKKEEPING_RE.search(recv):
                    continue
                if not (AUTHORITY_RE.search(recv) or AUTHORITY_RE.search(tail)):
                    continue
                label = f'{recv}.{meth}()'
                if label in seen:
                    continue
                seen.add(label)
                lineno = src.count('\n', 0, off + rhs.find(recv + '.' + meth)) + 1
                evidence.append((lineno, label, lines[lineno - 1].strip()[:110]))
        for i, ln in enumerate(lines):
            if ln.strip().startswith('//') or not var_re.search(ln):
                continue
            # A membership test on the buyer's own value sits on the line itself (or wraps
            # onto the next), never 12 lines away.
            window = ln + ' ' + (lines[i + 1] if i + 1 < len(lines) else '')
            for recv, meth, args in CALL_RE.findall(window):
                if not var_re.search(args):
                    continue  # the buyer's value is not what is being looked up
                tail = recv.split('.')[-1]
                if HAYSTACK_RE.match(recv) or HAYSTACK_RE.match(tail):
                    continue  # substring search against row content, not a vocabulary
                if BOOKKEEPING_RE.search(recv):
                    continue  # dedup/watch state keyed on row ids, not a vocabulary
                if not (AUTHORITY_RE.search(recv) or AUTHORITY_RE.search(tail)):
                    continue
                label = f'{recv}.{meth}()'
                if label in seen:
                    continue
                seen.add(label)
                evidence.append((i + 1, label, ln.strip()[:110]))
        if evidence:
            ctx = '\n'.join(lines[max(0, evidence[0][0] - 25):evidence[0][0] + 30])
            flags = []
            if FACET_TOKENS.search(ctx):
                flags.append('FETCHED-LIST?')
            if DROP_TOKENS.search(ctx) and not THROW_TOKENS.search(ctx):
                flags.append('DROPS-SILENTLY?')
            tag = 'c:RUNTIME_VALID' + (' [' + ','.join(flags) + ']' if flags else '')
            results.append((name, typ, tag, evidence))
        else:
            results.append((name, typ, 'b:FREE_TEXT', []))
    return results


def main():
    args = [a for a in sys.argv[1:] if not a.startswith('--')]
    all_buckets = '--all-buckets' in sys.argv
    slugs = args or sorted(d for d in os.listdir(ACTORS)
                           if os.path.isdir(os.path.join(ACTORS, d)) and not d.startswith('_'))
    totals = {'a': 0, 'b': 0, 'c': 0, 'd': 0}
    date_flagged = []
    for slug in slugs:
        filters = schema_filters(slug)
        if filters is None:
            continue
        srcpath = os.path.join(ACTORS, slug, 'src', 'main.js')
        if not os.path.exists(srcpath):
            continue
        src = open(srcpath).read()
        res = classify(slug, filters, src)
        cs = [r for r in res if r[2].startswith('c')]
        for r in res:
            totals[r[2][0]] += 1
        print(f'\n=== {slug} ({len(filters)} filter fields: '
              f"{sum(1 for r in res if r[2].startswith('a'))} enum, "
              f"{sum(1 for r in res if r[2].startswith('b'))} free-text, "
              f'{len(cs)} runtime-validated) ===')
        for name, typ, tag, ev in res:
            if not all_buckets and not tag.startswith('c'):
                continue
            print(f'  {name} ({typ}) -> {tag}')
            for lineno, label, text in ev[:6]:
                print(f'      L{lineno} [{label}] {text}')

        bodies = function_bodies(src)
        for name, spec in date_shaped_fields(slug):
            totals['d'] += 1
            ok, evidence = date_validated(name, spec, src, bodies)
            if ok:
                if all_buckets:
                    print(f'  {name} (date) -> d:DATE_VALIDATED [{evidence}]')
            else:
                date_flagged.append(f'{slug}.{name}')
                print(f'  FAIL {slug}.{name} -- date-shaped field, no schema pattern and '
                      f'no runtime throw+validity guard found (widen/narrow-silently risk)')
    print(f"\n--- FLEET TOTALS: {totals['a']} (a) schema-enum, {totals['b']} (b) free-text, "
          f"{totals['c']} (c) runtime-validated, {totals['d']} (d) date-shaped "
          f"({len(date_flagged)} FAILED) ---")
    if date_flagged:
        print('check-validated-filters: FAILED date fields: ' + ', '.join(date_flagged))
    return 1 if date_flagged else 0


if __name__ == '__main__':
    sys.exit(main())
