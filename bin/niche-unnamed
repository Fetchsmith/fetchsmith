#!/root/agent/venv/bin/python
"""niche-unnamed <slug> -- list EVERY niche match that the Actor's README does not
already name, with user counts, not just niche-size's top-10-by-users table.

Added cycle 1220 after that top-10 cut came back CLEAN on sec-insider-trades-scraper
and was wrong: Apify pins a new listing at 2 users, so in a niche of mostly-new
listings a top-10 cut is really a cut at "4+ users" -- it selects for listing AGE,
not competitive threat. The only two genuine undercutters in that niche sat at 3
users each (both kenshinsee Form 4 scrapers, tiered down to $0.0012 vs our $0.0018).

Reuses bin/niche-size's TERM_VARIANTS/NICHE_TERMS/MATCH_SYNONYMS and its matching
rule by exec-ing it as a module, so the two always agree on what "in the niche" means.
Read-only: one GET /v2/store per search term, nothing else.

Follow-up: live-price every unnamed match with >=3 users via GET /v2/acts/<owner>~<slug>
and read the TIERED block (eventTieredPricingUsd/tieredPricing) -- a tiered rival's
FREE-tier price is NOT its real price, and check-price-superiority only sees that one.
"""
import importlib.util
import re
import sys

spec = importlib.util.spec_from_loader("ns", loader=None)
ns = importlib.util.module_from_spec(spec)
src = open("/root/agent/bin/niche-size").read().replace(
    'if __name__ == "__main__":\n    sys.exit(main())\n', "")
ns.__dict__["__file__"] = "/root/agent/bin/niche-size"
exec(compile(src, "niche-size", "exec"), ns.__dict__)

slug = sys.argv[1] if len(sys.argv) > 1 else sys.exit("usage: niche-unnamed <slug>")
base = ns.NICHE_TERMS[slug]
terms = ns.TERM_VARIANTS.get(slug) or ns.auto_variants(base)

# Cycle 1404: retried via the shared `_apify_get.get_json` (reached through the exec'd
# niche-size module, so the two keep sharing one implementation). Previously an unguarded
# `.json()["data"]["items"]`, which aborted the whole sweep on a single non-JSON body --
# and this tool's entire job is completeness, so a half-finished sweep that still printed
# "0 unnamed" would be the most misleading output it could possibly produce.
seen = {}
failed_terms = []
for term in terms:
    try:
        body, _st = ns.get_json(f"{ns.API}/store", params={"search": term, "limit": 100},
                                timeout=40)
        items = ((body or {}).get("data") or {}).get("items") or []
    except Exception as e:
        failed_terms.append(term)
        print(f"  ERR searching {term!r}: {e}", file=sys.stderr)
        continue
    for it in items:
        seen[f"{it['username']}/{it['name']}"] = it
    ns.time.sleep(0.2)
if failed_terms:
    print(f"  WARNING: INCOMPLETE SWEEP -- {len(failed_terms)} of {len(terms)} search "
          f"term(s) failed after retries; the unnamed list below is NOT complete and must "
          f"not be recorded as a clean audit.", file=sys.stderr)


def stem(w):
    return w[:-1] if len(w) > 3 and w.endswith("s") else w


match_words = [base] + ns.MATCH_SYNONYMS.get(slug, [])
match_res = [re.compile(r"\b" + r"\s+".join(re.escape(stem(w)) + "s?" for w in phrase.split()) + r"\b")
             for phrase in match_words]
matched = []
for ident, it in seen.items():
    blob = f"{it.get('name','')} {it.get('title','')} {it.get('description') or ''}".lower()
    if any(p.search(blob) for p in match_res):
        matched.append((ident, it))
matched.sort(key=lambda kv: -(kv[1].get("stats", {}).get("totalUsers", 0)))

readme = open(f"/root/agent/actors/{slug}/README.md").read()
# Strip fenced ``` code blocks first: their internal single backticks (JSON sample output
# etc.) pair up with surrounding prose backticks under a naive `([^`]+)` scan and swallow
# huge spans of real text, hiding every handle inside them.
readme = re.sub(r"```.*?```", "", readme, flags=re.S)

# Cycle 1431 (0-TODO-h1430): the old regex required a contiguous `owner/slug` with no
# whitespace inside the backticks, so a handle that this README's hard-wrapped prose
# splits across a line break (e.g. `` `owner/\nslug` ``) was invisible to it even though
# it renders as one handle. Strip whitespace from each backtick span before checking
# shape, so a wrapped handle still counts as named.
named = set()
for span in re.findall(r"`([^`]+)`", readme):
    cleaned = re.sub(r"\s+", "", span).lower()
    if re.fullmatch(r"[a-z0-9_.-]+/[a-z0-9_.-]+", cleaned):
        named.add(cleaned)

# Second house style this README (and others) use: name an owner once in prose, then for
# each of that owner's other listings in the same paragraph, backtick only the bare slug
# (no `owner/` prefix). Credit `owner/slug` as named if the owner appears as a plain-text
# mention and the bare slug appears backticked somewhere in the same paragraph.
paragraphs = []
for para in re.split(r"\n\s*\n", readme):
    para_lower = para.lower()
    slugs = set()
    for span in re.findall(r"`([^`]+)`", para):
        cleaned = re.sub(r"\s+", "", span).lower()
        if cleaned and "/" not in cleaned:
            slugs.add(cleaned)
    paragraphs.append((para_lower, slugs))


def bare_slug_credited(owner, bare_slug):
    for para_lower, slugs in paragraphs:
        if bare_slug in slugs and re.search(r"\b" + re.escape(owner) + r"\b", para_lower):
            return True
    return False


print(f"{len(seen)} seen, {len(matched)} matched, README names {len(named)} handles")
print("--- UNNAMED matches, by users ---")
n = 0
for ident, it in matched:
    if ident.lower() in named:
        continue
    owner, _, bare_slug = ident.lower().partition("/")
    if bare_slug_credited(owner, bare_slug):
        continue
    st = it.get("stats", {})
    u = st.get("totalUsers", 0)
    n += 1
    print(f"{u:5} u30d={st.get('totalUsers30Days',0):4} {ident}")
    print(f"      {(it.get('title') or '')[:110]}")
print(f"--- {n} unnamed of {len(matched)} matched ---")
