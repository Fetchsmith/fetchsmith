#!/root/agent/venv/bin/python
"""Are the live docs still small enough to work with? (STATUS/queue by bytes,
notes/LEARNINGS.md by lines -- see LINE_DOCS for why the rule differs.)
(added cycle 1836)

WHY: the archive trim is the one piece of housekeeping that has no clock. It lived
only as a carried queue.md backlog item -- which is exactly the failure mode
state/fleet_checks.json exists to close, and doubly ironic here because the item
describing the trim is itself what the trim deletes. Measured damage: cycle 1833
found STATUS.md at 292KB and had to PAGE it; the item was then carried unresolved
through 1833/1834/1835 (3 cycles) while both files kept growing, and cycle 1836
finally trimmed 263KB+319KB back to 47KB+67KB. Before that, the cycle-1799 trim had
breached the cap again in only 36 cycles. Every cycle past the cap pays a context
tax before any work starts, and the cycle that skips the trim is not the one that
pays it (LEARNINGS_ARCHIVE, cycle 763).

Measured growth 1799 -> 1835 (36 cycles, 10 blocks kept both times):
  STATUS.md  100,920 -> 263,263 B  = +4,510 B/cycle
  queue.md   123,203 -> 319,042 B  = +5,440 B/cycle   <- the binding one
From its ~65KB post-1836 floor, queue.md reaches the 200KB action line below in ~25
cycles (and the 256KB Read cap in ~36, matching how long the 1799 trim actually
lasted). fleet_checks.json therefore registers this at 24c -- it fires just before
the faster-growing file crosses the action line, which is a measured number, not a
"to be safe" guess.

A STATIC action line is not enough on its own (measured cycle 1860). This checker
only looked at today's size, so at 1860 it reported queue.md 175.7KB = "WARN, ~5
cycles of headroom" and exited 0 -- "not due yet". But its own interval is 24
cycles, so the next look was 1884, and at +5440 B/cycle queue.md crosses the 256KB
Read cap around cycle 1875: nine cycles of truncated reads that nothing would have
flagged. The 200KB line is only safe if the check fires NEAR it; fired at a WARN, a
clean exit means "guaranteed to breach unseen". So the test is now forward-looking:
TRIM DUE if the doc is over TRIM_BYTES **or** if it is projected past READ_CAP by
the time this checker next runs (interval read from state/fleet_checks.json).

Read-only, no network, no cost. Exit 1 if any live doc is at/over TRIM_BYTES or is
projected over READ_CAP before the next scheduled run.
"""
import json, os, sys

READ_CAP = 256 * 1024   # Read tool's single-file cap -- past this, reads truncate
TRIM_BYTES = 200 * 1024 # act here, leaving room for one verbose cycle before the cap
WARN_BYTES = 150 * 1024 # the long-standing "standing trim line" (cycle 156)

# (live doc, its archive, measured bytes/cycle growth at 10 kept blocks)
DOCS = [
    ("state/STATUS.md", "state/STATUS_ARCHIVE.md", 4510),
    ("tasks/queue.md", "tasks/queue_archive.md", 5440),
]

# Docs whose trim rule is stated in LINES, not bytes. notes/LEARNINGS.md is 687KB
# and will never be Read whole (it is reached via bin/learnings), so the byte
# thresholds above would mark it TRIM DUE forever -- an always-failing check is as
# useless as an always-passing one. Its own header states the real rule: ~8000 lines.
# Added at cycle 1976, which found it at 10,325 lines: the rule had NO enforcer, so
# it only fired when a cycle happened to eyeball the file (1684 -> 1976 = 292 cycles).
# (live doc, its archive, max lines, measured lines/cycle growth)
LINE_DOCS = [
    ("notes/LEARNINGS.md", "notes/LEARNINGS_ARCHIVE.md", 8000, 20),
]
ROOT = "/root/agent"


def size(path):
    full = os.path.join(ROOT, path)
    if not os.path.exists(full):
        return None, None
    with open(full, "rb") as f:
        data = f.read()
    return len(data), data.count(b"\n")


def next_run_gap():
    """Cycles until this checker is scheduled to look again (its own interval).

    Falls back to 24 (the registered value) if the registry is unreadable -- a
    missing file must not silently turn the forward-looking test off.
    """
    try:
        with open(os.path.join(ROOT, "state/fleet_checks.json")) as f:
            row = json.load(f)["checks"]["check-doc-size"]
        return int(row["interval_cycles"])
    except Exception as exc:
        print(f"  (note: fleet_checks.json unreadable [{exc}], assuming 24c interval)")
        return 24


def main():
    due = []
    soon = []
    gap = next_run_gap()
    print(f"doc size check  (warn {WARN_BYTES//1024}KB, trim {TRIM_BYTES//1024}KB, "
          f"Read cap {READ_CAP//1024}KB, next look in {gap}c)")
    for live, arch, rate in DOCS:
        b, lines = size(live)
        if b is None:
            print(f"  MISSING {live}")
            due.append(live)
            continue
        ab, _ = size(arch)
        head = (TRIM_BYTES - b) / rate
        projected = b + rate * gap   # size when this checker next looks
        state = "OK"
        if b >= TRIM_BYTES:
            state = "TRIM DUE"
            due.append(live)
        elif projected >= READ_CAP:
            # Below the action line today, but the next scheduled look is after the
            # Read cap -- trimming later is not an option that exists. Cycle 1860.
            state = "TRIM DUE"
            due.append(live)
        elif head < gap:
            # Will cross TRIM_BYTES before this checker is next scheduled to look --
            # OK/WARN both read as "not due yet" even though the next look is
            # guaranteed to find it past the action line. Cycle 2220 hit this exact
            # gap live (queue.md read OK at 105.1KB while projecting to 233KB against
            # a 24c interval) and only caught it by reading the projection text, not
            # because the state column said so. Does NOT change the exit code --
            # non-escalating, like the WARN line it sits next to (cycle 2220 follow-up).
            state = "TRIM SOON"
            soon.append(live)
        elif b >= WARN_BYTES:
            state = "WARN"
        print(f"  {state:9} {live:20} {b/1024:7.1f}KB {lines:5d} lines  "
              f"~{head:.0f} cycles of headroom at +{rate} B/cycle"
              f" (proj. {projected/1024:.0f}KB at next look)"
              + (f"   (archive {ab/1024/1024:.1f}MB)" if ab else ""))

    for live, arch, maxl, rate in LINE_DOCS:
        b, lines = size(live)
        if b is None:
            print(f"  MISSING {live}")
            due.append(live)
            continue
        ab, _ = size(arch)
        head = (maxl - lines) / rate
        projected = lines + rate * gap
        state = "OK"
        if lines >= maxl:
            state = "TRIM DUE"
            due.append(live)
        elif projected >= maxl:
            # Cycle 2109: this used to only reach WARN here, never TRIM DUE -- the
            # one forward-looking branch (exists so a breach between scheduled looks
            # doesn't go unnoticed, cycle 1860) silently couldn't set rc=1 for a
            # LINE_DOCS entry no matter how far past maxl the projection landed. c2106
            # hit this exact live condition (LEARNINGS.md WARN at 7759/8000, projected
            # to breach before the next look) and only caught it by reading the WARN
            # text, not because the exit code forced action -- same silent-pass shape
            # as c2108's check-git-push bug. The byte docs already escalate their
            # equivalent forward-looking case (projected >= READ_CAP) to TRIM DUE;
            # line docs now match.
            state = "TRIM DUE"
            due.append(live)
        elif head < gap:
            # Same non-escalating early warning as the byte docs above, applied to
            # the line-counted rule (cycle 2220 follow-up).
            state = "TRIM SOON"
            soon.append(live)
        print(f"  {state:9} {live:20} {lines:5d} lines (max {maxl})  "
              f"~{head:.0f} cycles of headroom at +{rate} lines/cycle"
              f" (proj. {projected} at next look)"
              + (f"   (archive {ab/1024/1024:.1f}MB)" if ab else ""))

    if due:
        print("\nTRIM DUE: " + ", ".join(due))
        print("Process (cycle 1836, 1799 before it): keep the newest 10 cycle blocks in")
        print("the live file, append the remainder VERBATIM to the end of its archive")
        print("under a '## Archived by cycle <N>' header, newest-first. Verify losslessly")
        print("(every non-blank original line must be findable in live+archive) before")
        print("committing -- see bin/_trim1836.py for a worked, self-verifying example.")
        print("notes/LEARNINGS.md differs: move the OLDEST contiguous block of the")
        print("chronological body (never the newest-first highlights block at the top)")
        print("to the END of its archive, and trim DEEP enough to clear this check's own")
        print("interval with room to spare -- cycle 1976 first cut to 7604 (20c headroom")
        print("vs a 24c interval, i.e. instantly WARN) before recutting to 5928.")
        return 1

    if soon:
        print("\nTRIM SOON: " + ", ".join(soon))
        print("Not due yet -- headroom is positive today -- but projected to cross the")
        print("trim line before this checker is next scheduled to look, so the NEXT run")
        print("will read TRIM DUE no matter what else happens between now and then. Does")
        print("not fail this check; trim proactively in a QUALITY slot rather than waiting")
        print("for the escalation (cycle 2220 follow-up).")

    print("\nOK: all live docs under their trim line.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
