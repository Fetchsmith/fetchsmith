#!/root/agent/venv/bin/python
"""Are the live docs still small enough to work with? (STATUS/queue by bytes,
notes/LEARNINGS.md by lines -- see LINE_DOCS for why the rule differs.)
(added cycle 1836)

WHY: the archive trim is the one piece of housekeeping that has no clock. It lived
only as a carried queue.md backlog item -- which is exactly the failure mode
state/fleet_checks.json exists to close, and doubly ironic here because the item
describing the trim is itself what the trim deletes. Measured damage: cycle 1833
found STATUS.md at 292KB and had to PAGE it; the item was then carried unresolved
through 1833/1834/1835 (3 cycles) while both files kept growing, and cycle 1836
finally trimmed 263KB+319KB back to 47KB+67KB. Before that, the cycle-1799 trim had
breached the cap again in only 36 cycles. Every cycle past the cap pays a context
tax before any work starts, and the cycle that skips the trim is not the one that
pays it (LEARNINGS_ARCHIVE, cycle 763).

Measured growth 1799 -> 1835 (36 cycles, 10 blocks kept both times):
  STATUS.md  100,920 -> 263,263 B  = +4,510 B/cycle
  queue.md   123,203 -> 319,042 B  = +5,440 B/cycle   <- the binding one
From its ~65KB post-1836 floor, queue.md reaches the 200KB action line below in ~25
cycles (and the 256KB Read cap in ~36, matching how long the 1799 trim actually
lasted). fleet_checks.json therefore registers this at 24c -- it fires just before
the faster-growing file crosses the action line, which is a measured number, not a
"to be safe" guess.

A STATIC action line is not enough on its own (measured cycle 1860). This checker
only looked at today's size, so at 1860 it reported queue.md 175.7KB = "WARN, ~5
cycles of headroom" and exited 0 -- "not due yet". But its own interval is 24
cycles, so the next look was 1884, and at +5440 B/cycle queue.md crosses the 256KB
Read cap around cycle 1875: nine cycles of truncated reads that nothing would have
flagged. The 200KB line is only safe if the check fires NEAR it; fired at a WARN, a
clean exit means "guaranteed to breach unseen". So the test is now forward-looking:
TRIM DUE if the doc is over TRIM_BYTES **or** if it is projected past READ_CAP by
the time this checker next runs (interval read from state/fleet_checks.json).

Read-only, no network, no cost. Exit 1 if any live doc is at/over TRIM_BYTES or is
projected over READ_CAP before the next scheduled run.
"""
import json, os, re, sys

READ_CAP = 256 * 1024   # Read tool's single-file cap -- past this, reads truncate
TRIM_BYTES = 200 * 1024 # act here, leaving room for one verbose cycle before the cap
WARN_BYTES = 150 * 1024 # the long-standing "standing trim line" (cycle 156)

# Per-doc TRIM override (cycle 3824). The shared 200KB line assumes a doc whose
# bulk is rotatable history, which is true of STATUS.md (a pure chronological log:
# c3822 cut it 206.3KB -> 50.2KB) but is NO LONGER true of tasks/queue.md.
# MEASURED at c3824, right after that cycle's own successful floor-3 rotation:
#   live 204,254B = 106 live OPEN items (180,428B) + 17 CLOSED blocks (23,826B),
#   of which only 2 are rotatable report blocks (6,941B, and floor 3 means the
#   newest 2 can never be cut). Structural floor = 187,369B.
# So the 200KB line sits just 17.4KB above a floor the rotation cannot touch --
# LESS THAN ONE CYCLE'S growth short of three (+5440 B/cycle), while a full
# 8-block rotation yields ~35KB. The file therefore reads TRIM DUE within ~3
# cycles of every successful trim, forever, and each QUALITY slot gets pulled
# into a rotation that provably cannot clear the line. That is precisely the
# "an always-failing check is as useless as an always-passing one" failure this
# file's own docstring names, and the same remedy LINE_DOCS already applies to
# notes/LEARNINGS.md: when a doc's floor invalidates the shared threshold, give
# that doc its own rule rather than leaving a permanent false alarm.
# 225KB is derived, not chosen for comfort: it leaves 37KB of real working room
# above the measured floor (~one rotation's yield, ~7 cycles) while keeping
# ~31KB = ~5-6 verbose cycles of margin under the 256KB Read cap, which is the
# constraint that actually bites. The projected-past-READ_CAP escalation below
# is untouched and remains the real safety net.
# THE ACTUAL LEVER IS NOT ROTATION: 180KB of 204KB is live open items. Only
# closing/merging/compressing those reduces this file. See `NEW c3824a`.
TRIM_OVERRIDE = {"tasks/queue.md": 225 * 1024}

# (live doc, its archive, measured bytes/cycle growth at 10 kept blocks)
DOCS = [
    ("state/STATUS.md", "state/STATUS_ARCHIVE.md", 4510),
    ("tasks/queue.md", "tasks/queue_archive.md", 5440),
]

# Docs whose trim rule is stated in LINES, not bytes. notes/LEARNINGS.md is 687KB
# and will never be Read whole (it is reached via bin/learnings), so the byte
# thresholds above would mark it TRIM DUE forever -- an always-failing check is as
# useless as an always-passing one. Its own header states the real rule: ~8000 lines.
# Added at cycle 1976, which found it at 10,325 lines: the rule had NO enforcer, so
# it only fired when a cycle happened to eyeball the file (1684 -> 1976 = 292 cycles).
# (live doc, its archive, max lines, measured lines/cycle growth)
LINE_DOCS = [
    ("notes/LEARNINGS.md", "notes/LEARNINGS_ARCHIVE.md", 8000, 20),
]
ROOT = "/root/agent"

# Doc-trim cadence rule 6 (decided cycle 2865): each NEW queue.md DONE block
# should run ~15-20 lines, with the full narrative living in STATUS.md instead.
# Measured cycle 2916: 6 live blocks ran 40/29/31/46/32/9 lines (mean ~31) --
# nobody was honouring the cap by eye, and that overrun is roughly the whole
# +5440 B/cycle growth this checker tracks above. Surfacing the newest block's
# line count here puts it in the same preflight output a cycle already reads,
# instead of relying on memory of a rule stated only in queue.md prose.
DONE_BLOCK_CAP = 20
TOP_LEVEL_BULLET = re.compile(r"^- \[[ x]\] ")
# FIXED cycle 3180: this was `^- \[x\] \*\*DONE c\d+`, which matched NOTHING in the
# live queue and so silently disabled the whole rule-6 surfacing below -- the exact
# "always-passing check is as useless as an always-failing one" failure this file's
# own docstring warns about, and it had been dead since the queue's cycle blocks
# changed shape. Two independent reasons it could not match: today's blocks head
# with `- [ ] **CLOSED c3179` (open checkbox, CLOSED not DONE -- see the rule-7
# adaptation recorded in `bin/_trim3048q.py`), and the one `- [x]` form actually
# present writes `**DONE at c3166`, with an `at` the old pattern had no room for.
# So accept any checkbox state and the labels cycles really use. Verified at c3180:
# before, `bin/check-doc-size | grep -c 'DONE block'` was 0.
NEWEST_DONE = re.compile(r"^- \[[ x]\] \*\*(?:DONE|CLOSED|PROGRESS|SHIPPED)(?: at)? c\d+")


def newest_done_block_lines(path):
    """Line count of the first (newest) cycle block in a queue-style doc (a
    '- [ ] **CLOSED c<N>' / '- [x] **DONE c<N>' head), or None if there is no such
    block. A block runs from its own top-level bullet line up to (not including)
    the next top-level bullet line."""
    full = os.path.join(ROOT, path)
    if not os.path.exists(full):
        return None
    with open(full, encoding="utf-8") as f:
        lines = f.readlines()
    start = next((i for i, ln in enumerate(lines) if NEWEST_DONE.match(ln)), None)
    if start is None:
        return None
    end = next(
        (i for i in range(start + 1, len(lines)) if TOP_LEVEL_BULLET.match(lines[i])),
        len(lines),
    )
    return end - start


# Compressed-tracker entry cap (added cycle 3364). A "one line each" tracker line
# collapses one entry per cycle onto a single physical line so a long-running batch
# job costs ~25-300B/batch instead of a full paragraph. That rule is stated TWICE
# inside the vendor-catalogue block and was tightened once (c3320), and it has still
# been breached by the triage cycles following EVERY one of the last three trims:
# c3348 fixed c3340/c3341, c3353 fixed c3349-c3352, c3360 fixed c3354-c3359 (4,529B
# of a 10,314B line). Prose did not work, so this is a checker instead -- it runs in
# the 24c cadence that already reads this file, needs no new state and no network,
# and would have caught all three breaches in the cycle that caused them rather than
# 5-6 cycles later at ~1.5KB/batch.
#
# NON-ESCALATING, like the rule-6 DONE-block warning above: an oversized entry is a
# style regression to fix in passing, not a reason to fail the trim check.
#
# Two deliberate scope choices:
#  - The boundary regex is `\bc\d{3,4} rows `, NOT the `\bc3\d{3} rows ` that
#    bin/_trim3360q.py uses. Verified identical on the live line (41 parts both
#    ways), but the `c3` form silently stops matching at cycle 4000 -- ~636 cycles
#    out, i.e. inside this checker's lifetime -- and would then read as "no tracker
#    lines found", the always-passing failure this file's docstring warns about.
#  - Generalizing to ANY `one line each` line is only free because of MIN_ENTRIES.
#    Three other queue.md lines quote that label while merely DESCRIBING this
#    tracker (the c3360/c3348 tasks and STANDING c3280); all three split to 0
#    entries, so requiring >=3 excludes them without naming line numbers. Going
#    further -- a generic entry boundary for a future tracker that does not use the
#    `cNNNN rows N-M:` shape -- is NOT free and was not attempted.
ENTRY_CAP = 500          # bytes; the established entries on the live line run 25-450B
MIN_ENTRIES = 3          # below this it is prose about a tracker, not a tracker
ONE_LINE_EACH = "one line each"
ENTRY_SPLIT = re.compile(r"(?=\bc\d{3,4} rows )")
ENTRY_LABEL = re.compile(r"^(c\d{3,4}) rows ([\d-]+)")


def oversized_tracker_entries(path, cap=ENTRY_CAP):
    """Entries over `cap` bytes on each compressed 'one line each' tracker line.

    Yields (lineno, n_entries, line_bytes, [(label, rows, bytes), ...]) per tracker
    line found, newest-first within the line as it is written.
    """
    full = os.path.join(ROOT, path)
    if not os.path.exists(full):
        return
    with open(full, encoding="utf-8") as f:
        lines = f.read().split("\n")
    for i, ln in enumerate(lines, 1):
        if ONE_LINE_EACH not in ln:
            continue
        parts = ENTRY_SPLIT.split(ln)
        entries = [p for p in parts if ENTRY_LABEL.match(p)]
        if len(entries) < MIN_ENTRIES:
            continue
        over = []
        for p in entries:
            nb = len(p.encode("utf-8"))
            if nb > cap:
                m = ENTRY_LABEL.match(p)
                over.append((m.group(1), m.group(2), nb))
        yield i, len(entries), len(ln.encode("utf-8")), over


def size(path):
    full = os.path.join(ROOT, path)
    if not os.path.exists(full):
        return None, None
    with open(full, "rb") as f:
        data = f.read()
    return len(data), data.count(b"\n")


def next_run_gap():
    """Cycles until this checker is scheduled to look again (its own interval).

    Falls back to 24 (the registered value) if the registry is unreadable -- a
    missing file must not silently turn the forward-looking test off.
    """
    try:
        with open(os.path.join(ROOT, "state/fleet_checks.json")) as f:
            row = json.load(f)["checks"]["check-doc-size"]
        return int(row["interval_cycles"])
    except Exception as exc:
        print(f"  (note: fleet_checks.json unreadable [{exc}], assuming 24c interval)")
        return 24


REPORT_HEAD = re.compile(r"- \[[ x]\] \*\*CLOSED c\d{4} -- (?:BUILD|QUALITY|GROWTH)")


def structural_floor(live):
    """Split a queue-shaped doc into (floor_bytes, n_open_items, rotatable_bytes).

    Added cycle 3824 alongside TRIM_OVERRIDE, to make the thing that decides
    whether a trim is even possible visible instead of inferred. The floor is
    everything a rotation may NOT cut: live OPEN items (`- [ ]` heads), plus
    one-off `[x]` ITEM closures (out of the rotation pool by the c3745/c3748
    rule), plus the newest 2 report blocks that floor 3 protects. Rotatable =
    report blocks beyond those 2. Returns (None, 0, 0) for docs that are not
    queue-shaped (STATUS.md has no checkbox heads), so this stays silent there
    rather than printing a meaningless 0.
    """
    try:
        t = open(os.path.join(ROOT, live)).read()
    except OSError:
        return None, 0, 0
    heads = [m.start() for m in re.finditer(r"^- \[[ x]\] \*\*.*$", t, re.M)]
    if len(heads) < 10:          # not queue-shaped
        return None, 0, 0
    ends = heads[1:] + [len(t)]
    nopen = rotatable = 0
    reports = []                 # (start, end) of report blocks, newest first
    for s, e in zip(heads, ends):
        head = t[s:t.index("\n", s)] if "\n" in t[s:] else t[s:]
        if head.startswith("- [ ]"):
            nopen += 1
        elif REPORT_HEAD.match(head):
            reports.append((s, e))
    for s, e in reports[2:]:     # floor 3 protects the newest 2 (+ the running cycle)
        rotatable += e - s
    return len(t) - rotatable, nopen, rotatable


def main():
    due = []
    soon = []
    gap = next_run_gap()
    print(f"doc size check  (warn {WARN_BYTES//1024}KB, trim {TRIM_BYTES//1024}KB, "
          f"Read cap {READ_CAP//1024}KB, next look in {gap}c)")
    for live, arch, rate in DOCS:
        b, lines = size(live)
        if b is None:
            print(f"  MISSING {live}")
            due.append(live)
            continue
        ab, _ = size(arch)
        trim_bytes = TRIM_OVERRIDE.get(live, TRIM_BYTES)
        head = (trim_bytes - b) / rate
        projected = b + rate * gap   # size when this checker next looks
        state = "OK"
        if b >= trim_bytes:
            state = "TRIM DUE"
            due.append(live)
        elif projected >= READ_CAP:
            # Below the action line today, but the next scheduled look is after the
            # Read cap -- trimming later is not an option that exists. Cycle 1860.
            state = "TRIM DUE"
            due.append(live)
        elif head < gap:
            # Will cross the trim line before this checker is next scheduled to look --
            # OK/WARN both read as "not due yet" even though the next look is
            # guaranteed to find it past the action line. Cycle 2220 hit this exact
            # gap live (queue.md read OK at 105.1KB while projecting to 233KB against
            # a 24c interval) and only caught it by reading the projection text, not
            # because the state column said so. Does NOT change the exit code --
            # non-escalating, like the WARN line it sits next to (cycle 2220 follow-up).
            state = "TRIM SOON"
            soon.append(live)
        elif b >= WARN_BYTES:
            state = "WARN"
        print(f"  {state:9} {live:20} {b/1024:7.1f}KB {lines:5d} lines  "
              f"~{head:.0f} cycles of headroom at +{rate} B/cycle"
              f" (proj. {projected/1024:.0f}KB at next look)"
              + (f"   trim {trim_bytes//1024}KB" if live in TRIM_OVERRIDE else "")
              + (f"   (archive {ab/1024/1024:.1f}MB)" if ab else ""))
        # Cycle 3824: say out loud how much of the doc a rotation could even reach,
        # so a future cycle does not spend a QUALITY slot on a trim that cannot
        # clear the line. "TRIM DUE with 0B rotatable" means the lever is
        # open-item reduction, not another span cut.
        floor, nopen, rot = structural_floor(live)
        if floor is not None:
            msg = (f"             floor {floor/1024:.1f}KB ({nopen} live OPEN items, "
                   f"not rotatable) + {rot/1024:.1f}KB rotatable above floor-3 -> ")
            if rot == 0:
                msg += ("ROTATION EXHAUSTED: a span cut cannot shrink this file at "
                        "all. The only lever is closing/merging/compressing open "
                        "items -- see `NEW c3824a`.")
            else:
                msg += (f"a full rotation lands {(b - rot)/1024:.1f}KB "
                        f"({'CLEARS' if (b - rot) < trim_bytes else 'STILL OVER'} "
                        f"the {trim_bytes//1024}KB line)")
            print(msg)

    block_lines = newest_done_block_lines("tasks/queue.md")
    if block_lines is not None:
        flag = " -- OVER the ~" + str(DONE_BLOCK_CAP) + "-line cap (rule 6)" if block_lines > DONE_BLOCK_CAP else ""
        print(f"  newest tasks/queue.md DONE block: {block_lines} lines "
              f"(cap ~{DONE_BLOCK_CAP}){flag}")
        if flag:
            print("    Put the full narrative in STATUS.md instead and keep this file's")
            print("    copy to the cap -- this is the rate rule 6 governs, measured cycle")
            print("    2916 as the main driver of queue.md's byte growth above.")

    for lineno, n, line_bytes, over in oversized_tracker_entries("tasks/queue.md"):
        tag = f"tasks/queue.md:{lineno}"
        if not over:
            print(f"  compressed tracker {tag}: {n} entries, {line_bytes/1024:.1f}KB, "
                  f"all under the {ENTRY_CAP}B/entry cap")
            continue
        print(f"  compressed tracker {tag}: {n} entries, {line_bytes/1024:.1f}KB -- "
              f"{len(over)} OVER the {ENTRY_CAP}B/entry cap (one line each):")
        for label, rows, nb in over:
            print(f"    {label} rows {rows}: {nb}B")
        print("    These are full paragraphs pasted onto a line whose own rule is one")
        print("    compressed line per batch. The narrative is correct and belongs in")
        print("    state/STATUS.md and the cycle's own CLOSED block -- recompress the")
        print("    entries named above in the style of the older ones on the same line.")

    for live, arch, maxl, rate in LINE_DOCS:
        b, lines = size(live)
        if b is None:
            print(f"  MISSING {live}")
            due.append(live)
            continue
        ab, _ = size(arch)
        head = (maxl - lines) / rate
        projected = lines + rate * gap
        state = "OK"
        if lines >= maxl:
            state = "TRIM DUE"
            due.append(live)
        elif projected >= maxl:
            # Cycle 2109: this used to only reach WARN here, never TRIM DUE -- the
            # one forward-looking branch (exists so a breach between scheduled looks
            # doesn't go unnoticed, cycle 1860) silently couldn't set rc=1 for a
            # LINE_DOCS entry no matter how far past maxl the projection landed. c2106
            # hit this exact live condition (LEARNINGS.md WARN at 7759/8000, projected
            # to breach before the next look) and only caught it by reading the WARN
            # text, not because the exit code forced action -- same silent-pass shape
            # as c2108's check-git-push bug. The byte docs already escalate their
            # equivalent forward-looking case (projected >= READ_CAP) to TRIM DUE;
            # line docs now match.
            state = "TRIM DUE"
            due.append(live)
        elif head < gap:
            # Same non-escalating early warning as the byte docs above, applied to
            # the line-counted rule (cycle 2220 follow-up).
            state = "TRIM SOON"
            soon.append(live)
        print(f"  {state:9} {live:20} {lines:5d} lines (max {maxl})  "
              f"~{head:.0f} cycles of headroom at +{rate} lines/cycle"
              f" (proj. {projected} at next look)"
              + (f"   (archive {ab/1024/1024:.1f}MB)" if ab else ""))

    if due:
        print("\nTRIM DUE: " + ", ".join(due))
        print("Process (cycle 1836, 1799 before it): keep the newest 10 cycle blocks in")
        print("the live file, append the remainder VERBATIM to the end of its archive")
        print("under a '## Archived by cycle <N>' header, newest-first. Verify losslessly")
        print("(every non-blank original line must be findable in live+archive) before")
        print("committing -- see bin/_trim1836.py for a worked, self-verifying example.")
        print("notes/LEARNINGS.md differs: move the OLDEST contiguous block of the")
        print("chronological body (never the newest-first highlights block at the top)")
        print("to the END of its archive, and trim DEEP enough to clear this check's own")
        print("interval with room to spare -- cycle 1976 first cut to 7604 (20c headroom")
        print("vs a 24c interval, i.e. instantly WARN) before recutting to 5928.")
        return 1

    if soon:
        print("\nTRIM SOON: " + ", ".join(soon))
        print("Not due yet -- headroom is positive today -- but projected to cross the")
        print("trim line before this checker is next scheduled to look, so the NEXT run")
        print("will read TRIM DUE no matter what else happens between now and then. Does")
        print("not fail this check; trim proactively in a QUALITY slot rather than waiting")
        print("for the escalation (cycle 2220 follow-up).")

    print("\nOK: all live docs under their trim line.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
