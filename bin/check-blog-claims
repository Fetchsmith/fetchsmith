#!/usr/bin/env python3
"""Flag blog posts whose self-describing claims about OUR Actors have gone stale.

Two checks, same class of bug: a number or a list in hand-written copy whose real owner
lives elsewhere in the repo. Tool pages self-heal (they render from registry.json);
prose does not.

1. FIELD COUNTS (cycle 352) — '<N> flat/typed/normalized fields' vs registry.json.
   Added after two guides were found understating their own Actor by 16 and 3 fields.
   Only sentences that LINK to an Actor are checked, so counts describing an UPSTREAM
   API's row shape are left alone. See links_on() for the link forms that count.

   Cycle 2300: this check had gone silently blind — it reported "0 claims checked"
   while two guides carried wrong numbers. Two causes, both fixed here:
     a. link forms. Blog product CTAs stopped pointing at apify.com directly in
        cycle 1509 (they go through /go/<slug> now, so out_clicks are logged); the
        /go/ form was never taught to this check, and apify.com/fetchsmith/<slug>
        now appears in ZERO posts. Every field-count sentence in the blog happened
        to use a /go/ link, so check 1 matched nothing at all and still exited 0.
     b. what the number means. The truth was len(output_fields), which includes the
        internal `_watchChangeType`/`_watchPrevious` columns. Neither the tool pages
        nor the READMEs sell those as fields (the live /tools/fda-recall-scraper page
        says "40 typed fields" against 42 registry entries), so counting them made
        the check demand a number no customer-facing copy should ever print.

2. FEATURE COVERAGE (cycle 356) — which Actors a post says ship `watchChanges` /
   `watchLabel`, vs each Actor's own .actor/input_schema.json. Added after the same
   post went stale on this in cycles 352, 354 and 356: every new port has to be
   hand-added to the guide, and three cycles in a row it wasn't. Catches three shapes:
     a. the post credits the feature to an Actor that does not have it (or explicitly
        denies it on one that does);
     b. the post is enumerating (3+ Actors credited) and a shipped port is missing;
     c. a count phrase disagrees with what it is counting ('...A, B, C, D and E ...
        off by default on all four', or 'optional input on 14 of our Actors').

3. FLEET COUNTS (cycle 356) — any bare '<N> of our Actors' with no feature attached is
   a claim about the whole catalog, so it is checked against registry.json's length.
   Added because the first run of check 2 surfaced a guide still selling "all twelve of
   our Actors" back when the fleet was 12; it is 19. Nothing had ever read that number.
"""
import glob
import json
import os
import re
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
# Sellable field count = registry entries minus the internal `_`-prefixed watch columns,
# which is what the tool pages and READMEs print. See docstring note 1b (cycle 2300).
reg = {t["slug"]: len([f for f in t.get("output_fields", []) if not f.startswith("_")])
       for t in json.load(open(os.path.join(ROOT, "actors/registry.json")))["tools"]}


def links_on(line):
    """Slugs this line links to. /go/<slug> is the click-logged CTA form every blog
    product link uses since cycle 1509; /tools/<slug> is the on-site tool page.
    apify.com/fetchsmith/<slug> is kept only so a hand-written direct link would
    still be seen — no post has used one since cycle 1509."""
    return {s for s in reg
            if f"/go/{s}" in line or f"/tools/{s}" in line or f"fetchsmith/{s}" in line}


# "<N> flat fields", "<N> typed output fields", "<N> normalized fields",
# "<N> other typed fields" (cycle 374 near-miss: "~28 other typed fields" went unchecked), ...
COUNT = re.compile(r"(\d+)\s+(?:other\s+)?(?:flat|typed|normali[sz]ed)(?:\s+output)?\s+fields?")

flagged = 0
checked = 0
for path in sorted(glob.glob(os.path.join(ROOT, "site/content/blog/*.md"))):
    for lineno, line in enumerate(open(path), 1):
        counts = COUNT.findall(line)
        if not counts:
            continue
        slugs = sorted(links_on(line))
        if not slugs:
            continue  # count is about an upstream API, not one of ours
        checked += 1
        for claimed in counts:
            for slug in slugs:
                if int(claimed) != reg[slug]:
                    flagged += 1
                    print(f"STALE {os.path.basename(path)}:{lineno}  claims {claimed} fields, {slug} has {reg[slug]}")

print(f"check-blog-claims: {checked} Actor field-count claim(s) checked, {flagged} stale")

# ---------------------------------------------------------------- feature coverage
FEATURES = ("watchChanges", "watchLabel")
WORDS = {w: i for i, w in enumerate(
    "zero one two three four five six seven eight nine ten eleven twelve thirteen "
    "fourteen fifteen sixteen seventeen eighteen nineteen twenty".split())}


def as_int(tok):
    return int(tok) if tok.isdigit() else WORDS.get(tok.lower())


def has_input(slug, prop):
    p = os.path.join(ROOT, "actors", slug, ".actor/input_schema.json")
    if not os.path.exists(p):
        return False
    return prop in json.load(open(p)).get("properties", {})


truth = {f: {s for s in reg if has_input(s, f)} for f in FEATURES}
# "no `watchChanges`", "without `watchChanges`", "deliberately with **no** `watchChanges`"
DENY = r"(?:no|without|not)\*{0,2}\s+\*{0,2}`%s`"
ON_N_ACTORS = re.compile(r"\bon (\d+|[a-z]+) of our Actors\b", re.I)
ALL_N = re.compile(r"\ball (\d+|[a-z]+)\b", re.I)

fchecked = 0
for path in sorted(glob.glob(os.path.join(ROOT, "site/content/blog/*.md"))):
    lines = list(enumerate(open(path), 1))
    name = os.path.basename(path)
    for feat in FEATURES:
        credits, denials = {}, {}
        for lineno, line in lines:
            if f"`{feat}`" not in line:
                continue
            bucket = denials if re.search(DENY % feat, line) else credits
            for s in links_on(line):
                bucket.setdefault(s, lineno)
            m = ON_N_ACTORS.search(line)
            if m and (n := as_int(m.group(1))) is not None:
                fchecked += 1
                if n != len(truth[feat]):
                    flagged += 1
                    print(f"STALE {name}:{lineno}  says `{feat}` is on {n} Actors, real count is {len(truth[feat])}")
        if not credits and not denials:
            continue
        fchecked += 1
        for s, ln in sorted(credits.items()):
            if s not in truth[feat]:
                flagged += 1
                print(f"STALE {name}:{ln}  credits `{feat}` to {s}, which does not declare it")
        for s, ln in sorted(denials.items()):
            if s in truth[feat]:
                flagged += 1
                print(f"STALE {name}:{ln}  says {s} has no `{feat}`, but it declares one")
        # Only demand completeness of a post that is clearly enumerating the feature.
        if len(credits) >= 3:
            for s in sorted(truth[feat] - set(credits) - set(denials)):
                flagged += 1
                print(f"STALE {name}  enumerates `{feat}` ({len(credits)} Actors) but never mentions {s}, which ships it")

# Fleet counts: a bare "<N> of our Actors" with no feature attached means the catalog.
FLEET_N = re.compile(r"\b(?:all |each of )?(\d+|[a-z]+) of (?:our|the) Actors\b", re.I)
# Self-consistency: "…A, B, C, D and E …, off by default on all four."
for path in sorted(glob.glob(os.path.join(ROOT, "site/content/blog/*.md"))):
    for lineno, line in enumerate(open(path), 1):
        for tok in FLEET_N.findall(line):
            n = as_int(tok)
            if n is None or n < 2 or any(f"`{f}`" in line for f in FEATURES):
                # "every one of our Actors" is partitive prose, not a count; and a
                # feature-scoped count belongs to check 2, not to the fleet check.
                continue
            fchecked += 1
            if n != len(reg):
                flagged += 1
                print(f"STALE {os.path.basename(path)}:{lineno}  says '{tok} of our Actors', fleet is {len(reg)}")
        linked = links_on(line)
        if len(linked) < 2 or FLEET_N.search(line):
            continue
        for tok in ALL_N.findall(line):
            n = as_int(tok)
            if n is None or n < 2:
                continue  # "all of", "all five" only; prose words are not counts
            fchecked += 1
            if n != len(linked):
                flagged += 1
                print(f"STALE {os.path.basename(path)}:{lineno}  says 'all {tok}' but links {len(linked)} Actors")

print(f"check-blog-claims: {fchecked} Actor feature-coverage claim(s) checked, {flagged} total stale")

# ------------------------------------------------- registry summaries (cycle 2300)
# A summary's own field count is hand-written prose sitting next to the field list it
# describes, and it is the number the tool page, /llms.txt and /llms-full.txt all print.
# us-federal-awards-scraper's said "54 typed output fields" against 52 sellable ones
# (it had counted the two off-by-default `_watch*` columns); nothing read it. Same check
# as 1, different file -- a count whose owner is the output_fields list beside it.
schecked = 0
for t in json.load(open(os.path.join(ROOT, "actors/registry.json")))["tools"]:
    for claimed in COUNT.findall(t.get("summary") or ""):
        schecked += 1
        if int(claimed) != reg[t["slug"]]:
            flagged += 1
            print(f"STALE registry.json  {t['slug']} summary claims {claimed} fields,"
                  f" it has {reg[t['slug']]} sellable")

print(f"check-blog-claims: {schecked} registry summary field-count claim(s) checked, {flagged} total stale")

# ---------------------------------------------------- README self-claims (cycle 2301)
# A README's own field-count claim doesn't need links_on() to identify the Actor -- the
# file already belongs to one slug, so every match is a claim about reg[slug] directly.
# Added after two READMEs were found stale with nothing reading this surface at all:
# us-federal-awards-scraper said "37 typed fields" (real 52, in the paragraph arguing it
# beats a rival's advertised "18 Fields" -- understating itself by 15 in its own pitch),
# clinicaltrials-scraper said "37 flat fields" (real 38).
rchecked = 0
for t in json.load(open(os.path.join(ROOT, "actors/registry.json")))["tools"]:
    slug = t["slug"]
    path = os.path.join(ROOT, "actors", slug, "README.md")
    if not os.path.exists(path):
        continue
    for lineno, line in enumerate(open(path), 1):
        for claimed in COUNT.findall(line):
            rchecked += 1
            if int(claimed) != reg[slug]:
                flagged += 1
                print(f"STALE {slug}/README.md:{lineno}  claims {claimed} fields, has {reg[slug]} sellable")

print(f"check-blog-claims: {rchecked} README field-count claim(s) checked, {flagged} total stale")
sys.exit(1 if flagged else 0)
