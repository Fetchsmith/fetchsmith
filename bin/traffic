#!/usr/bin/env bash
# Site traffic summary from the cookieless pageviews table. Usage: traffic [days]
#
# Cycle 32: UA-based bot filtering alone overstates humans by ~40x — 48 distinct IPs
# hit us with real Chrome/Safari UAs but never fetched a single CSS file, and five
# separate cloud IPs each walked /pricing -> /checkout/{starter,pro,scale} in sequence
# (link enumeration, not buyers). So we now record a pseudonymous per-day visitor token
# (`vid`) and a row in `asset_hits` for any client that loads /static/*. A vid present
# in asset_hits rendered the page => real browser. Trust the VERIFIED numbers only.
# NOTE: vid/asset_hits start 2026-09-09 18:03 UTC; rows before that have vid NULL.
D=${1:-7}; DB=/root/agent/data/fetchsmith.db
SINCE="ts > strftime('%s','now')-$D*86400"
# Cycle 1711: 'fetchsmith-linkcheck/1' (bin/check-links' own UA, built cycle 1704, before
# it was renamed to include 'bot') was not matched by any pattern below and does load
# /static/* assets as part of its own asset-check -- so every check-links run silently
# counted itself as a VERIFIED human visitor, inflating the exact buyer-intent funnel this
# rule reads (622 of 639 "verified" views on 2026-10-14 were one check-links run; the
# tools+pricing+checkout bucket's reported n=291/14d was 195 linkcheck, only 96 real).
# Excluded explicitly (not just relying on the new UA's '%bot%' match) so pre-rename
# history stays correctly excluded too.
#
# Cycle 1712: same bug class, found by auditing which UAs in `asset_hits` are implausible
# as humans. Two renderer UAs carry NO 'bot'/'crawl'/'spider' token AND execute the page
# (so they fetch /static/* and land in asset_hits), i.e. they passed BOTH halves of the
# VERIFIED test: (1) 'GoogleOther' -- Google's non-search fetcher, UA is a plain mobile
# Chrome string with '(compatible; GoogleOther)' appended, 7 vids / 21 views; (2)
# 'HeadlessChrome' -- 3 vids. Together 10 of 382 verified vids fleet-wide (2.6%). They
# contributed 0 hits to the 14d tools+pricing+checkout bucket, so this was NOT distorting
# the Polar-escalation number today -- it is a correctness fix that stops a growing crawler
# share from being read as buyer intent later. NOT excluded (deliberately): the
# 'Nexus 5 Build/MRA58N ... MicroMessenger/7.0.1' cluster (7 vids) looks like a scanner
# template, but WeChat in-app browsing by a real person produces the same string -- left in
# rather than guess, and noted here so a future cycle doesn't re-derive it from scratch.
NOTBOT="ua NOT LIKE '%bot%' AND ua NOT LIKE '%crawl%' AND ua NOT LIKE '%spider%' AND ua NOT LIKE 'curl%' AND ua NOT LIKE '%linkcheck%' AND ua NOT LIKE '%GoogleOther%' AND ua NOT LIKE '%HeadlessChrome%'"
# Cycle 2278: same bug class as the out_click one below, found the same way (grouping by
# vid). Several vids load 20-56 DISTINCT paths within 0-85 seconds -- physically impossible
# reading speed -- with a plausible UA and a registered asset_hit, so they passed both
# existing VERIFIED halves. Real multi-page sessions in this data take 400-700+ seconds for
# 8-20 pages (e.g. vid 36f1e934050811c7: 20 pages / 436s; e4d43d85f925c4c3: 8 pages / 686s),
# a clean gap from the sweeps' <=85s. This funnel feeds the CLAUDE.md Polar-escalation
# trigger (>100 verified visits/day to /pricing or /tools => email owner) -- a repeat sweep
# landing on /tools/* could have forged that threshold. None of the known sweeps fall in the
# current 7-day window (all >=9 days old), so no past report was wrong, but this closes the
# hole before it can produce a false trigger or contaminate the pending c2276 CTA-fix
# measurement (~cycle 2420).
PV_SWEEPER="vid IN (SELECT vid FROM pageviews WHERE vid IS NOT NULL GROUP BY vid HAVING count(*) >= 15 AND (max(ts)-min(ts)) <= 90)"
# Cycle 2644: the first exclusion that USES the `ip` column c2642 added, and it closes a hole
# PV_SWEEPER structurally CANNOT see. vid = sha256(salt|day|ip|ua) (site/app.py visitor_token),
# so a scanner that rotates its User-Agent gets a DIFFERENT vid per request and every
# per-vid test above is blind to it -- PV_SWEEPER needs >=15 hits on ONE vid, and these
# arrive as N vids with 1 hit each. Measured live in the first hour of ip data: 45.138.12.46
# fetched `/` FOUR times in the SAME SECOND (02:53:45) with 4 different plausible
# browser UAs (2x Mac Chrome, 2x Win64 Chrome, no 'bot'/'crawl'/'spider' token) => 4 distinct
# vids, 4 "visitors", all passing NOTBOT and all invisible to PV_SWEEPER. Only the
# asset_hits half caught them (none fetched /static/*), which is a SINGLE point of failure:
# any UA-rotating scanner that also pulls the CSS would have scored 4 verified /-visitors
# from one IP in one second, and on /pricing or /tools it would feed the CLAUDE.md
# Polar-escalation trigger (>100 verified visits/day).
# WINDOW IS DELIBERATELY ONE SECOND, not 60s: 3+ distinct UAs from one IP inside a single
# second is not reachable by humans, whereas a 60s window would also catch 3 real people
# sharing one office/CGNAT egress -- exactly the "don't exclude a real small-business buyer"
# risk c2641 raised when it proposed (and this cycle's data refutes) a blanket 51.0.0.0/8
# CIDR block. No hardcoded ranges here at all: the test is behavioural, so it needs no
# maintenance as scanner IPs churn. The c2644 sample contained ZERO 51.x traffic, so that
# CIDR idea is dropped, not deferred.
# Matches only rows with ip populated (c2642 onward), so pre-c2642 history is untouched and
# nothing is retroactively reclassified. Verified a NO-OP on ship: it isolates exactly those
# 4 vids and 0 of them pass asset_hits, so no reported number moved -- it is purely a
# future-proofing fix, same posture as c2278's.
PV_UA_ROTATOR="vid IN (SELECT p.vid FROM pageviews p JOIN (SELECT ip, ts FROM pageviews WHERE ip IS NOT NULL GROUP BY ip, ts HAVING count(DISTINCT ua) >= 3) b ON p.ip = b.ip AND p.ts = b.ts)"
# Verified = browser-ish UA AND actually loaded our CSS AND not a same-second link sweep
# AND not a same-second UA-rotating scanner. All halves still matter: the UA test alone lets
# scanners through, the asset test alone lets our own `curl` tests through, and the per-vid
# sweeper test alone is blind to UA rotation.
VERIFIED="$NOTBOT AND vid IN (SELECT vid FROM asset_hits) AND NOT ($PV_SWEEPER) AND NOT ($PV_UA_ROTATOR)"
# Cycle 2696: ENGAGED is a strictly TIGHTER floor reported ALONGSIDE verified, not a new
# VERIFIED half -- deliberately NOT folded into VERIFIED, because every number in STATUS.md
# and the CLAUDE.md Polar gate is denominated in `verified` and silently redefining it would
# invalidate the whole recorded history rather than add information.
# WHY IT EXISTS: all four prior contamination fixes (c32 UA, c1712 renderer UAs, c2278
# same-second sweeps, c2644 UA rotation) are *token-* or *burst*-shaped, so they are blind to
# the population actually dominating this funnel today -- a DISTRIBUTED crawl whose every
# request is individually indistinguishable from a human. Measured c2696 over the live 7-day
# window: of 138 verified vids, 127 (92%) viewed exactly ONE path, and 142 of 157 verified
# views (90%) carried NO referrer, from IPs spread over ~30 distinct networks (1-2 vids each,
# so no burst/rotation test can see them) with a UA spread of 22 distinct strings over 38
# vids -- near 1:1, spanning Chrome 117->156 and iPhone OS 11->18, i.e. obsolete-version
# traffic no real human population produces. Only ~6% of verified views carry a search
# referrer. That is residential-proxy SEO/AI crawling, not buyers.
# THE TEST: a referrer OR >=2 distinct paths. Both are things a one-shot crawler does not do
# and a real visitor usually does; it is a FLOOR, so it undercounts a genuine
# direct-navigation single-page reader, which is the safe direction for a gate that triggers
# an owner email. Measured effect on the buyer-intent funnel: tools 39n/38v -> 9n/8v,
# pricing 4/4 -> 3/3, checkout 2/2 -> 0/0 (~4.3x inflation on tools). Both numbers stay far
# below the >100/day gate, so this changed no decision today -- it exists so that whenever
# the funnel DOES approach the gate, the cycle reads an honest number before mailing.
ENGAGED="((ref IS NOT NULL AND ref <> '') OR vid IN (SELECT vid FROM pageviews WHERE vid IS NOT NULL GROUP BY vid HAVING count(DISTINCT path) >= 2))"

echo "== daily totals last $D days (raw = every hit; verified = loaded our CSS)"
sqlite3 -header -column $DB "SELECT date(ts,'unixepoch') d, count(*) raw_views,
  count(DISTINCT vid) vids, count(DISTINCT CASE WHEN $VERIFIED THEN vid END) verified_vids,
  sum(CASE WHEN $VERIFIED THEN 1 ELSE 0 END) verified_views
  FROM pageviews WHERE $SINCE AND $NOTBOT GROUP BY d ORDER BY d;"

echo "== top paths (verified browsers only)"
sqlite3 -header -column $DB "SELECT path, count(*) n, count(DISTINCT vid) visitors FROM pageviews
  WHERE $SINCE AND $VERIFIED GROUP BY path ORDER BY n DESC LIMIT 12;"

echo "== BUYER-INTENT funnel (verified only) -- the CLAUDE.md Polar trigger reads THIS,"
echo "   not the raw counts. >100 verified visits/day to /pricing or /tools = email owner."
echo "   engaged_* (c2696) = verified AND (has a referrer OR viewed >=2 paths): a tighter"
echo "   FLOOR that a distributed one-page-no-referrer crawl cannot reach. 92% of verified"
echo "   vids are 1-path and 90% referrer-less, so read engaged_* before mailing the owner."
sqlite3 -header -column $DB "SELECT CASE WHEN path LIKE '/checkout%' THEN 'checkout'
    WHEN path='/pricing' THEN 'pricing' WHEN path LIKE '/tools%' THEN 'tools' END bucket,
  count(*) n, count(DISTINCT vid) visitors,
  sum(CASE WHEN $ENGAGED THEN 1 ELSE 0 END) engaged_n,
  count(DISTINCT CASE WHEN $ENGAGED THEN vid END) engaged_v FROM pageviews
  WHERE $SINCE AND $VERIFIED AND (path LIKE '/checkout%' OR path='/pricing' OR path LIKE '/tools%')
  GROUP BY bucket ORDER BY n DESC;"

echo "== top paths (raw, for comparison -- crawler-inflated)"
sqlite3 -header -column $DB "SELECT path, count(*) n FROM pageviews WHERE $SINCE AND $NOTBOT GROUP BY path ORDER BY n DESC LIMIT 8;"

echo "== top referrers (raw)"
sqlite3 -header -column $DB "SELECT substr(ref,1,60) ref, count(*) n FROM pageviews WHERE $SINCE AND ref<>'' GROUP BY ref ORDER BY n DESC LIMIT 10;"

echo "== api usage"
sqlite3 -header -column $DB "SELECT count(*) calls, coalesce(sum(results),0) results FROM usage WHERE $SINCE;"

# out_click rows carry ua+vid only from cycle 1652 on; older rows have neither, so
# they cannot be reclassified and are reported separately rather than silently counted
# as human. Same two-part test as pageviews above: browser-ish UA AND loaded our CSS.
OC_UA="json_extract(payload,'\$.ua')"
OC_NOTBOT="$OC_UA NOT LIKE '%bot%' AND $OC_UA NOT LIKE '%crawl%' AND $OC_UA NOT LIKE '%spider%' AND $OC_UA NOT LIKE 'curl%' AND $OC_UA NOT LIKE '%python-requests%' AND $OC_UA NOT LIKE '%Go-http-client%' AND $OC_UA NOT LIKE '%linkcheck%' AND $OC_UA NOT LIKE '%GoogleOther%' AND $OC_UA NOT LIKE '%HeadlessChrome%'"
# Cycle 2278: found by grouping verified out_clicks by vid -- 2 vids (10-16 and 10-17)
# each clicked all 24 /go/<slug> links inside a single second, with a plausible
# (non-'bot'-tagged) mobile/desktop UA AND a registered asset_hit, so both halves of
# OC_NOTBOT/asset_hits passed and they counted as 24 "verified" humans apiece -- the
# exact failure mode cycle 1652 set this filter up to catch, just not caught by it.
# Real sessions in this dataset never exceed 1 out_click; no plausible human session
# on a 24-tool site clicks >8 distinct outbound links, so exclude any vid whose
# lifetime out_click row count tops that. Must stay due before the c2276 CTA-fix
# measurement window (~cycle 2420): a repeat of this sweep during that window would
# have been misread as a huge conversion lift.
OC_SWEEPER="json_extract(payload,'\$.vid') IN (SELECT json_extract(payload,'\$.vid') FROM events WHERE kind='out_click' AND json_extract(payload,'\$.vid') IS NOT NULL GROUP BY json_extract(payload,'\$.vid') HAVING count(*) > 8)"
OC_VERIFIED="$OC_UA IS NOT NULL AND $OC_NOTBOT AND json_extract(payload,'\$.vid') IN (SELECT vid FROM asset_hits) AND NOT ($OC_SWEEPER)"

echo "== outbound clicks to Apify (events kind=out_click, added cycle 1509 -- /go/<slug>"
echo "   redirect+log; replaces blog/tool CTAs that used to link straight to apify.com"
echo "   with zero visibility). json_extract(payload,'\$.ref') = referring page."
echo "   Cycle 1652: VERIFIED applies the cycle-32 bot test (UA + asset_hits) that this"
echo "   metric never had -- 63% of /go/ hits measured in the access log were crawlers"
echo "   walking every slug, or our own curl. Trust 'verified' only."
sqlite3 -header -column $DB "SELECT
  sum(CASE WHEN $OC_UA IS NULL THEN 1 ELSE 0 END) unclassifiable_pre1652,
  sum(CASE WHEN $OC_UA IS NOT NULL AND NOT ($OC_NOTBOT) THEN 1 ELSE 0 END) declared_bot,
  sum(CASE WHEN $OC_UA IS NOT NULL AND $OC_NOTBOT AND NOT (json_extract(payload,'\$.vid') IN (SELECT vid FROM asset_hits)) THEN 1 ELSE 0 END) ua_ok_no_css,
  sum(CASE WHEN $OC_UA IS NOT NULL AND $OC_NOTBOT AND json_extract(payload,'\$.vid') IN (SELECT vid FROM asset_hits) AND $OC_SWEEPER THEN 1 ELSE 0 END) sweeper,
  sum(CASE WHEN $OC_VERIFIED THEN 1 ELSE 0 END) verified
  FROM events WHERE kind='out_click' AND $SINCE;"
echo "   -- verified out_clicks by slug/referrer:"
sqlite3 -header -column $DB "SELECT json_extract(payload,'\$.slug') slug,
  substr(json_extract(payload,'\$.ref'),1,50) referrer, count(*) n
  FROM events WHERE kind='out_click' AND $SINCE AND $OC_VERIFIED GROUP BY slug, referrer ORDER BY n DESC LIMIT 15;"
echo "   -- raw, for comparison (crawler-inflated; all rows incl. pre-1652 unclassifiable):"
sqlite3 -header -column $DB "SELECT json_extract(payload,'\$.slug') slug, count(*) n
  FROM events WHERE kind='out_click' AND $SINCE GROUP BY slug ORDER BY n DESC LIMIT 8;"
