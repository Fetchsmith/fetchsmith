#!/root/agent/venv/bin/python
"""Discovery sweep for the `isPrimaryEvent` trap found on westerly_breaker/ted-tender-monitor
(cycle 1176, eu-ted-tenders-scraper audit).

`isPrimaryEvent` is a Store-page display hint set by the Actor owner, not a statement
about what their code actually charges per row. A rival's live record can carry a
GENERIC platform-default event (`apify-default-dataset-item` / `apify-actor-start`)
flagged primary at a token price, while a real, materially dearer non-one-time event
sits on the same record -- `westerly_breaker` listed `tender-result` at $0.005/tender as
primary when first published, then moved the flag to a vestigial $0.00001 dataset-item
event 53 minutes later, leaving the $0.005 charge live and undocumented by the flag.
`check-price-superiority` reduces every rival to exactly the `isPrimaryEvent` price (or
the cheapest non-one-time event if none is flagged), so it is blind to this by
construction -- it passed clean both before and after the westerly_breaker fix. This is
the sibling of the cycle-1172 tiered-pricing bug (that one hid rivals entirely; this one
picks the wrong number for a rival it does see).

Like `check-rental-converts`/`check-comparison-breadth`, this is a DISCOVERY sweep, not
a verdict: a flag means "go read that rival's own README pricing table and decide",
never "this is a false claim". Cycle 1176's manual scan found 17 flags fleet-wide;
cycle 1177 read every one by hand against what our own READMEs already say and found
16 already correctly described (the dearer event's real price is already quoted in the
same file -- prior audits had read the rival's own pricing table even though the
reduction above did not) and the 17th (`taroyamada/procurement-intel-actor`) merely has
two optional per-run report/export add-ons priced above its real, correctly-primary
$0.008/row rate. So THIS SWEEP IS NOT ITSELF PROOF OF A GAP -- it is blind to whether
our prose already covers the dearer number, which is why it checks whole-file disclosure
(same reasoning as `check-price-superiority`'s whole-file disclosure check, not
per-paragraph: the rival may be described correctly in a different paragraph than the
one a text search lands on first).

Deliberately NOT bolted onto `check-price-superiority` -- that script's entire job is
collapsing each rival to one headline number, which is the bug, not a bolt-on point.

Read-only: GET /v2/acts/<owner>~<slug> only, no Actor runs, no file writes.
"""
import glob
import json
import os
import re
import sys
import urllib.request
from concurrent.futures import ThreadPoolExecutor
from datetime import datetime, timezone

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
ACK_FILE = os.path.join(ROOT, "state/primary_event_acks.json")
GENERIC = {"apify-default-dataset-item", "apify-actor-start"}
RATIO = 3.0
FULL_HANDLE = re.compile(r"`([a-z][a-z0-9_.-]{2,}/[A-Za-z0-9_.-]+)`")
SKIP_PREFIX = ("bin/", "cpvCodes/", "field/", "src/", "state/", "actors/", "notes/", "logs/")


_TOKEN = None


def token():
    global _TOKEN
    if _TOKEN is None:
        env = open(os.path.join(ROOT, "secrets/env")).read()
        _TOKEN = re.search(r"APIFY_TOKEN=(\S+)", env).group(1)
    return _TOKEN


def fetch(h):
    """GET one rival's public Actor record. Returns (handle, data|None); never raises.

    Serial fetching made a full fleet sweep ~hour-class (cycle 2151 could only sample
    ~14 of 2181 rivals in 90s), which is why the c2151 fix went un-verified against the
    real fleet. Read-only GETs, so they parallelize safely; the analysis below still
    walks `sorted(hs)` so output ordering is unchanged.
    """
    owner, slug = h.split("/", 1)
    try:
        with urllib.request.urlopen(
            f"https://api.apify.com/v2/acts/{owner}~{slug}?token={token()}", timeout=30
        ) as r:
            return h, json.load(r)["data"]
    except Exception:
        return h, None


def our_handles():
    """Map each full owner/slug named anywhere in a README to the file(s) that name it."""
    hs = {}
    for p in sorted(glob.glob(os.path.join(ROOT, "actors/*/README.md"))):
        slug = p.split("/")[-2]
        txt = open(p).read()
        for h in set(FULL_HANDLE.findall(txt)):
            owner, rest = h.split("/", 1)
            if h.startswith(SKIP_PREFIX) or "." in owner or len(rest) < 3:
                continue
            hs.setdefault(h, []).append((slug, p))
    return hs


def effective(infos):
    best = None
    now = datetime.now(timezone.utc)
    for p in infos or []:
        s = p.get("startedAt")
        if not s:
            continue
        try:
            t = datetime.fromisoformat(s.replace("Z", "+00:00"))
        except Exception:
            continue
        if t <= now and (best is None or t > best[0]):
            best = (t, p)
    return best[1] if best else None


def price_of(d):
    if d.get("eventPriceUsd") is not None:
        return float(d["eventPriceUsd"])
    tiers = d.get("eventTieredPricingUsd") or {}
    vals = [v.get("tieredEventPriceUsd") for v in tiers.values() if v.get("tieredEventPriceUsd") is not None]
    return float(min(vals)) if vals else None


def price_strings(price):
    """Plausible ways this price might be written in prose, for a whole-file disclosure check.

    Only renderings that round-trip to the SAME value count (cycle 2152). The old version
    accepted every rendering, so a sub-cent price was also searched for as its `.2f` form --
    `$0.00776239` became `"0.01"`, and any unrelated `0.01` elsewhere in the README marked the
    rival ALREADY DISCLOSED. That turned 3 real NEEDS REVIEW rows into silent passes.
    """
    out = {c for c in {f"{price:g}", f"{price:.2f}", f"{price:.4f}", f"{price:.5f}"}
           if float(c) == price}
    if price == int(price):
        out.add(str(int(price)))
    return out


def disclosed_in(text, price):
    """True if `price` appears in `text` as a whole numeric token.

    Token-anchored rather than a bare substring, so `0.01` cannot be satisfied by the `0.015`
    of some other rival in the same table.
    """
    return any(re.search(r"(?<![0-9.])" + re.escape(s) + r"(?![0-9])", text)
               for s in price_strings(price))


def load_acks():
    """handle -> {cycle, reason, dear_event, dear_price}. Missing/corrupt file = no acks.

    Added cycle 3496 (spec'd at c2824). Both of this check's permanent NEEDS REVIEW rows
    were genuine NON-GAPS -- scope-exclusion mentions that quote no price for the rival at
    all, so there is nothing for a disclosure check to find -- and they re-appeared on every
    run, costing each cycle a re-derivation. An acked row stays PRINTED (as `[ACKED: ...]`,
    same as `[ALREADY DISCLOSED]`); it only leaves the need-review tally. Never silently
    dropped: that is how a real re-price would get hidden.
    """
    try:
        with open(ACK_FILE) as f:
            return {k: v for k, v in (json.load(f).get("acks") or {}).items()}
    except (FileNotFoundError, ValueError):
        return {}


def save_acks(acks):
    with open(ACK_FILE, "w") as f:
        json.dump({"acks": dict(sorted(acks.items()))}, f, indent=2, sort_keys=True)
        f.write("\n")


def ack_state(ack, dear_event, dear_price):
    """'none' | 'acked' | 'stale'. An ack binds to the EXACT event key AND price it was
    written against, so any re-price (or a new, dearer event taking over the slot) re-flags
    the rival instead of riding the old judgement."""
    if not ack:
        return "none"
    if ack.get("dear_event") == dear_event and ack.get("dear_price") == dear_price:
        return "acked"
    return "stale"


def selftest():
    a = {"cycle": 1, "reason": "r", "dear_event": "portal-page", "dear_price": 0.00829}
    cases = [
        (ack_state(None, "portal-page", 0.00829), "none"),
        (ack_state({}, "portal-page", 0.00829), "none"),
        (ack_state(a, "portal-page", 0.00829), "acked"),
        (ack_state(a, "portal-page", 0.0083), "stale"),     # re-priced -> must re-flag
        (ack_state(a, "portal-page", 0.001), "stale"),      # cheaper too -> still re-flag
        (ack_state(a, "detail-filter-check", 0.00829), "stale"),  # new event in the slot
    ]
    bad = [(i, got, want) for i, (got, want) in enumerate(cases) if got != want]
    for i, got, want in bad:
        print(f"  FAIL case {i}: got {got!r}, want {want!r}")
    print(f"selftest: {len(cases) - len(bad)}/{len(cases)} ack-state case(s) pass")
    return 1 if bad else 0


def do_ack(handle, reason, cycle):
    """Record an ack using the rival's LIVE dearer event/price, never a hand-typed one."""
    _, d = fetch(handle)
    if d is None:
        print(f"ack FAILED: no live Actor record for {handle}")
        return 1
    p = effective(d.get("pricingInfos"))
    evs = (p or {}).get("pricingPerEvent", {}).get("actorChargeEvents", {}) or {}
    flag = flag_for(evs)
    if not flag:
        print(f"ack FAILED: {handle} is not currently flagged by this check (nothing to ack)")
        return 1
    _, _, dear_event, dear_price = flag
    acks = load_acks()
    acks[handle] = {"cycle": cycle, "reason": reason,
                    "dear_event": dear_event, "dear_price": dear_price}
    save_acks(acks)
    print(f"acked {handle}: {dear_event}@${dear_price:g} (cycle {cycle}) -- {reason}")
    return 0


def flag_for(evs):
    """(head, head_price, dear_event, dear_price) if these events trip the check, else None."""
    if len(evs) < 2:
        return None
    primary = [k for k, v in evs.items() if v.get("isPrimaryEvent")]
    if primary:
        head = primary[0]
    else:
        cands = [(price_of(v), k) for k, v in evs.items()
                 if not v.get("isOneTimeEvent") and price_of(v) is not None]
        if not cands:
            return None
        head = min(cands)[1]
    hp = price_of(evs[head])
    if hp is None or head not in GENERIC:
        return None
    worse = [(k, price_of(v)) for k, v in evs.items()
             if k != head and not v.get("isOneTimeEvent") and price_of(v) is not None
             and ((hp == 0 and price_of(v) > 0) or (hp > 0 and price_of(v) / hp >= RATIO))]
    if not worse:
        return None
    dear_event, dear_price = max(worse, key=lambda x: x[1])
    return head, hp, dear_event, dear_price


def main():
    if "--selftest" in sys.argv:
        return selftest()
    if "--list-acks" in sys.argv:
        acks = load_acks()
        print(f"{len(acks)} acknowledged non-gap(s) in {ACK_FILE}")
        for h, a in sorted(acks.items()):
            print(f"  {h}  {a['dear_event']}@${a['dear_price']:g}  (cycle {a['cycle']})")
            print(f"       {a['reason']}")
        return 0
    if "--ack" in sys.argv:
        i = sys.argv.index("--ack")
        handle = sys.argv[i + 1]
        reason = sys.argv[sys.argv.index("--reason") + 1] if "--reason" in sys.argv else ""
        cycle = int(sys.argv[sys.argv.index("--cycle") + 1]) if "--cycle" in sys.argv else 0
        if not reason:
            print("ack FAILED: --reason is required (an ack with no stated reason is a silent drop)")
            return 1
        return do_ack(handle, reason, cycle)
    hs = our_handles()
    names = sorted(hs)
    limit = None
    if "--limit" in sys.argv:
        limit = int(sys.argv[sys.argv.index("--limit") + 1])
        names = names[:limit]
    print(f"check-primary-event: scanning {len(names)} distinct named rivals across the fleet"
          + (f" (--limit {limit})" if limit is not None else ""))
    token()  # resolve once, before the pool reads it from several threads
    with ThreadPoolExecutor(max_workers=8) as pool:
        records = dict(pool.map(fetch, names))
    fetched = sum(1 for v in records.values() if v is not None)
    print(f"check-primary-event: {fetched}/{len(names)} records fetched "
          f"({len(names) - fetched} unreachable/deleted, skipped)")
    acks = load_acks()
    checked = flagged = disclosed = acked = 0
    for h in names:
        d = records.get(h)
        if d is None:
            continue
        p = effective(d.get("pricingInfos"))
        if not p or p.get("pricingModel") != "PAY_PER_EVENT":
            continue
        evs = p.get("pricingPerEvent", {}).get("actorChargeEvents", {}) or {}
        if len(evs) < 2:
            continue
        checked += 1
        flag = flag_for(evs)
        if not flag:
            continue
        head, hp, dear_event, dear_price = flag
        flagged += 1
        files = hs[h]
        all_text = " ".join(open(p).read() for _, p in files)
        is_disclosed = disclosed_in(all_text, dear_price)
        state = "none" if is_disclosed else ack_state(acks.get(h), dear_event, dear_price)
        if is_disclosed:
            disclosed += 1
            tag = "ALREADY DISCLOSED"
        elif state == "acked":
            acked += 1
            a = acks[h]
            tag = f"ACKED c{a['cycle']}: {a['reason']}"
        elif state == "stale":
            a = acks[h]
            tag = (f"NEEDS REVIEW -- ACK STALE (acked {a['dear_event']}@${a['dear_price']:g} "
                   f"at c{a['cycle']}, now {dear_event}@${dear_price:g})")
        else:
            tag = "NEEDS REVIEW"
        ratio_str = "FREE headline" if hp == 0 else f"{dear_price/hp:.0f}x"
        print(f"  FLAG {h}  (named in: {', '.join(s for s, _ in files)}) [{tag}]")
        print(f"       headline={head}@${hp:g} (generic default)  dearer={dear_event}@${dear_price:g}"
              f"  ({ratio_str})")
    print(f"check-primary-event: {checked} multi-event rivals checked, {flagged} flagged, "
          f"{disclosed} already disclosed in our own README, {acked} acked non-gap(s), "
          f"{flagged - disclosed - acked} need review")
    return 0


if __name__ == "__main__":
    sys.exit(main())
