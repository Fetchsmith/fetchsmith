#!/root/agent/venv/bin/python
"""check-usaspending-vocab -- keep us-federal-awards-scraper's two hardcoded USAspending
vocabularies in sync with USAspending's own reference endpoints.

WHY (cycle 1616): `bin/check-validated-filters` classifies a filter whose values OUR code
validates against a hardcoded list as bucket (c) RUNTIME_VALID and asks two questions about
it. Cycle 1616 answered question 2 ("what happens when every value is dropped?") across the
whole (c) bucket and found every Actor already safe -- unrecognised values are sent through
as-is (which NARROWS, never widens) or the run fails loudly. But question 1 ("what can the
validator see?") has no automated guard anywhere in bin/, and for these two lists it is a
*freshness* question: both mirror a vendor vocabulary that can change under us.

A stale allowlist here is not a silent no-op -- it is worse than that, because the warning
text is confidently wrong. us-federal-awards-scraper tells a buyer who passes an agency name
it does not recognise:

    "... is not one of USAspending's 111 top-tier agency names -- sent through as-is, but
     USAspending matches agency names exactly, so an unrecognised spelling narrows your
     results to nothing rather than widening them. Fix the spelling or drop it."

If USAspending ADDS or RENAMES an agency and our list has not caught up, that message fires
on a name that works perfectly, and the buyer's rational response is to delete a correct
filter. The value is still sent, so results stay right -- the damage is to trust in the log.

Why only this one Actor: it is the only one in the fleet whose allowlists have a true
machine-readable upstream vocabulary endpoint. The rest are deliberately maintained by live probe and
cannot be synced this way -- do NOT "generalise" this script to them:
  - sam-gov SET_ASIDE_CODES  -- SAM.gov publishes no facet/reference endpoint (re-confirmed
                                cycle 1524: setasidetypes 500s, every other spelling 404s).
  - nih-reporter IC_CODES / ACTIVITY_CODES -- built by facet-diff against live `meta.total`
                                (cycle 834), not from any vocabulary list.
  - trademark OFFICES / TM_STATUSES -- derived from a 1000-row live sample (cycle 936).
  - google-news VALID_TOPICS -- hand-probed per section (cycle 832).

Exits 1 on any drift so a cycle cannot miss it. Both endpoints are free, keyless and public.
"""
import json
import re
import sys
import urllib.request

ACTOR = '/root/agent/actors/us-federal-awards-scraper'
UA = {'User-Agent': 'FetchSmith/1.0 (+https://fetchsmith.com)'}


def get(url):
    return json.load(urllib.request.urlopen(urllib.request.Request(url, headers=UA), timeout=90))


def js_string_list(src, const):
    """Extract a `const NAME = [ ... ];` array of JS string literals.

    Handles BOTH quote styles and backslash escapes. This matters: the list contains
    "Commission for the Preservation of America's Heritage Abroad", double-quoted because of
    the apostrophe, among otherwise single-quoted entries. A single-quote-only regex (the
    first thing cycle 1616 reached for) silently parsed 13 entries out of 111 and reported
    98 phantom drifts -- so when this check ever does report drift, sanity-check the counts
    before believing it.
    """
    m = re.search(r'const %s = \[(.*?)\n\];' % re.escape(const), src, re.S)
    if not m:
        sys.exit('check-usaspending-vocab: could not find `const %s = [...]` -- was it '
                 'renamed or reformatted? Fix this extractor, do not skip the check.' % const)
    out = []
    for mm in re.finditer(r"""'((?:[^'\\]|\\.)*)'|"((?:[^"\\]|\\.)*)\"""", m.group(1)):
        s = mm.group(1) if mm.group(1) is not None else mm.group(2)
        out.append(re.sub(r'\\(.)', r'\1', s))
    return out


def report(label, ours, theirs, note):
    missing = sorted(theirs - ours)
    extra = sorted(ours - theirs)
    if not missing and not extra:
        print('  ok  %-24s %d/%d in sync' % (label, len(ours), len(theirs)))
        return 0
    print('  DRIFT %s' % label)
    for n in missing:
        print('    + upstream has, we do not: %r' % n)
    for n in extra:
        print('    - we have, upstream does not: %r' % n)
    print('    -> %s' % note)
    return len(missing) + len(extra)


def main():
    src = open('%s/src/main.js' % ACTOR).read()
    schema = json.load(open('%s/.actor/input_schema.json' % ACTOR))
    drift = 0

    # 1. TOPTIER_AGENCY_NAMES vs the toptier_agencies reference endpoint.
    ours = js_string_list(src, 'TOPTIER_AGENCY_NAMES')
    if len(ours) != len(set(ours)):
        dupes = sorted({n for n in ours if ours.count(n) > 1})
        print('  DRIFT TOPTIER_AGENCY_NAMES has duplicate entries: %s' % dupes)
        drift += len(dupes)
    live = {r['agency_name'] for r in get(
        'https://api.usaspending.gov/api/v2/references/toptier_agencies/')['results']}
    drift += report('TOPTIER_AGENCY_NAMES', set(ours), live,
                    'update the list in src/main.js (the warning text interpolates '
                    '.length, so the count in the buyer-facing message follows automatically)')

    # 2. defCodes schema enum vs the `disaster`-flagged subset of the def_codes endpoint.
    #    We deliberately surface ONLY the flagged codes (covid_19 + infrastructure); the
    #    other ~43 are unflagged appropriation codes, so compare against the flagged subset,
    #    not the whole vocabulary.
    codes = get('https://api.usaspending.gov/api/v2/references/def_codes/')['codes']
    flagged = {r['code'] for r in codes if r.get('disaster')}
    enum = set(schema['properties']['defCodes']['items']['enum'])
    drift += report('defCodes items.enum', enum, flagged,
                    'update .actor/input_schema.json enum + enumTitles AND the comment above '
                    '`const defCodes` in src/main.js; a new flagged code is a new sellable '
                    'filter value, so also mention it in the README')
    print('  (%d live def codes total, %d disaster-flagged)' % (len(codes), len(flagged)))

    print('check-usaspending-vocab: %d drift(s)' % drift)
    return 1 if drift else 0


if __name__ == '__main__':
    sys.exit(main())
