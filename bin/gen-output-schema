#!/usr/bin/env python3
"""Generate .actor/output_schema.json + .actor/dataset_schema.json for an Actor dir from its local test dataset (storage/datasets/default/*.json) or registry sample. Usage: gen-output-schema <actor-dir>"""
import sys, json, glob, os
d = sys.argv[1].rstrip('/'); slug = os.path.basename(d)
items = []
# Read the WHOLE local dataset, not just the first 20 alphabetically-sorted files. Actors that
# fan out over multiple sources (e.g. ats-jobs-scraper's 6 ATSes) sort one source's rows first;
# a [:20] slice — or even a 40-item evenly-spaced sample, tried and rejected cycle 198 — can miss
# a field (e.g. salaryMin) that is only non-null on a handful of rows from a source further down
# the list. Local test datasets are a few hundred rows at most, so reading all of them is cheap.
for f in sorted(glob.glob(f"{d}/storage/datasets/default/*.json")):
    try: items.append(json.load(open(f)))
    except Exception: pass
if not items:
    reg = json.load(open('/root/agent/actors/registry.json'))['tools']
    t = next((t for t in reg if t['slug'] == slug), None)
    if t and t.get('sample_output'): items = [t['sample_output']]
if not items: print('no sample items for', slug); sys.exit(1)
# Seed prior types from the existing dataset_schema.json (if any). Two failure modes this
# guards against, both real and found by cycle-199's fleet audit:
# (a) a field that is null in EVERY row of this run's local sample (e.g. uk-find-a-tender-
#     scraper's awardValueAmount/aboveThreshold, which only appear on awarded notices and the
#     local test set has none) must not be downgraded to 'string' just because this scan never
#     saw a non-null value — that would regress a type the platform already validated correctly.
# (b) a field that is genuinely polymorphic across real API responses (e.g. hacker-news-
#     scraper's storyId: `hit.story_id ?? hit.objectID` — a real number from Algolia comment
#     hits, a real string from Algolia's own objectID on story hits) must not be narrowed to
#     whichever single type this run's local sample happened to contain — the platform accepts
#     multi-type arrays and the existing schema already declared both alternates correctly.
# All prior alternates are unioned with whatever this scan observes; a genuinely wrong prior
# type (the cycle-198 bug: locked to 'string' by a null-first-sighting) still gets the real
# type added once real evidence exists, so it stops being pushed as a lone bad type, without
# needing to prove the old value was never separately valid.
prior_types = {}
try:
    prior = json.load(open(f"{d}/.actor/dataset_schema.json"))
    for k, p in prior.get("fields", {}).get("properties", {}).items():
        t = p.get("type")
        alts = t if isinstance(t, list) else [t]
        prior_types[k] = [a for a in alts if a and a != 'null']
except Exception: pass
def jtype(v):
    if isinstance(v, bool): return 'boolean'
    if isinstance(v, int) or isinstance(v, float): return 'number'
    if isinstance(v, list): return 'array'
    if isinstance(v, dict): return 'object'
    return 'string'
props = {}
for it in items:
    for k, v in it.items():
        if k not in props:
            props[k] = {"types": [], "title": k[0].upper() + k[1:].replace('_', ' ')}
        if v is not None:
            t = jtype(v)
            if t not in props[k]["types"]: props[k]["types"].append(t)
        if v not in (None, '', [], {}) and "example" not in props[k]:
            props[k]["example"] = v if not isinstance(v, str) else v[:120]
blind_guess = []
for k in props:
    for t in prior_types.get(k, []):
        if t not in props[k]["types"]: props[k]["types"].append(t)
    if not props[k]["types"]:
        props[k]["types"] = ['string']
        blind_guess.append(k)
for k in props:
    primary = props[k]["types"][0]
    if primary in ('array', 'object'): props[k].pop("example", None)
    if primary == 'string' and 'example' in props[k] and isinstance(props[k]['example'], (int, float, bool)): props[k]["example"] = str(props[k]["example"])
# type array is the observed/prior alternates (order preserved, primary first) plus 'null'
for k in props:
    props[k]["type"] = props[k]["types"] + ["null"]
    del props[k]["types"]
scalar = [k for k, p in props.items() if p["type"][0] in ('string', 'number', 'boolean') and k not in ('scrapedAt',)][:10]
fmt = {}
for k in scalar:
    t = props[k]["type"][0]
    fmt[k] = {"label": props[k]["title"], "format": "link" if (t == 'string' and (k == 'url' or k.lower().endswith('url'))) else ("number" if t == 'number' else ("boolean" if t == 'boolean' else "text"))}
ds = {"actorSpecification": 1,
      "fields": {"type": "object", "properties": props},
      "views": {"overview": {"title": "Overview", "transformation": {"fields": scalar}, "display": {"component": "table", "properties": fmt}}}}
os.makedirs(f"{d}/.actor", exist_ok=True)
json.dump(ds, open(f"{d}/.actor/dataset_schema.json", 'w'), indent=2)
out = {"actorOutputSchemaVersion": 1, "title": "Output", "properties": {"dataset": {"type": "string", "title": "Results", "template": "{{links.apiDefaultDatasetUrl}}/items"}}}
json.dump(out, open(f"{d}/.actor/output_schema.json", 'w'), indent=2)
aj = json.load(open(f"{d}/.actor/actor.json"))
aj["output"] = "./output_schema.json"; aj["storages"] = {"dataset": "./dataset_schema.json"}
json.dump(aj, open(f"{d}/.actor/actor.json", 'w'), indent=2)
print(slug, 'fields:', len(props), 'view fields:', scalar)
if blind_guess:
    print(f"WARNING: {len(blind_guess)} field(s) were null in EVERY sample row and have no prior "
          f"type, so their type was guessed as 'string' by default: {blind_guess}. If the code "
          f"actually produces a number/boolean/array for any of these on real data, this schema "
          f"will reject that row at publish time (cycle-738 sec-insider-trades-scraper incident) "
          f"-- check the source before trusting this schema, and re-run a wider platform sample "
          f"to confirm before publishing.")
