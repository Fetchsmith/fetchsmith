#!/root/agent/venv/bin/python
"""Apify admin helper.
  apify-admin list                         -> my actors with stats
  apify-admin get <name>                   -> full actor JSON
  apify-admin publish <name> <meta.json>   -> set title/description/seo/categories/pricing, isPublic true
  apify-admin unpublish <name>
  apify-admin store <query> [n]            -> search Apify Store (demand signal): users, runs, ratings
  apify-admin runs <name> [n]              -> recent runs (status, started, stats)
"""
import sys, json, httpx
env = dict(l.rstrip("\n").split("=", 1) for l in open("/root/agent/secrets/env") if "=" in l and not l.startswith("#"))
T = env["APIFY_TOKEN"]; H = {"Authorization": f"Bearer {T}"}; API = "https://api.apify.com/v2"
def me(): return httpx.get(f"{API}/users/me", headers=H).json()["data"]["username"]
def get(name): return httpx.get(f"{API}/acts/{me()}~{name}", headers=H).json()["data"]
cmd = sys.argv[1]
if cmd == "list":
    # /acts?my=true omits isPublic and most of stats (only totalRuns/lastRunStartedAt come
    # through) -- confirmed live cycle 363, same finding bin/revenue worked around at cycle 172.
    # Fetch each actor's full record instead, like bin/revenue does.
    r = httpx.get(f"{API}/acts?my=true&limit=1000", headers=H).json()["data"]["items"]
    acts = [get(a["name"]) for a in r]
    for a in acts:
        s = a.get("stats", {})
        p = s.get("publicActorRunStats30Days") or {}
        print(f"{a['name']:40} public={str(a.get('isPublic',False)):5} users30d={s.get('totalUsers30Days',0):4} runs30d={p.get('TOTAL',0):5} totalUsers={s.get('totalUsers',0):4} lastRun={str(s.get('lastRunStartedAt',''))[:10]}")
elif cmd == "get":
    print(json.dumps(get(sys.argv[2]), indent=2))
elif cmd == "publish":
    a = get(sys.argv[2]); meta = json.load(open(sys.argv[3]))
    # title's real API limit is 63, not 70 — measured cycle 536 (a 64-char title 400s with
    # "title must be at most 63 characters long"). seoTitle/description limits unverified
    # against the API; leave them until one actually trips.
    limits = {"title": 63, "description": 300, "seoTitle": 70, "seoDescription": 200}
    errs = [f"{k} is {len(meta[k])} chars, over the {v}-char limit" for k, v in limits.items() if k in meta and len(meta[k]) > v]
    if errs:
        sys.exit("meta.json validation failed:\n  " + "\n  ".join(errs))
    payload = {k: meta[k] for k in ("title", "description", "seoTitle", "seoDescription", "categories") if k in meta}
    existing = a.get("pricingInfos") or []
    existing_events = existing[-1].get("pricingPerEvent", {}).get("actorChargeEvents") if existing else None

    # Cycle 588: a plain `meta["events"] != existing_events` here was ALWAYS true, because
    # the API stores keys we never send -- `isPrimaryEvent: true` on every charge event.
    # So every `publish`, even a categories-only edit, appended a redundant but identical
    # pricingInfos entry (hacker-news-scraper collected one that way this cycle). Strip the
    # known server-added keys, then compare STRICTLY: a subset compare would have hidden a
    # real change (a deleted pricing tier reads as "same" under subset semantics). If Apify
    # ever adds another server-side key, this goes back to over-appending -- noisy but safe,
    # which is the right way round for something that edits live prices.
    SERVER_ADDED = {"isPrimaryEvent"}

    def strip_server_keys(v):
        if isinstance(v, dict):
            return {k: strip_server_keys(x) for k, x in v.items() if k not in SERVER_ADDED}
        return v

    if "events" in meta and meta["events"] != strip_server_keys(existing_events):
        # The API requires the pricingInfos array to start with the existing history
        # verbatim, plus exactly one new entry appended ("incorrect-pricing-modifier-prefix"
        # otherwise) - sending just a bare new entry also 400s separately ("createdAt is
        # required"). Verified live cycle 179: a price cut applies immediately (startedAt=now);
        # untested whether a price increase gets deferred/requires notice.
        import datetime
        now = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.000Z")
        new_entry = {"pricingModel": "PAY_PER_EVENT", "pricingPerEvent": {"actorChargeEvents": meta["events"]},
                     "createdAt": now, "startedAt": now, "apifyMarginPercentage": existing[-1]["apifyMarginPercentage"] if existing else 0.2}
        payload["pricingInfos"] = existing + [new_entry]
    payload["isPublic"] = True
    r = httpx.put(f"{API}/acts/{a['id']}", headers=H, json=payload)
    print(r.status_code, json.dumps(r.json())[:600])
elif cmd == "unpublish":
    a = get(sys.argv[2]); r = httpx.put(f"{API}/acts/{a['id']}", headers=H, json={"isPublic": False}); print(r.status_code)
elif cmd == "store":
    n = int(sys.argv[3]) if len(sys.argv) > 3 else 20
    r = httpx.get(f"{API}/store", params={"search": sys.argv[2], "limit": n, "sortBy": "relevance"}).json()["data"]["items"]
    for a in r:
        s = a.get("stats", {}); p = a.get("currentPricingInfo", {})
        print(f"{a['username']}/{a['name']:38} users={s.get('totalUsers',0):6} u30d={s.get('totalUsers30Days',0):5} runs30d={s.get('totalRuns30Days',0):6} model={p.get('pricingModel','?'):14} modified={a.get('modifiedAt','')[:10]} title={a.get('title','')[:50]}")
elif cmd == "runs":
    a = get(sys.argv[2]); n = int(sys.argv[3]) if len(sys.argv) > 3 else 10
    r = httpx.get(f"{API}/acts/{a['id']}/runs?desc=true&limit={n}", headers=H).json()["data"]["items"]
    for x in r: print(x["id"], x["status"], x["startedAt"][:19], x.get("stats", {}).get("durationMillis"), "ms")
