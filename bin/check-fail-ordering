    ),
}


def find_calls(lines, needle, exclude=None):
    out = []
    for i, l in enumerate(lines):
        stripped = l.strip()
        if stripped.startswith("//"):
            continue
        if needle in l and (exclude is None or exclude not in l):
            out.append(i)
    return out


def main(argv):
    wanted = set(argv[1:])
    drift = 0
    checked = 0

    actors_dir = os.path.join(ROOT, "actors")
    for slug in sorted(os.listdir(actors_dir)):
        if slug == "_template" or slug.startswith("."):
            continue
        if wanted and slug not in wanted:
            continue
        src = os.path.join(actors_dir, slug, "src", "main.js")
        if not os.path.isfile(src):
            continue
        with open(src) as fh:
            text = fh.read()
        if "watchLabel" not in text:
            continue
        lines = text.splitlines()
        save_lines = find_calls(lines, "saveWatchRecord(", exclude="function saveWatchRecord")
        if not save_lines:
            continue
        checked += 1
        last_save = max(save_lines)
        charge_lines = find_calls(lines, "Actor.charge(")
        first_charge = min(charge_lines) if charge_lines else None
        fail_lines = find_calls(lines, "Actor.fail(")
        if first_charge is None:
            suspect = []
        else:
            suspect = [
                i for i in fail_lines
                if first_charge < i < last_save and (slug, i + 1) not in ALLOWLIST
            ]
        if suspect:
            drift += 1
            rows = ", ".join(f"line {i + 1}" for i in suspect)
            print(f"{slug:33} SUSPECT Actor.fail() before last saveWatchRecord() (line {last_save + 1}): {rows}")
        else:
            print(f"{slug:33} ok (last saveWatchRecord() line {last_save + 1}, {len(fail_lines)} Actor.fail() call(s), 0 between first charge and save)")

    print()
    print(f"check-fail-ordering: {checked} watch-mode Actor(s) checked, {drift} suspect fail-before-save ordering(s)")
    return 1 if drift else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
