    # protects against false positives like the reviews-scraper one) so this niche's sweep is
    # explicit and documented rather than silently depending on the generic MODIFIERS list.
    "shopify-products-scraper": [
        "shopify products", "shopify products scraper", "shopify products monitor",
        "shopify products api", "shopify products tracker", "shopify products crawler",
        "shopify products data", "shopify products feed", "shopify products export",
        "shopify products alerts", "shopify products tool", "shopify scraper",
        "shopify store products", "shopify catalog", "shopify store", "shopify product",
        "shopify ecommerce",
    ],
}

