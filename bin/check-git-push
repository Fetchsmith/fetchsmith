#!/root/agent/venv/bin/python
"""Is the local git HEAD actually pushed to origin/main? (added cycle 1706)

WHY: PLAYBOOK step 9 only tells the Actor-build flow to `git push`. Verification-only
cycles follow the generic "git commit" discipline (cycle-1679 PROCESS FINDING) but
nothing ever told them to push, and nothing checked whether they had. Found this
cycle: HEAD was 69 commits (~35 cycles, since 2026-10-13) ahead of origin/main --
weeks of STATUS/queue/LEARNINGS/niche-research history existed ONLY on this single
Linode box, with no off-box copy, violating the spirit of CLAUDE.md rule 5 (protect
uptime -- a disk failure here would have erased it, unrecoverable). Fixed this cycle
(`git push`); this script is the tripwire so it can't silently recur for 35+ cycles
again before anyone notices.

PASS 2 (added cycle 2016): is the WORKING TREE committed? Pass 1 only measures
`origin/main..HEAD`, so it reports "fully pushed" while uncommitted changes sit on
this box -- exactly the off-box-copy risk the docstring above describes, in the one
state pass 1 cannot see. Found this cycle: cycle 2015's STATUS.md block (57 lines of
business state) and its queue.md updates were never committed, and pass 1 printed
"OK: HEAD == origin/main, fully pushed." Same bug class as the cycle-2012 channel-mix
finding: a check that reports OK for a state it does not look at.

A dirty tree is NORMAL mid-cycle (this check runs before the cycle's own commit), so
dirt alone is not a failure. What is a failure is dirt left by an EARLIER cycle:
cycles run every 30 min, so a tracked file modified longer than STALE_MINUTES ago
cannot belong to the running cycle. Those are reported and fail.

Read-only, no cost beyond `git fetch` (metadata only, no working-tree change).
Exit 0 if ahead-count <= MAX_AHEAD and no stale uncommitted changes; exit 1 otherwise.
"""
import os, subprocess, sys, time

MAX_AHEAD = 10  # a handful of cycles' slack; above this, push before doing anything else
STALE_MINUTES = 28  # < the 30-min cycle interval, so "older than this" means a prior cycle

def run(cmd):
    return subprocess.run(cmd, cwd="/root/agent", capture_output=True, text=True, check=True).stdout.strip()

def check_commits():
    """PASS 1 -- is HEAD pushed to origin/main?"""
    run(["git", "fetch", "origin", "-q"])
    ahead = int(run(["git", "rev-list", "--count", "origin/main..HEAD"]))
    if ahead == 0:
        print("PASS 1 (commits pushed): OK -- HEAD == origin/main.")
        return 0
    print(f"PASS 1 (commits pushed): NOT PUSHED -- HEAD is {ahead} commit(s) ahead of origin/main.")
    print(run(["git", "log", "--oneline", "origin/main..HEAD"]))
    if ahead > MAX_AHEAD:
        print(f"FAIL: {ahead} > MAX_AHEAD={MAX_AHEAD} -- run: git push -q origin main")
        return 1
    print(f"(within MAX_AHEAD={MAX_AHEAD} slack, not failing, but push when convenient)")
    return 0


def check_working_tree():
    """PASS 2 -- is anything left uncommitted, and is it older than the running cycle?"""
    # -uall so an untracked NEW state/notes file counts too; it is just as unbacked-up
    # as a modified one. Porcelain v1 is stable and quote-safe with -z.
    out = run(["git", "status", "--porcelain", "-uall", "-z"])
    entries = [e for e in out.split("\0") if e.strip()]
    if not entries:
        print("PASS 2 (working tree): OK -- nothing uncommitted.")
        return 0
    now, cutoff = time.time(), STALE_MINUTES * 60
    fresh, stale = [], []
    for e in entries:
        status, path = e[:2], e[3:]
        # A rename entry is "R  old\0new"; -z splits them, so the orphan half has no
        # status field and lands here as a bare path -- treat it as part of the pair.
        full = os.path.join("/root/agent", path)
        try:
            age = (now - os.path.getmtime(full)) / 60
        except OSError:
            age = 0.0  # deleted file: cannot age it, so never the basis for a failure
        (stale if age * 60 > cutoff else fresh).append((status, path, age))
    print(f"PASS 2 (working tree): {len(entries)} uncommitted change(s) "
          f"-- {len(fresh)} fresh (this cycle), {len(stale)} stale (>{STALE_MINUTES}m).")
    for status, path, age in sorted(stale, key=lambda t: -t[2]):
        print(f"  STALE {status} {path}  (modified {age:.0f}m ago)")
    if stale:
        print(f"FAIL: {len(stale)} change(s) predate the running cycle -- a previous cycle "
              f"left work uncommitted and PASS 1 cannot see it. Commit and push them.")
        return 1
    for status, path, age in sorted(fresh, key=lambda t: -t[2]):
        print(f"  ok    {status} {path}  ({age:.0f}m ago, this cycle -- commit before finishing)")
    return 0


def main():
    # Both passes always run: a non-zero pass 1 must not hide a dirty tree, or vice versa.
    rc1 = check_commits()
    rc2 = check_working_tree()
    return 1 if (rc1 or rc2) else 0

if __name__ == "__main__":
    sys.exit(main())
