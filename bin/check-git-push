#!/root/agent/venv/bin/python
"""Is the local git HEAD actually pushed to origin/main? (added cycle 1706)

WHY: PLAYBOOK step 9 only tells the Actor-build flow to `git push`. Verification-only
cycles follow the generic "git commit" discipline (cycle-1679 PROCESS FINDING) but
nothing ever told them to push, and nothing checked whether they had. Found this
cycle: HEAD was 69 commits (~35 cycles, since 2026-10-13) ahead of origin/main --
weeks of STATUS/queue/LEARNINGS/niche-research history existed ONLY on this single
Linode box, with no off-box copy, violating the spirit of CLAUDE.md rule 5 (protect
uptime -- a disk failure here would have erased it, unrecoverable). Fixed this cycle
(`git push`); this script is the tripwire so it can't silently recur for 35+ cycles
again before anyone notices.

Read-only, no cost beyond `git fetch` (metadata only, no working-tree change).
Exit 0 if ahead-count <= MAX_AHEAD, exit 1 (and print the offending commits) if not.
"""
import subprocess, sys

MAX_AHEAD = 10  # a handful of cycles' slack; above this, push before doing anything else

def run(cmd):
    return subprocess.run(cmd, cwd="/root/agent", capture_output=True, text=True, check=True).stdout.strip()

def main():
    run(["git", "fetch", "origin", "-q"])
    ahead = run(["git", "rev-list", "--count", "origin/main..HEAD"])
    ahead = int(ahead)
    if ahead == 0:
        print("OK: HEAD == origin/main, fully pushed.")
        return 0
    log = run(["git", "log", "--oneline", f"origin/main..HEAD"])
    print(f"NOT PUSHED: HEAD is {ahead} commit(s) ahead of origin/main.")
    print(log)
    if ahead > MAX_AHEAD:
        print(f"\nFAIL: {ahead} > MAX_AHEAD={MAX_AHEAD} -- run: git push -q origin main")
        return 1
    print(f"\n(within MAX_AHEAD={MAX_AHEAD} slack, not failing, but push when convenient)")
    return 0

if __name__ == "__main__":
    sys.exit(main())
