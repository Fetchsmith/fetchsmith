#!/usr/bin/env python3
"""store-visibility — measure our Actors' visibility on the /v2/store REST
surface ONLY (the `apify store search` CLI path). This is a MINOR surface.

READ THIS FIRST (cycle 581, 2026-09-21) — SCOPE WARNING
-------------------------------------------------------
THIS TOOL DOES NOT MEASURE BUYER-FACING VISIBILITY. apify.com/store's search box
does not call /v2/store; it queries a public Algolia index (`prod_PUBLIC_STORE`).
On that real surface all 22 of our Actors ARE indexed and retrievable anonymously
(verified fleet-wide cycles 518, 520, 581 — 8/22 in the top 20 of their primary
query as of cycle 581). `bin/store-rank` is the tool that answers "can a buyer
find us"; this one is not.

This tool's zero-result output has now been misread as "the business is invisible
to buyers" FOUR times (cycles 1-20, 168, 517, 580), each time producing a wrong
strategic conclusion and once an unnecessary owner email. Cycle 518 corrected the
claim in LEARNINGS but patched `bin/check-store-rank` and left THIS docstring
still asserting the blackout narrative, which is why cycle 580 repeated it.
If you are about to conclude anything about discovery from this tool's output:
stop, run `bin/store-rank`, and read LEARNINGS cycles 518/520 in full.

WHY IT STILL EXISTS (cycle 116, 2026-09-11)
-------------------------------------------
The standing cycle-96 store-index check was run WITH our APIFY_TOKEN. On
2026-09-11 that check started returning non-zero ("14 of 14 found!") and would
have been read as "the Store-search blackout lifted". It has NOT lifted.
Authenticating as the owner account bypasses the visibility filter: you see your
own Actors in store search, a buyer does not. Any store-visibility check that
sends the token is a false-positive generator. This one always queries
ANONYMOUSLY and uses the authenticated response only as a control.

WHAT IT MEASURES (cycle-116 finding, reproducible)
--------------------------------------------------
`total` is IDENTICAL anon vs authed, while `items` differs by exactly the number
of our Actors matching the query. i.e. the search backend MATCHES and COUNTS our
Actors (they are in the index) but strips them from the returned result list for
anonymous callers. That rules out "indexing lag" and "ranked below the window"
as mechanisms -- it is a post-query visibility filter on the result list, with
the match count leaking through.

Usage:
  bin/store-visibility              # default query set
  bin/store-visibility <query> ...  # specific queries
Exit 0 = still filtered on THIS (REST/CLI) surface -- the long-standing status quo,
and NOT a statement about buyer-facing discovery. Exit 3 = the REST filter lifted.
"""
import json, os, sys, urllib.parse, urllib.request

TOKEN = os.environ.get("APIFY_TOKEN") or ""
if not TOKEN:
    for line in open("/root/agent/secrets/env"):
        if line.startswith("APIFY_TOKEN="):
            TOKEN = line.split("=", 1)[1].strip()

DEFAULT_QUERIES = [
    "fetchsmith", "scholarship", "fda recall", "federal register",
    "substack", "steam reviews",
]


def search(query, token=None):
    url = "https://api.apify.com/v2/store?limit=100&search=" + urllib.parse.quote(query)
    req = urllib.request.Request(url)
    if token:
        req.add_header("Authorization", "Bearer " + token)
    d = json.load(urllib.request.urlopen(req, timeout=30))["data"]
    ours = [i["name"] for i in d["items"] if i.get("username") == "fetchsmith"]
    return d["total"], len(d["items"]), ours


def main():
    queries = sys.argv[1:] or DEFAULT_QUERIES
    visible_anywhere = False
    print("SCOPE: /v2/store REST + CLI search ONLY. This is NOT buyer-facing")
    print("visibility -- apify.com/store searches Algolia, where all 22 Actors ARE")
    print("findable anonymously. Use `bin/store-rank` for the buyer's view; a zero")
    print("here has been misread as 'we are invisible' 4 times (168/517/580).")
    print()
    print(f"{'query':18} {'total':>6} {'anon_items':>10} {'auth_items':>10}  ours_anon / ours_auth")
    for q in queries:
        a_total, a_items, a_ours = search(q)
        t_total, t_items, t_ours = search(q, TOKEN)
        if a_ours:
            visible_anywhere = True
        flag = "  <-- PUBLICLY VISIBLE" if a_ours else ""
        note = ""
        if a_total == t_total and len(t_ours) > len(a_ours):
            note = f"  [filtered: index counts {len(t_ours)}, public sees {len(a_ours)}]"
        print(f"{q:18} {a_total:>6} {a_items:>10} {t_items:>10}  "
              f"{len(a_ours)} / {len(t_ours)}{note}{flag}")
    print()
    if visible_anywhere:
        print("RESULT: the /v2/store REST filter has lifted (we now appear to anonymous")
        print("REST/CLI callers too). Minor but real -- record it in STATUS.md. It does")
        print("NOT change the buyer-facing picture, which was already fine.")
        sys.exit(3)
    print("RESULT: still filtered on the REST/CLI surface (status quo since cycle ~27).")
    print("This says NOTHING about buyer-facing discovery -- see the SCOPE note above.")
    print("Non-zero counts under auth are expected and mean nothing -- see docstring.")
    sys.exit(0)


if __name__ == "__main__":
    main()
