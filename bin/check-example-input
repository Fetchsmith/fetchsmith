#!/usr/bin/env python3
"""check-example-input — detect drift between each Actor's local test_input.json and
the live `exampleRunInput` advertised on its Store page's API tab.

WHY (cycle 1900): `bin/set-example-input <slug>` is the ONLY thing that ships
test_input.json to the live listing's API tab, and nothing enforced that it was ever
re-run. `apify push` does not touch `exampleRunInput` (same failure class as
check-store-meta's title/description: a field set once at creation and thereafter
only via PUT /v2/acts/<id>). So any cycle that rewrote a test_input.json — and the
PLAYBOOK records those rewrites happening, e.g. the cycle-1716 weak-test-input
fixes on sam-gov-opportunities-scraper and fec-campaign-finance-scraper — left the
Store page quietly advertising the OLD example to every buyer who opens the API tab.
A stale example is worse than a missing one: cycle 1716's own note is that the
pre-fix sam-gov input returned 1 row, so a buyer copy-pasting the advertised body
would have judged the Actor on a 1-row sample run.

Two failure modes reported:
  DRIFT    live exampleRunInput.body != local test_input.json (semantic JSON compare,
           so pure formatting/key-order differences are NOT flagged)
  TEMPLATE live body is still the Actor template's {"helloWorld": 123}, or absent

Read-only and free: one GET /v2/acts/<id> per Actor, nothing launched, nothing PUT.
Fix a reported slug with `bin/set-example-input <slug>` (local wins — test_input.json
is the file actor-health actually runs, so it is the source of truth by definition).

Usage:
  bin/check-example-input          # report, exit 1 if any drift
  bin/check-example-input <slug>   # single Actor
"""
import json
import os
import sys
import urllib.request

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
TEMPLATE = {"helloWorld": 123}


def token():
    for line in open(os.path.join(ROOT, "secrets/env")):
        if line.startswith("APIFY_TOKEN="):
            return line.split("=", 1)[1].strip().strip('"')
    sys.exit("APIFY_TOKEN not found in secrets/env")


def live(slug, tok):
    req = urllib.request.Request(
        f"https://api.apify.com/v2/acts/fetchsmith~{slug}",
        headers={"Authorization": f"Bearer {tok}"},
    )
    return json.load(urllib.request.urlopen(req, timeout=30))["data"]


def main():
    only = [a for a in sys.argv[1:] if not a.startswith("-")]
    tok = token()
    registry = json.load(open(os.path.join(ROOT, "actors/registry.json")))
    slugs = [t["slug"] for t in registry["tools"]]
    if only:
        slugs = [s for s in slugs if s in only]
        if not slugs:
            sys.exit(f"no such slug in registry.json: {only}")

    drift = 0
    checked = 0
    skipped = []
    for slug in slugs:
        path = os.path.join(ROOT, "actors", slug, "test_input.json")
        if not os.path.exists(path):
            skipped.append(f"{slug} (no test_input.json)")
            continue
        try:
            local = json.load(open(path))
        except json.JSONDecodeError as e:
            drift += 1
            print(f"{slug}: local test_input.json is not valid JSON ({e})")
            continue

        rem = live(slug, tok)
        if not rem.get("isPublic"):
            skipped.append(f"{slug} (not public)")
            continue
        checked += 1
        body = (rem.get("exampleRunInput") or {}).get("body")
        if not body:
            drift += 1
            print(f"{slug}: NO exampleRunInput on live listing (API tab has no example)")
            continue
        try:
            remote = json.loads(body)
        except json.JSONDecodeError:
            drift += 1
            print(f"{slug}: live exampleRunInput.body is not valid JSON:\n  {body[:200]}")
            continue
        if remote == TEMPLATE:
            drift += 1
            print(f"{slug}: TEMPLATE exampleRunInput still live ({TEMPLATE})")
            continue
        if remote != local:
            drift += 1
            print(f"{slug}: exampleRunInput DRIFT")
            print(f"  live : {json.dumps(remote, sort_keys=True)}")
            print(f"  local: {json.dumps(local, sort_keys=True)}")
            lk, rk = set(local), set(remote)
            if lk - rk:
                print(f"  keys only in local test_input.json: {sorted(lk - rk)}")
            if rk - lk:
                print(f"  keys only in live example       : {sorted(rk - lk)}")
            for k in sorted(lk & rk):
                if local[k] != remote[k]:
                    print(f"  {k}: live={remote[k]!r} local={local[k]!r}")

    for s in skipped:
        print(f"skip: {s}")
    print(f"\n{checked} public Actor(s) checked, {drift} drift")
    if drift:
        print("Fix with: bin/set-example-input <slug>   (local test_input.json wins)")
    return 1 if drift else 0


if __name__ == "__main__":
    sys.exit(main())
