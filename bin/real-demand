#!/root/agent/venv/bin/python
"""Baseline-adjusted demand: strip the Apify per-Actor daily auto-run floor out of runs30d.

WHY (discovered cycle 224): `bin/revenue`/`bin/usage-trend` report
`publicActorRunStats30Days.TOTAL` as "external demand". That number is real
(our own health runs genuinely do not appear in it) but it is NOT all demand:
every public Actor accrues a near-constant ~1.1-1.3 runs/day from the moment it
is published, independent of niche, price, feature depth or listing copy. Across
the 18-Actor fleet on 2026-09-13, 17 of 18 Actors sat in a 1.10-1.40 runs/day
band since publication -- a flat floor, not a demand curve. Only
`shopify-products-scraper` exceeded it (2.85/day). Reading the raw total is what
made ~20 cycles record "broad organic pickup, +1 across 7 Actors" when what was
actually happening was each Actor collecting its one automatic daily run.

This tool subtracts that floor. `excess` is the only number here that responds to
anything we do; treat it -- not runs30d -- as the demand signal.

  real-demand            -> per-Actor table + fleet totals
  real-demand --json     -> machine-readable
  real-demand --refresh  -> re-fetch each Actor's createdAt from the Apify API into AGES

AGE SOURCE (fixed cycle 1664 -- this was wrong for ~1440 cycles). Ages used to be
derived from `revenue_history.json`: the first snapshot in which an Actor appeared
with `public: true`. But history only starts 2026-09-25 and ALL 24 Actors were
already public by then, so every Actor read the same `days_public` -- a flat 18.00
fleet-wide -- when true ages span 19.3 to 34.6 days. Because `days` was an identical
constant for every row, `expected = median(runs30d/days) * days` collapsed to
`median(runs30d)` = 26 for EVERY Actor regardless of age, which is what hid the bug:
the table looked plausible. It was wrong three ways. (1) The printed floor read
1.44 runs/day when it is 0.87 -- overstated 1.66x, because it divided by 18 days of
exposure instead of the 30-day window. (2) It scored the four YOUNGEST Actors
(`sec-insider-trades` 19.3d, `remote-jobs` 22.3d, `sam-gov-opportunities` 23.4d,
`trademark-search` 24.0d) at -9/-6/-5/-3 "below floor" when all four actually sit AT
or above it (+0.3/+0.7/+0.7/+2.2) -- they simply had fewer days to accrue. The only
genuinely below-floor Actor is `scholarship-scraper` (-9.0 at a full 30 days), which
is also the only one carrying FAILED external runs. (3) The fleet total was wrong
too, not just the ranking: +17.0 -> +47.4.
Ages now come from the Apify API's own `createdAt`, cached in AGES. Note `createdAt`
is <= the public date (publication followed within a day for all 24, checked at the
fix), so it very slightly overestimates age and therefore underestimates rate --
conservative, and irrelevant for anything past the 30-day window cap.
"""
import json, os, statistics, sys, time

HIST = "/root/agent/state/revenue_history.json"
AGES = "/root/agent/state/actor_published.json"
WINDOW_DAYS = 30.0
# An Actor needs to have been public this long before its rate is stable enough
# to fold into the baseline estimate (a half-day-old Actor reads 1.85/day purely
# from integer rounding of a single run).
MIN_DAYS_FOR_BASELINE = 1.5


def refresh_ages():
    """Fetch createdAt for every owned Actor into AGES. Needs APIFY_TOKEN."""
    import httpx
    env = dict(l.rstrip("\n").split("=", 1) for l in open("/root/agent/secrets/env")
               if "=" in l and not l.startswith("#"))
    H = {"Authorization": f"Bearer {env['APIFY_TOKEN']}"}
    API = "https://api.apify.com/v2"
    user = httpx.get(f"{API}/users/me", headers=H).json()["data"]["username"]
    items = httpx.get(f"{API}/acts?my=true&limit=1000", headers=H).json()["data"]["items"]
    out = {}
    for it in items:
        a = httpx.get(f"{API}/acts/{user}~{it['name']}", headers=H).json()["data"]
        out[it["name"]] = a.get("createdAt")
    json.dump({"fetched": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
               "created_at": out}, open(AGES, "w"), indent=1)
    return out


def published_ts():
    """slug -> unix ts of publication, from the cached Apify createdAt."""
    if not os.path.exists(AGES):
        return {}
    created = (json.load(open(AGES)) or {}).get("created_at") or {}
    return {n: time.mktime(time.strptime(v[:19], "%Y-%m-%dT%H:%M:%S"))
            for n, v in created.items() if v}


def load():
    hist = json.load(open(HIST))
    # Fallback only: valid for an Actor first seen public AFTER history began.
    # For anything already public in snapshot 0 this is a floor on the age, not
    # the age -- see the AGE SOURCE note above.
    first_public = {}
    for snap in hist:
        for name, a in (snap.get("apify") or {}).items():
            if a.get("public") and name not in first_public:
                first_public[name] = snap["ts"]
    hist_start = hist[0]["ts"]
    pub = published_ts()
    ages, estimated = {}, set()
    for name, ts in first_public.items():
        if name in pub:
            ages[name] = pub[name]
        else:
            ages[name] = ts
            if ts <= hist_start:
                estimated.add(name)  # age is a lower bound, flagged in output
    last = hist[-1]
    return last, ages, estimated


def compute():
    last, published, estimated = load()
    now = last["ts"]
    rows = []
    for name, a in (last.get("apify") or {}).items():
        if not a.get("public"):
            continue
        # runs30d only counts the trailing 30 days, so an Actor public for longer
        # than the window has an effective exposure of exactly the window.
        days = min((now - published.get(name, now)) / 86400.0, WINDOW_DAYS)
        rows.append({"actor": name, "days_public": days, "runs30d": a.get("runs30d", 0),
                     "age_estimated": name in estimated,
                     "rate": a.get("runs30d", 0) / days if days > 0 else 0.0,
                     "users": a.get("users", 0), "users30d": a.get("users30d", 0)})
    stable = [r["rate"] for r in rows if r["days_public"] >= MIN_DAYS_FOR_BASELINE]
    # Median, not mean: a genuine breakout Actor must not drag the floor up and
    # hide itself. Falls back to 0 (i.e. no correction) if nothing is stable yet.
    baseline = statistics.median(stable) if stable else 0.0
    for r in rows:
        r["expected"] = baseline * r["days_public"]
        r["excess"] = r["runs30d"] - r["expected"]
    rows.sort(key=lambda r: -r["excess"])
    return {"ts": now, "date": last.get("date"), "baseline_runs_per_day": baseline,
            "actors": rows,
            "raw_runs30d": sum(r["runs30d"] for r in rows),
            "baseline_runs30d": sum(r["expected"] for r in rows),
            "excess_runs30d": sum(r["excess"] for r in rows)}


def main():
    if "--refresh" in sys.argv:
        got = refresh_ages()
        if "--json" not in sys.argv:  # keep --json output parseable
            print(f"refreshed createdAt for {len(got)} Actors into {AGES}")
    res = compute()
    if "--json" in sys.argv:
        print(json.dumps(res, indent=2))
        return
    print(f"as of {res['date']} ({time.strftime('%H:%MZ', time.gmtime(res['ts']))})  "
          f"baseline floor = {res['baseline_runs_per_day']:.2f} runs/day/Actor (fleet median)")
    print(f"{'actor':32} {'days':>6} {'runs30d':>8} {'expect':>7} {'excess':>7} {'users':>6}")
    for r in res["actors"]:
        flag = "  <-- real demand" if r["excess"] >= 2 else ""
        if r["age_estimated"]:
            flag += "  [age unknown, lower bound -- run --refresh]"
        print(f"{r['actor']:32} {r['days_public']:6.2f} {r['runs30d']:8} "
              f"{r['expected']:7.1f} {r['excess']:+7.1f} {r['users']:6}{flag}")
    print(f"\nraw runs30d       {res['raw_runs30d']:8}")
    print(f"baseline floor    {res['baseline_runs30d']:8.1f}  (accrues automatically on publication)")
    print(f"REAL DEMAND       {res['excess_runs30d']:+8.1f}  <- the only number that responds to our work")


if __name__ == "__main__":
    main()
