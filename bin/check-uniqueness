#!/root/agent/venv/bin/python
"""Flag result-uniqueness (PPE overcharge) risk for one Actor. FLAG ONLY, never fixes.

Usage: bin/check-uniqueness <slug> '{json input}' [rows] [extra,id,fields]

Background (cycles 760-763 sweep, 3 real overcharges / 5 Actors): several upstream
feeds re-publish a byte-identical record under a brand-new id, so a PPE Actor
charges the customer 2-3x for the same result. This helper finds that class.

Method, and why it is NOT the shallow content key the sweep used by hand:
  cycle 763's `federal-register-scraper` near-miss showed a hand-picked SUBSET of
  fields (title+date+citation+pages) merges genuinely-distinct records whenever the
  feed has boilerplate recurring titles ("Sunshine Act Meetings") and short notices
  that legitimately share a page. So here the grouping key is the WHOLE row minus
  id-ish fields, and every candidate group is then re-diffed across ALL fields:
    - REAL DUP   -> the only fields that differ are id-ish ones (auto-detected list)
    - AMBIGUOUS  -> some non-id field differs; prints which, for a human/agent call
  Nothing is auto-fixed and nothing is auto-reported as a bug: AMBIGUOUS groups need
  the raw-text diff step (cycle 763) before you believe them.

Cost: `rows` caps what we READ, not what the Actor CHARGES. Always put the Actor's
own cap (maxResults/maxItems/...) in the input JSON -- unknown input keys are
silently ignored by Apify, so a typo means an uncapped billable run (LEARNINGS,
apple-podcasts). We refuse to run if the input has no cap-looking key.
"""
import json, re, sys, hashlib, collections, httpx

ID_RE = re.compile(
    # NB: deliberately NOT created_at/updated_at -- on an upstream record those are
    # real content (publication time) and genuinely differ between distinct records;
    # excluding them would manufacture false REAL groups. Only scrape-side stamps.
    r"(^|_)(id|ids|uuid|guid|key|hash|url|uri|link|href|permalink|"
    r"(scraped|fetched|retrieved|crawled)_?at|timestamp|rownum)$", re.I)
CAP_RE = re.compile(r"max|limit|count|rows|items", re.I)


def is_id_field(name, extra):
    n = name.strip()
    if n.lower() in extra:
        return True
    # camelCase -> snake so `opportunityId` / `scrapedAt` hit the same rule
    snake = re.sub(r"(?<!^)(?=[A-Z])", "_", n).lower()
    return bool(ID_RE.search(snake))


def flatten(obj, prefix=""):
    """Flatten nested dicts so a nested id field is classified like a top-level one."""
    out = {}
    if isinstance(obj, dict):
        for k, v in obj.items():
            out.update(flatten(v, f"{prefix}.{k}" if prefix else k))
    else:
        out[prefix] = json.dumps(obj, sort_keys=True, default=str)
    return out


def main():
    if len(sys.argv) < 3:
        print(__doc__)
        sys.exit(2)
    slug = sys.argv[1]
    inp = json.loads(sys.argv[2])
    rows = int(sys.argv[3]) if len(sys.argv) > 3 else 200
    extra = {s.strip().lower() for s in sys.argv[4].split(",")} if len(sys.argv) > 4 else set()

    if not any(CAP_RE.search(k) for k in inp):
        print(f"REFUSING: input has no cap-looking key {list(inp)} -- an uncapped PPE run is billable.")
        print("Add the Actor's own cap (e.g. maxResults) to the input JSON.")
        sys.exit(2)

    env = dict(l.rstrip("\n").split("=", 1) for l in open("/root/agent/secrets/env")
               if "=" in l and not l.startswith("#"))
    T = env["APIFY_TOKEN"]
    API = "https://api.apify.com/v2"
    user = httpx.get(f"{API}/users/me", headers={"Authorization": f"Bearer {T}"}).json()["data"]["username"]
    reg = {t["slug"]: t for t in json.load(open("/root/agent/actors/registry.json"))["tools"]}
    mem = reg[slug].get("memory_mb", 1024)

    print(f"--- {slug} mem={mem} read_rows={rows} input={json.dumps(inp)}")
    r = httpx.post(f"{API}/acts/{user}~{slug}/run-sync-get-dataset-items",
                   # 300s is the run-sync endpoint's own hard cap -- asking for more is
                   # silently clamped (cycle 764 lost a google-news run to this). If a
                   # sample won't finish in 300s, narrow the input, don't raise this.
                   params={"token": T, "timeout": 300, "memory": mem, "clean": "true", "limit": rows},
                   json=inp, timeout=330)
    print("HTTP", r.status_code)
    items = r.json() if r.status_code < 300 else r.text[:400]
    if not isinstance(items, list):
        print(items)
        if isinstance(items, dict) and "timeout" in str(items):
            print("HINT: run-sync caps at 300s. Narrow the input (fewer queries, smaller "
                  "per-query cap, no body fetching) rather than asking for a longer timeout.")
        sys.exit(1)
    print("rows:", len(items))
    if not items:
        sys.exit(0)

    flat = [flatten(it) for it in items]
    names = sorted({k for f in flat for k in f})
    id_fields = [n for n in names if is_id_field(n.split(".")[-1], extra)]
    print(f"fields: {len(names)}  treated-as-id (excluded from the key): {id_fields}")
    if len(id_fields) == len(names):
        print("NOTE: every field looks id-ish -- pass an explicit shorter extra-id list or none.")

    groups = collections.defaultdict(list)
    for i, f in enumerate(flat):
        key = json.dumps({k: v for k, v in sorted(f.items()) if k not in id_fields}, sort_keys=True)
        groups[hashlib.sha1(key.encode()).hexdigest()].append(i)

    dups = [idxs for idxs in groups.values() if len(idxs) > 1]
    real, ambiguous = [], []
    for idxs in dups:
        base = flat[idxs[0]]
        differing = sorted({k for j in idxs[1:] for k in set(base) | set(flat[j])
                            if base.get(k) != flat[j].get(k)})
        (real if all(k in id_fields for k in differing) else ambiguous).append((idxs, differing))

    dup_rows = sum(len(i) - 1 for i, _ in real)
    print(f"\n== REAL duplicate groups (differ only in id-ish fields): {len(real)}"
          f"  -> {dup_rows} redundant rows = {dup_rows / len(items) * 100:.2f}% of the sample")
    for idxs, differing in real[:10]:
        print(f"  rows {idxs}  differing id fields: {differing}")
        for k in sorted(set(flat[idxs[0]]) - set(id_fields))[:4]:
            print(f"     {k} = {flat[idxs[0]][k][:90]}")
    print(f"\n== AMBIGUOUS groups (key matched but a non-id field differs): {len(ambiguous)}")
    for idxs, differing in ambiguous[:10]:
        print(f"  rows {idxs}  differing: {differing}  <- confirm with a raw-text diff before believing it")
    print("\nFLAG ONLY -- nothing was changed. A REAL group means the Actor charges twice "
          "for one result; fix with a same-source content hash applied BEFORE enrichment.")


main()
